    footer p {
      margin: 0;
      font-size: 18px;
      letter-spacing: -0.02em;
    }

    footer small {
      display: block;
      margin-top: 12px;
      color: var(--muted);
      font-size: 13px;
    }

    .side-dots {
      position: fixed;
      right: 22px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 999;
      display: flex;
      flex-direction: column;
