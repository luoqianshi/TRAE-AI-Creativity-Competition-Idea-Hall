<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DoneCheck——AI 编程需求兑现率检查器</title>
  <style>
    :root {
      --bg: #0f1117;
      --card: rgba(255, 255, 255, 0.065);
      --line: rgba(255, 255, 255, 0.12);
      --text: #f7f8fb;
      --muted: #9ba4b5;
      --soft: #cbd2e1;
      --blue: #68a6ff;
      --violet: #9b7cff;
      --green: #44d68c;
      --red: #ff6478;
      --orange: #ff9f43;
      --yellow: #ffd166;
      --shadow: 0 24px 80px rgba(0, 0, 0, 0.38);
      --radius: 24px;
      --max: 1100px;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(circle at 16% 4%, rgba(104, 166, 255, 0.22), transparent 28rem),
        radial-gradient(circle at 84% 8%, rgba(155, 124, 255, 0.2), transparent 30rem),
        radial-gradient(circle at 50% 52%, rgba(255, 159, 67, 0.08), transparent 38rem),
        linear-gradient(180deg, #0f1117 0%, #0b0d13 100%);
      font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", ui-sans-serif, system-ui, sans-serif;
      line-height: 1.6;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.85), transparent 75%);
      z-index: -2;
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.04;
      background-image: repeating-radial-gradient(circle at 20% 20%, #fff 0 1px, transparent 1px 4px);
      z-index: -1;
    }

    main {
      width: min(var(--max), calc(100% - 40px));
      margin: 0 auto;
    }

    section { margin: 92px 0; }

    .reveal {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding: 64px 0;
      margin: 0;
    }

    .hero-grid {
      width: 100%;
      display: grid;
      grid-template-columns: 1.02fr 0.98fr;
      gap: 48px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 8px 13px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.055);
      color: var(--soft);
      font-size: 13px;
      letter-spacing: 0.04em;
      backdrop-filter: blur(18px);
    }

    .eyebrow::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blue), var(--violet));
      box-shadow: 0 0 18px rgba(104, 166, 255, 0.9);
    }

    .brand-mark {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding: 10px 16px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.055);
      color: #edf2ff;
      font-size: clamp(20px, 2.2vw, 24px);
      line-height: 1;
      letter-spacing: -0.035em;
      font-weight: 760;
      backdrop-filter: blur(18px);
    }

    .brand-mark span {
      color: var(--muted);
      font-size: 0.68em;
      letter-spacing: 0;
      font-weight: 560;
    }

    .hero-copy {
      display: grid;
      align-content: center;
      gap: 0;
    }

    .tagline {
      margin: 28px 0 0;
      font-size: clamp(36px, 5.5vw, 64px);
      line-height: 1.08;
      letter-spacing: -0.06em;
      font-weight: 760;
      background: linear-gradient(135deg, #ffffff 15%, #b8c8ff 46%, #8d77ff 78%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero-desc {
      max-width: 620px;
      margin: 22px 0 0;
      color: var(--muted);
      font-size: 17px;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 34px;
    }

    button, .btn {
      border: 0;
      cursor: pointer;
      font: inherit;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: 0 20px;
      border-radius: 999px;
      color: var(--text);
      text-decoration: none;
      transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }

    .btn:focus-visible, .copy-btn:focus-visible, .side-dots a:focus-visible {
      outline: 2px solid rgba(104, 166, 255, 0.86);
      outline-offset: 4px;
    }

    .btn-primary {
      background: linear-gradient(135deg, #5b9dff, #8f6fff);
      box-shadow: 0 14px 42px rgba(104, 166, 255, 0.28);
    }

    .btn-secondary {
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(18px);
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 46px rgba(104, 166, 255, 0.2);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.085);
      border-color: rgba(255, 255, 255, 0.22);
    }

    .hero-visual {
      position: relative;
      min-height: 550px;
      display: grid;
      place-items: center;
    }

    .orb {
      position: absolute;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 38% 30%, rgba(255, 255, 255, 0.16), transparent 34%),
        radial-gradient(circle at 50% 52%, rgba(255, 159, 67, 0.14), transparent 48%),
        linear-gradient(135deg, rgba(104, 166, 255, 0.12), rgba(155, 124, 255, 0.08));
      filter: blur(1px);
      opacity: 0.75;
    }

    .progress-wrap {
      position: relative;
      width: min(360px, 80vw);
      height: min(360px, 80vw);
      border-radius: 50%;
      display: grid;
      place-items: center;
      background:
        linear-gradient(var(--bg), var(--bg)) padding-box,
        linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.03)) border-box;
      border: 1px solid transparent;
      box-shadow: var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(22px);
    }

    .progress-ring {
      position: absolute;
      inset: 22px;
      border-radius: 50%;
      background: conic-gradient(from -90deg, #ffd166 0deg, #ff9f43 calc(var(--p, 0) * 3.6deg), rgba(255, 255, 255, 0.06) 0deg);
      box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.08);
      transition: background 0.2s linear;
    }

    .progress-scan {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 2px;
      height: calc(50% - 22px);
      background: linear-gradient(to bottom, rgba(104, 166, 255, 0.76), rgba(104, 166, 255, 0));
      transform-origin: 50% 0;
      animation: scanRotate 3s linear infinite;
      z-index: 3;
      pointer-events: none;
    }

    @keyframes scanRotate {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .progress-ring::after {
      content: "";
      position: absolute;
      inset: 18px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 50% 0%, rgba(255, 159, 67, 0.12), transparent 44%),
        #10131b;
      box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.5);
    }

    .progress-core {
      position: relative;
      z-index: 2;
      text-align: center;
    }

    .progress-metrics-mobile {
      display: none;
      position: absolute;
      top: calc(50% + 166px);
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      gap: 8px;
      width: min(100%, 252px);
    }

    .progress-metrics-mobile .mini-row {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      font-size: 13px;
      line-height: 1.4;
    }

    .progress-metrics-mobile .mini-row span:first-child { color: var(--muted); }
    .progress-metrics-mobile .mini-row span:last-child { color: var(--text); font-weight: 680; }

    .progress-label {
      color: var(--muted);
      font-size: 15px;
      letter-spacing: 0.06em;
    }

    .progress-number {
      margin-top: 6px;
      font-size: clamp(72px, 10vw, 108px);
      line-height: 0.95;
      letter-spacing: -0.08em;
      font-weight: 780;
      background: linear-gradient(135deg, #ffe29a, #ff7a45);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .metric {
      position: absolute;
      width: 170px;
      padding: 14px 16px;
      border: 1px solid rgba(255, 255, 255, 0.13);
      border-radius: 18px;
      background: rgba(18, 22, 33, 0.72);
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.28);
      backdrop-filter: blur(18px);
    }

    .metric strong {
      display: block;
      margin-top: 4px;
      font-size: 24px;
      line-height: 1.1;
    }

    .metric span {
      color: var(--muted);
      font-size: 13px;
    }

    .metric.a { top: 58px; right: 2px; }
    .metric.b { left: 0; bottom: 90px; }
    .metric.c { right: 34px; bottom: 36px; }

    .section-head {
      max-width: 760px;
      margin-bottom: 28px;
    }

    h2 {
      margin: 0;
      font-size: clamp(30px, 5vw, 52px);
      line-height: 1.1;
      letter-spacing: -0.055em;
      font-weight: 760;
    }

    .section-note {
      margin: 14px 0 0;
      color: var(--muted);
      font-size: 16px;
    }

    .pain-layout {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 28px;
      align-items: center;
    }

    .pain-copy {
      padding-right: 18px;
    }

    .pain-copy p {
      margin: 18px 0 0;
      color: var(--muted);
      font-size: 16px;
    }

    .pain-strips {
      display: grid;
      gap: 12px;
    }

    .pain-strip {
      display: grid;
      grid-template-columns: auto 128px 1fr;
      gap: 14px;
      align-items: center;
      padding: 15px 17px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 18px;
      backdrop-filter: blur(18px);
      transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
    }

    .pain-strip:hover {
      transform: translateX(4px);
      border-color: rgba(255, 255, 255, 0.16);
    }

    .pain-strip:nth-child(1) { background: rgba(104, 166, 255, 0.11); }
    .pain-strip:nth-child(2) { background: rgba(255, 100, 120, 0.1); }
    .pain-strip:nth-child(3) { background: rgba(255, 209, 102, 0.1); }
    .pain-strip:nth-child(4) { background: rgba(155, 124, 255, 0.12); }

    .pain-strip .strip-index {
      width: 28px;
      height: 28px;
      display: inline-grid;
      place-items: center;
      border-radius: 50%;
      font-weight: 780;
      font-size: 12px;
      line-height: 1;
    }

    .pain-strip:nth-child(1) .strip-index { background: rgba(104, 166, 255, 0.25); color: var(--blue); }
    .pain-strip:nth-child(2) .strip-index { background: rgba(255, 100, 120, 0.25); color: var(--red); }
    .pain-strip:nth-child(3) .strip-index { background: rgba(255, 209, 102, 0.22); color: var(--yellow); }
    .pain-strip:nth-child(4) .strip-index { background: rgba(155, 124, 255, 0.25); color: var(--violet); }

    .pain-strip strong {
      color: #f5f7ff;
      font-size: 16px;
    }

    .pain-strip span:last-child {
      color: var(--muted);
      font-size: 14px;
    }

    .card {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.085), rgba(255, 255, 255, 0.045));
      box-shadow: 0 18px 60px rgba(0, 0, 0, 0.22);
      backdrop-filter: blur(20px);
      transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;
    }

    .card::before {
      content: "";
      position: absolute;
      inset: 0;
      opacity: 0;
      background: radial-gradient(circle at 20% 0%, rgba(104, 166, 255, 0.16), transparent 38%);
      transition: opacity 0.35s ease;
      pointer-events: none;
    }

    .card:hover::before { opacity: 1; }

    .card:hover {
      transform: translateY(-3px);
      border-color: rgba(255, 255, 255, 0.18);
      box-shadow: 0 22px 68px rgba(0, 0, 0, 0.26);
    }

    .pain-card {
      padding: 24px;
      min-height: 188px;
    }

    .index {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.08);
      color: var(--soft);
      font-weight: 680;
      font-size: 14px;
    }

    .pain-card h3, .feature-card h3 {
      position: relative;
      margin: 26px 0 10px;
      font-size: 19px;
      letter-spacing: -0.025em;
    }

    .pain-card p, .feature-card p {
      position: relative;
      margin: 0;
      color: var(--muted);
      font-size: 14px;
    }

    .workflow-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .input-card {
      padding: 22px;
      min-height: 310px;
    }

    .input-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
      color: #eef2ff;
      font-weight: 680;
      letter-spacing: -0.02em;
    }

    .badge-mini {
      padding: 4px 9px;
      border-radius: 999px;
      background: rgba(104, 166, 255, 0.12);
      color: #aecaef;
      font-size: 12px;
    }

    .mock-text {
      margin: 0;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      color: var(--soft);
      font-size: 14px;
    }

    pre {
      margin: 0;
      white-space: pre-wrap;
      overflow-x: auto;
      overflow-wrap: anywhere;
      color: #d8def0;
      font-size: 13px;
      line-height: 1.65;
      font-family: "SFMono-Regular", "Cascadia Code", "Liberation Mono", Consolas, monospace;
    }

    .keyword { color: #8bb8ff; }

    .analysis-bar {
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-top: 18px;
      padding: 16px 22px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: linear-gradient(90deg, rgba(104, 166, 255, 0.18), rgba(155, 124, 255, 0.05)), rgba(8, 11, 18, 0.78);
      color: #eaf0ff;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .analysis-bar span {
      position: relative;
      z-index: 1;
      flex: 1;
      text-align: center;
      color: var(--soft);
      font-size: 14px;
      font-weight: 680;
      animation: stepPulse 2.8s ease-in-out infinite;
    }

    .analysis-bar span:nth-child(2) { animation-delay: 0.93s; }
    .analysis-bar span:nth-child(3) { animation-delay: 1.86s; }

    .analysis-bar span + span::before {
      content: "→";
      position: absolute;
      left: -12px;
      color: rgba(255, 255, 255, 0.24);
    }

    @keyframes stepPulse {
      0%, 100% { opacity: 0.38; }
      45% { opacity: 1; }
    }

    .flow-output {
      margin-top: 18px;
      padding: 20px 24px;
      border-radius: 22px;
      border: 1px solid rgba(104, 166, 255, 0.26);
      background: radial-gradient(circle at 30% 0%, rgba(104, 166, 255, 0.18), transparent 44%), rgba(255, 255, 255, 0.055);
      text-align: center;
      color: #eaf0ff;
      font-size: 18px;
      font-weight: 680;
      letter-spacing: -0.02em;
    }

    .overview {
      display: grid;
      grid-template-columns: minmax(260px, 0.95fr) 1.6fr;
      gap: 14px;
      margin-bottom: 16px;
    }

    .stat-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .stat { padding: 20px; }

    .stat.main {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 188px;
      background: radial-gradient(circle at 70% 80%, rgba(255, 159, 67, 0.08), transparent 60%), linear-gradient(180deg, rgba(255, 255, 255, 0.085), rgba(255, 255, 255, 0.045));
    }

    .stat span {
      display: block;
      color: var(--muted);
      font-size: 13px;
    }

    .stat strong {
      display: block;
      margin-top: 8px;
      font-size: 30px;
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .stat.main strong {
      font-size: clamp(72px, 8vw, 96px);
      background: linear-gradient(135deg, #ffd166, #ff784f);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .table-shell {
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(104, 166, 255, 0.44) rgba(255, 255, 255, 0.06);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.045);
      box-shadow: var(--shadow);
    }

    .table-shell::-webkit-scrollbar { height: 10px; }
    .table-shell::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.06); }
    .table-shell::-webkit-scrollbar-thumb {
      border: 2px solid rgba(18, 22, 33, 0.9);
      border-radius: 999px;
      background: rgba(104, 166, 255, 0.44);
    }

    .report-chrome {
      min-width: 900px;
      height: 40px;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 18px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.09);
      background: rgba(255, 255, 255, 0.04);
      color: var(--muted);
      font-size: 12px;
    }

    .chrome-dots {
      display: flex;
      gap: 7px;
    }

    .chrome-dots span {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .chrome-dots span:nth-child(1) { background: #ff5f57; }
    .chrome-dots span:nth-child(2) { background: #febc2e; }
    .chrome-dots span:nth-child(3) { background: #28c840; }

    .chrome-title {
      flex: 1;
      text-align: center;
      transform: translateX(-25px);
    }

    table {
      width: 100%;
      min-width: 900px;
      border-collapse: collapse;
    }

    th, td {
      padding: 17px 18px;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.09);
      vertical-align: middle;
      font-size: 14px;
    }

    th {
      color: #dfe6f7;
      font-weight: 680;
      background: rgba(255, 255, 255, 0.055);
      white-space: nowrap;
    }

    td { color: var(--soft); }
    tr:last-child td { border-bottom: 0; }
    tbody tr {
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.55s ease, transform 0.55s ease;
    }

    tbody tr.row-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .source { color: var(--muted); }

    .evidence {
      color: #dce4f7;
      font-family: "SFMono-Regular", "Cascadia Code", "Liberation Mono", Consolas, monospace;
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-width: 74px;
      justify-content: center;
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 680;
      white-space: nowrap;
    }

    .ok {
      color: #b8ffd9;
      background: rgba(68, 214, 140, 0.13);
      border: 1px solid rgba(68, 214, 140, 0.28);
    }

    .bad {
      color: #ffd0d6;
      background: rgba(255, 100, 120, 0.13);
      border: 1px solid rgba(255, 100, 120, 0.28);
    }

    .weak {
      color: #d7e8ff;
      background: rgba(114, 154, 204, 0.13);
      border: 1px solid rgba(114, 154, 204, 0.26);
    }

    .extra {
      color: #ffe0ba;
      background: linear-gradient(135deg, rgba(255, 159, 67, 0.16), rgba(155, 124, 255, 0.14));
      border: 1px solid rgba(255, 159, 67, 0.28);
    }

    .compare {
      display: block;
    }

    .compare-card { padding: 26px; }
    .compare-list { display: grid; gap: 14px; }

    .compare-row {
      display: grid;
      grid-template-columns: 1.1fr 1.1fr 0.8fr;
      gap: 12px;
      align-items: center;
      padding: 15px;
      border-radius: 17px;
      background: rgba(255, 255, 255, 0.055);
      border: 1px solid rgba(255, 255, 255, 0.09);
      color: var(--soft);
      font-size: 14px;
    }

    .compare-row.head {
      color: #eef3ff;
      font-weight: 700;
      background: rgba(255, 255, 255, 0.085);
    }

    .mark-red { color: var(--red); font-weight: 760; }
    .mark-yellow { color: var(--yellow); font-weight: 760; }

    .evidence-map {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 28px;
      margin-top: 22px;
      padding: 30px 42px 24px;
