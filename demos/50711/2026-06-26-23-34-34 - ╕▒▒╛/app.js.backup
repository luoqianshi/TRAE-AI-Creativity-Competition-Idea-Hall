// ==================== API 配置（内置，密钥混淆�?====================
// API密钥通过 hex编码+分段偏移 混淆存储，运行时还原
// 原始密钥经过 hex 编码后分�?段，每段加不同偏移量
const _K_PARTS = [
  ';:;;8<;88885;7;78:;:8>8=8',   // Part 1 (offset 5)
  '76<646:95969494956:6<6794',  // Part 2 (offset 3)
  ':>:7:<:7=8=<:89l<h;=>==m>',  // Part 3 (offset 7)
  '56e786375859:666h557867',    // Part 4 (offset 2)
];
const _K_OFFSETS = [5, 3, 7, 2]; // 每段的字符偏移量

function _decodeKey() {
  // 还原：每段减去偏移量得到hex字符串，再从hex解码回原始密�?
var rawParts = _K_PARTS.map(function(part, idx) {
    var offset = _K_OFFSETS[idx];
    var decoded = '';
    for (var i = 0; i < part.length; i++) {
      decoded += String.fromCharCode(part.charCodeAt(i) - offset);
    }
    return decoded;
  });
  var hexStr = rawParts.join('');
  // hex字符串解码为原始文本
  var result = '';
  for (var i = 0; i < hexStr.length; i += 2) {
    result += String.fromCharCode(parseInt(hexStr.substring(i, i + 2), 16));
  }
  return result;
}

function getAPIConfig() {
  return {
    baseUrl: 'https://open.bigmodel.cn/api/paas/v4',
    apiKey: _decodeKey(),
    model: 'glm-4-flash',
  };
}

function isAPIConfigured() {
  // API已内置，始终返回true
  return true;
}

// ==================== 安全哈希（用于统计数据防篡改�?====================
function _simpleHash(str) {
  // 简单但有效的哈希函数，用于校验统计数据完整�?  var hash = 0;
  var salt = '_eqStation_2024_';
  var salted = salt + str + salt;
  for (var i = 0; i < salted.length; i++) {
    var c = salted.charCodeAt(i);
    hash = ((hash << 5) - hash) + c;
    hash |= 0; // Convert to 32bit integer
  }
  return 'h_' + Math.abs(hash).toString(36);
}

function _verifyHash(record) {
  // 验证统计记录的完整�?  if (!record._hash) return false;
  // 重建哈希：基�?nickname + action + time
  var raw = record.nickname + '|' + record.action + '|' + record.time;
  return record._hash === _simpleHash(raw);
}

