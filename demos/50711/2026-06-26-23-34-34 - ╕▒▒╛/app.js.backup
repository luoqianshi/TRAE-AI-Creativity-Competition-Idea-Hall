// ==================== 管理员认�?====================
const AdminAuth = {
  // 管理员密码的哈希（防止密码明文出现在代码中）
  _passwordHash: 'h_j4cgjl', // 默认密码: qinggan123

  verify: function() {
    var input = $('admin-password').value;
    if (!input) {
      showToast('请输入密�?);
      return;
    }
    if (_simpleHash(input) === this._passwordHash) {
      $('admin-login').style.display = 'none';
      $('admin-stats-container').style.display = '';
      tracker.renderAdmin();
      showToast('验证成功');
    } else {
      showToast('密码错误');
      $('admin-password').value = '';
      $('admin-password').focus();
    }
  },

  // 修改管理员密码（仅管理员已验证后可用�?  changePassword: function(oldPwd, newPwd) {
    if (_simpleHash(oldPwd) !== this._passwordHash) {
      showToast('旧密码错�?);
      return false;
    }
    this._passwordHash = _simpleHash(newPwd);
    showToast('密码已更新（注意：密码存储在JS代码中，修改需要更新代码）');
    return true;
  },
};

// ==================== 用户统计追踪 ====================
const tracker = {
  nickname: '',

  init: function() {
    var saved = localStorage.getItem('user_nickname');
    if (saved) {
      this.nickname = saved;
      this.recordVisit();
      return true;
    }
    return false;
  },

  setNickname: function(name) {
    this.nickname = name;
    localStorage.setItem('user_nickname', name);
    this.recordVisit();
  },

  getNickname: function() {
    return this.nickname || localStorage.getItem('user_nickname') || '匿名用户';
  },

  // 记录访问
  recordVisit: function() {
    var record = {
      nickname: this.getNickname(),
      action: 'visit',
      time: new Date().toISOString(),
      _hash: '', // 预留哈希字段
    };
    record._hash = _simpleHash(record.nickname + '|' + record.action + '|' + record.time);
    this.addRecord(record);
  },

  // 记录功能使用
  recordFeature: function(feature) {
    var record = {
      nickname: this.getNickname(),
      action: feature,
      time: new Date().toISOString(),
      _hash: '',
    };
    record._hash = _simpleHash(record.nickname + '|' + record.action + '|' + record.time);
    this.addRecord(record);
  },

  // 添加记录�?localStorage（带完整性校验）
  addRecord: function(record) {
    var stats = this.getStats();
    stats.push(record);
    // 最多保�?500 �?    if (stats.length > 500) stats = stats.slice(-500);
    localStorage.setItem('app_stats', JSON.stringify(stats));
  },

  // 获取所有统计记录（带完整性验证）
  getStats: function() {
    try {
      var raw = JSON.parse(localStorage.getItem('app_stats') || '[]');
      // 验证每条记录的完整性，剔除被篡改的记录
      var valid = raw.filter(function(r) {
        return _verifyHash(r);
      });
      // 如果有记录被剔除，更新存�?      if (valid.length !== raw.length) {
        localStorage.setItem('app_stats', JSON.stringify(valid));
      }
      return valid;
    } catch(e) {
      return [];
    }
  },

  // 渲染统计面板
  renderAdmin: function() {
    var container = $('admin-stats-container');
    if (!container) return;

    var stats = this.getStats();

    // 统计汇�?    var totalVisits = stats.filter(function(r) { return r.action === 'visit'; }).length;
    var uniqueUsers = {};
    stats.forEach(function(r) { uniqueUsers[r.nickname] = true; });
    var uniqueCount = Object.keys(uniqueUsers).length;

    // 功能使用统计
    var featureCounts = {};
    stats.forEach(function(r) {
      if (r.action !== 'visit') {
        featureCounts[r.action] = (featureCounts[r.action] || 0) + 1;
      }
    });

    var html = '';

    // 汇总卡�?    html += '<div class="stats-summary">';
    html += '<div class="stats-card"><div class="stats-card-value">' + totalVisits + '</div><div class="stats-card-label">总访问次�?/div></div>';
    html += '<div class="stats-card"><div class="stats-card-value">' + uniqueCount + '</div><div class="stats-card-label">用户�?/div></div>';
    html += '<div class="stats-card"><div class="stats-card-value">' + stats.length + '</div><div class="stats-card-label">总记录数</div></div>';
    html += '</div>';

    // 功能使用
    html += '<div class="stats-section">';
    html += '<div class="stats-section-title">📈 功能使用统计</div>';
    if (Object.keys(featureCounts).length === 0) {
      html += '<div class="stats-empty">暂无功能使用记录</div>';
    } else {
      html += '<div class="stats-feature-list">';
      var featureLabels = {
        'enter_single': '进入单人调解模式',
        'enter_pk': '进入双人PK模式',
        'single_complete': '单人模式完成倾诉',
        'pk_sideA_complete': 'PK甲方完成倾诉',
        'pk_sideB_complete': 'PK乙方完成倾诉',
        'mentor_view': '查看导师点评',
        'advice_generate': '生成综合建议',
        'pdf_export': '导出PDF处方�?,
        'copy_result': '复制结果',
        'share_link': '生成分享链接',
      };
      Object.keys(featureCounts).sort(function(a,b) { return featureCounts[b] - featureCounts[a]; }).forEach(function(key) {
        html += '<div class="stats-feature-row">';
        html += '<span class="stats-feature-name">' + (featureLabels[key] || key) + '</span>';
        html += '<span class="stats-feature-count">' + featureCounts[key] + ' �?/span>';
        html += '</div>';
      });
      html += '</div>';
    }
    html += '</div>';

    // 最近活动日�?    html += '<div class="stats-section">';
    html += '<div class="stats-section-title">🕐 最近活�?/div>';
    if (stats.length === 0) {
      html += '<div class="stats-empty">暂无活动记录</div>';
    } else {
      html += '<div class="stats-log">';
      var recent = stats.slice(-30).reverse();
      recent.forEach(function(r) {
        var time = new Date(r.time);
        var timeStr = (time.getMonth()+1) + '/' + time.getDate() + ' ' +
          String(time.getHours()).padStart(2,'0') + ':' + String(time.getMinutes()).padStart(2,'0');
        var featureLabels = {
          'visit': '访问页面',
          'enter_single': '进入单人调解',
          'enter_pk': '进入双人PK',
          'single_complete': '完成单人倾诉',
          'pk_sideA_complete': 'PK甲方完成',
          'pk_sideB_complete': 'PK乙方完成',
          'mentor_view': '查看导师点评',
          'advice_generate': '生成综合建议',
          'pdf_export': '导出PDF',
          'copy_result': '复制结果',
          'share_link': '生成分享链接',
        };
        html += '<div class="stats-log-row">';
        html += '<span class="stats-log-name">' + escapeHTML(r.nickname) + '</span>';
        html += '<span class="stats-log-detail">' + (featureLabels[r.action] || r.action) + '</span>';
        html += '<span class="stats-log-time">' + timeStr + '</span>';
        html += '</div>';
      });
      html += '</div>';
    }
    html += '</div>';

    // 导出按钮
    html += '<button class="btn-secondary btn-block stats-export-btn" onclick="tracker.exportStats()">📋 导出统计数据（JSON�?/button>';
    html += '<button class="btn-secondary btn-block stats-export-btn" onclick="tracker.clearStats()" style="margin-top:8px;color:#f44336">🗑 清空统计数据</button>';

    container.innerHTML = html;
  },

  exportStats: function() {
    var stats = this.getStats();
    // 导出时去除哈希字段（内部校验用）
    var exportData = stats.map(function(r) {
      return { nickname: r.nickname, action: r.action, time: r.time };
    });
    var json = JSON.stringify(exportData, null, 2);
    var blob = new Blob([json], { type: 'application/json' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'stats_' + new Date().toISOString().slice(0,10) + '.json';
    a.click();
    URL.revokeObjectURL(url);
    showToast('统计数据已导�?);
  },

  clearStats: function() {
    if (!confirm('确定要清空所有统计数据吗？此操作不可恢复�?)) return;
    localStorage.removeItem('app_stats');
    this.renderAdmin();
    showToast('统计数据已清�?);
  },
};

// ==================== 工具函数 ====================
function $(id) { return document.getElementById(id); }
function $$(selector) { return document.querySelectorAll(selector); }

function showToast(msg, duration) {
  duration = duration || 2500;
  const toast = $('toast');
  toast.textContent = msg;
  toast.classList.add('show');
  clearTimeout(toast._timer);
  toast._timer = setTimeout(function() { toast.classList.remove('show'); }, duration);
}

function encodeData(data) {
  try {
    return btoa(unescape(endecodeURIComponent(JSON.stringify(data))));
  } catch (e) {
    console.error('encode error:', e);
    return '';
  }
}

function decodeData(encoded) {
  try {
    return JSON.parse(decodeURIComponent(escape(atob(encoded))));
  } catch (e) {
    console.error('decode error:', e);
    return null;
  }
}

function formatContent(text) {
  if (!text) return '';
  var html = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  var paragraphs = html.split(/\n\n+/);
  return paragraphs.map(function(p) {
    return '<p>' + p
      .replace(/\n/g, '<br>')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/�?.+?)�?g, '<strong>�?1�?/strong>') + '</p>';
  }).join('');
}

function getAgeLabel(age) {
  var labels = {
    'under18': '18岁以�?,
    '18-25': '18-25�?,
    '25-35': '25-35�?,
    '35-55': '35-55�?,
    'over55': '55岁以�?,
  };
  return labels[age] || age;
}

function getGenderLabel(gender) {
  return gender === 'male' ? '�? : '�?;
}

function escapeHTML(text) {
  if (!text) return '';
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\n/g, '<br>');
}

// ==================== LLM API 调用（支持流式输出）====================
async function callLLMStream(systemPrompt, userMessages, temperature, onToken, onComplete, onError) {
  var config = getAPIConfig();

  var messages = [
    { role: 'system', content: systemPrompt },
    ...userMessages,
  ];

  var url = config.baseUrl.replace(/\/+$/, '') + '/chat/completions';

  // 创建 AbortController
  var controller = new AbortController();
  streamState.active = true;
  streamState.abortController = controller;

  try {
    var response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + config.apiKey,
      },
      body: JSON.stringify({
        model: config.model,
        messages: messages,
        temperature: temperature,
        max_tokens: 2000,
        stream: true,
      }),
      signal: controller.signal,
    });

    if (!response.ok) {
      var errText = await response.text().catch(function() { return ''; });
      var errMsg = 'API请求失败 (' + response.status + ')';
      if (response.status === 401) errMsg = 'API密钥无效';
      else if (response.status === 404) errMsg = 'API地址或模型名称不正确�?04�?;
      else if (response.status === 429) errMsg = '请求过于频繁，请稍后再试';
      else if (response.status >= 500) errMsg = '服务器错误，请稍后再�?;
      else {
        try {
          var errJson = JSON.parse(errText);
          if (errJson.error && errJson.error.message) errMsg = errJson.error.message;
        } catch(e) {}
      }
      if (onError) onError(new Error(errMsg));
      return;
    }

    // 处理 SSE 流式响应
    var reader = response.body.getReader();
    var decoder = new TextDecoder();
    var buffer = '';
    var fullText = '';
    var lastUpdateTime = 0;
    var pendingUpdate = false;
    var latestText = '';

    // 节流更新函数：每 150ms 最多更新一�?DOM
    function scheduleUpdate() {
      var now = Date.now();
      if (now - lastUpdateTime >= 150) {
        lastUpdateTime = now;
        if (onToken && latestText !== undefined) {
          onToken(latestText, '');
        }
      } else if (!pendingUpdate) {
        pendingUpdate = true;
        setTimeout(function() {
          pendingUpdate = false;
          lastUpdateTime = Date.now();
          if (onToken && latestText !== undefined) {
            onToken(latestText, '');
          }
        }, 150);
      }
    }

    while (true) {
      var result = await reader.read();
      if (result.done) break;

      buffer += decoder.decode(result.value, { stream: true });
      var lines = buffer.split('\n');
      buffer = lines.pop() || '';

      for (var i = 0; i < lines.length; i++) {
        var line = lines[i].replace(/\r$/, '').trim();
        if (!line || line === 'data: [DONE]') continue;
        if (line.startsWith('data: ')) {
          var jsonStr = line.slice(6);
          if (jsonStr.trim() === '[DONE]') continue;
          try {
            var data = JSON.parse(jsonStr);
            var choice = data.choices && data.choices[0];
            var token = (choice && choice.delta && choice.delta.content)
              || (choice && choice.text);
            if (token) {
              fullText += token;
              latestText = fullText;
              scheduleUpdate();
            }
          } catch (e) {
            // 忽略解析错误
          }
        }
      }
    }

    // 确保最终内容被更新
    if (onToken) onToken(fullText, '');

    streamState.active = false;
    if (onComplete) onComplete(fullText.trim());

  } catch (err) {
    streamState.active = false;
    if (err.name === 'AbortError') {
      if (onError) onError(new Error('请求被取�?));
    } else if (err.message.includes('Failed to fetch') || err.message.includes('NetworkError')) {
      var protocol = window.location.protocol;
      var hint = '网络连接失败';
      if (protocol === 'file:') {
        hint = '网络连接失败。检测到你正在用 file:// 协议直接打开HTML文件，浏览器会阻止网络请求。\n\n请通过本地服务器访问：http://localhost:8080';
      } else {
        hint = '网络连接失败。可能原因：\n1. 网络无法访问API服务器\n2. 浏览器扩展阻止了请求\n\n请稍后重�?;
      }
      if (onError) onError(new Error(hint));
    } else {
      if (onError) onError(err);
    }
  }
}

// 非流式调用（用于一些快速请求）
async function callLLM(systemPrompt, userMessages, temperature) {
  return new Promise(function(resolve, reject) {
    var fullText = '';
    callLLMStream(systemPrompt, userMessages, temperature || 0.8,
      function(text) { fullText = text; },
      function(text) { resolve(text); },
      function(err) { reject(err); }
    );
  });
}

// 停止当前流式输出
function stopStream() {
  if (streamState.active && streamState.abortController) {
    streamState.abortController.abort();
    streamState.active = false;
  }
}

// ==================== PDF 导出 ====================
function exportPDF(mode) {
  tracker.recordFeature('pdf_export');
  var html = buildPrescriptionHTML(mode);
  var printWin = window.open('', '_blank');
  printWin.document.write(html);
  printWin.document.close();
  printWin.onload = function() {
    setTimeout(function() {
      printWin.print();
    }, 500);
  };
}

function buildPrescriptionHTML(mode) {
  var title = mode === 'single' ? '感情急诊处方单（单人�? : '感情急诊处方单（双人PK�?;
  var now = new Date();
  var dateStr = now.getFullYear() + '�? + (now.getMonth()+1) + '�? + now.getDate() + '�?;

  var bodyHTML = '';

  if (mode === 'single') {
    var p = state.single.profile;
    bodyHTML += '<div class="section">';
    bodyHTML += '<div class="section-title">📋 基本信息</div>';
    bodyHTML += '<div class="field"><span class="label">用户性别�?/span>' + escapeHTML(getGenderLabel(p.gender)) + '</div>';
    bodyHTML += '<div class="field"><span class="label">年龄范围�?/span>' + escapeHTML(getAgeLabel(p.age)) + '</div>';
    bodyHTML += '</div>';

    bodyHTML += '<div class="section">';
    bodyHTML += '<div class="section-title">📝 事件概要</div>';
    bodyHTML += '<div class="content">' + formatContent(state.single.summary) + '</div>';
    bodyHTML += '</div>';
  } else {
    var a = state.pk.sideA;
    var b = state.pk.sideB;
    bodyHTML += '<div class="section">';
    bodyHTML += '<div class="section-title">📝 双方陈述</div>';
    var aProfile = a.profile && a.profile.gender ? '�? + getGenderLabel(a.profile.gender) + ' · ' + getAgeLabel(a.profile.age) + '�? : '';
    var bProfile = b.profile && b.profile.gender ? '�? + getGenderLabel(b.profile.gender) + ' · ' + getAgeLabel(b.profile.age) + '�? : '';
    bodyHTML += '<div class="sub-section"><div class="sub-title">' + escapeHTML(a.name || '甲方') + escapeHTML(aProfile) + '</div>';
    bodyHTML += '<div class="content">' + formatContent(a.summary) + '</div></div>';
    bodyHTML += '<div class="sub-section"><div class="sub-title">' + escapeHTML(b.name || '乙方') + escapeHTML(bProfile) + '</div>';
    bodyHTML += '<div class="content">' + formatContent(b.summary) + '</div></div>';
    bodyHTML += '</div>';
  }

  // 四位导师点评
  MENTOR_ORDER.forEach(function(mid) {
    var m = MENTORS[mid];
    var commentary = state[mode].mentorCommentaries[mid];
    if (!commentary) return;

    bodyHTML += '<div class="section mentor-section" style="border-left:4px solid ' + m.color + '">';
    bodyHTML += '<div class="section-title" style="color:' + m.color + '">' + m.emoji + ' ' + m.name + '�? + m.role + '�?/div>';
    bodyHTML += '<div class="content">' + formatContent(commentary) + '</div>';
    bodyHTML += '</div>';
  });

  // 综合建议
  var advice = state[mode].advice;
  if (advice) {
    bodyHTML += '<div class="section advice-section">';
    bodyHTML += '<div class="section-title advice-title">💊 综合处方建议</div>';
    bodyHTML += '<div class="content">' + formatContent(advice) + '</div>';
    bodyHTML += '</div>';
  }

  return '<!DOCTYPE html>\n' +
    '<html><head>\n' +
    '<meta charset="UTF-8">\n' +
    '<title>感情急诊处方�?/title>\n' +
    '<style>\n' +
    '  * { margin:0; padding:0; box-sizing:border-box; }\n' +
    '  body { font-family: "PingFang SC","Microsoft YaHei",sans-serif; color:#333; line-height:1.8; padding:30px; max-width:800px; margin:0 auto; }\n' +
    '  .header { text-align:center; padding:20px 0 30px; border-bottom:3px solid #FF6B6B; margin-bottom:30px; }\n' +
    '  .header h1 { font-size:24px; color:#FF6B6B; margin-bottom:8px; }\n' +
    '  .header .date { font-size:14px; color:#999; }\n' +
    '  .stamp { display:inline-block; border:2px solid #FF6B6B; color:#FF6B6B; padding:4px 16px; border-radius:20px; font-size:13px; font-weight:700; margin-top:8px; }\n' +
    '  .section { margin-bottom:24px; }\n' +
    '  .section-title { font-size:16px; font-weight:700; margin-bottom:12px; padding-bottom:8px; border-bottom:1px solid #f0e0d8; }\n' +
    '  .advice-title { color:#667eea; border-bottom-color:#667eea; }\n' +
    '  .field { margin-bottom:6px; font-size:14px; }\n' +
    '  .field .label { font-weight:600; color:#666; }\n' +
    '  .content { font-size:14px; line-height:1.9; white-space:pre-wrap; word-break:break-word; }\n' +
    '  .sub-section { margin-bottom:16px; }\n' +
    '  .sub-title { font-size:14px; font-weight:700; color:#FF6B6B; margin-bottom:6px; }\n' +
    '  .mentor-section { padding-left:16px; }\n' +
    '  .advice-section { background:linear-gradient(135deg,#f0f4ff,#f5f0ff); padding:20px; border-radius:12px; border:2px solid #667eea40; }\n' +
    '  @media print { body { padding:15px; } }\n' +
    '</style>\n' +
    '</head><body>\n' +
    '<div class="header">\n' +
    '  <h1>💘 感情急诊事务所</h1>\n' +
    '  <div style="font-size:18px;font-weight:700;color:#333;margin-top:8px;">' + title + '</div>\n' +
    '  <div class="date">' + dateStr + '</div>\n' +
    '  <div class="stamp">吵架就吵明白，我来评评理</div>\n' +
    '</div>\n' +
    bodyHTML +
    '<script>setTimeout(function(){window.print();},800);<\/script>\n' +
    '</body></html>';
}

// ==================== 页面导航 ====================
const App = {
  showPage: function(pageId) {
    stopStream();
    var pages = document.querySelectorAll('.page');
    pages.forEach(function(p) { p.classList.remove('active'); });
    var target = document.getElementById(pageId + '-page');
    if (target) target.classList.add('active');
    window.scrollTo(0, 0);

    if (pageId === 'single') {
      tracker.recordFeature('enter_single');
      this.initSingleMode();
    }
    if (pageId === 'pk') {
      tracker.recordFeature('enter_pk');
      this.initPKMode();
    }
    if (pageId === 'admin') {
      // 不自动渲染，需要密码验证后才渲�?    }
  },

  // ==================== 单人调解模式 ====================
  initSingleMode: function() {
    if (state.single.infoComplete) {
      this.showSingleMentors();
      return;
    }
    if (state.single.messages.length > 0) {
      this.showSingleChat();
      return;
    }
    this.showSingleProfile();
  },

  showSingleProfile: function() {
    $('single-step-profile').style.display = '';
    $('single-step-chat').style.display = 'none';
    $('single-step-mentors').style.display = 'none';
  },

  showSingleChat: function() {
    $('single-step-profile').style.display = 'none';
    $('single-step-chat').style.display = '';
    $('single-step-mentors').style.display = 'none';
    this.renderSingleMessages();
  },

  showSingleMentors: function() {
    $('single-step-profile').style.display = 'none';
    $('single-step-chat').style.display = 'none';
    $('single-step-mentors').style.display = '';
    $('single-summary').textContent = state.single.summary;
    this.renderMentorButtons('single');
    this.updateProgress('single');
    if (state.single.viewedMentors.size === 4) {
      $('single-advice-section').style.display = '';
    }
  },

  selectSingleProfile: function(type, value) {
    state.single.profile[type] = value;
    this.updateProfileUI();
  },

  updateProfileUI: function() {
    var self = this;
    var genderBtns = document.querySelectorAll('#gender-options .option-btn');
    genderBtns.forEach(function(btn) {
      btn.classList.toggle('selected', btn.dataset.value === state.single.profile.gender);
    });
    var ageBtns = document.querySelectorAll('#age-options .option-btn');
    ageBtns.forEach(function(btn) {
      btn.classList.toggle('selected', btn.dataset.value === state.single.profile.age);
    });
    $('single-start-btn').disabled = !(state.single.profile.gender && state.single.profile.age);
  },

  startSingleChat: function() {
    if (!state.single.profile.gender || !state.single.profile.age) return;
    state.single.messages = [];
    this.showSingleChat();

    var welcomeMsg = '你好呀，我是感情急诊事务所的接待员 💛\n\n别紧张，就当跟朋友聊天一样。跟我说说，你和伴侣之间发生了什么事�?;
    state.single.messages.push({ role: 'assistant', content: welcomeMsg });
    this.renderSingleMessages();
  },

  renderSingleMessages: function() {
    var container = $('single-chat-messages');
    container.innerHTML = '';

    state.single.messages.forEach(function(msg) {
      var div = document.createElement('div');
      div.className = 'message ' + (msg.role === 'user' ? 'user' : 'ai');
      if (msg.role === 'assistant') {
        div.innerHTML = '<div class="message-avatar">接待�?/div>';
      }
      var p = document.createElement('div');
      p.innerHTML = formatContent(msg.content);
      div.appendChild(p);
      container.appendChild(div);
    });

    container.scrollTop = container.scrollHeight;
  },

  sendSingleMessage: function() {
    var input = $('single-input');
    var text = input.value.trim();
    if (!text) return;

    input.value = '';
    input.style.height = 'auto';

    state.single.messages.push({ role: 'user', content: text });
    this.renderSingleMessages();

    this.showSingleTyping();
    $('single-send-btn').disabled = true;

    var self = this;
    var apiMessages = state.single.messages
      .filter(function(m, idx) { return !(idx === 0 && m.role === 'assistant'); })
      .map(function(m) { return { role: m.role, content: m.content }; });

    var accumulatedText = '';
    // ע���û�����ϵͳ��ʾ��
    var systemPrompt = SYSTEM_PROMPTS.intake;
    var profileContext = buildProfileContext(state.single.profile, state.single.name || '�û�');
    if (profileContext) {
      systemPrompt += profileContext;
    }

    callLLMStream(systemPrompt, apiMessages, 0.7,
      function(fullText, token) {
        accumulatedText = fullText;
        self.updateTypingContent(accumulatedText);
      },
      function(fullText) {
        self.hideSingleTyping();
        var response = fullText;

        // 检�?[COMPLETE] 标记（可能在开头或单独一行）
        var completeMatch = response.match(/\[COMPLETE\]\s*([\s\S]*)/);
        if (completeMatch) {
          var summary = completeMatch[1].trim();
          state.single.summary = summary;
          state.single.infoComplete = true;
          tracker.recordFeature('single_complete');
          // 显示接待员的总结消息（不含标记）
          state.single.messages.push({ role: 'assistant', content: summary });
          self.renderSingleMessages();
          // 延迟显示导师选择界面
          setTimeout(function() {
            $('single-step-chat').style.display = 'none';
            $('single-step-mentors').style.display = '';
            self.renderSingleSummary();
            showToast('四位导师已准备就绪，请选择一位开始点评！');
          }, 2000);
        } else {
          state.single.messages.push({ role: 'assistant', content: response });
          self.renderSingleMessages();
        }
        $('single-send-btn').disabled = false;
      },
      function(err) {
        self.hideSingleTyping();
        state.single.messages.push({ role: 'assistant', content: '抱歉，出了点问题�? + err.message + '\n请稍后重试�? });
        self.renderSingleMessages();
        $('single-send-btn').disabled = false;
      }
    );
  },

  renderSingleSummary: function() {
    $('single-summary').textContent = state.single.summary;
  },

  showSingleTyping: function() {
    var container = $('single-chat-messages');
    var div = document.createElement('div');
    div.className = 'message ai';
    div.id = 'typing-indicator';
    div.innerHTML = '<div class="message-avatar">接待�?/div><div class="streaming-text"></div>';
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
  },

  updateTypingContent: function(text) {
    var indicator = $('typing-indicator');
    if (!indicator) {
      var container = $('single-chat-messages');
      indicator = document.createElement('div');
      indicator.className = 'message ai';
      indicator.id = 'typing-indicator';
      indicator.innerHTML = '<div class="message-avatar">接待�?/div><div class="streaming-text"></div>';
      container.appendChild(indicator);
    }
    var textDiv = indicator.querySelector('.streaming-text');
    if (textDiv) {
      textDiv.innerHTML = formatContent(text);
    }
    var container = $('single-chat-messages');
    container.scrollTop = container.scrollHeight;
  },

  hideSingleTyping: function() {
    var indicator = $('typing-indicator');
    if (indicator) indicator.remove();
  },

  // ==================== 导师点评（通用�?====================
  renderMentorButtons: function(mode) {
    var container = $(mode + '-mentor-btns');
    container.innerHTML = '';

    MENTOR_ORDER.forEach(function(mid) {
      var m = MENTORS[mid];
      var btn = document.createElement('button');
      btn.className = 'mentor-btn';
      btn.style.setProperty('--mc', m.color);
      if (state[mode].currentMentor === mid) btn.classList.add('active');
      if (state[mode].viewedMentors.has(mid)) btn.classList.add('viewed');

      btn.innerHTML =
        '<div class="mentor-btn-avatar">' + m.emoji + '</div>' +
        '<div class="mentor-btn-name">' + m.name + '</div>' +
        '<div class="mentor-btn-role">' + m.role + '</div>';

      btn.onclick = function() { App.selectMentor(mode, mid); };
      container.appendChild(btn);
    });
  },

  selectMentor: function(mode, mentorId) {
    if (state[mode].currentMentor === mentorId && state[mode].mentorCommentaries[mentorId]) {
      this.renderMentorContent(mode, mentorId);
      return;
    }

    state[mode].currentMentor = mentorId;
    tracker.recordFeature('mentor_view');
    this.renderMentorButtons(mode);

    var mentor = MENTORS[mentorId];
    var display = $(mode + '-mentor-display');

    if (state[mode].mentorCommentaries[mentorId]) {
      this.renderMentorContent(mode, mentorId);
      return;
    }

    // 显示加载状�?    display.innerHTML =
      '<div class="mentor-card" style="--mc:' + mentor.color + '">' +
        '<div class="mentor-card-header">' +
          '<div class="mentor-card-avatar">' + mentor.emoji + '</div>' +
          '<div class="mentor-card-info">' +
            '<div class="mentor-card-name">' + mentor.name + '</div>' +
            '<div class="mentor-card-role">' + mentor.role + '</div>' +
          '</div>' +
        '</div>' +
        '<div class="mentor-card-body">' +
          '<div class="loading-container">' +
            '<div class="loading-dots"><span></span><span></span><span></span></div>' +
            '<div class="loading-text">' + mentor.name + '正在认真分析�?..</div>' +
          '</div>' +
        '</div>' +
      '</div>';

    var self = this;
    var context = this.buildMentorContext(mode);

    callLLMStream(mentor.systemPrompt, [
      { role: 'user', content: context },
    ], 0.85,
      function(fullText, token) {
        self.renderMentorStreamContent(mode, mentorId, fullText);
      },
      function(fullText) {
        state[mode].mentorCommentaries[mentorId] = fullText;
        state[mode].viewedMentors.add(mentorId);
        self.renderMentorContent(mode, mentorId);
        self.renderMentorButtons(mode);
        self.updateProgress(mode);

        if (state[mode].viewedMentors.size === 4) {
          $(mode + '-advice-section').style.display = '';
          showToast('四位导师都已点评完毕，可以查看综合建议了�?);
        }
      },
      function(err) {
        display.innerHTML =
          '<div class="mentor-card" style="--mc:' + mentor.color + '">' +
            '<div class="mentor-card-header">' +
              '<div class="mentor-card-avatar">' + mentor.emoji + '</div>' +
              '<div class="mentor-card-info">' +
                '<div class="mentor-card-name">' + mentor.name + '</div>' +
                '<div class="mentor-card-role">' + mentor.role + '</div>' +
              '</div>' +
            '</div>' +
            '<div class="mentor-card-body">' +
              '<p>⚠️ ' + err.message + '</p>' +
              '<button class="btn-secondary" style="margin-top:12px" onclick="App.selectMentor(\'' + mode + '\',\'' + mentorId + '\')">重试</button>' +
            '</div>' +
          '</div>';
      }
    );
  },

  renderMentorStreamContent: function(mode, mentorId, fullText) {
    var mentor = MENTORS[mentorId];
    var display = $(mode + '-mentor-display');
    var bodyId = mode + '-mentor-body-' + mentorId;

    // 首次渲染：创建完整卡片结�?    if (!document.getElementById(bodyId)) {
      display.innerHTML =
        '<div class="mentor-card" style="--mc:' + mentor.color + '">' +
          '<div class="mentor-card-header">' +
            '<div class="mentor-card-avatar">' + mentor.emoji + '</div>' +
            '<div class="mentor-card-info">' +
              '<div class="mentor-card-name">' + mentor.name + '</div>' +
              '<div class="mentor-card-role">' + mentor.role + '</div>' +
            '</div>' +
          '</div>' +
          '<div class="mentor-card-body" id="' + bodyId + '">' +
            '<span class="stream-text"></span>' +
            '<span class="cursor-blink">�?/span>' +
          '</div>' +
        '</div>';
    }

    // 只更新文本内容，不重建DOM
    var body = document.getElementById(bodyId);
    if (body) {
      var textSpan = body.querySelector('.stream-text');
      if (textSpan) {
        textSpan.innerHTML = formatContent(fullText);
      }
      if (display.scrollHeight - display.scrollTop - display.clientHeight < 150) {
        display.scrollTop = display.scrollHeight;
      }
    }
  },

  renderMentorContent: function(mode, mentorId) {
    var mentor = MENTORS[mentorId];
    var commentary = state[mode].mentorCommentaries[mentorId];
    var display = $(mode + '-mentor-display');

    display.innerHTML =
      '<div class="mentor-card" style="--mc:' + mentor.color + '">' +
        '<div class="mentor-card-header">' +
          '<div class="mentor-card-avatar">' + mentor.emoji + '</div>' +
          '<div class="mentor-card-info">' +
            '<div class="mentor-card-name">' + mentor.name + '</div>' +
            '<div class="mentor-card-role">' + mentor.role + '</div>' +
          '</div>' +
        '</div>' +
        '<div class="mentor-card-body">' +
          formatContent(commentary) +
        '</div>' +
      '</div>';
  },

  buildMentorContext: function(mode) {
    if (mode === 'single') {
      var p = state.single.profile;
      return '用户信息：\n- 性别�? + getGenderLabel(p.gender) + '\n- 年龄段：' + getAgeLabel(p.age) + '\n\n' +
        '情感矛盾描述（接待员整理）：\n' + state.single.summary + '\n\n' +
        '请作为你的角色人设，对这段情感矛盾进行点评。直接输出点评内容，不要�?你好"之类的开场白�?;
    } else {
      var a = state.pk.sideA;
      var b = state.pk.sideB;
      var aProfile = a.profile && a.profile.gender ? '�? + getGenderLabel(a.profile.gender) + '�? + getAgeLabel(a.profile.age) + '�? : '';
      var bProfile = b.profile && b.profile.gender ? '�? + getGenderLabel(b.profile.gender) + '�? + getAgeLabel(b.profile.age) + '�? : '';
      return '以下是双方各自的陈述：\n\n�? + (a.name || '甲方') + aProfile + '的陈述】\n' + a.summary + '\n\n�? + (b.name || '乙方') + bProfile + '的陈述】\n' + b.summary + '\n\n' +
        '请作为你的角色人设，对这段情感矛盾进行点评。注意要公平客观地看待双方的观点。直接输出点评内容，不要�?你好"之类的开场白�?;
    }
  },

  updateProgress: function(mode) {
    var count = state[mode].viewedMentors.size;
    $(mode + '-progress').textContent = count + '/4';
  },

  // ==================== 综合建议 ====================
  getComprehensiveAdvice: function(mode) {
    var btn = $(mode + '-advice-btn');
    var content = $(mode + '-advice-content');

    tracker.recordFeature('advice_generate');
    btn.disabled = true;
    btn.textContent = '正在生成综合建议...';

    content.style.display = '';
    content.innerHTML =
      '<div class="loading-container">' +
        '<div class="loading-dots"><span></span><span></span><span></span></div>' +
        '<div class="loading-text">正在整合四位导师的观�?..</div>' +
      '</div>';

    var self = this;
    var commentaries = MENTOR_ORDER.map(function(mid) {
      var m = MENTORS[mid];
      return m.name + '�? + m.role + '）：\n' + (state[mode].mentorCommentaries[mid] || '（未生成�?);
    }).join('\n\n---\n\n');

    var context = this.buildMentorContext(mode) + '\n\n四位导师的点评如下：\n\n' + commentaries;

    var fullAdvice = '';
    callLLMStream(SYSTEM_PROMPTS.advice, [
      { role: 'user', content: context },
    ], 0.7,
      function(text) {
        fullAdvice = text;
        content.innerHTML = formatContent(text) + '<span class="cursor-blink">�?/span>';
      },
      function(text) {
        state[mode].advice = text;
        content.innerHTML = formatContent(text);
        btn.textContent = '�?综合建议（已生成�?;
        btn.disabled = false;
        showToast('综合建议已生成！');

        // 显示导出 PDF 按钮
        self.showExportButton(mode);
      },
      function(err) {
        content.innerHTML = '<p>⚠️ ' + err.message + '</p>';
        btn.textContent = '�?重新生成综合建议';
        btn.disabled = false;
      }
    );
  },

  showExportButton: function(mode) {
    var content = $(mode + '-advice-content');
    var existingBtn = document.getElementById('export-pdf-btn');
    if (existingBtn) return;

    var exportBtn = document.createElement('button');
    exportBtn.id = 'export-pdf-btn';
    exportBtn.className = 'btn-primary btn-block';
    exportBtn.style.marginTop = '16px';
    exportBtn.style.background = 'linear-gradient(135deg, #36D399, #2EBD9E)';
    exportBtn.innerHTML = '📄 导出感情急诊处方单（PDF�?;
    exportBtn.onclick = function() { exportPDF(mode); };
    content.parentNode.appendChild(exportBtn);
  },

  // ==================== 重置 ====================
  resetSingleMode: function() {
    if (state.single.messages.length > 0 && !confirm('确定要重新开始吗？当前对话将被清空�?)) return;
    stopStream();
    state.single = {
      profile: { gender: null, age: null },
      messages: [],
      infoComplete: false,
      summary: '',
      mentorCommentaries: {},
      viewedMentors: new Set(),
      currentMentor: null,
      advice: null,
    };
    this.updateProfileUI();
    this.showSingleProfile();
    showToast('已重�?);
  },

  // ==================== 复制结果 ====================
  copyResults: function(mode) {
    tracker.recordFeature('copy_result');
    var text = '══�?感情急诊事务所 ═══\n\n';

    if (mode === 'single') {
      var p = state.single.profile;
      text += '【用户信息】\n性别�? + getGenderLabel(p.gender) + ' | 年龄�? + getAgeLabel(p.age) + '\n\n';
      text += '【事件概要】\n' + state.single.summary + '\n\n';

      MENTOR_ORDER.forEach(function(mid) {
        var m = MENTORS[mid];
        if (state.single.mentorCommentaries[mid]) {
          text += '�? + m.name + ' - ' + m.role + '】\n' + state.single.mentorCommentaries[mid] + '\n\n';
        }
      });

      if (state.single.advice) {
        text += '【综合建议】\n' + state.single.advice + '\n';
      }
    } else {
      text += '【双方陈述】\n';
      if (state.pk.sideA && state.pk.sideA.summary) {
        var ap = state.pk.sideA.profile;
        var apStr = ap && ap.gender ? '�? + getGenderLabel(ap.gender) + ' · ' + getAgeLabel(ap.age) + '�? : '';
        text += '\n' + (state.pk.sideA.name || '甲方') + apStr + '：\n' + state.pk.sideA.summary + '\n';
      }
      if (state.pk.sideB && state.pk.sideB.summary) {
        var bp = state.pk.sideB.profile;
        var bpStr = bp && bp.gender ? '�? + getGenderLabel(bp.gender) + ' · ' + getAgeLabel(bp.age) + '�? : '';
        text += '\n' + (state.pk.sideB.name || '乙方') + bpStr + '：\n' + state.pk.sideB.summary + '\n';
      }
      text += '\n';

      MENTOR_ORDER.forEach(function(mid) {
        var m = MENTORS[mid];
        if (state.pk.mentorCommentaries[mid]) {
          text += '�? + m.name + ' - ' + m.role + '】\n' + state.pk.mentorCommentaries[mid] + '\n\n';
        }
      });

      if (state.pk.advice) {
        text += '【综合建议】\n' + state.pk.advice + '\n';
      }
    }

    this.copyToClipboard(text);
  },

  copyToClipboard: function(text) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function() {
        showToast('已复制到剪贴�?);
      }).catch(function() {
        App.fallbackCopy(text);
      });
    } else {
      this.fallbackCopy(text);
    }
  },

  fallbackCopy: function(text) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.left = '-9999px';
    document.body.appendChild(ta);
    ta.select();
    try {
      document.execCommand('copy');
      showToast('已复制到剪贴�?);
    } catch (e) {
      showToast('复制失败，请手动选择文本复制');
    }
    document.body.removeChild(ta);
  },

  // ==================== 双人 PK 模式 ====================
  initPKMode: function() {
    var hashData = this.parsePKHash();

    if (hashData.sideA && hashData.sideB) {
      // 双方都已完成，直接展�?      state.pk.sideA = {
        name: hashData.sideA.name || '甲方',
        profile: hashData.sideA.profile || { gender: null, age: null },
        messages: [], infoComplete: true,
        summary: hashData.sideA.summary || hashData.sideA.content || '',
      };
      state.pk.sideB = {
        name: hashData.sideB.name || '乙方',
        profile: hashData.sideB.profile || { gender: null, age: null },
        messages: [], infoComplete: true,
        summary: hashData.sideB.summary || hashData.sideB.content || '',
      };
      state.pk.bothSubmitted = true;
      this.showPKCombined();
    } else if (hashData.sideA) {
      // 甲方已完成，乙方通过链接进入
      state.pk.sideA = {
        name: hashData.sideA.name || '甲方',
        profile: hashData.sideA.profile || { gender: null, age: null },
        messages: [], infoComplete: true,
        summary: hashData.sideA.summary || hashData.sideA.content || '',
      };
      this.showPKSideB();
    } else {
      // 全新开�?      this.showPKSideA();
    }
  },

  parsePKHash: function() {
    var hash = window.location.hash.substring(1);
    var params = new URLSearchParams(hash);
    return {
      sideA: params.get('sideA') ? decodeData(params.get('sideA')) : null,
      sideB: params.get('sideB') ? decodeData(params.get('sideB')) : null,
    };
  },

  hideAllPKSteps: function() {
    $('pk-step-a').style.display = 'none';
    $('pk-step-choice').style.display = 'none';
    $('pk-step-share').style.display = 'none';
    $('pk-step-b').style.display = 'none';
    $('pk-step-combined').style.display = 'none';
  },

  showPKSideA: function() {
    this.hideAllPKSteps();
    $('pk-step-a').style.display = '';
    // 重置子区�?    $('pk-a-profile').style.display = '';
    $('pk-a-chat-section').style.display = 'none';
    this.updatePKSideAProfileUI();
  },

  selectPKSideAProfile: function(type, value) {
    state.pk.sideA.profile[type] = value;
    this.updatePKSideAProfileUI();
  },

  updatePKSideAProfileUI: function() {
    var self = this;
    document.querySelectorAll('#pk-a-gender-options .option-btn').forEach(function(btn) {
      btn.classList.toggle('selected', btn.dataset.value === state.pk.sideA.profile.gender);
    });
    document.querySelectorAll('#pk-a-age-options .option-btn').forEach(function(btn) {
      btn.classList.toggle('selected', btn.dataset.value === state.pk.sideA.profile.age);
    });
    var btn = $('pk-a-start-btn');
    var p = state.pk.sideA.profile;
    var name = $('pk-role-a-name').value.trim();
    btn.disabled = !(p.gender && p.age && name);
  },

  startPKSideA: function() {
    var name = $('pk-role-a-name').value.trim();
    var p = state.pk.sideA.profile;
    if (!p.gender || !p.age) {
      showToast('请先选择性别和年�?);
      return;
    }
    if (!name) {
      showToast('请输入你的称�?);
      return;
    }

    state.pk.sideA.name = name;
    state.pk.sideA.messages = [];
    state.pk.sideA.infoComplete = false;

    // 切换到对话界�?    $('pk-a-profile').style.display = 'none';
    $('pk-a-chat-section').style.display = '';

    // 构建个性化欢迎消息（考虑性别和年龄）
    var profileInfo = '';
    if (p.gender) {
      profileInfo += '你是一�? + (p.gender === 'male' ? '男士' : '女士');
    }
    if (p.age) {
      profileInfo += (profileInfo ? '�? : '�?) + '�? + getAgeLabel(p.age).toLowerCase();
    }
    var welcomeMsg = '你好呀�? + name + '�?;
    if (profileInfo) {
      welcomeMsg += '我知�? + profileInfo + '�?;
    }
    welcomeMsg += '\n\n我是感情急诊事务所的接待员 💛\n\n别紧张，就当跟朋友聊天一样。跟我说说，你和伴侣之间发生了什么事�?;

    state.pk.sideA.messages.push({ role: 'assistant', content: welcomeMsg });
    this.renderPKSideAMessages();
  },

  renderPKSideAMessages: function() {
    var container = $('pk-a-chat-messages');
    container.innerHTML = '';

    state.pk.sideA.messages.forEach(function(msg) {
      var div = document.createElement('div');
      div.className = 'message ' + (msg.role === 'user' ? 'user' : 'ai');

      if (msg.role === 'user') {
        div.innerHTML = '<div class="message-content">' + formatContent(msg.content) + '</div>';
      } else {
        div.innerHTML = '<div class="message-avatar">接待�?/div><div class="message-content">' + formatContent(msg.content) + '</div>';
      }
      container.appendChild(div);
    });

    container.scrollTop = container.scrollHeight;
  },

  sendPKSideAMessage: function() {
    var input = $('pk-a-input');
    var text = input.value.trim();
    if (!text) return;

    input.value = '';
    input.style.height = 'auto';

    state.pk.sideA.messages.push({ role: 'user', content: text });
    this.renderPKSideAMessages();

    this.showPKSideATyping();
    $('pk-a-send-btn').disabled = true;

    var self = this;
    var apiMessages = state.pk.sideA.messages
      .filter(function(m, idx) { return !(idx === 0 && m.role === 'assistant'); })
      .map(function(m) { return { role: m.role, content: m.content }; });

    // 注入用户画像到系统提示词
    var systemPrompt = SYSTEM_PROMPTS.pkIntakeA;
    var profileContext = buildProfileContext(state.pk.sideA.profile, state.pk.sideA.name || '甲方');
    if (profileContext) {
      systemPrompt += profileContext;
    }

    var accumulatedText = '';
    callLLMStream(systemPrompt, apiMessages, 0.7,
      function(fullText) {
        accumulatedText = fullText;
        self.updatePKSideATyping(accumulatedText);
      },
      function(fullText) {
        self.hidePKSideATyping();
        var response = fullText;

        var completeMatch = response.match(/\[COMPLETE\]\s*([\s\S]*)/);
        if (completeMatch) {
          var summary = completeMatch[1].trim();
          state.pk.sideA.summary = summary;
          state.pk.sideA.infoComplete = true;
          tracker.recordFeature('pk_sideA_complete');
          state.pk.sideA.messages.push({ role: 'assistant', content: summary });
          self.renderPKSideAMessages();

          // 延迟显示选择界面
          setTimeout(function() {
            self.showPKChoice();
          }, 2000);
        } else {
          state.pk.sideA.messages.push({ role: 'assistant', content: response });
          self.renderPKSideAMessages();
        }
        $('pk-a-send-btn').disabled = false;
      },
      function(err) {
        self.hidePKSideATyping();
        state.pk.sideA.messages.push({ role: 'assistant', content: '抱歉，出了点问题�? + err.message + '\n请稍后重试�? });
        self.renderPKSideAMessages();
        $('pk-a-send-btn').disabled = false;
      }
    );
  },

  showPKSideATyping: function() {
    var container = $('pk-a-chat-messages');
    var div = document.createElement('div');
    div.className = 'message ai';
    div.id = 'pk-a-typing-indicator';
    div.innerHTML = '<div class="message-avatar">接待�?/div><div class="streaming-text"></div>';
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
  },

  updatePKSideATyping: function(text) {
    var indicator = $('pk-a-typing-indicator');
    if (!indicator) return;
    var textDiv = indicator.querySelector('.streaming-text');
    if (textDiv) {
      textDiv.innerHTML = formatContent(text);
    }
    var container = $('pk-a-chat-messages');
    container.scrollTop = container.scrollHeight;
  },

  hidePKSideATyping: function() {
    var indicator = $('pk-a-typing-indicator');
    if (indicator) indicator.remove();
  },

  // 甲方完成后的选择界面
  showPKChoice: function() {
    this.hideAllPKSteps();
    $('pk-step-choice').style.display = '';
  },

  showPKShare: function() {
    this.hideAllPKSteps();
    // 生成分享链接（包�?profile�?    var encoded = encodeData({ name: state.pk.sideA.name, profile: state.pk.sideA.profile, summary: state.pk.sideA.summary });
    var baseUrl = window.location.href.split('#')[0];
    var shareUrl = baseUrl + '#mode=pk&sideA=' + encoded;
    $('pk-link-url').value = shareUrl;
    $('pk-step-share').style.display = '';
    tracker.recordFeature('share_link');
  },

  copyShareLink: function() {
    var url = $('pk-link-url').value;
    this.copyToClipboard(url);
  },

  showPKSideB: function() {
    this.hideAllPKSteps();
    $('pk-step-b').style.display = '';

    // 展示甲方陈述概要
    var a = state.pk.sideA;
    var aProfile = '';
    if (a.profile && a.profile.gender) {
      aProfile = '�? + getGenderLabel(a.profile.gender) + ' · ' + getAgeLabel(a.profile.age) + '�?;
    }
    $('pk-side-a-display').innerHTML = '<strong>' + (a.name || '甲方') + aProfile + '</strong><br>' + formatContent(a.summary);

    // 重置乙方子区�?    $('pk-b-profile').style.display = '';
    $('pk-b-chat-section').style.display = 'none';
    this.updatePKSideBProfileUI();
  },

  selectPKSideBProfile: function(type, value) {
    state.pk.sideB.profile[type] = value;
    this.updatePKSideBProfileUI();
  },

  updatePKSideBProfileUI: function() {
    document.querySelectorAll('#pk-b-gender-options .option-btn').forEach(function(btn) {
      btn.classList.toggle('selected', btn.dataset.value === state.pk.sideB.profile.gender);
    });
    document.querySelectorAll('#pk-b-age-options .option-btn').forEach(function(btn) {
      btn.classList.toggle('selected', btn.dataset.value === state.pk.sideB.profile.age);
    });
    var btn = $('pk-b-start-btn');
    var p = state.pk.sideB.profile;
    var name = $('pk-role-b-name').value.trim();
    btn.disabled = !(p.gender && p.age && name);
  },

  startPKSideB: function() {
    var name = $('pk-role-b-name').value.trim();
    var p = state.pk.sideB.profile;
    if (!p.gender || !p.age) {
      showToast('请先选择性别和年�?);
      return;
    }
    if (!name) {
      showToast('请输入你的称�?);
      return;
    }

    state.pk.sideB.name = name;
    state.pk.sideB.messages = [];
    state.pk.sideB.infoComplete = false;

    // 切换到对话界�?    $('pk-b-profile').style.display = 'none';
    $('pk-b-chat-section').style.display = '';

    // 构建个性化欢迎消息（考虑性别和年龄）
    var profileInfo = '';
    if (p.gender) {
      profileInfo += '你是一�? + (p.gender === 'male' ? '男士' : '女士');
    }
    if (p.age) {
      profileInfo += (profileInfo ? '�? : '�?) + '�? + getAgeLabel(p.age).toLowerCase();
    }

    var otherName = state.pk.sideA.name || '甲方';
    var otherGenderInfo = '';
    if (state.pk.sideA.profile && state.pk.sideA.profile.gender) {
      var otherGender = state.pk.sideA.profile.gender === 'male' ? '男士' : '女士';
      otherGenderInfo = otherName + '�? + otherGender;
    }

    var welcomeMsg = '你好呀�? + name + '�?;
    if (profileInfo) {
      welcomeMsg += '我知�? + profileInfo + '�?;
    }
    if (otherGenderInfo) {
      welcomeMsg += '\n\n我已经看�? + otherName + '的陈述了�? + otherGenderInfo + '。现在我想听听你的视角�?;
    } else {
      welcomeMsg += '\n\n我已经看�? + otherName + '的陈述了。现在我想听听你的视角�?;
    }
    welcomeMsg += '\n\n跟我说说，从你的角度，这件事是怎么发生的？';

    state.pk.sideB.messages.push({ role: 'assistant', content: welcomeMsg });
    this.renderPKSideBMessages();
  },

  renderPKSideBMessages: function() {
    var container = $('pk-b-chat-messages');
    container.innerHTML = '';

    state.pk.sideB.messages.forEach(function(msg) {
      var div = document.createElement('div');
      div.className = 'message ' + (msg.role === 'user' ? 'user' : 'ai');

      if (msg.role === 'user') {
        div.innerHTML = '<div class="message-content">' + formatContent(msg.content) + '</div>';
      } else {
        div.innerHTML = '<div class="message-avatar">接待�?/div><div class="message-content">' + formatContent(msg.content) + '</div>';
      }
      container.appendChild(div);
    });

    container.scrollTop = container.scrollHeight;
  },

  sendPKSideBMessage: function() {
    var input = $('pk-b-input');
    var text = input.value.trim();
    if (!text) return;

    input.value = '';
    input.style.height = 'auto';

    state.pk.sideB.messages.push({ role: 'user', content: text });
    this.renderPKSideBMessages();

    this.showPKSideBTyping();
    $('pk-b-send-btn').disabled = true;

    var self = this;
    var apiMessages = state.pk.sideB.messages
      .filter(function(m, idx) { return !(idx === 0 && m.role === 'assistant'); })
      .map(function(m) { return { role: m.role, content: m.content }; });

    // 在系统提示词中注入甲方陈述和乙方画像
    var systemPrompt = SYSTEM_PROMPTS.pkIntakeB;
    systemPrompt += '\n\n## 甲方陈述参考\n以下�? + state.pk.sideA.name + '的陈述概要：\n' + state.pk.sideA.summary;

    // 注入乙方画像
    var profileContext = buildProfileContext(state.pk.sideB.profile, state.pk.sideB.name || '乙方');
    if (profileContext) {
      systemPrompt += profileContext;
    }

    // 注入甲方性别信息（让AI知道对方是男方还是女方）
    if (state.pk.sideA.profile && state.pk.sideA.profile.gender) {
      var otherGender = state.pk.sideA.profile.gender === 'male' ? '�? : '�?;
      systemPrompt += '\n\n注意：对方的性别�? + otherGender + '方，请在对话中正确使用称谓�?;
    }

    var accumulatedText = '';
    callLLMStream(systemPrompt, apiMessages, 0.7,
      function(fullText) {
        accumulatedText = fullText;
        self.updatePKSideBTyping(accumulatedText);
      },
      function(fullText) {
        self.hidePKSideBTyping();
        var response = fullText;

        var completeMatch = response.match(/\[COMPLETE\]\s*([\s\S]*)/);
        if (completeMatch) {
          var summary = completeMatch[1].trim();
          state.pk.sideB.summary = summary;
          state.pk.sideB.infoComplete = true;
          state.pk.bothSubmitted = true;
          tracker.recordFeature('pk_sideB_complete');
          state.pk.sideB.messages.push({ role: 'assistant', content: summary });
          self.renderPKSideBMessages();

          // 生成结果分享链接（包含双方数据）
          var encodedA = encodeData({
            name: state.pk.sideA.name,
            profile: state.pk.sideA.profile,
            summary: state.pk.sideA.summary
          });
          var encodedB = encodeData({
            name: state.pk.sideB.name,
            profile: state.pk.sideB.profile,
            summary: state.pk.sideB.summary
          });
          var baseUrl = window.location.href.split('#')[0];
          var resultUrl = baseUrl + '#mode=pk&sideA=' + encodedA + '&sideB=' + encodedB;
          state.pk.resultShareUrl = resultUrl;

          // 延迟展示综合界面
          setTimeout(function() {
            self.showPKCombined();
            showToast('双方陈述已提交！四位导师已准备就绪�?);
          }, 2000);
        } else {
          state.pk.sideB.messages.push({ role: 'assistant', content: response });
          self.renderPKSideBMessages();
        }
        $('pk-b-send-btn').disabled = false;
      },
      function(err) {
        self.hidePKSideBTyping();
        state.pk.sideB.messages.push({ role: 'assistant', content: '抱歉，出了点问题�? + err.message + '\n请稍后重试�? });
        self.renderPKSideBMessages();
        $('pk-b-send-btn').disabled = false;
      }
    );
  },

  showPKSideBTyping: function() {
    var container = $('pk-b-chat-messages');
    var div = document.createElement('div');
    div.className = 'message ai';
    div.id = 'pk-b-typing-indicator';
    div.innerHTML = '<div class="message-avatar">接待�?/div><div class="streaming-text"></div>';
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
  },

  updatePKSideBTyping: function(text) {
    var indicator = $('pk-b-typing-indicator');
    if (!indicator) return;
    var textDiv = indicator.querySelector('.streaming-text');
    if (textDiv) {
      textDiv.innerHTML = formatContent(text);
    }
    var container = $('pk-b-chat-messages');
    container.scrollTop = container.scrollHeight;
  },

  hidePKSideBTyping: function() {
    var indicator = $('pk-b-typing-indicator');
    if (indicator) indicator.remove();
  },

  showPKCombined: function() {
    this.hideAllPKSteps();
    $('pk-step-combined').style.display = '';

    var a = state.pk.sideA;
    var b = state.pk.sideB;
    var aProfile = a.profile && a.profile.gender ? '�? + getGenderLabel(a.profile.gender) + ' · ' + getAgeLabel(a.profile.age) + '�? : '';
    var bProfile = b.profile && b.profile.gender ? '�? + getGenderLabel(b.profile.gender) + ' · ' + getAgeLabel(b.profile.age) + '�? : '';
    $('pk-both-sides').innerHTML =
      '<div class="side-block side-a">' +
        '<div class="side-block-name">' + (a.name || '甲方') + aProfile + '</div>' +
        '<div>' + formatContent(a.summary) + '</div>' +
      '</div>' +
      '<div class="side-block side-b">' +
        '<div class="side-block-name">' + (b.name || '乙方') + bProfile + '</div>' +
        '<div>' + formatContent(b.summary) + '</div>' +
      '</div>';

    this.renderMentorButtons('pk');
    this.updateProgress('pk');

    if (state.pk.viewedMentors.size === 4) {
      $('pk-advice-section').style.display = '';
    }

    // 显示/隐藏分享结果区域
    var shareResultDiv = $('pk-share-result');
    if (shareResultDiv) {
      if (state.pk.resultShareUrl) {
        shareResultDiv.style.display = '';
        $('pk-result-url').value = state.pk.resultShareUrl;
      } else {
        // 如果 URL 中包�?sideB 参数，说明是甲方查看结果，不需要显示分享按�?        var hash = window.location.hash;
        if (hash.includes('sideB=')) {
          shareResultDiv.style.display = 'none';
        } else {
          shareResultDiv.style.display = 'none';
        }
      }
    }
  },

  // 复制结果分享链接
  copyResultLink: function() {
    var url = $('pk-result-url').value;
    if (!url) {
      showToast('暂无分享链接');
      return;
    }
    this.copyToClipboard(url);
    showToast('链接已复制，可以发送给甲方了！');
  },

  // 微信分享（复制链接并提示�?  openWechatShare: function() {
    var url = $('pk-result-url').value;
    if (!url) {
      showToast('暂无分享链接');
      return;
    }
    this.copyToClipboard(url);
    showToast('链接已复制！请打开微信，粘贴链接发送给好友�?);
  },

  resetPKMode: function() {
    if (!confirm('确定要重置吗？当前内容将被清空�?)) return;
    stopStream();

    window.location.hash = '';

    state.pk = {
      sideA: { name: '', profile: { gender: null, age: null }, messages: [], infoComplete: false, summary: '' },
      sideB: { name: '', profile: { gender: null, age: null }, messages: [], infoComplete: false, summary: '' },
      bothSubmitted: false,
      resultShareUrl: null,
      mentorCommentaries: {},
      viewedMentors: new Set(),
      currentMentor: null,
      advice: null,
    };

    $('pk-role-a-name').value = '';
    $('pk-a-input').value = '';
    $('pk-role-b-name').value = '';
    $('pk-b-input').value = '';

    this.updatePKSideAProfileUI();
    this.showPKSideA();
    showToast('已重�?);
  },
};

// ==================== 事件监听 ====================
function initEventListeners() {
  // 性别和年龄选择
  var genderBtns = document.querySelectorAll('#gender-options .option-btn');
  genderBtns.forEach(function(btn) {
    btn.onclick = function() { App.selectSingleProfile('gender', this.dataset.value); };
  });
  var ageBtns = document.querySelectorAll('#age-options .option-btn');
  ageBtns.forEach(function(btn) {
    btn.onclick = function() { App.selectSingleProfile('age', this.dataset.value); };
  });

  // 开始倾诉
  $('single-start-btn').onclick = function() { App.startSingleChat(); };

  // 发送消�?  $('single-send-btn').onclick = function() { App.sendSingleMessage(); };

  // 输入框回车发�?  $('single-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      App.sendSingleMessage();
    }
  });

  // 输入框自动增�?  $('single-input').addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
  });

  // PK 模式 - 甲方性别/年龄选择
  document.querySelectorAll('#pk-a-gender-options .option-btn').forEach(function(btn) {
    btn.onclick = function() { App.selectPKSideAProfile('gender', this.dataset.value); };
  });
  document.querySelectorAll('#pk-a-age-options .option-btn').forEach(function(btn) {
    btn.onclick = function() { App.selectPKSideAProfile('age', this.dataset.value); };
  });
  // PK 甲方称呼输入
  $('pk-role-a-name').addEventListener('input', function() { App.updatePKSideAProfileUI(); });

  // PK 模式 - 乙方性别/年龄选择
  document.querySelectorAll('#pk-b-gender-options .option-btn').forEach(function(btn) {
    btn.onclick = function() { App.selectPKSideBProfile('gender', this.dataset.value); };
  });
  document.querySelectorAll('#pk-b-age-options .option-btn').forEach(function(btn) {
    btn.onclick = function() { App.selectPKSideBProfile('age', this.dataset.value); };
  });
  // PK 乙方称呼输入
  $('pk-role-b-name').addEventListener('input', function() { App.updatePKSideBProfileUI(); });

  // PK 模式 - 甲方发�?  $('pk-a-send-btn').onclick = function() { App.sendPKSideAMessage(); };
  $('pk-a-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      App.sendPKSideAMessage();
    }
  });
  $('pk-a-input').addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
  });

  // PK 模式 - 乙方发�?  $('pk-b-send-btn').onclick = function() { App.sendPKSideBMessage(); };
  $('pk-b-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      App.sendPKSideBMessage();
    }
  });
  $('pk-b-input').addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
  });

  // 管理员密码输入回�?  $('admin-password').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      AdminAuth.verify();
    }
  });

  // 监听 URL hash 变化
  window.addEventListener('hashchange', function() {
    handleHashRoute();
  });
}

function updateHomeNickname() {
  var el = $('home-nickname');
  if (el) el.textContent = '👋 ' + tracker.getNickname();
}

// ==================== 昵称弹窗 ====================
function showNicknameModal() {
  $('nickname-modal').style.display = '';
  $('nickname-input').focus();
}

function hideNicknameModal() {
  $('nickname-modal').style.display = 'none';
}

function confirmNickname() {
  var name = $('nickname-input').value.trim();
  if (!name) {
    showToast('请输入昵�?);
    $('nickname-input').focus();
    return;
  }
  if (name.length < 1 || name.length > 20) {
    showToast('昵称长度请控制在1-20个字�?);
    return;
  }
  tracker.setNickname(name);
  hideNicknameModal();
  updateHomeNickname();
  showToast('欢迎你，' + name + '�?);

  // 处理 URL hash
  handleHashRoute();
}

// ==================== URL hash 路由 ====================
// 解析 PK 模式�?URL hash 参数
function parsePKHash() {
  var hash = window.location.hash;
  var result = { sideA: null, sideB: null };

  // 解析 sideA 参数
  var sideAMatch = hash.match(/sideA=([^&]+)/);
  if (sideAMatch) {
    try {
      var decoded = decodeData(sideAMatch[1]);
      if (decoded && decoded.name) {
        result.sideA = decoded;
      }
    } catch (e) {
      console.warn('解析 sideA 数据失败:', e);
    }
  }

  // 解析 sideB 参数
  var sideBMatch = hash.match(/sideB=([^&]+)/);
  if (sideBMatch) {
    try {
      var decodedB = decodeData(sideBMatch[1]);
      if (decodedB && decodedB.name) {
        result.sideB = decodedB;
      }
    } catch (e) {
      console.warn('解析 sideB 数据失败:', e);
    }
  }

  return result;
}

// 构建用户画像上下文（注入到系统提示词�?function buildProfileContext(profile, roleName) {
  if (!profile || (!profile.gender && !profile.age)) {
    return '';
  }

  var context = '\n\n## 用户画像\n';
  context += roleName + '的基本信息：\n';
  if (profile.gender) {
    var genderLabel = getGenderLabel(profile.gender);
    var genderText = profile.gender === 'male' ? '�? : '�?;
    context += '- 性别�? + genderText + '\n';
  }
  if (profile.age) {
    var ageLabel = getAgeLabel(profile.age);
    context += '- 年龄段：' + ageLabel + '\n';
  }
  context += '\n请在对话中使用正确的称谓。如果知道对方性别，可以说"男方"/"女方"来区分双方。\n';
  return context;
}

function handleHashRoute() {
  var hash = window.location.hash;

  if (hash.includes('mode=admin') || hash === '#admin') {
    App.showPage('admin');
    return;
  }

  if (hash.includes('mode=pk')) {
    // 解析 PK 模式的参�?    var pkData = parsePKHash();

    if (pkData.sideA && pkData.sideB) {
      // 双方数据都已提交，直接进入展示页�?      state.pk.sideA = pkData.sideA;
      state.pk.sideB = pkData.sideB;
      state.pk.bothSubmitted = true;
      App.showPage('pk');
      // 延迟执行以确保页面已渲染
      setTimeout(function() {
        App.showPKCombined();
      }, 100);
    } else if (pkData.sideA && !pkData.sideB) {
      // 只有甲方数据，进入乙方填写流�?      state.pk.sideA = pkData.sideA;
      state.pk.sideB = { name: '', profile: { gender: null, age: null }, messages: [], infoComplete: false, summary: '' };
      state.pk.bothSubmitted = false;
      App.showPage('pk');
      // 延迟执行以确保页面已渲染
      setTimeout(function() {
        App.showPKSideB();
      }, 100);
    } else {
      // 无参数，显示 PK 首页（甲方填写）
      App.showPage('pk');
      setTimeout(function() {
        App.showPKSideA();
      }, 100);
    }
    return;
  }

  // 默认显示首页
  App.showPage('home');
}

// ==================== 初始�?====================
function init() {
  initEventListeners();

  // 昵称弹窗确认
  $('nickname-confirm').onclick = confirmNickname;
  $('nickname-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      confirmNickname();
    }
  });

  App.updateProfileUI();
  App.updatePKSideAProfileUI();

  // 检查昵�?  if (tracker.init()) {
    // 已有昵称，处理路�?    updateHomeNickname();
    handleHashRoute();
  } else {
    // 显示昵称弹窗
    showNicknameModal();
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}

