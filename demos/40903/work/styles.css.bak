:root {
  --bg: #1a1510;
  --panel: rgba(42, 30, 22, 0.72);
  --panel-border: rgba(224, 198, 152, 0.18);
  --text: #f2e8d6;
  --muted: #c0ae91;
  --gold: #d6ab62;
  --gold-strong: #efd2a1;
  --cyan: #88c1bf;
  --accent: #d76f4a;
  --shadow: 0 18px 60px rgba(0, 0, 0, 0.32);
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  min-height: 100%;
  font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
  background:
    radial-gradient(circle at top left, rgba(153, 113, 56, 0.18), transparent 30%),
    radial-gradient(circle at right center, rgba(53, 92, 98, 0.18), transparent 34%),
    linear-gradient(180deg, #140f0d 0%, #221913 55%, #17120e 100%);
  color: var(--text);
}

body {
  padding: 28px;
}

.app-shell {
  max-width: 1480px;
  margin: 0 auto;
}

.hero {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: flex-start;
  margin-bottom: 24px;
}

.eyebrow {
  margin: 0 0 10px;
  color: var(--gold);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-size: 12px;
}

h1 {
  margin: 0;
  font-size: 42px;
  line-height: 1.15;
}

.hero-copy,
.panel-head p,
.detail-section p,
.canvas-note {
  color: var(--muted);
}

.hero-copy {
  max-width: 760px;
  margin: 14px 0 0;
  font-size: 16px;
  line-height: 1.8;
}

.hero-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(132px, 1fr));
  gap: 14px;
  min-width: 420px;
}

.stat-card,
.panel,
.timeline-item {
  background: var(--panel);
  border: 1px solid var(--panel-border);
  box-shadow: var(--shadow);
  backdrop-filter: blur(16px);
}

.stat-card {
  border-radius: 18px;
  padding: 18px 20px;
}

.stat-label {
  display: block;
  margin-bottom: 8px;
  font-size: 13px;
  color: var(--muted);
}

.stat-card strong {
  font-size: 20px;
  color: var(--gold-strong);
}

.layout {
  display: grid;
  grid-template-columns: minmax(780px, 1.7fr) minmax(320px, 0.9fr);
  gap: 20px;
}

.panel {
  border-radius: 24px;
  padding: 22px;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-start;
  margin-bottom: 18px;
}

.panel-head h2,
.detail-section h4 {
  margin: 0;
}

.panel-head p {
  margin: 6px 0 0;
}

.legend {
  display: flex;
  gap: 16px;
  align-items: center;
  flex-wrap: wrap;
  font-size: 13px;
  color: var(--muted);
}

.dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  margin-right: 6px;
}

.dot-active {
  background: var(--accent);
  box-shadow: 0 0 16px rgba(255, 139, 107, 0.7);
}

.dot-normal {
  background: var(--gold);
}

.line-sample {
  display: inline-block;
  width: 24px;
  height: 2px;
  margin-right: 6px;
  background: linear-gradient(90deg, rgba(119, 215, 242, 0.2), rgba(119, 215, 242, 0.8));
  vertical-align: middle;
}

.canvas-wrap {
  position: relative;
  border-radius: 22px;
  overflow: hidden;
  height: 600px;
  background:
    radial-gradient(circle at 30% 20%, rgba(255, 245, 221, 0.08), transparent 22%),
    linear-gradient(180deg, rgba(34, 24, 17, 0.96), rgba(28, 21, 17, 0.98));
  border: 1px solid rgba(242, 216, 170, 0.15);
}

#mapCanvas {
  display: block;
  width: 100%;
  height: 100%;
}

.canvas-note {
  position: absolute;
  right: 16px;
  bottom: 14px;
  max-width: 320px;
  padding: 10px 12px;
  border-radius: 14px;
  background: rgba(30, 22, 17, 0.72);
  font-size: 12px;
  line-height: 1.6;
}

.map-loading {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  padding: 14px 22px;
  border-radius: 16px;
  background: rgba(20, 15, 13, 0.82);
  color: var(--gold);
  font-size: 14px;
  pointer-events: none;
  z-index: 10;
}

.map-caption {
  margin: 6px 0 0;
  font-size: 12px;
  color: var(--gold);
  letter-spacing: 0.04em;
}

.detail-card {
  display: flex;
  flex-direction: column;
  gap: 18px;
  min-height: 660px;
}

.detail-top {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  align-items: flex-start;
}

.detail-type {
  margin: 0 0 6px;
  font-size: 13px;
  color: var(--gold);
}

.detail-top h3 {
  margin: 0;
  font-size: 28px;
  line-height: 1.25;
}

.detail-year {
  white-space: nowrap;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(230, 194, 122, 0.12);
  border: 1px solid rgba(230, 194, 122, 0.2);
  color: var(--gold-strong);
  font-size: 13px;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.tag {
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(136, 193, 191, 0.08);
  border: 1px solid rgba(136, 193, 191, 0.16);
  color: #d9f0ef;
  font-size: 13px;
}

.detail-section {
  padding-top: 8px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.detail-section p,
.detail-section blockquote,
.detail-section pre {
  margin: 10px 0 0;
  line-height: 1.9;
  font-size: 14px;
}

.detail-section blockquote {
  padding-left: 14px;
  border-left: 3px solid rgba(230, 194, 122, 0.55);
  color: #f1dec0;
}

.detail-section pre {
  white-space: pre-wrap;
  font-family: inherit;
  color: #e8eef8;
}

.timeline {
  margin-top: 20px;
}

.timeline-list {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.timeline-item {
  border-radius: 18px;
  padding: 16px;
  width: 100%;
  border: 1px solid var(--panel-border);
  color: var(--text);
  text-align: left;
  font: inherit;
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}

.timeline-item:hover {
  transform: translateY(-3px);
  border-color: rgba(230, 194, 122, 0.36);
  background: rgba(64, 44, 31, 0.96);
}

.timeline-item.active {
  transform: translateY(-3px);
  border-color: rgba(192, 57, 43, 0.5);
  background: rgba(64, 36, 28, 0.98);
  box-shadow: 0 0 20px rgba(192, 57, 43, 0.25), inset 0 0 12px rgba(192, 57, 43, 0.08);
}

.timeline-item .year {
  display: inline-block;
  margin-bottom: 8px;
  color: var(--gold);
  font-size: 12px;
  letter-spacing: 0.08em;
}

.timeline-item h3 {
  margin: 0 0 8px;
  font-size: 18px;
}

.timeline-item p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
  font-size: 13px;
}

@media (max-width: 1280px) {
  .layout {
    grid-template-columns: 1fr;
  }

  .timeline-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 980px) {
  body {
    padding: 18px;
  }

  .hero {
    flex-direction: column;
  }

  .hero-meta {
    min-width: auto;
    width: 100%;
  }

  .timeline-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
