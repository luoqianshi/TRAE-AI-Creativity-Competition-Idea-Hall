<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>毛主席诗词创作足迹图</title>
  <link rel="stylesheet" href="./styles.css">
  <script src="./assets/d3.min.js"></script>
  <script type="importmap">
  {
    "imports": {
      "three": "./assets/three.module.js",
      "three/addons/": "./assets/"
    }
  }
  </script>
</head>
<body>
  <div class="app-shell">
    <header class="hero">
      <div>
        <p class="eyebrow">Poetry Magnetic Map</p>
        <h1>毛主席诗词创作足迹图</h1>
        <p class="hero-copy">
          以诗词、地点、时间与历史语境为线索，在一张交互式地图上浏览创作轨迹。
        </p>
      </div>
      <div class="hero-meta">
        <div class="stat-card">
          <span class="stat-label">展示节点</span>
          <strong id="nodeCount">0</strong>
        </div>
        <div class="stat-card">
          <span class="stat-label">时间跨度</span>
          <strong id="yearRange">-</strong>
        </div>
        <div class="stat-card">
          <span class="stat-label">地图风格</span>
          <strong>古风地图册</strong>
        </div>
      </div>
    </header>

    <main class="layout">
      <section class="map-panel panel">
        <div class="panel-head">
          <div>
            <h2>地图总览</h2>
            <p>点击节点查看诗词原文、创作时间和背景，地图基于真实经纬度精准定位。</p>
          </div>
          <div class="legend">
            <span><i class="dot dot-active"></i>当前节点</span>
            <span><i class="dot dot-normal"></i>创作节点</span>
            <span><i class="line-sample"></i>时间轨迹</span>
          </div>
        </div>
        <div class="canvas-wrap">
          <canvas id="mapCanvas" aria-label="毛主席诗词创作足迹地图"></canvas>
          <div class="canvas-note">当前为 3D 诗词意境地图：Three.js 地形起伏 + 云雾光影，点击节点触发对联垂落。</div>
        </div>
      </section>

      <aside class="info-panel panel">
        <div class="panel-head">
          <div>
            <h2>节点详情</h2>
            <p>默认展示首个节点，可从左侧地图与下方时间轴切换。</p>
          </div>
        </div>

        <article class="detail-card" id="detailCard">
          <div class="detail-top">
            <div>
              <p class="detail-type" id="detailType">词</p>
              <h3 id="detailTitle">加载中</h3>
            </div>
            <span class="detail-year" id="detailYear"></span>
          </div>

          <div class="detail-tags" id="detailTags"></div>

          <section class="detail-section">
            <h4>地点</h4>
            <p id="detailLocation"></p>
          </section>

          <section class="detail-section">
            <h4>创作背景</h4>
            <p id="detailBackground"></p>
          </section>

          <section class="detail-section">
            <h4>诗词节选</h4>
            <blockquote id="detailQuote"></blockquote>
          </section>

          <section class="detail-section">
            <h4>原文</h4>
            <pre id="detailFullText"></pre>
          </section>
        </article>
      </aside>
    </main>

    <section class="timeline panel">
      <div class="panel-head">
        <div>
          <h2>创作轨迹</h2>
          <p>按时间顺序浏览节点，快速切换地图焦点。</p>
        </div>
      </div>
      <div class="timeline-list" id="timelineList"></div>
    </section>
  </div>

  <script src="./data.js"></script>
  <script type="module" src="./app.js"></script>
</body>
</html>
