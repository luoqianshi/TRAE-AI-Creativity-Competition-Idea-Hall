async function startGame() {
  game.difficulty = document.getElementById('difficultySelect').value;
  game.playerCount = parseInt(document.getElementById('playerCountSelect').value);

  const config = DIFFICULTY[game.difficulty];
  game.rows = config.rows;
  game.cols = config.cols;
  game.totalMines = config.mines;

  // 创建棋盘
  const boardData = createBoard(game.rows, game.cols, game.totalMines);
  game.board = boardData.board;
  game.revealed = boardData.revealed;
  game.flagged = boardData.flagged;
  game.safeMarked = boardData.safeMarked;

  // 分配角色
  game.players = assignRoles(game.playerCount);
  game.humanPlayerIdx = 0;
  game.round = 1;
  game.phase = 'discussion';
  game.minesFound = 0;
  game.minesFlagged = 0;
  game.eliminatedPlayers = [];
  game.gameOver = false;
  game.chatHistory = [];

  // 显示角色分配
  showRoleReveal();
}

function showRoleReveal() {
  switchScreen('roleScreen');
  const player = game.players[0]; // 人类玩家
  const card = document.getElementById('roleRevealCard');

  let secretHtml = '';
  if (player.role === 'murderer') {
    // 显示凶手知道的机关位置
    const minePositions = [];
    for (let r = 0; r < game.rows; r++)
      for (let c = 0; c < game.cols; c++)
        if (game.board[r][c] === -1)
          minePositions.push(getRoomName(r, c));
    secretHtml = `
      <div class="role-secret">
        <i class="fas fa-skull-crossbones"></i> 凶手独有信息<br>
        你知道机关位置：${minePositions.join('、')}<br>
        利用话术引导其他人触发机关，不要暴露自己！
      </div>
    `;
  } else if (player.role === 'detective') {
    secretHtml = `
      <div class="role-secret" style="background:rgba(52,152,219,0.1);border-color:rgba(52,152,219,0.2);color:var(--accent-blue);">
        <i class="fas fa-search"></i> 侦探独有能力<br>
        每回合你会获得一条额外的线索提示，帮助你推理机关位置。<br>
        善用你的分析能力，引导团队找出凶手！
      </div>
    `;
  }

  card.innerHTML = `
    <div class="role-icon">${player.icon}</div>
    <div class="role-name">${player.name}</div>
    <div class="role-identity ${getRoleIdentityClass(player.role)}">${getRoleName(player.role)}</div>
    <div class="role-desc">${player.desc}</div>
