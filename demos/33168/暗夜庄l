}

async function enterGame() {
  switchScreen('gameScreen');
  renderBoard();
  renderPlayerList();
  renderProgress();
  updatePhaseBadge();

  // 开场剧情
  for (const line of STORY_EVENTS.gameStart) {
    await typeMessage('旁白', line, 'narrator', 25);
    await sleep(800);
  }

  await sleep(500);
  addSystemMessage('游戏正式开始！所有嫌疑人请准备。');

  // 开始第一回合
  await startRound();
}

async function startRound() {
  game.phase = 'discussion';
  updatePhaseBadge();
  renderPlayerList();

  // 回合开始剧情
  if (game.round > 1) {
    const event = rand(STORY_EVENTS.roundStart);
    await typeMessage('旁白', event, 'narrator', 25);
    await sleep(500);
  }

  addSystemMessage(`── 第 ${game.round} 回合 · 讨论阶段 ──`);

  // 侦探线索
  const detective = game.players.find(p => p.role === 'detective' && p.alive);
  if (detective) {
    await sleep(600);
    await giveDetectiveClue(detective);
  }

  // AI玩家发言
  const alivePlayers = game.players.filter(p => p.alive && !p.isHuman);
  for (const player of alivePlayers) {
    game.currentSpeaker = game.players.indexOf(player);
    renderPlayerList();
    await sleep(800 + Math.random() * 1000);

    const dialogue = generateAIDialogue(player, {
      phase: 'discussion', round: game.round,
      lastRevealedCell: null, lastRevealedValue: -1,
      eliminatedPlayer: null
    });
    await typeMessage(player.name, dialogue, 'normal', 20);
    await sleep(400);
  }

  // 人类玩家发言
  game.currentSpeaker = game.humanPlayerIdx;
  renderPlayerList();
  addSystemMessage('轮到你发言了。你可以分析线索、质疑他人，或保持沉默。');
  showDiscussionActions();

  // 等待人类操作
}

function showDiscussionActions() {
  const btns = document.getElementById('actionButtons');
  btns.innerHTML = `
    <button class="btn btn-secondary btn-sm" onclick="humanSkipSpeak()">
      <i class="fas fa-forward"></i> 跳过发言
    </button>
    <button class="btn btn-secondary btn-sm" onclick="humanAnalyze()">
      <i class="fas fa-brain"></i> 分析线索
    </button>
    <button class="btn btn-secondary btn-sm" onclick="humanAccuse()">
      <i class="fas fa-exclamation-triangle"></i> 质疑某人
    </button>
  `;
}

async function humanSkipSpeak() {
  addMessage(game.players[0].name, '（沉默不语）', 'normal');
  document.getElementById('actionButtons').innerHTML = '';
  await sleep(500);
  enterVotingPhase();
}

async function humanAnalyze() {
  const player = game.players[0];
  // 生成分析文本
  const revealedCells = [];
  for (let r = 0; r < game.rows; r++)
    for (let c = 0; c < game.cols; c++)
      if (game.revealed[r][c] && game.board[r][c] >= 0)
        revealedCells.push({r, c, val: game.board[r][c]});

  let analysis = '';
  if (revealedCells.length === 0) {
    analysis = '目前还没有探查任何房间，我们需要尽快获取线索。';
  } else {
    const highNumCells = revealedCells.filter(c => c.val >= 2);
    if (highNumCells.length > 0) {
      const cell = rand(highNumCells);
      analysis = `我注意到${getRoomName(cell.r, cell.c)}显示数字${cell.val}，说明周围有${cell.val}个机关。我们需要重点排查相邻的未探查房间。`;
    } else {
      analysis = `根据已探查的线索，目前揭示的数字都比较低，机关可能集中在尚未探查的区域。`;
    }
  }

  await typeMessage(player.name, analysis, 'normal', 20);
  document.getElementById('actionButtons').innerHTML = '';
  await sleep(500);
  enterVotingPhase();
}

async function humanAccuse() {
  const others = game.players.filter(p => !p.isHuman && p.alive);
  const btns = document.getElementById('actionButtons');
  btns.innerHTML = '<div style="font-size:12px;color:var(--text-muted);margin-bottom:4px;">选择要质疑的人：</div>';

  others.forEach(p => {
    const btn = document.createElement('button');
    btn.className = 'btn btn-secondary btn-sm';
    btn.innerHTML = `${p.icon} ${p.name}`;
    btn.onclick = () => executeAccuse(p);
    btns.appendChild(btn);
  });

  const cancelBtn = document.createElement('button');
  cancelBtn.className = 'btn btn-secondary btn-sm';
  cancelBtn.innerHTML = '<i class="fas fa-times"></i> 取消';
  cancelBtn.onclick = () => showDiscussionActions();
  btns.appendChild(cancelBtn);
}

async function executeAccuse(target) {
  const player = game.players[0];
  const dialogues = AI_DIALOGUE.accuse;
  let text = rand(dialogues).replace('{target}', target.name);
  await typeMessage(player.name, text, 'normal', 20);

  // 被质疑者的回应
  await sleep(800);
  const defense = rand(AI_DIALOGUE.defend);
  await typeMessage(target.name, defense, 'normal', 20);

  document.getElementById('actionButtons').innerHTML = '';
  await sleep(500);
  enterVotingPhase();
}

async function giveDetectiveClue(detective) {
  // 侦探获得一条线索
  const unrevealed = [];
  for (let r = 0; r < game.rows; r++)
    for (let c = 0; c < game.cols; c++)
      if (!game.revealed[r][c]) unrevealed.push({r, c});

  if (unrevealed.length === 0) return;

  // 找一个安全格子给出提示
  const safeUnrevealed = unrevealed.filter(({r, c}) => game.board[r][c] !== -1);
  if (safeUnrevealed.length > 0) {
    const target = rand(safeUnrevealed);
    const clue = `（侦探直觉）我有一种强烈的感觉，${getRoomName(target.r, target.c)}是安全的。`;
    await typeMessage(detective.name, clue, 'normal', 20);
  } else {
    const clue = '（侦探直觉）我感到不安……剩下的房间似乎都很危险。';
    await typeMessage(detective.name, clue, 'normal', 20);
  }
}

// ===========================
// 投票阶段
// ===========================

async function enterVotingPhase() {
  game.phase = 'voting';
  game.selectedVote = null;
  updatePhaseBadge();
  addSystemMessage('── 投票阶段 ── 请选择一个房间进行探查。');

  // 显示投票面板
  showVotePanel();
  renderBoard();
}

function showVotePanel() {
  const panel = document.getElementById('votePanel');
  const options = document.getElementById('voteOptions');
  panel.classList.add('active');
  options.innerHTML = '';

  // 列出未揭示的格子作为选项
  for (let r = 0; r < game.rows; r++) {
    for (let c = 0; c < game.cols; c++) {
      if (!game.revealed[r][c]) {
        const opt = document.createElement('div');
        opt.className = 'vote-option';
        opt.innerHTML = `<i class="fas fa-door-open" style="color:var(--text-muted);"></i> ${getRoomName(r, c)} (${r+1},${c+1})`;
        opt.onclick = () => selectVote(r, c, opt);
        options.appendChild(opt);
      }
    }
  }

  // 确认按钮
  const btns = document.getElementById('actionButtons');
  btns.innerHTML = `
    <button class="btn btn-primary btn-sm" id="confirmVoteBtn" onclick="confirmVote()" disabled>
      <i class="fas fa-check"></i> 确认投票
    </button>
  `;
}

function selectVote(r, c, el) {
  game.selectedVote = {r, c};
  document.querySelectorAll('.vote-option').forEach(o => o.classList.remove('selected'));
  el.classList.add('selected');
  document.getElementById('confirmVoteBtn').disabled = false;
  renderBoard();
}

async function confirmVote() {
  if (!game.selectedVote) return;

  const {r, c} = game.selectedVote;
  document.getElementById('votePanel').classList.remove('active');
  document.getElementById('actionButtons').innerHTML = '';

  addSystemMessage(`你投票探查了「${getRoomName(r, c)}」。`);

  // AI投票
  const aliveAI = game.players.filter(p => p.alive && !p.isHuman);
  const aiVotes = [];
  for (const player of aliveAI) {
    const vote = generateAIVote(player);
    if (vote) {
      aiVotes.push(vote);
      const dialogue = rand(AI_DIALOGUE.voteSuggest).replace('{room}', getRoomName(vote.r, vote.c));
      await sleep(400);
      addMessage(player.name, dialogue, 'normal');
    }
  }

  await sleep(600);

  // 统计投票结果（简单多数）
  const voteCount = {};
  aiVotes.forEach(v => {
    const key = `${v.r},${v.c}`;
    voteCount[key] = (voteCount[key] || 0) + 1;
  });
  const humanKey = `${r},${c}`;
  voteCount[humanKey] = (voteCount[humanKey] || 0) + 2; // 人类票权重更高

  // 找出最高票
  let maxVotes = 0;
  let winner = null;
  for (const [key, count] of Object.entries(voteCount)) {
    if (count > maxVotes) {
      maxVotes = count;
      const [wr, wc] = key.split(',').map(Number);
      winner = {r: wr, c: wc};
    }
  }

  if (!winner) winner = {r, c};

  addSystemMessage(`投票结果：探查「${getRoomName(winner.r, winner.c)}」。`);

  await sleep(800);
  await investigateCell(winner.r, winner.c);
}

// ===========================
// 探查阶段
// ===========================

async function investigateCell(r, c) {
  game.phase = 'investigation';
  updatePhaseBadge();

  // 揭示格子
  game.revealed[r][c] = true;
  game.flagged[r][c] = false;
  game.safeMarked[r][c] = false;
  renderBoard();

  if (game.board[r][c] === -1) {
    // 踩到机关！
    game.minesFound++;
    const event = rand(STORY_EVENTS.mineFound);
    await typeMessage('旁白', event, 'narrator', 25);
    await sleep(500);
    addMessage('系统', `「${getRoomName(r, c)}」是一个机关陷阱！`, 'danger');

    // 随机一个投票者出局
    const alivePlayers = game.players.filter(p => p.alive);
    if (alivePlayers.length > 0) {
      // 投票者中随机一人出局
      const victim = rand(alivePlayers);
      victim.alive = false;
      game.eliminatedPlayers.push(victim);

      const deathEvent = rand(STORY_EVENTS.playerEliminated).replace('{name}', victim.name);
      await sleep(600);
      await typeMessage('旁白', deathEvent, 'narrator', 25);
      addMessage('系统', `${victim.name} 出局了！`, 'danger');

      // 如果是人类玩家出局
      if (victim.isHuman) {
        await sleep(1000);
        endGame('murderer', '你触发了机关，倒在了暗夜庄园中……');
        return;
      }

      // 检查是否还有足够的好人
      const aliveGood = game.players.filter(p => p.alive && p.role !== 'murderer');
      if (aliveGood.length <= 1) {
        await sleep(1000);
        endGame('murderer', '好人阵营几乎全军覆没，凶手得逞了……');
        return;
      }
    }
  } else {
    // 安全房间
    const event = rand(STORY_EVENTS.safeReveal);
    await typeMessage('旁白', event, 'narrator', 25);

    if (game.board[r][c] === 0) {
      addMessage('系统', `「${getRoomName(r, c)}」是安全的，周围没有机关。`, 'success');
    } else {
      addMessage('系统', `「${getRoomName(r, c)}」是安全的，周围有 ${game.board[r][c]} 个机关。`, 'success');
    }

    // 如果是0，自动揭示相邻格子
    if (game.board[r][c] === 0) {
      await revealAdjacentZeros(r, c);
    }
  }

  renderBoard();
  renderPlayerList();
  renderProgress();

  // 检查是否所有机关都已揭示
  let allMinesRevealed = true;
  for (let rr = 0; rr < game.rows; rr++)
    for (let cc = 0; cc < game.cols; cc++)
      if (game.board[rr][cc] === -1 && !game.revealed[rr][cc])
        allMinesRevealed = false;

  if (allMinesRevealed) {
    await sleep(1000);
    enterAccusationPhase();
    return;
  }

  // 检查标记数量
  let flaggedCount = 0;
  for (let rr = 0; rr < game.rows; rr++)
    for (let cc = 0; cc < game.cols; cc++)
      if (game.flagged[rr][cc] && game.board[rr][cc] === -1)
        flaggedCount++;

  game.minesFlagged = flaggedCount;

  // 进入下一回合
  await sleep(1000);
  game.round++;
  await startRound();
}

async function revealAdjacentZeros(r, c) {
  const adj = getAdjacentCells(r, c);
  for (const {r: nr, c: nc} of adj) {
    if (!game.revealed[nr][nc] && game.board[nr][nc] !== -1) {
      game.revealed[nr][nc] = true;
      if (game.board[nr][nc] === 0) {
        await revealAdjacentZeros(nr, nc);
      }
    }
  }
  renderBoard();
}

// ===========================
// 指控阶段
// ===========================

async function enterAccusationPhase() {
  game.phase = 'accusation';
  updatePhaseBadge();

  for (const line of STORY_EVENTS.allMinesFound) {
    await typeMessage('旁白', line, 'narrator', 25);
    await sleep(600);
  }

  addSystemMessage('── 指控阶段 ── 所有机关已被揭示，现在投票选出凶手！');

  // AI发表指控意见
  const alivePlayers = game.players.filter(p => p.alive);
  for (const player of alivePlayers) {
    if (player.isHuman) continue;
    await sleep(800);
    const dialogue = generateAIDialogue(player, {
      phase: 'accusation', round: game.round,
      lastRevealedCell: null, lastRevealedValue: -1,
      eliminatedPlayer: null
    });
    await typeMessage(player.name, dialogue, 'normal', 20);
  }

  // 人类投票
  showAccusationVote();
}

function showAccusationVote() {
  const panel = document.getElementById('votePanel');
  const options = document.getElementById('voteOptions');
  panel.classList.add('active');

  const titleEl = panel.querySelector('.vote-title');
  titleEl.innerHTML = '<i class="fas fa-gavel"></i> 投票选出凶手！';

  options.innerHTML = '';
  const suspects = game.players.filter(p => p.alive && !p.isHuman);

  suspects.forEach(p => {
    const opt = document.createElement('div');
    opt.className = 'vote-option';
    opt.innerHTML = `${p.icon} ${p.name}`;
    opt.onclick = () => selectAccusation(p, opt);
    options.appendChild(opt);
  });

  const btns = document.getElementById('actionButtons');
  btns.innerHTML = `
    <button class="btn btn-danger btn-sm" id="confirmAccBtn" onclick="confirmAccusation()" disabled>
      <i class="fas fa-gavel"></i> 确认指控
    </button>
  `;
}

let selectedAccusationTarget = null;
function selectAccusation(player, el) {
  selectedAccusationTarget = player;
  document.querySelectorAll('.vote-option').forEach(o => o.classList.remove('selected'));
  el.classList.add('selected');
  document.getElementById('confirmAccBtn').disabled = false;
}

async function confirmAccusation() {
  if (!selectedAccusationTarget) return;

  document.getElementById('votePanel').classList.remove('active');
  document.getElementById('actionButtons').innerHTML = '';

  const target = selectedAccusationTarget;

  // AI也投票
  const aliveAI = game.players.filter(p => p.alive && !p.isHuman);
  const votes = {};
  aliveAI.forEach(p => {
    const suspect = game.players.find(s => s.alive && s !== p);
    if (suspect) {
      votes[suspect.name] = (votes[suspect.name] || 0) + 1;
    }
  });
  votes[target.name] = (votes[target.name] || 0) + 2;

  let maxVote = 0, accused = target;
  for (const [name, count] of Object.entries(votes)) {
    if (count > maxVote) {
      maxVote = count;
      accused = game.players.find(p => p.name === name) || target;
    }
  }

  await sleep(800);
  addSystemMessage(`投票结果：${accused.name} 被指控为凶手！`);

  await sleep(1000);

  if (accused.role === 'murderer') {
    endGame('good', `真相大白！${accused.name}就是暗夜庄园的凶手！好人阵营获胜！`);
  } else {
    endGame('murderer', `${accused.name}不是凶手！真正的凶手逃脱了……凶手获胜！`);
  }
}

// ===========================
// 格子交互
// ===========================

function handleCellClick(r, c, e) {
  if (game.gameOver) return;
  if (game.revealed[r][c]) return;

  // 讨论阶段可以标记/取消标记
  if (game.phase === 'discussion' || game.phase === 'voting') {
    if (game.safeMarked[r][c]) {
      game.safeMarked[r][c] = false;
    } else if (game.flagged[r][c]) {
      game.flagged[r][c] = false;
    } else {
      game.flagged[r][c] = true;
    }

    // 更新标记计数
    let fc = 0;
    for (let rr = 0; rr < game.rows; rr++)
      for (let cc = 0; cc < game.cols; cc++)
        if (game.flagged[rr][cc] && game.board[rr][cc] === -1)
          fc++;
    game.minesFlagged = fc;

    renderBoard();
    renderProgress();
  }
}

function handleCellRightClick(r, c) {
  if (game.gameOver) return;
  if (game.revealed[r][c]) return;

  if (game.phase === 'discussion' || game.phase === 'voting') {
    if (game.flagged[r][c]) {
      game.flagged[r][c] = false;
    } else if (game.safeMarked[r][c]) {
      game.safeMarked[r][c] = false;
    } else {
      game.safeMarked[r][c] = true;
    }
    renderBoard();
  }
}

// ===========================
// 游戏结束
// ===========================

function endGame(winner, summary) {
  game.gameOver = true;
  game.winner = winner;

  switchScreen('endScreen');

  const iconEl = document.getElementById('endIcon');
  const titleEl = document.getElementById('endTitle');
  const summaryEl = document.getElementById('endSummary');
  const revealEl = document.getElementById('endReveal');

  if (winner === 'good') {
    iconEl.textContent = '🏆';
    titleEl.textContent = '正义必胜';
    titleEl.className = 'end-title win';
  } else {
    iconEl.textContent = '💀';
    titleEl.textContent = '暗夜降临';
    titleEl.className = 'end-title lose';
  }

  summaryEl.textContent = summary;

  // 揭示所有角色
  revealEl.innerHTML = '';
  game.players.forEach(p => {
    const card = document.createElement('div');
    card.className = 'reveal-card';
    const roleClass = p.role === 'murderer' ? 'color:var(--accent-red-light)' :
                      p.role === 'detective' ? 'color:var(--accent-blue)' : 'color:var(--accent-green)';
    card.innerHTML = `
      <div class="avatar">${p.icon}</div>
      <div class="name">${p.name}${p.isHuman ? ' (你)' : ''}</div>
      <div class="role" style="${roleClass}">${getRoleName(p.role)} ${p.alive ? '' : '✗'}</div>
    `;
    revealEl.appendChild(card);
  });
}

