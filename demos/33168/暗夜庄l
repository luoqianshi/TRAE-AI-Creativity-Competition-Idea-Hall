}

async function typeMessage(sender, text, type = 'normal', delay = 30) {
  const container = document.getElementById('chatMessages');
  const msg = document.createElement('div');
  msg.className = `chat-msg ${type}`;

  let avatarHtml = '';
  if (type === 'narrator') {
    avatarHtml = '<div class="chat-msg-avatar" style="background:rgba(142,68,173,0.15);">🎭</div>';
  } else {
    const player = game.players.find(p => p.name === sender);
    const icon = player ? player.icon : '👤';
    avatarHtml = `<div class="chat-msg-avatar" style="background:var(--bg-tertiary);">${icon}</div>`;
  }

  msg.innerHTML = `
    ${avatarHtml}
    <div class="chat-msg-body">
      <div class="chat-msg-name">${sender}</div>
      <div class="chat-msg-text typewriter"></div>
    </div>
  `;

  container.appendChild(msg);

  const textEl = msg.querySelector('.chat-msg-text');
  for (let i = 0; i < text.length; i++) {
    textEl.textContent += text[i];
    container.scrollTop = container.scrollHeight;
    await sleep(delay);
  }
  textEl.classList.remove('typewriter');
}

