<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>暗夜庄园 - 剧本杀式逻辑扫雷</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
/* ===== 字体回退（离线可用） ===== */
@font-face {
  font-family: 'Noto Serif SC';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: local('Noto Serif SC'), local('NotoSerifSC-Regular');
}
@font-face {
  font-family: 'Noto Serif SC';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: local('Noto Serif SC'), local('NotoSerifSC-Bold');
}
@font-face {
  font-family: 'Noto Serif SC';
  font-style: normal;
  font-weight: 900;
  font-display: swap;
  src: local('Noto Serif SC'), local('NotoSerifSC-Black');
}
@font-face {
  font-family: 'Noto Sans SC';
  font-style: normal;
  font-weight: 300;
  font-display: swap;
  src: local('Noto Sans SC'), local('NotoSansSC-Light');
}
@font-face {
  font-family: 'Noto Sans SC';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: local('Noto Sans SC'), local('NotoSansSC-Regular');
}
@font-face {
  font-family: 'Noto Sans SC';
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: local('Noto Sans SC'), local('NotoSansSC-Medium');
}
@font-face {
  font-family: 'Noto Sans SC';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: local('Noto Sans SC'), local('NotoSansSC-Bold');
}
</style>
<style>
:root {
  --bg-deep: #0a0a0f;
  --bg-primary: #12121a;
  --bg-secondary: #1a1a28;
  --bg-tertiary: #222236;
  --bg-card: #1e1e30;
  --text-primary: #e8e6e3;
  --text-secondary: #a09cb0;
  --text-muted: #6b6780;
  --accent-red: #c0392b;
  --accent-red-light: #e74c3c;
  --accent-gold: #d4a843;
  --accent-gold-dim: #a8842f;
  --accent-blue: #3498db;
  --accent-green: #27ae60;
  --accent-purple: #8e44ad;
  --border-color: #2a2a40;
  --border-glow: rgba(212,168,67,0.3);
  --shadow-deep: 0 8px 32px rgba(0,0,0,0.6);
  --shadow-card: 0 4px 16px rgba(0,0,0,0.4);
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Noto Sans SC', sans-serif;
  background: var(--bg-deep);
  color: var(--text-primary);
  min-height: 100vh;
  overflow-x: hidden;
}

/* ===== 背景氛围 ===== */
.atmosphere {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  pointer-events: none; z-index: 0;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(192,57,43,0.06) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(142,68,173,0.05) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 80%, rgba(212,168,67,0.04) 0%, transparent 50%);
}

.fog-layer {
  position: fixed; top: 0; left: 0; width: 200%; height: 100%;
  pointer-events: none; z-index: 0; opacity: 0.03;
  background: repeating-linear-gradient(90deg, transparent, transparent 200px, rgba(255,255,255,0.1) 200px, rgba(255,255,255,0.1) 201px);
  animation: fogDrift 60s linear infinite;
}
@keyframes fogDrift { from { transform: translateX(0); } to { transform: translateX(-50%); } }

/* ===== 通用组件 ===== */
.screen { display: none; position: relative; z-index: 1; min-height: 100vh; }
.screen.active { display: flex; }

.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 28px; border: none; border-radius: var(--radius-md);
  font-family: 'Noto Sans SC', sans-serif; font-size: 15px; font-weight: 500;
  cursor: pointer; transition: all 0.3s ease; position: relative; overflow: hidden;
}
.btn-primary {
  background: linear-gradient(135deg, var(--accent-gold), var(--accent-gold-dim));
  color: #1a1a28; box-shadow: 0 4px 20px rgba(212,168,67,0.3);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 28px rgba(212,168,67,0.5); }
.btn-secondary {
  background: var(--bg-tertiary); color: var(--text-primary);
  border: 1px solid var(--border-color);
}
.btn-secondary:hover { border-color: var(--accent-gold-dim); background: var(--bg-card); }
.btn-danger {
  background: linear-gradient(135deg, var(--accent-red), #962d22);
  color: white; box-shadow: 0 4px 20px rgba(192,57,43,0.3);
}
.btn-danger:hover { transform: translateY(-2px); box-shadow: 0 6px 28px rgba(192,57,43,0.5); }
.btn-sm { padding: 8px 18px; font-size: 13px; }
.btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none !important; }

.card {
  background: var(--bg-card); border: 1px solid var(--border-color);
  border-radius: var(--radius-lg); padding: 24px;
  box-shadow: var(--shadow-card);
}

/* ===== 开始界面 ===== */
#startScreen {
  flex-direction: column; align-items: center; justify-content: center;
  text-align: center; padding: 40px 20px; gap: 40px;
}
.title-group { animation: fadeInUp 1s ease; }
.main-title {
  font-family: 'Noto Serif SC', serif; font-size: clamp(36px, 6vw, 64px);
  font-weight: 900; letter-spacing: 8px;
  background: linear-gradient(135deg, var(--accent-gold), #f0d78c, var(--accent-gold-dim));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; text-shadow: none;
  filter: drop-shadow(0 2px 8px rgba(212,168,67,0.3));
}
.sub-title {
  font-size: clamp(14px, 2vw, 18px); color: var(--text-secondary);
  margin-top: 12px; letter-spacing: 4px; font-weight: 300;
}
.divider {
  width: 120px; height: 1px; margin: 0 auto;
  background: linear-gradient(90deg, transparent, var(--accent-gold-dim), transparent);
}
.story-intro {
  max-width: 680px; font-size: 15px; line-height: 2;
  color: var(--text-secondary); animation: fadeInUp 1s ease 0.3s both;
}
.story-intro .highlight { color: var(--accent-gold); font-weight: 500; }

.settings-panel {
  display: flex; gap: 24px; flex-wrap: wrap; justify-content: center;
  animation: fadeInUp 1s ease 0.5s both;
}
.setting-item {
  display: flex; flex-direction: column; gap: 8px; align-items: center;
}
.setting-label { font-size: 13px; color: var(--text-muted); letter-spacing: 2px; }
.setting-select {
  background: var(--bg-tertiary); border: 1px solid var(--border-color);
  color: var(--text-primary); padding: 10px 20px; border-radius: var(--radius-sm);
  font-family: 'Noto Sans SC', sans-serif; font-size: 14px;
  cursor: pointer; min-width: 140px; text-align: center;
}
.setting-select:focus { outline: none; border-color: var(--accent-gold-dim); }

.start-actions { animation: fadeInUp 1s ease 0.7s both; display: flex; gap: 16px; }

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 角色分配界面 ===== */
#roleScreen {
  flex-direction: column; align-items: center; justify-content: center;
  padding: 40px 20px; gap: 32px;
}
.role-reveal-card {
  max-width: 500px; width: 100%; text-align: center;
  animation: cardReveal 0.8s ease;
}
@keyframes cardReveal {
  0% { opacity: 0; transform: scale(0.8) rotateY(90deg); }
  50% { transform: scale(1.05) rotateY(0deg); }
  100% { opacity: 1; transform: scale(1) rotateY(0deg); }
}
.role-icon { font-size: 64px; margin-bottom: 16px; }
.role-name {
  font-family: 'Noto Serif SC', serif; font-size: 28px; font-weight: 700;
  margin-bottom: 8px;
}
.role-identity {
  display: inline-block; padding: 4px 16px; border-radius: 20px;
  font-size: 13px; font-weight: 500; letter-spacing: 2px; margin-bottom: 16px;
}
.role-identity.detective { background: rgba(52,152,219,0.2); color: var(--accent-blue); border: 1px solid rgba(52,152,219,0.3); }
.role-identity.villager { background: rgba(39,174,96,0.2); color: var(--accent-green); border: 1px solid rgba(39,174,96,0.3); }
.role-identity.murderer { background: rgba(192,57,43,0.2); color: var(--accent-red-light); border: 1px solid rgba(192,57,43,0.3); }
.role-desc { font-size: 14px; color: var(--text-secondary); line-height: 1.8; }
.role-secret {
  margin-top: 16px; padding: 16px; border-radius: var(--radius-md);
  background: rgba(192,57,43,0.1); border: 1px solid rgba(192,57,43,0.2);
  font-size: 13px; color: var(--accent-red-light); line-height: 1.8;
}

/* ===== 游戏主界面 ===== */
#gameScreen {
  flex-direction: column; height: 100vh; overflow: hidden;
}
.game-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 24px; background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-color); flex-shrink: 0;
}
.game-title-small {
  font-family: 'Noto Serif SC', serif; font-size: 18px; font-weight: 700;
  color: var(--accent-gold);
}
.round-info { font-size: 13px; color: var(--text-muted); }
.phase-badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 500;
}
.phase-badge.discussion { background: rgba(212,168,67,0.15); color: var(--accent-gold); }
.phase-badge.voting { background: rgba(142,68,173,0.15); color: var(--accent-purple); }
.phase-badge.investigation { background: rgba(52,152,219,0.15); color: var(--accent-blue); }
.phase-badge.result { background: rgba(39,174,96,0.15); color: var(--accent-green); }

.game-body {
  display: flex; flex: 1; overflow: hidden;
}

/* 左侧面板 - 角色信息 */
.side-panel {
  width: 260px; flex-shrink: 0; background: var(--bg-secondary);
  border-right: 1px solid var(--border-color);
  display: flex; flex-direction: column; overflow: hidden;
}
.panel-section {
  padding: 16px; border-bottom: 1px solid var(--border-color);
}
.panel-title {
  font-size: 12px; color: var(--text-muted); letter-spacing: 2px;
  margin-bottom: 12px; text-transform: uppercase;
}
.player-list { display: flex; flex-direction: column; gap: 8px; }
.player-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; border-radius: var(--radius-sm);
  background: var(--bg-tertiary); border: 1px solid transparent;
  transition: all 0.3s;
}
.player-item.active { border-color: var(--accent-gold-dim); background: rgba(212,168,67,0.08); }
.player-item.dead { opacity: 0.4; }
.player-item.is-you { border-color: var(--accent-blue); background: rgba(52,152,219,0.08); }
.player-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; flex-shrink: 0;
}
.player-info { flex: 1; min-width: 0; }
.player-name { font-size: 13px; font-weight: 500; }
.player-role-tag { font-size: 11px; color: var(--text-muted); }
.player-status {
  font-size: 11px; padding: 2px 8px; border-radius: 10px;
}
.player-status.alive { background: rgba(39,174,96,0.15); color: var(--accent-green); }
.player-status.dead { background: rgba(192,57,43,0.15); color: var(--accent-red-light); }

/* 中间 - 棋盘区域 */
.board-area {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 20px; overflow: auto;
  background: radial-gradient(ellipse at center, rgba(30,30,48,0.5), transparent);
}
.board-container {
  position: relative; padding: 16px;
  background: var(--bg-card); border: 2px solid var(--border-color);
  border-radius: var(--radius-lg); box-shadow: var(--shadow-deep);
}
.board-label {
  text-align: center; font-size: 12px; color: var(--text-muted);
  letter-spacing: 3px; margin-bottom: 12px;
}
.mine-grid {
  display: grid; gap: 3px;
}
.cell {
  width: 48px; height: 48px; border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; font-weight: 700; cursor: pointer;
  transition: all 0.2s; position: relative; user-select: none;
}
.cell.hidden {
  background: var(--bg-tertiary); border: 1px solid var(--border-color);
}
.cell.hidden:hover { border-color: var(--accent-gold-dim); background: rgba(212,168,67,0.08); }
.cell.revealed {
  background: var(--bg-secondary); border: 1px solid rgba(255,255,255,0.05);
  cursor: default;
}
.cell.flagged {
  background: rgba(192,57,43,0.15); border: 1px solid rgba(192,57,43,0.3);
}
.cell.flagged::after {
  content: '\f024'; font-family: 'Font Awesome 6 Free'; font-weight: 900;
  color: var(--accent-red-light); font-size: 14px;
}
.cell.exploded {
  background: rgba(192,57,43,0.4); border: 1px solid var(--accent-red);
  animation: explode 0.5s ease;
}
@keyframes explode {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}
.cell .number { font-family: 'Noto Sans SC', sans-serif; }
.cell .number.n1 { color: #4fc3f7; }
.cell .number.n2 { color: #66bb6a; }
.cell .number.n3 { color: #ef5350; }
.cell .number.n4 { color: #ab47bc; }
.cell .number.n5 { color: #ff7043; }
.cell .number.n6 { color: #26c6da; }
.cell .number.n7 { color: #8d6e63; }
.cell .number.n8 { color: #bdbdbd; }
.cell .bomb-icon { color: var(--accent-red-light); font-size: 18px; }

.board-legend {
  display: flex; gap: 16px; margin-top: 12px; justify-content: center;
  font-size: 11px; color: var(--text-muted);
}
.legend-item { display: flex; align-items: center; gap: 4px; }
.legend-dot {
  width: 10px; height: 10px; border-radius: 2px;
}

/* 右侧面板 - 剧情对话 */
.chat-panel {
  width: 360px; flex-shrink: 0; background: var(--bg-secondary);
  border-left: 1px solid var(--border-color);
  display: flex; flex-direction: column; overflow: hidden;
}
.chat-header {
  padding: 14px 16px; border-bottom: 1px solid var(--border-color);
  font-size: 13px; font-weight: 500; color: var(--text-secondary);
  display: flex; align-items: center; gap: 8px;
}
.chat-messages {
  flex: 1; overflow-y: auto; padding: 16px;
  display: flex; flex-direction: column; gap: 12px;
  scroll-behavior: smooth;
}
.chat-messages::-webkit-scrollbar { width: 4px; }
.chat-messages::-webkit-scrollbar-track { background: transparent; }
.chat-messages::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 2px; }

.chat-msg {
  display: flex; gap: 10px; animation: msgIn 0.4s ease;
}
@keyframes msgIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
.chat-msg-avatar {
  width: 32px; height: 32px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; flex-shrink: 0;
}
.chat-msg-body { flex: 1; min-width: 0; }
.chat-msg-name { font-size: 12px; font-weight: 500; margin-bottom: 4px; }
.chat-msg-text {
  font-size: 13px; line-height: 1.7; color: var(--text-secondary);
  padding: 10px 14px; border-radius: var(--radius-md);
  background: var(--bg-tertiary); border: 1px solid var(--border-color);
}
.chat-msg.system .chat-msg-text {
  background: rgba(212,168,67,0.08); border-color: rgba(212,168,67,0.15);
  color: var(--accent-gold); font-style: italic;
}
.chat-msg.narrator .chat-msg-text {
  background: rgba(142,68,173,0.08); border-color: rgba(142,68,173,0.15);
  color: #bb8fce;
}
.chat-msg.danger .chat-msg-text {
  background: rgba(192,57,43,0.08); border-color: rgba(192,57,43,0.15);
  color: var(--accent-red-light);
}
.chat-msg.success .chat-msg-text {
  background: rgba(39,174,96,0.08); border-color: rgba(39,174,96,0.15);
  color: var(--accent-green);
}

/* 底部操作栏 */
.chat-actions {
  padding: 16px; border-top: 1px solid var(--border-color);
  display: flex; flex-direction: column; gap: 10px;
}
.action-buttons {
  display: flex; gap: 8px; flex-wrap: wrap;
}

/* 投票面板 */
.vote-panel {
  padding: 16px; border-top: 1px solid var(--border-color);
  display: none;
}
.vote-panel.active { display: block; }
.vote-title { font-size: 13px; color: var(--text-muted); margin-bottom: 10px; }
.vote-options { display: flex; flex-direction: column; gap: 6px; }
.vote-option {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px; border-radius: var(--radius-sm);
  background: var(--bg-tertiary); border: 1px solid var(--border-color);
  cursor: pointer; transition: all 0.2s; font-size: 13px;
}
.vote-option:hover { border-color: var(--accent-purple); background: rgba(142,68,173,0.08); }
.vote-option.selected { border-color: var(--accent-purple); background: rgba(142,68,173,0.15); }
.vote-option.voted { opacity: 0.5; pointer-events: none; }

/* ===== 结算界面 ===== */
#endScreen {
  flex-direction: column; align-items: center; justify-content: center;
  padding: 40px 20px; gap: 32px; text-align: center;
}
.end-icon { font-size: 80px; animation: pulse 2s ease infinite; }
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}
.end-title {
  font-family: 'Noto Serif SC', serif; font-size: 36px; font-weight: 900;
}
.end-title.win { color: var(--accent-gold); }
.end-title.lose { color: var(--accent-red-light); }
.end-summary {
  max-width: 600px; font-size: 15px; line-height: 2;
  color: var(--text-secondary);
}
.end-reveal {
  display: flex; gap: 16px; flex-wrap: wrap; justify-content: center;
}
.reveal-card {
  padding: 16px 20px; border-radius: var(--radius-md);
  background: var(--bg-card); border: 1px solid var(--border-color);
  text-align: center; min-width: 120px;
}
.reveal-card .avatar { font-size: 28px; margin-bottom: 8px; }
.reveal-card .name { font-size: 14px; font-weight: 500; margin-bottom: 4px; }
.reveal-card .role { font-size: 12px; }

/* ===== 规则弹窗 ===== */
.modal-overlay {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.7); z-index: 100;
  display: none; align-items: center; justify-content: center;
  backdrop-filter: blur(4px);
}
.modal-overlay.active { display: flex; }
.modal-content {
  max-width: 560px; width: 90%; max-height: 80vh; overflow-y: auto;
  padding: 32px; animation: modalIn 0.3s ease;
}
@keyframes modalIn {
  from { opacity: 0; transform: scale(0.95) translateY(10px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
.modal-title {
  font-family: 'Noto Serif SC', serif; font-size: 22px; font-weight: 700;
  margin-bottom: 20px; color: var(--accent-gold);
}
.modal-text { font-size: 14px; line-height: 2; color: var(--text-secondary); }
.modal-text h3 { color: var(--text-primary); margin: 16px 0 8px; font-size: 15px; }
.modal-text ul { padding-left: 20px; }
.modal-text li { margin-bottom: 4px; }
.modal-close {
  margin-top: 24px; width: 100%;
}

/* ===== 响应式 ===== */
@media (max-width: 1100px) {
  .side-panel { width: 200px; }
  .chat-panel { width: 300px; }
  .cell { width: 40px; height: 40px; font-size: 14px; }
}
@media (max-width: 860px) {
  .game-body { flex-direction: column; }
  .side-panel { width: 100%; max-height: 120px; flex-direction: row; overflow-x: auto; border-right: none; border-bottom: 1px solid var(--border-color); }
  .panel-section { border-bottom: none; border-right: 1px solid var(--border-color); min-width: max-content; }
  .player-list { flex-direction: row; }
  .chat-panel { width: 100%; max-height: 300px; border-left: none; border-top: 1px solid var(--border-color); }
  .cell { width: 36px; height: 36px; font-size: 13px; }
}

/* ===== 打字机效果 ===== */
.typewriter { overflow: hidden; border-right: 2px solid var(--accent-gold-dim); animation: blink 0.8s step-end infinite; }
@keyframes blink { 50% { border-color: transparent; } }

/* ===== 提示工具 ===== */
.tooltip {
  position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%);
  padding: 6px 12px; background: var(--bg-deep); border: 1px solid var(--border-color);
  border-radius: var(--radius-sm); font-size: 11px; white-space: nowrap;
  pointer-events: none; opacity: 0; transition: opacity 0.2s; z-index: 10;
}
.cell:hover .tooltip { opacity: 1; }

/* ===== 进度条 ===== */
.progress-bar {
  width: 100%; height: 4px; background: var(--bg-tertiary);
  border-radius: 2px; overflow: hidden;
}
.progress-fill {
  height: 100%; border-radius: 2px; transition: width 0.5s ease;
  background: linear-gradient(90deg, var(--accent-gold), var(--accent-gold-dim));
}

/* ===== 选择房间高亮 ===== */
.cell.selectable {
  animation: cellGlow 1.5s ease infinite;
}
@keyframes cellGlow {
