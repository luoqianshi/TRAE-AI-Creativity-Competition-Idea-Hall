function generateAIDialogue(player, context) {
  const { phase, round, lastRevealedCell, lastRevealedValue, eliminatedPlayer } = context;
  let dialogue = '';
  const otherPlayers = game.players.filter(p => p !== player && p.alive);
  const randomTarget = rand(otherPlayers);

  if (player.role === 'murderer') {
    // 凶手策略：误导
    if (phase === 'discussion') {
      if (round <= 2) {
        dialogue = rand(AI_DIALOGUE.opening);
      } else if (lastRevealedCell && lastRevealedValue > 0) {
        // 故意引导到危险区域
        const dangerousCells = getAdjacentCells(lastRevealedCell.r, lastRevealedCell.c)
          .filter(({r, c}) => !game.revealed[r][c] && game.board[r][c] === -1);
        if (dangerousCells.length > 0 && Math.random() > 0.4) {
          const target = rand(dangerousCells);
          dialogue = rand(AI_DIALOGUE.murdererMislead)
            .replace('{room}', getRoomName(target.r, target.c))
            .replace('{target}', randomTarget ? randomTarget.name : '某人');
        } else {
          dialogue = rand(AI_DIALOGUE.murdererMislead)
            .replace('{target}', randomTarget ? randomTarget.name : '某人')
            .replace('{room}', getRoomName(Math.floor(Math.random()*game.rows), Math.floor(Math.random()*game.cols)));
        }
      } else {
        dialogue = rand(AI_DIALOGUE.murdererMislead)
          .replace('{target}', randomTarget ? randomTarget.name : '某人')
          .replace('{room}', getRoomName(Math.floor(Math.random()*game.rows), Math.floor(Math.random()*game.cols)));
      }
    } else if (phase === 'voting') {
      // 凶手投安全区域
      const safeCells = [];
      for (let r = 0; r < game.rows; r++)
        for (let c = 0; c < game.cols; c++)
          if (!game.revealed[r][c] && game.board[r][c] !== -1)
            safeCells.push({r, c});
      if (safeCells.length > 0) {
        const target = rand(safeCells);
        dialogue = rand(AI_DIALOGUE.voteSuggest).replace('{room}', getRoomName(target.r, target.c));
      } else {
        dialogue = rand(AI_DIALOGUE.opening);
      }
    } else if (phase === 'accusation') {
      // 凶手指控无辜者
      const innocent = otherPlayers.filter(p => p.role !== 'murderer');
      const target = rand(innocent);
      dialogue = rand(AI_DIALOGUE.accuseMurderer).replace('{target}', target ? target.name : '某人');
    }
  } else if (player.role === 'detective') {
    // 侦探策略：分析线索
    if (phase === 'discussion') {
      if (lastRevealedCell && lastRevealedValue >= 0) {
        // 分析已揭示的数字
        const adj = getAdjacentCells(lastRevealedCell.r, lastRevealedCell.c)
          .filter(({r, c}) => !game.revealed[r][c]);
        if (adj.length > 0) {
          const target = rand(adj);
          if (lastRevealedValue === 0) {
            dialogue = rand(AI_DIALOGUE.detectiveAnalyze)
              .replace('{room}', getRoomName(target.r, target.c))
              .replace('{num}', '0');
          } else {
            dialogue = rand(AI_DIALOGUE.detectiveAnalyze)
              .replace('{room}', getRoomName(target.r, target.c))
              .replace('{num}', String(lastRevealedValue));
          }
        }
      }
      if (!dialogue) {
        dialogue = rand(AI_DIALOGUE.detectiveAnalyze)
          .replace('{room}', getRoomName(Math.floor(Math.random()*game.rows), Math.floor(Math.random()*game.cols)))
          .replace('{num}', String(Math.floor(Math.random()*3)));
      }
    } else if (phase === 'voting') {
      // 侦探投安全区域
      const safeCells = [];
      for (let r = 0; r < game.rows; r++)
        for (let c = 0; c < game.cols; c++)
          if (!game.revealed[r][c] && game.board[r][c] !== -1)
            safeCells.push({r, c});
      if (safeCells.length > 0) {
        const target = rand(safeCells);
        dialogue = rand(AI_DIALOGUE.voteSuggest).replace('{room}', getRoomName(target.r, target.c));
      } else {
        dialogue = rand(AI_DIALOGUE.opening);
      }
    } else if (phase === 'accusation') {
      const murderer = game.players.find(p => p.role === 'murderer');
      dialogue = rand(AI_DIALOGUE.accuseMurderer).replace('{target}', murderer ? murderer.name : '某人');
    }
  } else {
    // 普通嫌疑人
    if (phase === 'discussion') {
      if (eliminatedPlayer) {
        dialogue = rand(AI_DIALOGUE.playerOut);
      } else if (lastRevealedCell && lastRevealedValue > 2) {
        dialogue = rand(AI_DIALOGUE.analyzeDanger);
      } else if (lastRevealedCell && lastRevealedValue >= 0) {
        dialogue = rand(AI_DIALOGUE.analyzeSafe);
      } else if (Math.random() > 0.6) {
        dialogue = rand(AI_DIALOGUE.accuse).replace('{target}', randomTarget ? randomTarget.name : '某人');
      } else {
        dialogue = rand([...AI_DIALOGUE.opening, ...AI_DIALOGUE.idle]);
      }
    } else if (phase === 'voting') {
      const cells = [];
      for (let r = 0; r < game.rows; r++)
        for (let c = 0; c < game.cols; c++)
          if (!game.revealed[r][c]) cells.push({r, c});
      if (cells.length > 0) {
        const target = rand(cells);
        dialogue = rand(AI_DIALOGUE.voteSuggest).replace('{room}', getRoomName(target.r, target.c));
      }
    } else if (phase === 'accusation') {
      if (Math.random() > 0.5) {
        const murderer = game.players.find(p => p.role === 'murderer');
        dialogue = rand(AI_DIALOGUE.accuseMurderer).replace('{target}', murderer ? murderer.name : randomTarget.name);
      } else {
        dialogue = rand(AI_DIALOGUE.accuseMurderer).replace('{target}', randomTarget ? randomTarget.name : '某人');
      }
    }
  }

  return dialogue || rand(AI_DIALOGUE.opening);
}

function generateAIVote(player) {
  // AI投票逻辑
  if (player.role === 'murderer') {
    // 凶手投安全区域
    const safeCells = [];
    for (let r = 0; r < game.rows; r++)
      for (let c = 0; c < game.cols; c++)
        if (!game.revealed[r][c] && game.board[r][c] !== -1)
          safeCells.push({r, c});
    return safeCells.length > 0 ? rand(safeCells) : null;
  } else {
    // 好人投安全区域（有概率投危险区域增加紧张感）
    const safeCells = [];
    for (let r = 0; r < game.rows; r++)
      for (let c = 0; c < game.cols; c++)
        if (!game.revealed[r][c] && game.board[r][c] !== -1)
          safeCells.push({r, c});
    if (safeCells.length > 0 && Math.random() > 0.2) {
      return rand(safeCells);
    }
    // 20%概率随机投
    const allCells = [];
    for (let r = 0; r < game.rows; r++)
      for (let c = 0; c < game.cols; c++)
        if (!game.revealed[r][c]) allCells.push({r, c});
    return allCells.length > 0 ? rand(allCells) : null;
  }
}

