function assignRoles(playerCount) {
  const characters = shuffle(CHARACTER_POOL).slice(0, playerCount);
  const roles = [];

  // 1个侦探, 1个凶手, 其余为普通嫌疑人
  for (let i = 0; i < playerCount; i++) {
    let role = 'villager';
    if (i === 0) role = 'detective';
    else if (i === 1) role = 'murderer';

    roles.push({
      ...characters[i],
      role: role,
      alive: true,
      isHuman: i === 0,
      suspicion: 0, // 被怀疑程度
    });
  }

  // 随机打乱顺序，但人类玩家始终在第一位
  const human = roles[0];
  const others = shuffle(roles.slice(1));
  return [human, ...others];
}

