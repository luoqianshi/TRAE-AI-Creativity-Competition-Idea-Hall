function renderBoard() {
  const grid = document.getElementById('mineGrid');
  grid.style.gridTemplateColumns = `repeat(${game.cols}, 48px)`;
  grid.innerHTML = '';

  for (let r = 0; r < game.rows; r++) {
    for (let c = 0; c < game.cols; c++) {
      const cell = document.createElement('div');
      cell.className = 'cell';
      cell.dataset.row = r;
      cell.dataset.col = c;

      if (game.revealed[r][c]) {
        cell.classList.add('revealed');
        if (game.board[r][c] === -1) {
          cell.classList.add('exploded');
          cell.innerHTML = '<i class="fas fa-bomb bomb-icon"></i>';
        } else if (game.board[r][c] > 0) {
          cell.innerHTML = `<span class="number n${game.board[r][c]}">${game.board[r][c]}</span>`;
        }
      } else if (game.flagged[r][c]) {
        cell.classList.add('flagged', 'hidden');
      } else if (game.safeMarked[r][c]) {
        cell.classList.add('hidden');
        cell.style.borderColor = 'rgba(39,174,96,0.4)';
        cell.style.background = 'rgba(39,174,96,0.08)';
        cell.innerHTML = '<i class="fas fa-check" style="color:var(--accent-green);font-size:12px;"></i>';
      } else {
        cell.classList.add('hidden');
      }

      // 投票阶段可选标记
      if (game.phase === 'voting' && !game.revealed[r][c]) {
        cell.classList.add('selectable');
      }
      if (game.selectedVote && game.selectedVote.r === r && game.selectedVote.c === c) {
        cell.classList.add('voted-cell');
      }

      // 房间名提示
      const tooltip = document.createElement('div');
      tooltip.className = 'tooltip';
      tooltip.textContent = getRoomName(r, c);
      cell.appendChild(tooltip);

      // 点击事件
      cell.addEventListener('click', (e) => handleCellClick(r, c, e));
      cell.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        handleCellRightClick(r, c);
      });

      grid.appendChild(cell);
    }
  }
}

function renderPlayerList() {
  const list = document.getElementById('playerList');
  list.innerHTML = '';

  game.players.forEach((p, i) => {
    const item = document.createElement('div');
    item.className = 'player-item';
    if (!p.alive) item.classList.add('dead');
    if (p.isHuman) item.classList.add('is-you');
    if (game.currentSpeaker === i && p.alive) item.classList.add('active');

    const roleTag = p.isHuman ? getRoleLabel(p.role) : '???';
    const statusClass = p.alive ? 'alive' : 'dead';
    const statusText = p.alive ? '存活' : '出局';

    item.innerHTML = `
      <div class="player-avatar" style="background:var(--bg-tertiary);">${p.icon}</div>
      <div class="player-info">
        <div class="player-name">${p.name}${p.isHuman ? ' (你)' : ''}</div>
        <div class="player-role-tag">${roleTag}</div>
      </div>
      <span class="player-status ${statusClass}">${statusText}</span>
    `;
    list.appendChild(item);
  });
}

function getRoleLabel(role) {
  switch(role) {
    case 'detective': return '🔍 侦探';
    case 'murderer': return '凶手';
    case 'villager': return '嫌疑人';
    default: return '???';
  }
}

function getRoleIdentityClass(role) {
  switch(role) {
    case 'detective': return 'detective';
    case 'murderer': return 'murderer';
    default: return 'villager';
  }
}

function getRoleName(role) {
  switch(role) {
    case 'detective': return '侦探';
    case 'murderer': return '凶手';
    case 'villager': return '普通嫌疑人';
  }
}

function renderProgress() {
  const info = document.getElementById('progressInfo');
  const bar = document.getElementById('progressBar');
  const total = game.totalMines;
  const flagged = game.minesFlagged;
  const pct = Math.round((flagged / total) * 100);

  info.innerHTML = `
    已标记机关: <span style="color:var(--accent-gold);">${flagged}</span> / ${total}<br>
    已探查房间: <span style="color:var(--accent-blue);">${countRevealed()}</span> / ${game.rows * game.cols}<br>
    存活人数: <span style="color:var(--accent-green);">${game.players.filter(p=>p.alive).length}</span> / ${game.playerCount}
  `;
  bar.style.width = pct + '%';
}

function countRevealed() {
  let count = 0;
  for (let r = 0; r < game.rows; r++)
    for (let c = 0; c < game.cols; c++)
      if (game.revealed[r][c]) count++;
  return count;
}

function updatePhaseBadge() {
  const badge = document.getElementById('phaseBadge');
  const roundInfo = document.getElementById('roundInfo');
  roundInfo.textContent = `第 ${game.round} 回合`;

  switch(game.phase) {
    case 'discussion':
      badge.className = 'phase-badge discussion';
      badge.innerHTML = '<i class="fas fa-comments"></i> 讨论阶段';
      break;
    case 'voting':
      badge.className = 'phase-badge voting';
      badge.innerHTML = '<i class="fas fa-vote-yea"></i> 投票阶段';
      break;
    case 'investigation':
      badge.className = 'phase-badge investigation';
      badge.innerHTML = '<i class="fas fa-search"></i> 探查阶段';
      break;
    case 'accusation':
      badge.className = 'phase-badge result';
      badge.innerHTML = '<i class="fas fa-gavel"></i> 指控阶段';
      break;
  }
}

