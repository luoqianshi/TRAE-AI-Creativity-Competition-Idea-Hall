{
  "tools": {
    "maven": {
      "name": "Maven",
      "description": "Java 项目构建与依赖管理工具",
      "commands": [
        {
          "name": "清理并打包（跳过测试）",
          "template": "mvn clean package -DskipTests",
          "description": "清理 target 目录并重新打包，跳过单元测试",
          "params": [
            {
              "id": "extraOpts",
              "label": "额外参数",
              "type": "text",
              "placeholder": "如 -U -T 4 -P prod"
            }
          ]
        },
        {
          "name": "编译安装到本地仓库",
          "template": "mvn clean install",
          "description": "清理后编译并安装 jar 到本地 ~/.m2 仓库",
          "params": [
            {"id": "skipTests", "label": "跳过测试", "type": "switch", "flag": "-DskipTests"},
            {"id": "extraOpts", "label": "额外参数", "type": "text", "placeholder": "如 -U -T 4"}
          ]
        },
        {
          "name": "指定 Profile 构建",
          "template": "mvn clean package -P {profile}",
          "description": "使用指定的 Maven Profile 进行构建",
          "params": [
            {"id": "profile", "label": "Profile 名称", "type": "text", "placeholder": "如 dev / prod / staging", "required": true},
            {"id": "skipTests", "label": "跳过测试", "type": "switch", "flag": "-DskipTests"},
            {"id": "extraOpts", "label": "额外参数", "type": "text", "placeholder": "如 -U"}
          ]
        },
        {
          "name": "运行单个测试类",
          "template": "mvn test -Dtest={testClass}",
          "description": "单独运行指定的测试类",
          "params": [
            {"id": "testClass", "label": "测试类全限定名", "type": "text", "placeholder": "如 com.example.MyTest", "required": true}
          ]
        },
        {
          "name": "查看依赖树",
          "template": "mvn dependency:tree",
          "description": "打印项目的完整依赖树",
          "params": [
            {"id": "extraOpts", "label": "额外参数", "type": "text", "placeholder": "如 -Dincludes=com.example"}
          ]
        },
        {
          "name": "部署到远程仓库",
          "template": "mvn clean deploy",
          "description": "清理后打包并部署到配置的远程 Maven 仓库",
          "params": [
            {"id": "skipTests", "label": "跳过测试", "type": "switch", "flag": "-DskipTests"},
            {"id": "extraOpts", "label": "额外参数", "type": "text", "placeholder": "如 -U -P release"}
          ]
        }
      ]
    },
    "npm": {
      "name": "npm",
      "description": "Node.js 包管理器",
      "commands": [
        {
          "name": "初始化项目",
          "template": "npm init",
          "description": "交互式创建 package.json",
          "params": [
            {"id": "yesFlag", "label": "跳过交互，使用默认值", "type": "switch", "flag": "-y"}
          ]
        },
        {
          "name": "安装依赖",
          "template": "npm install {packages}",
          "description": "安装指定的 npm 包",
          "params": [
            {"id": "packages", "label": "包名（多个用空格分隔）", "type": "text", "placeholder": "如 lodash axios 或留空安装全部"},
            {"id": "saveDev", "label": "安装为开发依赖", "type": "switch", "flag": "--save-dev"},
            {"id": "global", "label": "全局安装", "type": "switch", "flag": "-g"}
          ]
        },
        {
          "name": "运行脚本",
          "template": "npm run {script}",
          "description": "运行 package.json 中定义的脚本",
          "params": [
            {"id": "script", "label": "脚本名", "type": "select", "options": ["start", "dev", "build", "test", "lint", "serve", "deploy"], "placeholder": "或输入自定义脚本名", "required": true}
          ]
        },
        {
          "name": "卸载依赖",
          "template": "npm uninstall {packages}",
          "description": "卸载指定的 npm 包",
          "params": [
            {"id": "packages", "label": "包名（多个用空格分隔）", "type": "text", "required": true, "placeholder": "如 lodash"},
            {"id": "saveDev", "label": "是开发依赖", "type": "switch", "flag": "--save-dev"},
            {"id": "global", "label": "全局卸载", "type": "switch", "flag": "-g"}
          ]
        },
        {
          "name": "更新依赖",
          "template": "npm update {packages}",
          "description": "更新指定的 npm 包到最新版本",
          "params": [
            {"id": "packages", "label": "包名（留空则更新全部）", "type": "text", "placeholder": "如 lodash"}
          ]
        },
        {
          "name": "发布包",
          "template": "npm publish",
          "description": "发布当前包到 npm registry",
          "params": [
            {"id": "tag", "label": "发布标签", "type": "text", "placeholder": "如 beta / next（默认 latest）"}
          ]
        },
        {
          "name": "列出全局已安装包",
          "template": "npm list -g --depth=0",
          "description": "列出全局安装的 npm 包（仅顶层）"
        }
      ]
    },
    "git": {
      "name": "Git",
      "description": "分布式版本控制系统",
      "commands": [
        {
          "name": "克隆仓库",
          "template": "git clone {url}",
          "description": "克隆远程仓库到本地",
          "params": [
            {"id": "url", "label": "仓库 URL", "type": "text", "required": true, "placeholder": "如 https://github.com/user/repo.git"},
            {"id": "branch", "label": "指定分支", "type": "text", "placeholder": "如 develop（默认 main/master）"},
            {"id": "depth", "label": "浅克隆深度", "type": "text", "placeholder": "如 1（仅最新一次提交）"}
          ]
        },
        {
          "name": "提交更改",
          "template": "git commit -m \"{message}\"",
          "description": "将暂存区的更改提交到本地仓库",
          "params": [
            {"id": "message", "label": "提交信息", "type": "text", "required": true, "placeholder": "如 fix: 修复登录页样式"},
            {"id": "amend", "label": "追加到上次提交", "type": "switch", "flag": "--amend"}
          ]
        },
        {
          "name": "创建并切换分支",
          "template": "git checkout -b {branch}",
          "description": "创建新分支并立即切换过去",
          "params": [
            {"id": "branch", "label": "分支名", "type": "text", "required": true, "placeholder": "如 feature/user-auth"}
          ]
        },
        {
          "name": "推送分支",
          "template": "git push origin {branch}",
          "description": "将本地分支推送到远程仓库",
          "params": [
            {"id": "branch", "label": "分支名", "type": "text", "placeholder": "留空推送当前分支"},
            {"id": "force", "label": "强制推送（⚠️ 危险）", "type": "switch", "flag": "--force"},
            {"id": "setUpstream", "label": "设置上游分支", "type": "switch", "flag": "-u"}
          ]
        },
        {
          "name": "拉取并变基",
          "template": "git pull --rebase origin {branch}",
          "description": "拉取远程分支并以 rebase 方式合并",
          "params": [
            {"id": "branch", "label": "分支名", "type": "text", "placeholder": "如 main（默认当前跟踪分支）"}
          ]
        },
        {
          "name": "合并分支",
          "template": "git merge {branch}",
          "description": "将指定分支合并到当前分支",
          "params": [
            {"id": "branch", "label": "要合并的分支", "type": "text", "required": true, "placeholder": "如 feature/payment"},
            {"id": "noFastForward", "label": "禁用快进合并（保留分支历史）", "type": "switch", "flag": "--no-ff"}
          ]
        },
        {
          "name": "查看状态",
          "template": "git status",
          "description": "查看工作区和暂存区状态",
          "params": [
            {"id": "short", "label": "简洁模式", "type": "switch", "flag": "-s"}
          ]
        },
        {
          "name": "暂存更改",
          "template": "git stash",
          "description": "暂存当前工作区更改，恢复干净的工作目录",
          "params": [
            {"id": "includeUntracked", "label": "包含未跟踪文件", "type": "switch", "flag": "-u"},
            {"id": "message", "label": "暂存说明", "type": "text", "placeholder": "如 WIP: 支付模块"}
          ]
        },
        {
          "name": "查看提交日志",
          "template": "git log",
          "description": "查看提交历史",
          "params": [
            {"id": "oneline", "label": "单行模式", "type": "switch", "flag": "--oneline"},
            {"id": "graph", "label": "图形化分支图", "type": "switch", "flag": "--graph"},
            {"id": "n", "label": "显示最近 N 条", "type": "text", "placeholder": "如 10"}
          ]
        },
        {
          "name": "初始化仓库",
          "template": "git init",
          "description": "在当前目录初始化 Git 仓库",
          "params": [
            {"id": "branch", "label": "初始分支名", "type": "text", "placeholder": "如 main（默认取决于 Git 配置）"}
          ]
        }
      ]
    }
  }
}
