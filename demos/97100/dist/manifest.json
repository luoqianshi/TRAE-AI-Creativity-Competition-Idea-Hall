{
  "manifest_version": 3,
  "name": "抖音助手",
  "version": "1.0.0",
  "description": "辅助刷抖音的浏览器扩展",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://live.douyin.com/*"
  ],
  "action": {
    "default_title": "打开抖音助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
