<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>一眼数清 - 极速数量识别挑战</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    background: #0a0a2e; color: #e0e0ff;
    overflow: hidden; height: 100vh; width: 100vw;
    user-select: none; -webkit-user-select: none;
    touch-action: manipulation;
  }
  #app { width: 100%; height: 100%; position: relative; }

  /* 开始界面 */
  #start-screen {
    position: absolute; inset: 0; z-index: 10;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
  }
  #start-screen .logo { font-size: 72px; margin-bottom: 8px; animation: pulse 2s ease-in-out infinite; }
  #start-screen h1 {
    font-size: 48px; font-weight: 900; margin-bottom: 6px;
    background: linear-gradient(135deg, #a29bfe, #00cec9, #fdcb6e);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  #start-screen .subtitle { color: #8888cc; font-size: 14px; letter-spacing: 2px; margin-bottom: 20px; }
  #start-screen .rules {
    color: #aaaadd; font-size: 13px; line-height: 1.8;
    max-width: 420px; margin-bottom: 28px; padding: 14px 18px;
    background: rgba(255,255,255,0.06); border-radius: 12px;
  }
  .btn-start {
    padding: 16px 48px; border-radius: 16px; border: none;
    background: linear-gradient(135deg, #6c5ce7, #a29bfe);
    color: #fff; font-size: 20px; font-weight: 700; cursor: pointer;
    transition: all 0.3s; box-shadow: 0 8px 32px rgba(108,92,231,0.4);
  }
  .btn-start:hover { transform: translateY(-3px); box-shadow: 0 12px 40px rgba(108,92,231,0.6); }
  .btn-start:active { transform: scale(0.96); }

  /* 游戏界面 */
  #game-screen { display: none; width: 100%; height: 100%; position: relative; }
  #top-bar {
    position: absolute; top: 10px; left: 12px; right: 12px;
    display: flex; align-items: center; gap: 8px; z-index: 10;
  }
  #top-bar .info {
    background: rgba(255,255,255,0.1); backdrop-filter: blur(8px);
    border-radius: 10px; padding: 6px 14px;
    font-size: 14px; font-weight: 600; white-space: nowrap;
  }
  #top-bar .info span { color: #fdcb6e; font-size: 17px; margin-left: 4px; }
  #time-bar-wrap {
    flex: 1; height: 8px; background: rgba(255,255,255,0.1);
    border-radius: 4px; overflow: hidden; margin-left: 6px;
  }
  #time-bar {
    height: 100%; width: 100%; border-radius: 3px;
    background: linear-gradient(90deg, #ff6b6b, #fdcb6e, #00cec9);
    transition: width 0.1s linear;
  }
  #prompt-text {
    position: absolute; top: 48px; left: 50%; transform: translateX(-50%);
    font-size: 16px; font-weight: 700; z-index: 5; pointer-events: none;
    text-shadow: 0 0 16px rgba(162,155,254,0.6); display: none; white-space: nowrap;
  }
  #game-canvas {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    z-index: 2; cursor: pointer;
  }

  /* 结果弹窗 */
  #overlay {
    display: none; position: fixed; inset: 0; z-index: 100;
    background: rgba(0,0,0,0.7); backdrop-filter: blur(8px);
    justify-content: center; align-items: center;
  }
  #result-card {
    background: linear-gradient(145deg, #1a1a4e, #0d0d35);
    border: 2px solid rgba(255,255,255,0.15);
    border-radius: 24px; padding: 32px 36px; text-align: center;
    max-width: 380px; width: 90%; animation: popIn 0.4s ease;
  }
  #result-card .result-title {
    font-size: 32px; font-weight: 900; margin-bottom: 12px;
    background: linear-gradient(135deg, #fdcb6e, #e17055);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  #result-card .stat-row {
    display: flex; justify-content: center; gap: 28px; margin: 16px 0 24px;
  }
  #result-card .stat-val { font-size: 28px; font-weight: 800; color: #a29bfe; }
  #result-card .stat-lbl { font-size: 11px; color: #888; margin-top: 2px; }
  .btn {
    padding: 12px 32px; border-radius: 12px; border: none;
    font-size: 16px; font-weight: 700; cursor: pointer; transition: all 0.3s;
  }
  .btn-primary { background: #6c5ce7; color: #fff; }
  .btn-primary:hover { background: #7d6ff0; transform: translateY(-2px); }

  @keyframes pulse { 0%,100%{transform:scale(1);} 50%{transform:scale(1.08);} }
  @keyframes popIn { from{opacity:0;transform:scale(0.8);} to{opacity:1;transform:scale(1);} }
  @keyframes shake { 0%,100%{transform:translateX(0);} 25%{transform:translateX(-8px);} 75%{transform:translateX(8px);} }

  @media (max-width: 600px) {
    #start-screen h1 { font-size: 32px; }
    #start-screen .logo { font-size: 48px; }
    .btn-start { padding: 12px 36px; font-size: 16px; }
    #top-bar .info { font-size: 11px; padding: 5px 10px; }
    #top-bar .info span { font-size: 14px; }
  }
</style>
</head>
<body>
<div id="app">
  <div id="start-screen">
    <div class="logo">🎯</div>
    <h1>一眼数清</h1>
    <p class="subtitle">COUNT &amp; CLICK FROM MOST TO LEAST</p>
    <div class="rules">
      屏幕上会出现多种 <b>不同颜色 + 不同形状</b> 的图形在漂浮。<br>
      你需要 <b>从多到少</b> 依次点击：<br>
      先点数量最多的那种 → 再点次多的 → 以此类推。<br>
      点对一组，整组消失；<b>点错即结束</b>！
    </div>
    <button class="btn-start" onclick="startGame()">开始挑战</button>
  </div>

  <div id="game-screen">
    <div id="top-bar">
      <div class="info">关卡<span id="level-num">1</span></div>
      <div class="info">得分<span id="score-num">0</span></div>
      <div class="info">连击<span id="combo-num">0</span></div>
      <div id="time-bar-wrap"><div id="time-bar"></div></div>
    </div>
    <div id="prompt-text">准备开始...</div>
    <canvas id="game-canvas"></canvas>
  </div>
</div>

<div id="overlay">
  <div id="result-card">
    <div class="result-title" id="result-title">游戏结束</div>
    <div id="result-msg" style="color:#aaaadd;font-size:14px;margin-bottom:8px;"></div>
    <div class="stat-row">
      <div><div class="stat-val" id="final-level">1</div><div class="stat-lbl">通过关卡</div></div>
      <div><div class="stat-val" id="final-score">0</div><div class="stat-lbl">最终得分</div></div>
      <div><div class="stat-val" id="final-combo">0</div><div class="stat-lbl">最高连击</div></div>
    </div>
    <button class="btn btn-primary" onclick="restart()">再来一局</button>
  </div>
</div>

<script>
// ====== 配置 ======
// 关卡曲线：每种数字代表一组的数量，从多到少
const LEVELS = [
  [5, 3, 2],       // 第1关：3种
  [6, 4, 2],       // 第2关：3种
  [6, 5, 3, 2],    // 第3关：4种
  [7, 5, 4, 3],    // 第4关：4种
  [7, 6, 4, 3, 2], // 第5关：5种
  [8, 6, 5, 4, 3], // 第6关：5种
  [8, 7, 5, 4, 3, 2], // 第7关：6种
];

// 颜色池（高对比度，按色相均匀间隔）
const COLORS = [
  '#ff6b6b', '#4ecdc4', '#ffe66d', '#a8e6cf', '#c9b1ff',
  '#ff9a76', '#6ec5e9', '#f88cc8', '#b5e855', '#ffa552',
];

// 形状池：圆、三角、方、五边、六边、星、菱
const SHAPES = ['circle', 'triangle', 'square', 'pentagon', 'hexagon', 'star', 'diamond'];

// ====== 状态 ======
const state = {
  level: 1, score: 0, combo: 0, maxCombo: 0,
  items: [], types: [], targetOrder: [], targetIdx: 0,
  countdownTotal: 0, countdownRemain: 0,
  phase: 'idle', gameOver: false,
  canvasW: 0, canvasH: 0,
  countdownTimer: null, animTimer: null,
};

const canvas = document.getElementById('game-canvas');
const ctx = canvas.getContext('2d');

// ====== 初始化 ======
function resizeCanvas() {
  const dpr = window.devicePixelRatio || 1;
  state.canvasW = window.innerWidth;
  state.canvasH = window.innerHeight;
  canvas.width = state.canvasW * dpr;
  canvas.height = state.canvasH * dpr;
  canvas.style.width = state.canvasW + 'px';
  canvas.style.height = state.canvasH + 'px';
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

canvas.addEventListener('click', (e) => {
  const rect = canvas.getBoundingClientRect();
  handleClick(e.clientX - rect.left, e.clientY - rect.top);
});
canvas.addEventListener('touchstart', (e) => {
  e.preventDefault();
  const rect = canvas.getBoundingClientRect();
  const t = e.touches[0];
  handleClick(t.clientX - rect.left, t.clientY - rect.top);
}, { passive: false });

// ====== 游戏流程 ======
function startGame() {
  state.level = 1; state.score = 0; state.combo = 0; state.maxCombo = 0;
  state.gameOver = false;
  document.getElementById('start-screen').style.display = 'none';
  document.getElementById('game-screen').style.display = 'block';
  startLevel();
}

function restart() {
  document.getElementById('overlay').style.display = 'none';
  startGame();
}

function startLevel() {
  const lvlIdx = Math.min(state.level - 1, LEVELS.length - 1);
  const counts = [...LEVELS[lvlIdx]];
  const numTypes = counts.length;

  // 选颜色：按色相均匀间隔
  const colors = pickContrastColors(numTypes, COLORS);

  // 创建类型：每个类型分配不同颜色+不同形状
  state.types = colors.map((c, i) => ({
    id: i, color: c, count: counts[i],
    shape: SHAPES[i % SHAPES.length],
  }));

  // 目标顺序：从多到少
  state.targetOrder = state.types.slice().sort((a, b) => b.count - a.count).map(t => t.id);
  state.targetIdx = 0;

  // 生成元素
  state.items = [];
  let itemId = 0;
  const minDim = Math.min(state.canvasW, state.canvasH);
  const r = Math.max(28, Math.min(60, minDim * 0.07));
  for (let t of state.types) {
    for (let i = 0; i < t.count; i++) {
      state.items.push({
        id: itemId++,
        typeId: t.id,
        x: r + Math.random() * (state.canvasW - 2 * r),
        y: r + 80 + Math.random() * (state.canvasH - 2 * r - 80),
        r: r,
        vx: (Math.random() - 0.5) * 0.6,
        vy: (Math.random() - 0.5) * 0.6,
        rot: Math.random() * Math.PI * 2,
        rotSpd: (Math.random() - 0.5) * 0.01,
        removed: false,
        wrong: false,
      });
    }
  }

  // 时间：基础 + 每元素
  const totalItems = state.items.length;
  state.countdownTotal = (3 + totalItems * 0.5) * 1000;
  state.countdownRemain = state.countdownTotal;

  updateUI();
  startCountdown();
  startAnim();
}

function pickContrastColors(n, pool) {
  if (n >= pool.length) return pool.slice();
  const step = pool.length / n;
  const result = [];
  for (let i = 0; i < n; i++) result.push(pool[Math.floor(i * step)]);
  return result;
}

function startCountdown() {
  if (state.countdownTimer) clearInterval(state.countdownTimer);
  state.phase = 'playing';
  document.getElementById('prompt-text').style.display = 'none';
  state.countdownTimer = setInterval(() => {
    state.countdownRemain -= 50;
    updateTimer();
    if (state.countdownRemain <= 0) {
      state.countdownRemain = 0;
      clearInterval(state.countdownTimer);
      if (!state.gameOver) {
        state.gameOver = true;
        failGame('⏰ 时间到！');
      }
    }
  }, 50);
}

function startAnim() {
  if (state.animTimer) cancelAnimationFrame(state.animTimer);
  const loop = () => {
    updatePositions();
    drawGame();
    state.animTimer = requestAnimationFrame(loop);
  };
  loop();
}

function updatePositions() {
  for (let it of state.items) {
    if (it.removed) continue;
    it.x += it.vx;
    it.y += it.vy;
    it.rot += it.rotSpd;
    // 边界反弹
    if (it.x < it.r) { it.x = it.r; it.vx = -it.vx; }
    if (it.x > state.canvasW - it.r) { it.x = state.canvasW - it.r; it.vx = -it.vx; }
    if (it.y < it.r + 70) { it.y = it.r + 70; it.vy = -it.vy; }
    if (it.y > state.canvasH - it.r) { it.y = state.canvasH - it.r; it.vy = -it.vy; }
  }
}

function drawGame() {
  ctx.clearRect(0, 0, state.canvasW, state.canvasH);
  const currentTarget = state.targetOrder[state.targetIdx];
  for (let it of state.items) {
    if (it.removed) continue;
    const t = state.types[it.typeId];
    const color = it.wrong ? '#ff6b6b' : t.color;
    drawShape(ctx, t.shape, it.x, it.y, it.r, color, it.rot);
  }
}

// 根据形状类型绘制不同图形
function drawShape(c, shape, x, y, r, color, rot) {
  c.save();
  c.translate(x, y);
  c.rotate(rot);
  c.shadowColor = color;
  c.shadowBlur = 14;
  c.strokeStyle = color;
  c.lineWidth = 3;
  c.fillStyle = 'rgba(255,255,255,0.08)';

  // 构建路径
  c.beginPath();
  switch (shape) {
    case 'circle':
      c.arc(0, 0, r, 0, Math.PI * 2);
      break;
    case 'triangle':
      polygonPath(c, 3, r, -Math.PI / 2);
      break;
    case 'square':
      polygonPath(c, 4, r, -Math.PI / 4);
      break;
    case 'pentagon':
      polygonPath(c, 5, r, -Math.PI / 2);
      break;
    case 'hexagon':
      polygonPath(c, 6, r, 0);
      break;
    case 'diamond':
      polygonPath(c, 4, r, 0);
      break;
    case 'star':
      starPath(c, 5, r, r * 0.45);
      break;
    default:
      c.arc(0, 0, r, 0, Math.PI * 2);
  }
  c.closePath();
  c.fill();
  c.stroke();

  // 内部装饰小圆点
  c.shadowBlur = 0;
  c.fillStyle = color;
  c.beginPath();
  c.arc(0, 0, r * 0.2, 0, Math.PI * 2);
  c.fill();
  c.restore();
}

// 正多边形路径
function polygonPath(c, sides, r, startAngle) {
  for (let i = 0; i < sides; i++) {
    const a = startAngle + (i / sides) * Math.PI * 2;
    const px = Math.cos(a) * r;
    const py = Math.sin(a) * r;
    if (i === 0) c.moveTo(px, py);
    else c.lineTo(px, py);
  }
}

// 星形路径
function starPath(c, points, outerR, innerR) {
  for (let i = 0; i < points * 2; i++) {
    const radius = i % 2 === 0 ? outerR : innerR;
    const a = -Math.PI / 2 + (i / (points * 2)) * Math.PI * 2;
    const px = Math.cos(a) * radius;
    const py = Math.sin(a) * radius;
    if (i === 0) c.moveTo(px, py);
    else c.lineTo(px, py);
  }
}

function findItemAt(cx, cy) {
  for (let it of state.items) {
    if (it.removed) continue;
    const dx = it.x - cx, dy = it.y - cy;
    if (dx * dx + dy * dy <= it.r * it.r) return it;
  }
  return null;
}

function handleClick(cx, cy) {
  if (state.phase !== 'playing' || state.gameOver) return;
  const item = findItemAt(cx, cy);
  if (!item) return;

  const currentTarget = state.targetOrder[state.targetIdx];
  if (item.typeId === currentTarget) {
    // 点对：整组消失
    soundCorrect();
    state.combo++;
    state.maxCombo = Math.max(state.maxCombo, state.combo);
    state.score += 100 * state.combo;
    // 加一点时间
    state.countdownRemain += 1500;
    // 移除整组
    for (let it of state.items) {
      if (it.typeId === currentTarget && !it.removed) it.removed = true;
    }
    state.targetIdx++;
    updateUI();

    // 检查是否过关
    if (state.targetIdx >= state.targetOrder.length) {
      // 过关
      clearInterval(state.countdownTimer);
      state.phase = 'transition';
      const prompt = document.getElementById('prompt-text');
      prompt.textContent = `✅ 第 ${state.level} 关通过！`;
      prompt.style.display = 'block';
      setTimeout(() => {
        state.level++;
        startLevel();
      }, 1200);
    }
  } else {
    // 点错
    soundWrong();
    item.wrong = true;
    state.combo = 0;
    state.gameOver = true;
    clearInterval(state.countdownTimer);
    document.getElementById('game-screen').style.animation = 'shake 0.5s ease';
    setTimeout(() => document.getElementById('game-screen').style.animation = '', 500);
    failGame('❌ 顺序错了！');
  }
}

function failGame(msg) {
  state.phase = 'gameover';
  setTimeout(() => showResult(msg), 800);
}

function showResult(msg) {
  document.getElementById('result-title').textContent = msg.includes('时间') ? '时间到！' : '点错了！';
  document.getElementById('result-msg').textContent = msg;
  document.getElementById('final-level').textContent = state.level - 1;
  document.getElementById('final-score').textContent = state.score;
  document.getElementById('final-combo').textContent = state.maxCombo;
  document.getElementById('overlay').style.display = 'flex';
}

function updateUI() {
  document.getElementById('level-num').textContent = state.level;
  document.getElementById('score-num').textContent = state.score;
  document.getElementById('combo-num').textContent = state.combo;
}

function updateTimer() {
  const pct = state.countdownTotal > 0 ? (state.countdownRemain / state.countdownTotal) * 100 : 0;
  const bar = document.getElementById('time-bar');
  bar.style.width = Math.max(0, Math.min(100, pct)) + '%';
}

// ====== 简单音效 ======
let audioCtx = null;
function getAudio() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  return audioCtx;
}
function beep(freq, dur, type = 'sine', vol = 0.15) {
  try {
    const ac = getAudio();
    const osc = ac.createOscillator();
    const gain = ac.createGain();
    osc.connect(gain); gain.connect(ac.destination);
    osc.type = type; osc.frequency.value = freq;
    gain.gain.setValueAtTime(vol, ac.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + dur);
    osc.start(); osc.stop(ac.currentTime + dur);
  } catch {}
}
function soundCorrect() { beep(660, 0.15); setTimeout(() => beep(880, 0.2), 80); }
function soundWrong() { beep(200, 0.3, 'sawtooth', 0.2); }
</script>
</body>
</html>
