PROJECT_NAME=My App Backend
APP_ENV=local
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
DEV_AUTH_BYPASS=false
DEV_AUTH_USERNAME=dev
DEV_AUTH_PHONE=13900000000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=12345678
MYSQL_DATABASE=my_app
DATABASE_URL=
SQLITE_DB_FILENAME=my_app.sqlite3

SECRET_KEY=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

ALIYUN_DYPNS_ACCESS_KEY_ID=
ALIYUN_DYPNS_ACCESS_KEY_SECRET=
ALIYUN_DYPNS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_REGISTER_LOGIN=100001
ALIYUN_SMS_TEMPLATE_CHANGE_PHONE=100002
ALIYUN_SMS_TEMPLATE_RESET_PASSWORD=100003
ALIYUN_SMS_TEMPLATE_BIND_NEW_PHONE=100004
ALIYUN_SMS_TEMPLATE_VERIFY_BIND_PHONE=100005
ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}
ALIYUN_SMS_CODE_LENGTH=6
ALIYUN_SMS_VALID_TIME=300
ALIYUN_SMS_INTERVAL=60
ALIYUN_SMS_CODE_TYPE=1
SMS_DEBUG_FALLBACK=false

CORS_ORIGINS=["*"]
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=[".jpg",".jpeg",".png",".gif",".webp",".pdf",".doc",".docx"]
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_COMPLETIONS_PATH=/chat/completions
ARK_IMAGE_GENERATIONS_PATH=/images/generations
ARK_VIDEO_GENERATION_TASKS_PATH=/contents/generations/tasks
ARK_API_KEY=
ARK_MODEL=doubao-seed-1-8-251228
ARK_IMAGE_MODEL=doubao-seedream-5-0-lite-260128
ARK_VIDEO_MODEL=doubao-seedance-2-0-fast-260128
ARK_TIMEOUT_SECONDS=45
ARK_DISABLE_THINKING=true
