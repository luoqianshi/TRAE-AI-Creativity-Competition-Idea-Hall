.page {
  min-height: 100vh;
  background: #f5f0e8;
  position: relative;
  overflow: hidden;
}

.page::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse 120% 60% at 50% 0%, rgba(180,165,140,0.12) 0%, transparent 70%),
    repeating-linear-gradient(135deg, transparent, transparent 3px, rgba(160,145,120,0.03) 3px, rgba(160,145,120,0.03) 4px);
  pointer-events: none;
  z-index: 0;
}

.hero-section {
  position: relative;
  height: 400rpx;
  overflow: hidden;
  z-index: 1;
}

.hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(
    180deg,
    #dcd8cf 0%,
    #e4dfd5 25%,
    #ebe6db 50%,
    #f2ede2 80%,
    #f5f0e8 100%
  );
}

.mountain {
  position: absolute;
  bottom: 0;
  border-radius: 50% 50% 0 0 / 40% 40% 0 0;
}

.mountain-far {
  left: -15%;
  width: 90%;
  height: 180rpx;
  background: linear-gradient(180deg, transparent 30%, rgba(130,125,115,0.10) 70%, rgba(130,125,115,0.16) 100%);
  transform: skewX(-6deg);
  filter: blur(3rpx);
}

.mountain-mid {
  left: 20%;
  width: 85%;
  height: 220rpx;
  background: linear-gradient(180deg, transparent 35%, rgba(110,105,95,0.13) 75%, rgba(110,105,95,0.20) 100%);
  transform: skewX(7deg);
  filter: blur(2rpx);
}

.mountain-near {
  right: -20%;
  width: 80%;
  height: 180rpx;
  background: linear-gradient(180deg, transparent 40%, rgba(85,80,72,0.14) 80%, rgba(85,80,72,0.22) 100%);
  transform: skewX(-4deg);
  filter: blur(1rpx);
}

.cloud {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(150,140,125,0.20), transparent 70%);
}

.cloud-left {
  width: 160rpx; height: 50rpx;
  top: 60rpx; left: 40rpx;
  opacity: 0.5;
}

.cloud-right {
  width: 120rpx; height: 40rpx;
  top: 100rpx; right: 60rpx;
  opacity: 0.35;
}

.hero-content {
  position: relative;
  z-index: 2;
  padding: 100rpx 32rpx 0;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2c2a26;
  letter-spacing: 4rpx;
}

.hero-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(58,52,44,0.5);
  margin-top: 8rpx;
}

.records-card {
  margin: -40rpx 32rpx 24rpx;
  background: rgba(255,252,245,0.88);
  backdrop-filter: blur(16rpx);
  border-radius: 20rpx;
  position: relative;
  z-index: 3;
  border: 1rpx solid rgba(160,148,125,0.25);
  box-shadow:
    inset 0 1rpx 4rpx rgba(140,128,110,0.06),
    0 8rpx 36rpx rgba(100,92,78,0.08);
}

.records-card::before {
  content: '';
  position: absolute;
  top: -1rpx; left: 50%; transform: translateX(-50%);
  width: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, rgba(160,140,110,0.35), transparent);
  border-radius: 0 0 4rpx 4rpx;
}

.records-list {
  padding: 16rpx 0;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx;
  border-bottom: 1rpx solid rgba(170,158,135,0.1);
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  flex: 1;
  overflow: hidden;
}

.record-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.record-name {
  font-size: 28rpx;
  color: #3a342c;
  font-weight: 600;
}

.record-gender {
  font-size: 20rpx;
  color: rgba(200,160,80,0.7);
  padding: 2rpx 10rpx;
  border: 1rpx solid rgba(200,160,80,0.3);
  border-radius: 6rpx;
}

.record-date {
  font-size: 24rpx;
  color: rgba(58,52,44,0.55);
  display: block;
  margin-bottom: 6rpx;
}

.record-bazi {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.record-bazi-text {
  font-size: 26rpx;
  color: #5a5248;
  letter-spacing: 2rpx;
}

.record-rizhu {
  font-size: 22rpx;
  color: rgba(200,160,80,0.6);
}

.record-save-time {
  font-size: 20rpx;
  color: rgba(58,52,44,0.35);
}

.record-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.record-fortune {
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(106,154,120,0.3);
  border-radius: 8rpx;
  background: rgba(106,154,120,0.06);
}

.fortune-text {
  font-size: 24rpx;
  color: #6a9a78;
}

.record-delete {
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(180,80,80,0.25);
  border-radius: 8rpx;
}

.delete-text {
  font-size: 24rpx;
  color: rgba(180,80,80,0.6);
}

.records-empty {
  padding: 80rpx 36rpx;
  text-align: center;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: rgba(58,52,44,0.45);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: rgba(58,52,44,0.35);
}

.disclaimer-section {
  margin: 40rpx 32rpx;
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(180,140,100,0.25);
  background: rgba(180,140,100,0.06);
  text-align: center;
}

.disclaimer-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(180,140,100,0.7);
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.disclaimer-text {
  font-size: 20rpx;
  color: rgba(180,140,100,0.55);
  line-height: 1.7;
  letter-spacing: 1rpx;
}
