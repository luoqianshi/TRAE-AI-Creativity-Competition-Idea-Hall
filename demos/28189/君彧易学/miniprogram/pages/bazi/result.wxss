/* ================================================================
   智能古籍参考
   ================================================================ */
.guji-card {
  background: #fff;
  margin: 0 20rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  overflow: hidden;
  padding: 24rpx 28rpx 20rpx;
}

/* Tab 横向滚动 */
.guji-tab-scroll {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.guji-tab-list {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.guji-tab-item {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  border: 1.5rpx solid #e8e0d0;
  background: #faf9f6;
  transition: all 0.2s ease;
}

.guji-tab-item.active {
  background: linear-gradient(135deg, #c8a050, #b08d40);
  border-color: #c8a050;
}

.guji-tab-text {
  font-size: 24rpx;
  color: #777;
  white-space: nowrap;
  letter-spacing: 1rpx;
}

.guji-tab-item.active .guji-tab-text {
  color: #fff;
  font-weight: 500;
}

/* 调候用神提示行 */
.guji-tiaohou-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  background: #faf9f6;
  border-radius: 10rpx;
  gap: 10rpx;
}

.guji-tiaohou-label {
  font-size: 23rpx;
  color: #999;
  flex-shrink: 0;
}

.guji-tiaohou-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.guji-benbazi-info {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-left: auto;
  flex-shrink: 0;
}

.guji-benbazi-label {
  font-size: 22rpx;
  color: #bbb;
}

.guji-benbazi-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.tag-tou {
  background: rgba(200,160,80,0.15);
  color: #a07830;
  border: 1rpx solid rgba(200,160,80,0.35);
}

.tag-cang {
  background: rgba(150,140,120,0.12);
  color: #888;
  border: 1rpx solid rgba(150,140,120,0.25);
}

.guji-info-icon {
  font-size: 22rpx;
  color: #bbb;
  margin-left: 4rpx;
}

/* 论断内容区 */
.guji-content {
  margin-top: 16rpx;
}

.guji-section {
  border-bottom: 1rpx solid #f3f0eb;
}

.guji-section:last-child {
  border-bottom: none;
}

.guji-section-header {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  gap: 12rpx;
}

.guji-section-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #c8a050, #b08d40);
  font-size: 20rpx;
  color: #fff;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.guji-section-title {
  flex: 1;
  font-size: 27rpx;
  color: #2c2c2c;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.guji-section-arrow {
  font-size: 24rpx;
  color: #bbb;
  transition: transform 0.25s ease;
  flex-shrink: 0;
}

.guji-section-arrow.arrow-up {
  transform: rotate(90deg);
}

.guji-section-body {
  padding: 0 0 16rpx 0;
  animation: sectionFadeIn 0.25s ease;
}

@keyframes sectionFadeIn {
  from { opacity: 0; max-height: 0; }
  to { opacity: 1; max-height: 2000rpx; }
}

.guji-para {
  margin-bottom: 14rpx;
  line-height: 1.75;
}

.guji-para:last-child {
  margin-bottom: 0;
}

.guji-para-text {
  font-size: 25rpx;
  color: #555;
  text-align: justify;
  letter-spacing: 0.5rpx;
}

/* 空数据 */
.guji-empty {
  padding: 40rpx 0;
  text-align: center;
}

.guji-empty-text {
  font-size: 26rpx;
  color: #ccc;
}

/* ================================================================
   分享解锁卡 · 墨韵金章
   ================================================================ */
.unlock-area {
  margin: 0 20rpx 8rpx;
}

.unlock-card {
  position: relative;
  background: linear-gradient(175deg, #1e1c19 0%, #161412 40%, #1a1816 100%);
  border-radius: 20rpx;
  padding: 36rpx 32rpx 28rpx;
  overflow: hidden;
  box-shadow:
    0 8rpx 40rpx rgba(0,0,0,0.45),
    0 0 1rpx rgba(200,160,80,0.18),
    inset 0 1rpx 0 rgba(200,160,80,0.06);
  border: 1rpx solid rgba(200,160,80,0.08);
}

/* 暗纹背景 */
.unlock-card::before {
  content: '';
  position: absolute;
  top: -40%;
  left: -20%;
  width: 140%;
  height: 180%;
  background: radial-gradient(ellipse at 30% 20%, rgba(200,160,80,0.03) 0%, transparent 60%),
              radial-gradient(ellipse at 70% 80%, rgba(200,160,80,0.02) 0%, transparent 50%);
  pointer-events: none;
}

/* 顶饰 */
.unlock-ornament-top {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.unlock-gold-line {
  width: 80%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(200,160,80,0.28), transparent);
}

.unlock-diamond-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.unlock-diamond-sm {
  width: 10rpx;
  height: 10rpx;
  background: rgba(200,160,80,0.4);
  transform: rotate(45deg);
  flex-shrink: 0;
}

.unlock-ornament-text {
  font-size: 22rpx;
  color: rgba(200,160,80,0.5);
  letter-spacing: 10rpx;
}

/* 主文案 */
.unlock-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.unlock-title {
  font-size: 34rpx;
  color: #d4c5a0;
  font-weight: 600;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 12rpx rgba(200,160,80,0.15);
}

.unlock-title-sub {
  font-size: 26rpx;
  color: rgba(180,155,110,0.7);
  letter-spacing: 4rpx;
  margin-top: 10rpx;
}

.unlock-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 0;
  width: 70%;
}

.unlock-divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(200,160,80,0.2), transparent);
}

.unlock-divider-dot {
  font-size: 20rpx;
  color: rgba(200,160,80,0.35);
  flex-shrink: 0;
}

.unlock-desc {
  font-size: 24rpx;
  color: rgba(190,175,145,0.5);
  letter-spacing: 2rpx;
}

.unlock-desc-sub {
  font-size: 20rpx;
  color: rgba(190,175,145,0.3);
  letter-spacing: 1rpx;
  margin-top: 8rpx;
}

/* 分享按钮 */
.unlock-share-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #c8a050, #a08040);
  border: none;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  box-shadow:
    0 6rpx 24rpx rgba(200,160,80,0.35),
    0 0 40rpx rgba(200,160,80,0.08);
  transition: all 0.2s ease;
}

.unlock-share-btn::after {
  border: none;
}

.unlock-share-btn:active {
  transform: scale(0.97);
  box-shadow: 0 3rpx 12rpx rgba(200,160,80,0.25);
}

.unlock-share-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.unlock-share-icon {
  font-size: 32rpx;
  color: #1e1c19;
}

.unlock-share-text {
  font-size: 28rpx;
  color: #1e1c19;
  font-weight: 600;
  letter-spacing: 6rpx;
}

/* 底纹 */
.unlock-footer {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
  position: relative;
  z-index: 1;
}

.unlock-footer-text {
  font-size: 20rpx;
  color: rgba(200,160,80,0.2);
  letter-spacing: 4rpx;
}

/* ================================================================
   底部按钮
   ================================================================ */
.bottom-bar {
  padding: 24rpx 20rpx 40rpx;
  display: flex;
  gap: 20rpx;
}

.btn-back {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #2c2c2c, #3d3d3d);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.12);
}

.btn-exclusive {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #c8a050, #b8903a);
  color: #1a1a2e;
  border: none;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(200,160,80,0.25);
}

.btn-back::after { border: none; }
.btn-exclusive::after { border: none; }

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 30rpx;
}

/* ================================================================
   五行知识弹窗（高级暗金质感）
   ================================================================ */
.wx-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.wx-overlay-card {
  width: 600rpx;
  background: linear-gradient(165deg, #1e1b18 0%, #161412 50%, #1a1815 100%);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow:
    0 24rpx 80rpx rgba(0, 0, 0, 0.7),
    0 0 2rpx rgba(200, 160, 80, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  animation: wxOverlayRise 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes wxOverlayRise {
  from { opacity: 0; transform: scale(0.9) translateY(40rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.wx-overlay-header {
  padding: 32rpx 36rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.wx-overlay-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 48rpx;
  right: 48rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(200,160,80,0.25), transparent);
}

.wx-overlay-title {
  font-size: 30rpx;
  color: #d4b87a;
  font-weight: 500;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(200, 160, 80, 0.15);
}

.wx-overlay-body {
  padding: 20rpx 36rpx 16rpx;
}

/* 占比行 */
.wx-overlay-ratio-row {
  align-items: flex-start !important;
  padding-bottom: 20rpx !important;
  margin-bottom: 8rpx !important;
  border-bottom: none !important;
}

.wx-overlay-ratio-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.wx-overlay-ratio-bar-track {
  height: 10rpx;
  background: rgba(200, 160, 80, 0.08);
  border-radius: 5rpx;
  overflow: hidden;
}

.wx-overlay-ratio-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #9a7b4f, #c8a060, #dfc07a) !important;
  transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  min-width: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(200, 160, 80, 0.25);
}

.wx-overlay-ratio-text {
  font-size: 22rpx;
  color: #666;
  letter-spacing: 1rpx;
}

.wx-overlay-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(200, 160, 80, 0.05);
  transition: background 0.15s ease;
}

.wx-overlay-row:last-of-type {
  border-bottom: none;
}

.wx-overlay-label {
  width: 96rpx;
  font-size: 23rpx;
  color: #5a5550;
  flex-shrink: 0;
  letter-spacing: 2rpx;
}

.wx-overlay-value {
  font-size: 25rpx;
  color: #cfc4ae;
  font-weight: 400;
  letter-spacing: 2rpx;
}

.wx-overlay-desc {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(200,160,80,0.06), rgba(200,160,80,0.02));
  border-radius: 16rpx;
  border-left: 3rpx solid rgba(200, 160, 80, 0.35);
}

.wx-overlay-desc-text {
  font-size: 23rpx;
  color: #8a8278;
  line-height: 1.85;
  letter-spacing: 1rpx;
}

.wx-overlay-close {
  margin: 24rpx 36rpx 32rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(200,160,80,0.08), rgba(200,160,80,0.03));
  border: 1rpx solid rgba(200, 160, 80, 0.12);
  border-radius: 38rpx;
  transition: all 0.25s ease;
}
.wx-overlay-close:active {
  transform: scale(0.97);
  background: rgba(200, 160, 80, 0.14);
}

.wx-overlay-close-text {
  font-size: 26rpx;
  color: #a89368;
  font-weight: 400;
  letter-spacing: 6rpx;
}
