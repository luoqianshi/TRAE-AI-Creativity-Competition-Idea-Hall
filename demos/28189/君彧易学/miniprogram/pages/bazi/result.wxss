/* 八字排盘 - 结果页样式（问真八字专业风格） */

/* ========== 基础 ========== */
.page {
  min-height: 100vh;
  background: #f5f2ec;
  padding-bottom: 40rpx;
}

/* ========== 加载/错误 ========== */
.loading-area, .error-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(200, 160, 80, 0.15);
  border-top-color: #c8a050;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #b8a080;
  font-size: 28rpx;
  margin-top: 24rpx;
  letter-spacing: 4rpx;
}

.error-icon {
  font-size: 80rpx;
  color: #d4a4a4;
  margin-bottom: 20rpx;
}

.error-text {
  color: #c0392b;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.retry-btn {
  background: rgba(200, 160, 80, 0.12);
  color: #c8a050;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
}

/* ================================================================
   顶部标题区
   ================================================================ */
.header-section {
  position: relative;
  margin: 20rpx;
  padding: 36rpx 28rpx;
  background: linear-gradient(160deg, #2c2c2c 0%, #3a3835 100%);
  border-radius: 20rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  opacity: 0.04;
  pointer-events: none;
}

.header-ornament-left {
  position: absolute;
  left: -40rpx;
  top: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border: 2rpx solid rgba(255,255,255,0.3);
  border-radius: 50%;
}

.header-ornament-right {
  position: absolute;
  right: -30rpx;
  bottom: -40rpx;
  width: 160rpx;
  height: 160rpx;
  border: 2rpx solid rgba(255,255,255,0.25);
  border-radius: 50%;
}

.header-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  position: relative;
  z-index: 1;
}

.header-name {
  font-size: 40rpx;
  color: #f5ecd7;
  font-weight: 600;
  letter-spacing: 6rpx;
}

.header-gender {
  font-size: 26rpx;
  color: #c8a050;
  padding: 4rpx 16rpx;
  border: 1rpx solid rgba(200,160,80,0.5);
  border-radius: 20rpx;
  letter-spacing: 2rpx;
}

.header-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
}

.header-date, .header-time {
  font-size: 26rpx;
  color: rgba(245,236,215,0.7);
}

.header-divider {
  color: rgba(245,236,215,0.3);
}

.header-lunar {
  margin-top: 14rpx;
  position: relative;
  z-index: 1;
}

.header-lunar-text {
  font-size: 30rpx;
  color: #c8a050;
  letter-spacing: 4rpx;
  font-weight: 500;
}

.header-solar-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
}

.solar-dot {
  font-size: 22rpx;
  color: #c8a050;
}

.solar-label {
  font-size: 22rpx;
  color: rgba(245,236,215,0.5);
}

/* ================================================================
   通用卡片样式
   ================================================================ */
.bazi-card, .rizhu-card, .wuxing-card, .shensha-card, .dayun-card, .liunian-card {
  background: #fff;
  margin: 0 20rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.card-title-row {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 0;
  gap: 10rpx;
}

.card-title-dot {
  width: 8rpx;
  height: 8rpx;
  background: #c8a050;
  border-radius: 50%;
  flex-shrink: 0;
}

.card-title {
  font-size: 30rpx;
  color: #2c2c2c;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.card-subtitle {
  font-size: 22rpx;
  color: #bbb;
  margin-left: auto;
}

/* ================================================================
   四柱表格
   ================================================================ */
.bazi-table {
  padding: 20rpx 0 0;
}

.table-row {
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid #f3f0eb;
}

.table-row:last-child {
  border-bottom: none;
}

.table-header {
  background: #faf9f6;
  border-bottom: 2rpx solid #ece5d8;
}

.table-cell {
  flex: 1;
  padding: 16rpx 6rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  border-right: 1rpx solid #ece5d8;
  overflow: hidden;
}

.table-cell:last-child {
  border-right: none;
}

.col-time {
  flex: 0 0 96rpx;
  background: #faf9f6;
  border-right: 1rpx solid #f3f0eb;
  justify-content: center;
}

/* 列标题 */
.col-title {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.day-col .col-title {
  color: #c8a050;
  font-weight: 600;
}

/* 行标签 */
.row-label {
  font-size: 22rpx;
  color: #bbb;
  letter-spacing: 1rpx;
}

/* 十神 */
.shishen-text {
  font-size: 24rpx;
  color: #555;
}

/* 天干 - 大字核心 */
.row-gan .table-cell {
  padding: 8rpx 6rpx;
}

.gan-text {
  font-size: 52rpx;
  font-weight: bold;
  line-height: 1.1;
}

/* 地支 - 大字核心 */
.row-zhi .table-cell {
  padding: 4rpx 6rpx 12rpx;
}

.zhi-text {
  font-size: 52rpx;
  font-weight: bold;
  line-height: 1.1;
}

.zhi-text.kongwang {
  text-decoration: underline;
  text-underline-offset: 8rpx;
  text-decoration-color: #d4a4a4;
}

/* 藏干 */
.row-canggan .table-cell {
  padding: 6rpx 4rpx;
}

.canggan-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.canggan-item {
  font-size: 22rpx;
  font-weight: 500;
}

.canggan-shishen {
  font-size: 18rpx;
  color: #bbb;
}

/* 纳音 */
.nayin-text {
  font-size: 20rpx;
  color: #888;
}

/* ================================================================
   日主分析卡
   ================================================================ */
.rizhu-card {
  padding: 28rpx;
}

.rizhu-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.rizhu-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rizhu-gan {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
}

.rizhu-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.rizhu-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

.rizhu-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.rizhu-details {
  display: flex;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f0eb;
}

.rizhu-detail-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.detail-label {
  font-size: 20rpx;
  color: #bbb;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.detail-value.good {
  color: #2d8c3f;
}

.detail-value.neutral {
  color: #999;
}

/* ================================================================
   五行力量 - 条形图
   ================================================================ */
.wuxing-card {
  padding: 28rpx;
}

.wx-bars-box {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.wx-bar-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 6rpx 10rpx;
  border-radius: 12rpx;
  transition: all 0.15s ease;
}

.wx-bar-item:active {
  background: rgba(0, 0, 0, 0.04);
  transform: scale(0.98);
}

.wx-bar-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.wx-bar-dot.wx-mu { background: #52b788; }
.wx-bar-dot.wx-huo { background: #e03a3a; }
.wx-bar-dot.wx-tu { background: #c8a050; }
.wx-bar-dot.wx-jin { background: #e8c560; }
.wx-bar-dot.wx-shui { background: #1a6eb5; }

.wx-bar-name {
  width: 36rpx;
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  text-align: center;
  flex-shrink: 0;
}

.wx-bar-track {
  flex: 1;
  height: 22rpx;
  background: #f3f0eb;
  border-radius: 11rpx;
  overflow: hidden;
}

.wx-bar-fill {
  height: 100%;
  border-radius: 11rpx;
  transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  min-width: 4rpx;
}

.wx-mu { background: #52b788; }
.wx-huo { background: #e03a3a; }
.wx-tu { background: #c8a050; }
.wx-jin { background: #e8c560; }
.wx-shui { background: #1a6eb5; }

.wx-bar-count {
  width: 48rpx;
  font-size: 24rpx;
  color: #888;
  text-align: right;
  font-weight: 500;
  flex-shrink: 0;
}

/* ================================================================
   神煞
   ================================================================ */
.shensha-card {
  padding: 28rpx;
}

.shensha-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 20rpx;
  margin-top: 16rpx;
}

.shensha-pillar {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f2ec;
}

.shensha-pillar-name {
  font-size: 22rpx;
  color: #bbb;
  margin-bottom: 8rpx;
}

.shensha-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.shensha-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  transition: all 0.2s ease;
  border: 1rpx solid #c8a050;
}

.shensha-tag.clickable:active {
  opacity: 0.7;
  transform: scale(0.96);
}

.tag-good {
  background: rgba(200,160,80,0.06);
  color: #333;
}

.tag-bad {
  background: rgba(200,160,80,0.06);
  color: #333;
}

.tag-neutral {
  background: rgba(200,160,80,0.06);
  color: #333;
}

.shensha-empty {
  font-size: 22rpx;
  color: #ddd;
}

/* ================================================================
   起运与大运
   ================================================================ */
.dayun-card {
  padding: 28rpx 28rpx 0;
}

.qiyun-info {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx;
  background: #faf9f6;
  border-radius: 12rpx;
  gap: 20rpx;
}

.qiyun-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.qiyun-col-right {
  margin-left: auto;
  align-items: flex-end;
}

.qiyun-label {
  font-size: 20rpx;
  color: #bbb;
}

.qiyun-value {
  font-size: 24rpx;
  color: #555;
}

.qiyun-age {
  font-size: 36rpx;
  color: #c8a050;
  font-weight: bold;
}

.qiyun-siling {
  font-size: 20rpx;
  color: #bbb;
}

/* 当前选中大运详情 */
.dayun-detail {
  margin-top: 16rpx;
  padding: 20rpx;
  background: linear-gradient(160deg, #2c2c2c, #3a3835);
  border-radius: 14rpx;
}

.dayun-detail-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.dayun-detail-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
  background: rgba(200,160,80,0.12);
  border-radius: 12rpx;
}

.dayun-detail-age {
  font-size: 30rpx;
  color: #c8a050;
  font-weight: bold;
}

.dayun-detail-label {
  font-size: 18rpx;
  color: rgba(245,236,215,0.5);
  margin-top: 2rpx;
}

.dayun-detail-ganzhi {
  display: flex;
  gap: 12rpx;
}

.dayun-detail-gan, .dayun-detail-zhi {
  font-size: 48rpx;
  font-weight: bold;
  color: #f5ecd7;
}

.dayun-detail-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-left: auto;
}

.dayun-detail-shishen {
  font-size: 24rpx;
  color: #f5ecd7;
  font-weight: 500;
}

.dayun-detail-year {
  font-size: 22rpx;
  color: rgba(245,236,215,0.5);
}

.dayun-detail-desc {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 10rpx;
  border-left: 4rpx solid #c8a050;
}

.dayun-detail-desc-text {
  font-size: 22rpx;
  color: rgba(245,236,215,0.7);
  line-height: 1.6;
}

/* 大运纵向滚动列表 */
.dayun-scroll-h {
  width: 100%;
  margin-top: 20rpx;
  padding-bottom: 12rpx;
  white-space: nowrap;
}

.dayun-list-h {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  padding: 0 28rpx;
}

.dayun-item {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 22rpx;
  background: #faf9f6;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  gap: 8rpx;
  min-width: 120rpx;
}

.dayun-item.selected {
  background: linear-gradient(135deg, #fdf8ee, #faf3e0);
  border-color: #c8a050;
  box-shadow: 0 2rpx 10rpx rgba(200,160,80,0.1);
}

.dayun-item.is-now {
  background: #fdf8ee;
}

.dayun-item.is-now.selected {
  background: linear-gradient(135deg, #fdf8ee, #faf3e0);
}

.dy-item-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
}

.dy-age-range {
  font-size: 24rpx;
  color: #555;
  font-weight: 500;
}

.dayun-item.selected .dy-age-range {
  color: #c8a050;
  font-weight: 600;
}

.dy-year {
  font-size: 18rpx;
  color: #bbb;
}

.dy-item-center {
  display: flex;
  gap: 6rpx;
}

.dy-gan {
  font-size: 34rpx;
  font-weight: bold;
}

.dy-zhi {
  font-size: 34rpx;
  font-weight: 500;
}

.dy-item-right {
  display: flex;
  align-items: center;
}

.dy-shishen {
  font-size: 20rpx;
  color: #888;
  font-weight: 500;
}

