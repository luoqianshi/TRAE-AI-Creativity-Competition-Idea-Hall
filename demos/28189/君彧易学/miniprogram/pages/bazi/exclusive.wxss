/* ================================================================
   解锁截断卡 · 墨印封章
   ================================================================ */
.lock-section {
  margin: 40rpx 0;
  background: transparent !important;
  box-shadow: none !important;
}

.lock-card {
  position: relative;
  background: linear-gradient(175deg, #1a1816 0%, #131211 50%, #1a1816 100%);
  border-radius: 24rpx;
  padding: 48rpx 32rpx 36rpx;
  overflow: hidden;
  border: 1rpx solid rgba(180,150,90,0.12);
  box-shadow:
    0 16rpx 56rpx rgba(0,0,0,0.5),
    0 0 2rpx rgba(180,150,90,0.1),
    inset 0 1rpx 0 rgba(200,160,80,0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 暗金光晕 */
.lock-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 10%;
  width: 80%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(180,150,90,0.35), transparent);
}

.lock-card::after {
  content: '';
  position: absolute;
  top: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 200rpx;
  background: radial-gradient(ellipse, rgba(180,150,90,0.04) 0%, transparent 60%);
  pointer-events: none;
}

/* 上方截断渐变（模拟内容被遮） */
.lock-fade-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(to bottom, rgba(28,26,26,0.95) 0%, transparent 100%);
  pointer-events: none;
  z-index: 2;
}

/* 封 */
.lock-seal {
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.lock-seal-outer {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(180,150,90,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 0 40rpx rgba(180,150,90,0.08), inset 0 0 30rpx rgba(180,150,90,0.04);
}

.lock-seal-outer::before {
  content: '';
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(180,150,90,0.1);
}

.lock-seal-inner {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(180,150,90,0.08), rgba(180,150,90,0.02));
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(180,150,90,0.12);
}

.lock-seal-glyph {
  font-size: 42rpx;
  color: rgba(180,150,90,0.5);
  font-weight: bold;
  letter-spacing: 2rpx;
}

.lock-title {
  font-size: 34rpx;
  color: #cfba8a;
  font-weight: 600;
  letter-spacing: 8rpx;
  text-shadow: 0 2rpx 12rpx rgba(180,150,90,0.12);
  position: relative;
  z-index: 1;
}

.lock-subtitle {
  font-size: 24rpx;
  color: rgba(180,150,90,0.45);
  letter-spacing: 4rpx;
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
}

/* 待解锁内容预览 */
.lock-preview {
  margin: 32rpx 0 28rpx;
  padding: 24rpx 32rpx;
  background: rgba(180,150,90,0.03);
  border-radius: 16rpx;
  border: 1rpx solid rgba(180,150,90,0.06);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.lock-preview-item {
  font-size: 24rpx;
  color: rgba(180,150,90,0.3);
  letter-spacing: 5rpx;
  text-align: center;
  padding: 6rpx 0;
  border-bottom: 1rpx solid rgba(180,150,90,0.03);
}

.lock-preview-item:last-child {
  border-bottom: none;
}

/* 分享按钮 */
.lock-share-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #c8a050, #a0803a);
  border: none;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  box-shadow:
    0 6rpx 28rpx rgba(200,160,80,0.3),
    0 0 40rpx rgba(200,160,80,0.06);
  margin-top: 8rpx;
}

.lock-share-btn::after {
  border: none;
}

.lock-share-btn:active {
  transform: scale(0.97);
  box-shadow: 0 3rpx 14rpx rgba(200,160,80,0.2);
}

.lock-share-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.lock-share-icon {
  font-size: 30rpx;
  color: #1e1c19;
}

.lock-share-text {
  font-size: 28rpx;
  color: #1e1c19;
  font-weight: 600;
  letter-spacing: 6rpx;
