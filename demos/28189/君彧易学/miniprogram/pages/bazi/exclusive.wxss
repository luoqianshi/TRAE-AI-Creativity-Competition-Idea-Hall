/* ================================================================
   专属解读 - 墨韵金章风格
   设计理念：墨色为底，金砂为缀，朱砂点睛
   追求厚重文化感与大器风范
   ================================================================ */

/* ---- 页面基色 ---- */
page {
  background: #1C1A1A;
  min-height: 100vh;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", serif;
}

.page {
  padding: 0 32rpx 80rpx;
}

/* ================================================================
   加载态 & 太极旋转
   ================================================================ */
.loading-area, .error-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 300rpx;
}

.taiji-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 3rpx solid rgba(196,165,80,0.12);
  border-top: 3rpx solid #C8A85A;
  border-right: 3rpx solid rgba(196,165,80,0);
  border-radius: 50%;
  animation: taijiSpin 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  box-shadow: 0 0 40rpx rgba(196,165,80,0.08);
}

@keyframes taijiSpin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: rgba(196,165,80,0.5);
  letter-spacing: 8rpx;
}

/* V2 引擎状态指示条 */
.v2-status-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  margin-bottom: 12rpx;
  background: rgba(34,197,94,0.12);
  border: 1rpx solid rgba(34,197,94,0.35);
  border-radius: 6rpx;
}

.v2-status-text {
  font-size: 22rpx;
  color: #16a34a;
  text-align: center;
  word-break: break-all;
}

/* 深度分析计算中提示条 */
.computing-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 30rpx;
  margin-bottom: 16rpx;
  background: rgba(200,168,90,0.06);
  border-radius: 8rpx;
}

.computing-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C8A85A;
  animation: dotPulse 1s ease-in-out infinite;
  margin-right: 12rpx;
}

@keyframes dotPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

.computing-text {
  font-size: 24rpx;
  color: rgba(200,168,90,0.6);
  letter-spacing: 2rpx;
}

.error-text {
  font-size: 28rpx;
  color: rgba(245,236,215,0.45);
  margin-bottom: 20rpx;
}

.retry-btn {
  padding: 16rpx 56rpx;
  background: transparent;
  color: #C8A85A;
  border: 1rpx solid rgba(196,165,80,0.25);
  border-radius: 40rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

/* ================================================================
   顶部铭牌 · 印鉴风骨
   ================================================================ */
.seal-header {
  padding: 48rpx 0 36rpx;
}

.seal-frame {
  position: relative;
  padding: 56rpx 28rpx 48rpx;
  margin: 0 4rpx;
}

/* 四角装饰纹 */
.seal-corner {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border-color: rgba(200,168,90,0.55);
  border-style: solid;
}

.seal-tl { top: 0; left: 0; border-width: 2rpx 0 0 2rpx; }
.seal-tr { top: 0; right: 0; border-width: 2rpx 2rpx 0 0; }
.seal-bl { bottom: 0; left: 0; border-width: 0 0 2rpx 2rpx; }
.seal-br { bottom: 0; right: 0; border-width: 0 2rpx 2rpx 0; }

.seal-body {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.seal-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #E8DCC8;
  letter-spacing: 12rpx;
  margin-bottom: 24rpx;
}

.seal-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.seal-line {
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(200,168,90,0.5), transparent);
}

.seal-divider-text {
  font-size: 24rpx;
  color: rgba(200,168,90,0.75);
  letter-spacing: 10rpx;
}

.seal-sub {
  font-size: 24rpx;
  color: rgba(232,220,200,0.45);
  letter-spacing: 6rpx;
}

/* ================================================================
   卡片区块 · 古卷质感
   ================================================================ */
.card-section {
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(200,168,90,0.1);
  border-radius: 4rpx;
  background: linear-gradient(180deg, rgba(200,168,90,0.04) 0%, rgba(200,168,90,0.01) 40%, transparent 100%);
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 36rpx 28rpx 0;
  margin-bottom: 20rpx;
}

.card-ornament {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.ornament-diamond {
  width: 10rpx;
  height: 10rpx;
  background: rgba(200,168,90,0.5);
  transform: rotate(45deg);
}

.ornament-line {
  width: 36rpx;
  height: 1rpx;
  background: rgba(200,168,90,0.3);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #D4BE8A;
  letter-spacing: 8rpx;
  flex-shrink: 0;
}

.card-body {
  padding: 0 32rpx 36rpx;
}

.body-text {
  display: block;
  font-size: 28rpx;
  color: rgba(210,195,170,0.7);
  line-height: 2;
  text-align: justify;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
  white-space: pre-line;
}

.body-text:last-child {
  margin-bottom: 0;
}

/* 分析维度网格 */
.analysis-grid {
  display: flex;
  margin-top: 28rpx;
  gap: 12rpx;
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: rgba(200,168,90,0.04);
  border: 1rpx solid rgba(200,168,90,0.08);
  border-radius: 4rpx;
}

.grid-icon {
  font-size: 34rpx;
  color: rgba(200,168,90,0.6);
  margin-bottom: 12rpx;
}

.grid-label {
  font-size: 22rpx;
  color: rgba(210,195,170,0.55);
  letter-spacing: 4rpx;
}

/* ================================================================
   预告卡片 · 温润朱磦
   ================================================================ */
.notice-card {
  border-color: rgba(180,120,70,0.15);
  background: linear-gradient(180deg, rgba(180,120,70,0.05) 0%, rgba(180,120,70,0.01) 60%, transparent 100%);
}

.notice-body {
  padding: 36rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.notice-icon {
  font-size: 44rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #C8A080;
  letter-spacing: 6rpx;
  margin-bottom: 18rpx;
}

.notice-text {
  font-size: 24rpx;
  color: rgba(200,160,128,0.5);
  line-height: 1.8;
  letter-spacing: 2rpx;
}

/* ================================================================
   古文装饰语 · 易经摘句
   ================================================================ */
.verse-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 16rpx;
  gap: 14rpx;
}

.verse-line {
  width: 120rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(200,168,90,0.2), transparent);
}

.verse-text {
  font-size: 24rpx;
  color: rgba(200,168,90,0.35);
  letter-spacing: 6rpx;
}

/* ================================================================
   底部操作
   ================================================================ */
.bottom-bar {
  padding: 40rpx 0 20rpx;
}

.btn-return {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, rgba(45,40,35,0.95), rgba(35,30,28,0.95));
  color: #D4BE8A;
  border: 1rpx solid rgba(200,168,90,0.18);
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.3);
}

.btn-return::after { border: none; }

.btn-text {
  font-size: 28rpx;
  color: #D4BE8A;
  letter-spacing: 8rpx;
}

/* ================================================================
   四柱速览
   ================================================================ */
.pillar-quick {
  display: flex;
  margin-top: 24rpx;
  border: 1rpx solid rgba(200,168,90,0.12);
  border-radius: 4rpx;
  overflow: hidden;
}

.pillar-quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 4rpx;
  border-right: 1rpx solid rgba(200,168,90,0.1);
  background: rgba(200,168,90,0.03);
}

.pillar-quick-item:last-child {
  border-right: none;
}

.pq-name {
  font-size: 20rpx;
  color: rgba(200,168,90,0.5);
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.pq-ganZhi {
  font-size: 30rpx;
  font-weight: 600;
  color: #E8DCC8;
  letter-spacing: 4rpx;
  margin-bottom: 4rpx;
}

.pq-shiShen {
  font-size: 20rpx;
  color: rgba(210,195,170,0.5);
}

/* ================================================================
   用神分析 · 重点高亮卡片
   ================================================================ */
.highlight-card {
  border-color: rgba(200,168,90,0.22);
  background: linear-gradient(180deg, rgba(200,168,90,0.08) 0%, rgba(200,168,90,0.03) 40%, rgba(200,168,90,0.01) 100%);
}

.ornament-diamond-gold {
  background: rgba(200,168,90,0.7);
}

.card-title-gold {
  color: #D4BE8A;
}

/* 喜用忌神标签 */
.yongshen-tag-row {
  display: flex;
  gap: 40rpx;
  margin-bottom: 24rpx;
}

.ys-tag-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ys-label {
  font-size: 24rpx;
  color: rgba(200,168,90,0.6);
  letter-spacing: 4rpx;
  flex-shrink: 0;
}

.ys-tags {
  display: flex;
  gap: 8rpx;
}

.ys-tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 4rpx;
  letter-spacing: 4rpx;
}

.ys-tag-yong {
  background: rgba(200,168,90,0.15);
  color: #D4BE8A;
  border: 1rpx solid rgba(200,168,90,0.25);
}

.ys-tag-ji {
  background: rgba(180,120,70,0.1);
  color: rgba(200,160,128,0.7);
  border: 1rpx solid rgba(180,120,70,0.18);
}

/* 调候 / 病药行 */
.tiaohou-row, .sick-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(200,168,90,0.03);
  border-left: 2rpx solid rgba(200,168,90,0.2);
  border-radius: 0 4rpx 4rpx 0;
}

.tiaohou-dot, .sick-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.tiaohou-dot {
  background: rgba(220,140,80,0.6);
}

.sick-dot {
  background: rgba(180,120,70,0.5);
}

.body-text-sm {
  font-size: 24rpx;
  color: rgba(210,195,170,0.55);
  line-height: 1.8;
  letter-spacing: 2rpx;
  white-space: pre-line;
}

.dim-text {
  color: rgba(210,195,170,0.35);
}

.mt-20 {
  margin-top: 20rpx;
}

/* 指引网格 */
.guidance-box {
  margin-top: 24rpx;
  padding: 20rpx;
  background: rgba(200,168,90,0.04);
  border: 1rpx solid rgba(200,168,90,0.08);
  border-radius: 4rpx;
}

.guidance-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.guidance-item {
  flex: 0 0 calc(50% - 6rpx);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.guidance-item-wide {
  flex: 1 0 100%;
}

.guidance-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.guidance-text {
  font-size: 23rpx;
  color: rgba(210,195,170,0.6);
  letter-spacing: 2rpx;
  line-height: 1.6;
}

/* ================================================================
   格局判定
   ================================================================ */
.geju-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.geju-main-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #E8DCC8;
  background: rgba(200,168,90,0.12);
  border: 1rpx solid rgba(200,168,90,0.2);
  border-radius: 4rpx;
  letter-spacing: 4rpx;
}

.geju-jian-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: rgba(200,160,128,0.6);
  background: rgba(180,120,70,0.06);
  border: 1rpx solid rgba(180,120,70,0.12);
  border-radius: 4rpx;
  letter-spacing: 3rpx;
}

/* ================================================================
   干支关系
   ================================================================ */
.relation-group {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(200,168,90,0.02);
  border: 1rpx solid rgba(200,168,90,0.06);
  border-radius: 4rpx;
}

.relation-group-title {
  font-size: 22rpx;
  color: rgba(200,168,90,0.5);
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
  display: block;
}

.relation-item {
  margin-bottom: 6rpx;
  display: block;
}

.relation-item:last-child {
  margin-bottom: 0;
}

/* ================================================================
   引言文字
   ================================================================ */
.intro {
  font-size: 26rpx;
  color: rgba(210,195,170,0.6);
  line-height: 2.1;
  letter-spacing: 3rpx;
  text-align: justify;
}

/* ================================================================
   原盘结构 · 旺衰条 + 角色列表 + 特征标签
   ================================================================ */

/* 旺衰强度条 */
.strength-bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.strength-label {
  font-size: 24rpx;
  color: #D4BE8A;
  font-weight: 600;
  letter-spacing: 4rpx;
  width: 80rpx;
  flex-shrink: 0;
}

.strength-bar-track {
  flex: 1;
  height: 8rpx;
  background: rgba(200,168,90,0.1);
  border-radius: 4rpx;
  overflow: hidden;
}

.strength-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #C8A85A, #D4BE8A);
  border-radius: 4rpx;
  transition: width 0.6s ease;
}

.strength-value {
  font-size: 22rpx;
  color: rgba(200,168,90,0.5);
  width: 50rpx;
  text-align: right;
  flex-shrink: 0;
}

/* 各柱角色列表 */
.role-list {
  margin-top: 20rpx;
}

.role-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.role-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(200,168,90,0.4);
  margin-top: 14rpx;
  flex-shrink: 0;
}

.role-text {
  flex: 1;
}

/* 特征标签 */
.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.feature-tag {
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: rgba(210,195,170,0.55);
  background: rgba(200,168,90,0.05);
  border: 1rpx solid rgba(200,168,90,0.1);
  border-radius: 4rpx;
  letter-spacing: 2rpx;
  word-break: break-all;
  line-height: 1.6;
}

/* ================================================================
   大运流年 · 时间线
   ================================================================ */

/* 最佳/最差运速览 */
.best-worst-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.bw-item {
  flex: 1;
  padding: 16rpx 20rpx;
  border-radius: 4rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bw-best {
  background: rgba(200,168,90,0.08);
  border: 1rpx solid rgba(200,168,90,0.15);
}

.bw-worst {
  background: rgba(180,120,70,0.06);
  border: 1rpx solid rgba(180,120,70,0.12);
}

.bw-label {
  font-size: 20rpx;
  color: rgba(200,168,90,0.5);
  letter-spacing: 4rpx;
}

.bw-value {
  font-size: 25rpx;
  font-weight: 600;
  color: #E8DCC8;
  letter-spacing: 2rpx;
}

/* 转折点提示 */
.turning-alert {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  background: rgba(220,180,80,0.06);
  border: 1rpx solid rgba(220,180,80,0.12);
  border-radius: 4rpx;
  margin-bottom: 28rpx;
}

.turning-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.turning-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.turning-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #D4BE8A;
  letter-spacing: 4rpx;
  margin-bottom: 4rpx;
}

.turning-desc {
  font-size: 23rpx;
  color: rgba(210,195,170,0.6);
  line-height: 1.75;
  letter-spacing: 2rpx;
}

/* 大运时间线 */
.dayun-timeline {
  position: relative;
  margin-top: 8rpx;
}

.dayun-item {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.dayun-item:last-child {
  margin-bottom: 0;
}

.dayun-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20rpx;
  flex-shrink: 0;
}

.dayun-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.dayun-dot-yong { background: #C8A85A; box-shadow: 0 0 10rpx rgba(200,168,90,0.3); }
.dayun-dot-yong-light { background: rgba(200,168,90,0.5); }
.dayun-dot-neutral { background: rgba(200,168,90,0.3); }
.dayun-dot-ji-light { background: rgba(180,120,70,0.4); }
.dayun-dot-ji { background: rgba(160,100,60,0.45); }

.dayun-line {
  width: 2rpx;
  flex: 1;
  background: linear-gradient(180deg, rgba(200,168,90,0.15), rgba(200,168,90,0.04));
  margin-top: 6rpx;
}

.dayun-right {
  flex: 1;
  padding-bottom: 4rpx;
}

.dayun-top-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.dayun-ganzhi {
  font-size: 30rpx;
  font-weight: 700;
  color: #E8DCC8;
  letter-spacing: 4rpx;
}

.dayun-type-tag {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  letter-spacing: 3rpx;
  font-weight: 500;
}

.dayun-type-yong { background: rgba(200,168,90,0.15); color: #D4BE8A; }
.dayun-type-yong-light { background: rgba(200,168,90,0.08); color: rgba(212,190,138,0.7); }
.dayun-type-neutral { background: rgba(200,168,90,0.05); color: rgba(210,195,170,0.45); }
.dayun-type-ji-light { background: rgba(180,120,70,0.08); color: rgba(200,160,128,0.55); }
.dayun-type-ji { background: rgba(160,100,60,0.1); color: rgba(200,160,128,0.45); }

.dayun-age {
  font-size: 21rpx;
  color: rgba(210,195,170,0.35);
  letter-spacing: 2rpx;
  margin-left: auto;
}

.dayun-desc {
  font-size: 24rpx;
  color: rgba(210,195,170,0.58);
  line-height: 1.8;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 8rpx;
}

/* 大运五行标注 */
.dayun-wx-row {
  display: flex;
  gap: 10rpx;
}

.dayun-wx-tag {
  font-size: 19rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  letter-spacing: 2rpx;
}

.wx-yong { background: rgba(200,168,90,0.12); color: #D4BE8A; }
.wx-ji { background: rgba(180,120,70,0.1); color: rgba(200,160,128,0.5); text-decoration: line-through; }
.wx-normal { background: rgba(200,168,90,0.04); color: rgba(210,195,170,0.35); }

/* ================================================================
   健康指南 · 五行脏腑网格
   ================================================================ */
.health-grid {
