<!-- 时序转化 - 输入页面（中国水墨风格） -->
<view class="page">

  <!-- 顶部山水意境区域 -->
  <view class="hero-section">
    <view class="hero-bg">
      <!-- 山水装饰：远山 -->
      <view class="mountain mountain-far"></view>
      <view class="mountain mountain-mid"></view>
      <view class="mountain mountain-near"></view>
      <!-- 祥云/飞鸟 -->
      <view class="cloud cloud-left"></view>
      <view class="cloud cloud-right"></view>
      <!-- 鹤/鸟 -->
      <view class="bird bird-1">〰</view>
      <view class="bird bird-2">〰</view>
    </view>

    <view class="hero-content">
      <text class="hero-title">输入个人档案</text>
      <text class="hero-subtitle">开启特质分析</text>
      <text class="hero-desc">让我猜猜你的性格</text>
    </view>
  </view>

  <!-- 表单卡片 -->
  <view class="form-card">

    <!-- 姓名 -->
    <view class="form-row">
      <text class="form-label">姓名 <text class="required-mark">*</text></text>
      <input class="form-input" placeholder="请输入（必填）" placeholder-class="placeholder" value="{{name}}" bindinput="onNameInput" />
    </view>

    <!-- 性别 -->
    <view class="form-row">
      <text class="form-label">性别</text>
      <view class="gender-group">
        <view class="gender-btn {{gender === '男' ? 'active-male' : ''}}" data-gender="男" bindtap="onGenderChange">
          <text class="gender-icon male-icon">♂</text>
          <text class="gender-text">男</text>
        </view>
        <view class="gender-btn {{gender === '女' ? 'active-female' : ''}}" data-gender="女" bindtap="onGenderChange">
          <text class="gender-icon female-icon">♀</text>
          <text class="gender-text">女</text>
        </view>
      </view>
    </view>

    <!-- 出生日期 -->
    <view class="form-row arrow-row" bindtap="showDatePicker">
      <text class="form-label">出生日期</text>
      <view class="form-value-box">
        <text class="form-value">{{year}}年{{month}}月{{day}}日 {{hour < 10 ? '0'+hour : hour}}时{{minute < 10 ? '0'+minute : minute}}分</text>
        <text class="arrow-icon">›</text>
      </view>
    </view>

    <!-- 出生地区 -->
    <view class="form-row arrow-row" bindtap="showRegionPicker">
      <text class="form-label">出生地点 <text class="required-mark">*</text></text>
      <view class="form-value-box">
        <text class="form-value {{region ? '' : 'placeholder'}}">{{regionLabel || region || '请选择（必填）'}}</text>
        <text class="arrow-icon">›</text>
      </view>
    </view>

  </view>

  <!-- 高级文案区域 -->
  <view class="motto-section">
    <view class="motto-line"></view>
    <text class="motto-text">传统文化 · 性格探索 · 趣味体验</text>
    <view class="motto-line"></view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer-section">
    <text class="disclaimer-title">温 馨 提 示</text>
    <text class="disclaimer-text">本工具基于中国传统干支纪年法，提供性格特质趣味分析体验。所有内容均为算法自动生成的娱乐性参考，不代表任何科学结论或人生指导。每个人的性格与人生轨迹由自身选择与努力决定，请理性看待，仅供娱乐体验。</text>
  </view>

  <!-- 保存开关 -->
  <view class="save-section">
    <view class="save-toggle" bindtap="toggleSave">
      <view class="toggle-switch {{isSaved ? 'on' : ''}}">
        <view class="toggle-dot"></view>
      </view>
      <text class="toggle-text">{{isSaved ? '已保存' : '保存'}}</text>
    </view>
  </view>

  <!-- 解读按钮 -->
  <view class="submit-area">
    <button class="submit-btn" bindtap="startPaipan">开始分析</button>
  </view>

  <!-- ========== 地区选择弹窗 ========== -->
  <view class="picker-mask {{showRegionPicker ? 'show' : ''}}" bindtap="hideRegionPicker">
    <view class="picker-panel region-panel" catchtap="stopPropagation">
      <view class="picker-header">
        <text class="picker-cancel" bindtap="hideRegionPicker">取消</text>
        <text class="picker-title">选择地区</text>
        <text class="picker-confirm" bindtap="confirmRegionPicker">确定</text>
      </view>
      <!-- 三列：省 → 市 -->
      <view class="region-columns">
        <scroll-view class="region-list" scroll-y>
          <view
            class="region-item {{pickerProvinceIndex === index ? 'active' : ''}}"
            wx:for="{{provinces}}"
            wx:key="name"
            data-index="{{index}}"
            bindtap="onSelectProvince"
          >{{item.name}}</view>
        </scroll-view>
        <view class="region-divider"></view>
        <scroll-view class="region-list" scroll-y>
          <view
            class="region-item {{pickerCityIndex === index ? 'active' : ''}}"
            wx:for="{{currentCities}}"
            wx:key="name"
            data-index="{{index}}"
            bindtap="onSelectCity"
          >{{item.name}}</view>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- ========== 日期时间选择弹窗 ========== -->
  <view class="picker-mask {{showDatePicker ? 'show' : ''}}" bindtap="hideDatePicker">
    <view class="picker-panel" catchtap="stopPropagation">
      <!-- 头部 -->
      <view class="picker-header">
        <text class="picker-cancel" bindtap="hideDatePicker">取消</text>
        <text class="picker-title">选择出生时间</text>
        <text class="picker-confirm" bindtap="confirmDatePicker">确定</text>
      </view>

      <!-- 列标题 -->
      <view class="picker-col-headers">
        <text class="picker-col-header">年</text>
        <text class="picker-col-header">月</text>
        <text class="picker-col-header">日</text>
        <text class="picker-col-header">时</text>
        <text class="picker-col-header">分</text>
      </view>

      <!-- 五列选择器 -->
      <view class="picker-columns">
        <picker-view class="picker-col" value="{{[pickerYearIndex]}}" bindchange="onPickerYearChange">
          <picker-view-column>
            <view class="picker-item {{pickerYearIndex === index ? 'active' : ''}}" wx:for="{{years}}" wx:key="*this">{{item}}</view>
          </picker-view-column>
        </picker-view>
        <picker-view class="picker-col" value="{{[pickerMonthIndex]}}" bindchange="onPickerMonthChange">
          <picker-view-column>
            <view class="picker-item {{pickerMonthIndex === index ? 'active' : ''}}" wx:for="{{months}}" wx:key="*this">{{item < 10 ? '0'+item : item}}</view>
          </picker-view-column>
        </picker-view>
        <picker-view class="picker-col" value="{{[pickerDayIndex]}}" bindchange="onPickerDayChange">
          <picker-view-column>
            <view class="picker-item {{pickerDayIndex === index ? 'active' : ''}}" wx:for="{{days}}" wx:key="*this">{{item < 10 ? '0'+item : item}}</view>
          </picker-view-column>
        </picker-view>
        <picker-view class="picker-col" value="{{[pickerHourIndex]}}" bindchange="onPickerHourChange">
          <picker-view-column>
            <view class="picker-item {{pickerHourIndex === index ? 'active' : ''}}" wx:for="{{hours}}" wx:key="*this">{{item < 10 ? '0'+item : item}}</view>
          </picker-view-column>
        </picker-view>
        <picker-view class="picker-col" value="{{[pickerMinuteIndex]}}" bindchange="onPickerMinuteChange">
          <picker-view-column>
            <view class="picker-item {{pickerMinuteIndex === index ? 'active' : ''}}" wx:for="{{minutes}}" wx:key="*this">{{item < 10 ? '0'+item : item}}</view>
          </picker-view-column>
        </picker-view>
      </view>
    </view>
  </view>

</view>
