<!-- 时序转化 - 结果页面（专业风格） -->
<view class="page">

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-area">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在分析...</text>
  </view>

  <!-- 错误状态 -->
  <view wx:elif="{{error}}" class="error-area">
    <text class="error-icon">✕</text>
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="rePaipan">返回重新输入</button>
  </view>

  <!-- 计算结果 -->
  <view wx:else class="result-content">

    <!-- ========== 顶部标题区 ========== -->
    <view class="header-section">
      <view class="header-bg">
        <view class="header-ornament-left"></view>
        <view class="header-ornament-right"></view>
      </view>
      <view class="header-info">
        <text class="header-name">{{inputInfo.name || '探索者'}}</text>
        <text class="header-gender">{{inputInfo.gender === '男' ? '乾造' : '坤造'}}</text>
      </view>
      <view class="header-meta">
        <text class="header-date">{{inputInfo.year}}年{{inputInfo.month}}月{{inputInfo.day}}日</text>
        <text class="header-divider">·</text>
        <text class="header-time">{{inputInfo.origHour < 10 ? '0'+inputInfo.origHour : inputInfo.origHour}}时</text>
      </view>
      <view class="header-lunar">
        <text class="header-lunar-text">{{result.baZi}}</text>
      </view>
      <!-- 真太阳时标识 -->
      <view class="header-solar-tag" wx:if="{{inputInfo.region}}">
        <text class="solar-dot">☀</text>
        <text class="solar-label">真太阳时 · {{inputInfo.region}} · {{inputInfo.hour < 10 ? '0'+inputInfo.hour : inputInfo.hour}}时</text>
      </view>
    </view>

    <!-- ========== 时序表格 ========== -->
    <view class="bazi-card">
      <view class="card-title-row">
        <view class="card-title-dot"></view>
        <text class="card-title">时序解读</text>
        <text class="card-subtitle">特质组合参考</text>
      </view>

      <view class="bazi-table">
        <!-- 表头 -->
        <view class="table-row table-header">
          <view class="table-cell col-time"></view>
          <view class="table-cell"><text class="col-title">年元</text></view>
          <view class="table-cell"><text class="col-title">月元</text></view>
          <view class="table-cell day-col"><text class="col-title">日元</text></view>
          <view class="table-cell"><text class="col-title">时元</text></view>
        </view>

        <!-- 角色定位 -->
        <view class="table-row row-shishen">
          <view class="table-cell col-time"><text class="row-label">角色</text></view>
          <view class="table-cell" wx:for="{{pillars}}" wx:key="name">
            <text class="shishen-text">{{item.shiShen}}</text>
          </view>
        </view>

        <!-- 天干 -->
        <view class="table-row row-gan">
          <view class="table-cell col-time"><text class="row-label">天干</text></view>
          <view class="table-cell" wx:for="{{pillars}}" wx:key="name">
            <text class="gan-text" style="color: {{item.ganColor}}">{{item.gan}}</text>
          </view>
        </view>

        <!-- 地支 -->
        <view class="table-row row-zhi">
          <view class="table-cell col-time"><text class="row-label">地支</text></view>
          <view class="table-cell" wx:for="{{pillars}}" wx:key="name">
            <text class="zhi-text {{item.isKongWang ? 'kongwang' : ''}}" style="color: {{item.zhiColor}}">{{item.zhi}}</text>
          </view>
        </view>

        <!-- 隐藏元素 -->
        <view class="table-row row-canggan">
          <view class="table-cell col-time"><text class="row-label">隐藏</text></view>
          <view class="table-cell" wx:for="{{pillars}}" wx:key="name">
            <view class="canggan-list">
              <block wx:for="{{item.cangGan}}" wx:for-item="cg" wx:key="gan">
                <text class="canggan-item" style="color: {{cg.color}}">{{cg.gan}}</text>
                <text class="canggan-shishen">{{cg.shiShen}}</text>
              </block>
            </view>
          </view>
        </view>

        <!-- 音律属性 -->
        <view class="table-row row-nayin">
          <view class="table-cell col-time"><text class="row-label">音律</text></view>
          <view class="table-cell" wx:for="{{pillars}}" wx:key="name">
            <text class="nayin-text">{{item.naYin || '-'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== 特质基础分析卡 ========== -->
    <view class="rizhu-card">
      <view class="rizhu-main">
        <view class="rizhu-badge" style="background: {{result.riZhu.ganColor || '#c8a050'}}">
          <text class="rizhu-gan">{{result.riZhu.gan}}</text>
        </view>
        <view class="rizhu-info">
          <text class="rizhu-label">特质基础倾向（{{result.riZhu.wuXing}}型特质）</text>
          <text class="rizhu-desc">{{riZhuDesc}}</text>
        </view>
      </view>
      <view class="rizhu-details">
        <view class="rizhu-detail-item">
          <text class="detail-label">日元</text>
          <text class="detail-value">{{result.riZhu.ganZhi}}</text>
        </view>
        <view class="rizhu-detail-item">
          <text class="detail-label">元素</text>
          <text class="detail-value" style="color: {{result.riZhu.ganColor || '#333'}}">{{result.riZhu.wuXing}}</text>
        </view>
        <view class="rizhu-detail-item">
          <text class="detail-label">得令</text>
          <text class="detail-value {{result.isMonthLing ? 'good' : 'neutral'}}">{{result.isMonthLing ? '是' : '否'}}</text>
        </view>
        <view class="rizhu-detail-item">
          <text class="detail-label">月令</text>
          <text class="detail-value">{{result.monthLing}}</text>
        </view>
      </view>
    </view>

    <!-- ========== 元素力量 ========== -->
    <view class="wuxing-card">
      <view class="card-title-row">
        <view class="card-title-dot"></view>
        <text class="card-title">元素力量</text>
        <text class="card-subtitle">天干+隐藏元素统计</text>
      </view>
      <!-- 元素力量条形图 -->
      <view class="wx-bars-box">
        <view class="wx-bar-item" wx:for="{{wxBarList}}" wx:key="name" bindtap="onWuXingTap" data-wxname="{{item.name}}">
          <view class="wx-bar-dot {{item.cls}}"></view>
          <text class="wx-bar-name">{{item.name}}</text>
          <view class="wx-bar-track">
            <view class="wx-bar-fill {{item.cls}}" style="width: {{(result.wuXingStats[item.name] || 0) / wxMax * 100}}%"></view>
          </view>
          <text class="wx-bar-count">{{result.wuXingStats[item.name] || 0}}</text>
        </view>
      </view>
    </view>

    <!-- ========== 元素知识弹窗 ========== -->
    <view class="wx-overlay" wx:if="{{showWxOverlay}}" bindtap="closeWxOverlay">
      <view class="wx-overlay-card" catchtap="noop" wx:if="{{wxOverlayData}}">
        <view class="wx-overlay-header">
          <text class="wx-overlay-title">{{wxOverlayData.name}} · 元素属性</text>
        </view>
        <view class="wx-overlay-body">
          <view class="wx-overlay-row wx-overlay-ratio-row">
            <text class="wx-overlay-label">特质能量</text>
            <view class="wx-overlay-ratio-bar-wrap">
              <view class="wx-overlay-ratio-bar-track">
                <view class="wx-overlay-ratio-bar-fill" style="width: {{wxOverlayData.ratio}}%"></view>
              </view>
              <text class="wx-overlay-ratio-text">{{wxOverlayData.count}} / {{wxOverlayData.total}}（{{wxOverlayData.ratio}}%）</text>
            </view>
          </view>
          <view class="wx-overlay-row">
            <text class="wx-overlay-label">季节</text>
            <text class="wx-overlay-value" style="color: {{wxOverlayData.name === '木' ? '#6a9a78' : wxOverlayData.name === '火' ? '#b86a5c' : wxOverlayData.name === '土' ? '#b89a5c' : wxOverlayData.name === '金' ? '#c4b46a' : '#5a7a98'}}">{{wxOverlayData.season}}</text>
          </view>
          <view class="wx-overlay-row">
            <text class="wx-overlay-label">方位</text>
            <text class="wx-overlay-value" style="color: {{wxOverlayData.name === '木' ? '#6a9a78' : wxOverlayData.name === '火' ? '#b86a5c' : wxOverlayData.name === '土' ? '#b89a5c' : wxOverlayData.name === '金' ? '#c4b46a' : '#5a7a98'}}">{{wxOverlayData.direction}}</text>
          </view>
          <view class="wx-overlay-row">
            <text class="wx-overlay-label">颜色</text>
            <text class="wx-overlay-value" style="color: {{wxOverlayData.name === '木' ? '#6a9a78' : wxOverlayData.name === '火' ? '#b86a5c' : wxOverlayData.name === '土' ? '#b89a5c' : wxOverlayData.name === '金' ? '#c4b46a' : '#5a7a98'}}">{{wxOverlayData.color}}</text>
          </view>
          <view class="wx-overlay-row">
            <text class="wx-overlay-label">五脏</text>
            <text class="wx-overlay-value" style="color: {{wxOverlayData.name === '木' ? '#6a9a78' : wxOverlayData.name === '火' ? '#b86a5c' : wxOverlayData.name === '土' ? '#b89a5c' : wxOverlayData.name === '金' ? '#c4b46a' : '#5a7a98'}}">{{wxOverlayData.zang}}</text>
          </view>
          <view class="wx-overlay-row">
            <text class="wx-overlay-label">六腑</text>
            <text class="wx-overlay-value" style="color: {{wxOverlayData.name === '木' ? '#6a9a78' : wxOverlayData.name === '火' ? '#b86a5c' : wxOverlayData.name === '土' ? '#b89a5c' : wxOverlayData.name === '金' ? '#c4b46a' : '#5a7a98'}}">{{wxOverlayData.fu}}</text>
          </view>
          <view class="wx-overlay-row">
            <text class="wx-overlay-label">外应</text>
            <text class="wx-overlay-value" style="color: {{wxOverlayData.name === '木' ? '#6a9a78' : wxOverlayData.name === '火' ? '#b86a5c' : wxOverlayData.name === '土' ? '#b89a5c' : wxOverlayData.name === '金' ? '#c4b46a' : '#5a7a98'}}">{{wxOverlayData.body}}</text>
          </view>
          <view class="wx-overlay-row">
            <text class="wx-overlay-label">六亲</text>
            <text class="wx-overlay-value" style="color: {{wxOverlayData.name === '木' ? '#6a9a78' : wxOverlayData.name === '火' ? '#b86a5c' : wxOverlayData.name === '土' ? '#b89a5c' : wxOverlayData.name === '金' ? '#c4b46a' : '#5a7a98'}}">{{wxOverlayData.liuqin}}</text>
          </view>
          <view class="wx-overlay-desc">
            <text class="wx-overlay-desc-text">{{wxOverlayData.desc}}</text>
          </view>
        </view>
        <view class="wx-overlay-close" bindtap="closeWxOverlay">
          <text class="wx-overlay-close-text">收起</text>
        </view>
      </view>
    </view>

    <!-- ========== 星象特质 ========== -->
    <view class="shensha-card">
      <view class="card-title-row">
        <view class="card-title-dot"></view>
        <text class="card-title">星象特质</text>
        <text class="card-subtitle">点击星象查看知识解读</text>
      </view>
      <view class="shensha-grid">
        <view class="shensha-pillar" wx:for="{{pillars}}" wx:key="name">
          <text class="shensha-pillar-name">{{item.name}}</text>
          <view class="shensha-tags">
            <text class="shensha-tag {{shenshaTypeMap[tag] === 'good' ? 'tag-good' : shenshaTypeMap[tag] === 'bad' ? 'tag-bad' : 'tag-neutral'}} clickable"
              wx:for="{{shenShaByPillar[indexMap[item.name]]}}" wx:for-item="tag" wx:key="*this"
              bindtap="onShenshaTap"
              data-tag="{{tag}}">{{tag}}</text>
            <text wx:if="{{shenShaByPillar[indexMap[item.name]].length === 0}}" class="shensha-empty">—</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== 起始阶段与人生阶段 ========== -->
    <view class="dayun-card">
      <view class="card-title-row">
        <view class="card-title-dot"></view>
        <text class="card-title">阶段成长状态参考</text>
        <text class="card-subtitle">{{result.daYun.isShunPai ? '顺排' : '逆排'}} · 点击查看详细解读</text>
      </view>

      <!-- 起始信息 -->
      <view class="qiyun-info">
        <view class="qiyun-col">
          <text class="qiyun-label">起始</text>
          <text class="qiyun-value">{{qiYunText}}</text>
        </view>
        <view class="qiyun-col">
          <text class="qiyun-label">交接</text>
          <text class="qiyun-value">{{jiaoYunText}}</text>
        </view>
        <view class="qiyun-col qiyun-col-right">
          <text class="qiyun-age">{{qiYunAgeDisplay}}岁</text>
          <text class="qiyun-siling">起始</text>
        </view>
      </view>

      <!-- 当前选中人生阶段详情 -->
      <view class="dayun-detail" wx:if="{{dayunList.length > 0}}">
        <view class="dayun-detail-main">
          <view class="dayun-detail-badge">
            <text class="dayun-detail-age">{{dayunList[selectedDayunIndex].age}}~{{dayunList[selectedDayunIndex].age + 9}}岁</text>
            <text class="dayun-detail-label">阶段</text>
          </view>
          <view class="dayun-detail-ganzhi">
            <text class="dayun-detail-gan" style="color: {{dayunList[selectedDayunIndex].ganColor}}">{{dayunList[selectedDayunIndex].gan}}</text>
            <text class="dayun-detail-zhi" style="color: {{dayunList[selectedDayunIndex].zhiColor}}">{{dayunList[selectedDayunIndex].zhi}}</text>
          </view>
          <view class="dayun-detail-info">
            <text class="dayun-detail-shishen">{{dayunList[selectedDayunIndex].shiShen}}</text>
            <text class="dayun-detail-year">{{dayunList[selectedDayunIndex].year}}年起</text>
          </view>
        </view>
        <view class="dayun-detail-desc">
          <text class="dayun-detail-desc-text">{{dayunList[selectedDayunIndex].fullDesc}}</text>
          <text class="desc-disclaimer">该解读基于对当前的静态阐释，并不能针对个人整体的结论</text>
        </view>
      </view>

      <!-- 人生阶段横向滑动列表 -->
      <scroll-view class="dayun-scroll-h" scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="dy-{{selectedDayunIndex}}">
        <view class="dayun-list-h">
          <view
            class="dayun-item {{item.isCurrent ? 'is-now' : ''}} {{index === selectedDayunIndex ? 'selected' : ''}}"
            wx:for="{{dayunList}}"
            wx:key="age"
            id="dy-{{index}}"
            bindtap="onDayunTap"
            data-index="{{index}}"
          >
            <view class="dy-item-left">
              <text class="dy-age-range">{{item.age}}~{{item.age + 9}}岁</text>
              <text class="dy-year">{{item.year}}年</text>
            </view>
            <view class="dy-item-center">
              <text class="dy-gan" style="color: {{item.ganColor}}">{{item.gan}}</text>
              <text class="dy-zhi" style="color: {{item.zhiColor}}">{{item.zhi}}</text>
            </view>
            <view class="dy-item-right">
              <text class="dy-shishen">{{item.shiShen}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ========== 年度阶段全览 ========== -->
    <view class="liunian-card">
      <view class="card-title-row">
        <view class="card-title-dot"></view>
        <text class="card-title">年度阶段全览</text>
        <text class="card-subtitle">点击查看详细解读</text>
      </view>

      <!-- 当前选中年度阶段详情 -->
      <view class="liunian-detail" wx:if="{{allLiuNianList.length > 0}}">
        <view class="liunian-detail-main">
          <view class="liunian-year-badge">
            <text class="liunian-year-num">{{allLiuNianList[selectedLiuNianIndex].year}}</text>
            <text class="liunian-year-label">{{allLiuNianList[selectedLiuNianIndex].age}}岁</text>
          </view>
          <view class="liunian-ganzhi">
            <text class="liunian-gan" style="color: {{liunianGanColor}}">{{allLiuNianList[selectedLiuNianIndex].yearGan}}</text>
            <text class="liunian-zhi" style="color: {{liunianZhiColor}}">{{allLiuNianList[selectedLiuNianIndex].yearZhi}}</text>
          </view>
          <view class="liunian-info">
            <text class="liunian-shishen">{{allLiuNianList[selectedLiuNianIndex].shiShen}}</text>
            <text class="liunian-wuxing">{{allLiuNianList[selectedLiuNianIndex].wuXing}}</text>
          </view>
        </view>
        <view class="liunian-desc">
          <text class="liunian-desc-text">{{allLiuNianList[selectedLiuNianIndex].fullDesc}}</text>
          <text class="desc-disclaimer">该解读基于对当前的静态阐释，并不能针对个人整体的结论</text>
        </view>
      </view>

      <!-- 年度阶段横向滑动选择列表 -->
      <scroll-view class="liunian-scroll-h" scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="ln-{{selectedLiuNianIndex}}">
        <view class="liunian-list-h">
          <view
            class="liunian-item {{item.isCurrent ? 'is-now' : ''}} {{index === selectedLiuNianIndex ? 'selected' : ''}}"
            wx:for="{{allLiuNianList}}"
            wx:key="year"
            id="ln-{{index}}"
            bindtap="onLiuNianTap"
            data-index="{{index}}"
          >
            <view class="ln-item-left">
              <text class="ln-year">{{item.year}}</text>
              <text class="ln-age">{{item.age}}岁</text>
            </view>
            <view class="ln-item-center">
              <text class="ln-gan" style="color: {{item.ganColor}}">{{item.yearGan}}</text>
              <text class="ln-zhi" style="color: {{item.zhiColor}}">{{item.yearZhi}}</text>
            </view>
            <view class="ln-item-right">
              <text class="ln-shishen">{{item.shiShen}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ========== 智能古籍参考 ========== -->
    <view class="guji-card">
      <view class="card-title-row">
        <view class="card-title-dot"></view>
        <text class="card-title">智能古籍参考</text>
      </view>

      <!-- 古籍 Tab 栏 -->
      <scroll-view class="guji-tab-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="guji-tab-list">
          <view
            class="guji-tab-item {{index === selectedGujiIndex ? 'active' : ''}}"
            wx:for="{{gujiTabs}}"
            wx:key="name"
            bindtap="onGujiTabTap"
            data-index="{{index}}"
          >
            <text class="guji-tab-text">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 平衡状态核心能量偏向提示 -->
      <view class="guji-tiaohou-row" wx:if="{{currentGujiData.tiaohou}}">
        <text class="guji-tiaohou-label">平衡状态核心能量偏向提示：</text>
        <text class="guji-tiaohou-value">{{currentGujiData.tiaohou}}</text>
        <view class="guji-benbazi-info" wx:if="{{currentGujiData.benbazi}}" bindtap="onBenbaziToggle">
          <text class="guji-benbazi-label">本解读：</text>
          <block wx:for="{{currentGujiData.benbazi}}" wx:key="*this">
            <text class="guji-benbazi-tag {{item.type === 'tou' ? 'tag-tou' : 'tag-cang'}}">{{item.text}}</text>
          </block>
        </view>
        <text class="guji-info-icon" wx:if="{{currentGujiData.benbazi}}">ⓘ</text>
      </view>

      <!-- 论断内容 -->
      <view class="guji-content" wx:if="{{currentGujiData.sections}}">
        <view class="guji-section" wx:for="{{currentGujiData.sections}}" wx:key="title" wx:for-item="sec">
          <view class="guji-section-header" bindtap="onGujiSectionToggle" data-idx="{{index}}" data-gujiidx="{{selectedGujiIndex}}">
            <view class="guji-section-tag">{{sec.tag || ''}}</view>
            <text class="guji-section-title">{{sec.title}}</text>
            <text class="guji-section-arrow {{sec.expanded ? 'arrow-up' : ''}}">▸</text>
          </view>
          <view class="guji-section-body" wx:if="{{sec.expanded}}">
            <view class="guji-para" wx:for="{{sec.paragraphs}}" wx:for-item="para" wx:key="*this">
              <text class="guji-para-text">{{para}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 无数据提示 -->
      <view class="guji-empty" wx:if="{{!currentGujiData.sections && !currentGujiData.tiaohou}}">
        <text class="guji-empty-text">暂无该古籍相关内容</text>
      </view>
    </view>

    <!-- ========== 分享解锁 · 邀友共鉴 ========== -->
    <view class="unlock-area" wx:if="{{!unlocked}}">
      <view class="unlock-card">
        <!-- 顶饰 -->
        <view class="unlock-ornament-top">
          <view class="unlock-gold-line"></view>
          <view class="unlock-diamond-row" bindtap="onDevBypass">
            <view class="unlock-diamond-sm"></view>
            <text class="unlock-ornament-text">诚 邀 共 鉴</text>
            <view class="unlock-diamond-sm"></view>
          </view>
          <view class="unlock-gold-line"></view>
        </view>
        <!-- 主文案 -->
        <view class="unlock-body">
          <text class="unlock-title">趣味特质解析报告</text>
          <text class="unlock-title-sub">邀一位好友解锁完整个人专属分析</text>
          <view class="unlock-divider">
            <view class="unlock-divider-line"></view>
            <text class="unlock-divider-dot">◇</text>
            <view class="unlock-divider-line"></view>
          </view>
          <text class="unlock-desc">好友点击卡片即可进入小程序</text>
          <text class="unlock-desc-sub">分享即解锁，无需额外操作</text>
        </view>
        <!-- 分享按钮 -->
        <button class="unlock-share-btn" open-type="share">
          <view class="unlock-share-inner">
            <text class="unlock-share-icon">✦</text>
            <text class="unlock-share-text">邀 友 共 鉴 · 解 锁 报 告</text>
          </view>
        </button>
        <!-- 底纹 -->
        <view class="unlock-footer">
          <text class="unlock-footer-text">君彧易学 · 趣味参详</text>
        </view>
      </view>
    </view>

    <!-- ========== 免责声明 ========== -->
    <view class="disclaimer-section">
