.page {
  min-height: 100vh;
  background: #f5f0e8;
  position: relative;
  overflow: hidden;
}

.page::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse 120% 60% at 50% 0%, rgba(180,165,140,0.12) 0%, transparent 70%),
    repeating-linear-gradient(135deg, transparent, transparent 3px, rgba(160,145,120,0.03) 3px, rgba(160,145,120,0.03) 4px);
  pointer-events: none;
  z-index: 0;
}

.hero-section {
  position: relative;
  height: 480rpx;
  overflow: hidden;
  z-index: 1;
}

.hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(
    180deg,
    #dcd8cf 0%,
    #e4dfd5 25%,
    #ebe6db 50%,
    #f2ede2 80%,
    #f5f0e8 100%
  );
}

.mountain {
  position: absolute;
  bottom: 0;
  border-radius: 50% 50% 0 0 / 40% 40% 0 0;
}

.mountain-far {
  left: -15%;
  width: 90%;
  height: 220rpx;
  background: linear-gradient(180deg, transparent 30%, rgba(130,125,115,0.10) 70%, rgba(130,125,115,0.16) 100%);
  transform: skewX(-6deg);
  filter: blur(3rpx);
}

.mountain-mid {
  left: 20%;
  width: 85%;
  height: 280rpx;
  background: linear-gradient(180deg, transparent 35%, rgba(110,105,95,0.13) 75%, rgba(110,105,95,0.20) 100%);
  transform: skewX(7deg);
  filter: blur(2rpx);
}

.mountain-near {
  right: -20%;
  width: 80%;
  height: 240rpx;
  background: linear-gradient(180deg, transparent 40%, rgba(85,80,72,0.14) 80%, rgba(85,80,72,0.22) 100%);
  transform: skewX(-4deg);
  filter: blur(1rpx);
}

.cloud {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(150,140,125,0.20), transparent 70%);
}

.cloud-left {
  width: 200rpx; height: 60rpx;
  top: 80rpx; left: 40rpx;
  opacity: 0.5;
}

.cloud-right {
  width: 160rpx; height: 48rpx;
  top: 120rpx; right: 60rpx;
  opacity: 0.35;
}

.hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 100rpx 32rpx 0;
  gap: 24rpx;
}

.avatar {
  flex-shrink: 0;
}

.avatar-inner {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3a3733 0%, #2a2825 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(42,40,37,0.25);
}

.avatar-text {
  color: #f0ece4;
  font-size: 44rpx;
  font-weight: bold;
}

.avatar-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(42,40,37,0.25);
}

.user-info {
  flex: 1;
}

.phone {
  display: block;
  font-size: 30rpx;
  color: #2c2a26;
  font-weight: 600;
}

.login-hint {
  display: flex;
  flex-direction: column;
}

.login-text {
  font-size: 32rpx;
  color: #2c2a26;
  font-weight: 600;
}

.login-sub {
  font-size: 22rpx;
  color: rgba(44,42,38,0.5);
  margin-top: 6rpx;
}

.menu-card {
  margin: -40rpx 32rpx 24rpx;
  background: rgba(255,252,245,0.88);
  backdrop-filter: blur(16rpx);
  border-radius: 20rpx;
  position: relative;
  z-index: 3;
  border: 1rpx solid rgba(160,148,125,0.25);
  box-shadow:
    inset 0 1rpx 4rpx rgba(140,128,110,0.06),
    0 8rpx 36rpx rgba(100,92,78,0.08);
}

.menu-card::before {
  content: '';
  position: absolute;
  top: -1rpx; left: 50%; transform: translateX(-50%);
  width: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, rgba(160,140,110,0.35), transparent);
  border-radius: 0 0 4rpx 4rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid rgba(170,158,135,0.15);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: 29rpx;
  color: #3a342c;
}

.menu-right {
  display: flex;
  align-items: center;
}

.right-text {
  font-size: 23rpx;
  margin-right: 8rpx;
}

.badge {
  background-color: #a03030;
  color: #ffffff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.disclaimer-section {
  margin: 40rpx 32rpx;
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(180,140,100,0.25);
  background: rgba(180,140,100,0.06);
  text-align: center;
}

.disclaimer-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(180,140,100,0.7);
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.disclaimer-text {
  font-size: 20rpx;
  color: rgba(180,140,100,0.55);
  line-height: 1.7;
  letter-spacing: 1rpx;
}

.login-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.login-modal.show {
  opacity: 1;
}

.login-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
}

.login-content {
  position: relative;
  width: 600rpx;
  background: #fdfbf6;
  border-radius: 20rpx;
  border: 1rpx solid rgba(160,148,125,0.3);
  box-shadow: 0 16rpx 48rpx rgba(60,55,45,0.2);
  overflow: hidden;
  z-index: 1001;
}

.login-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 32rpx 24rpx;
  position: relative;
  border-bottom: 1rpx solid rgba(160,148,125,0.15);
}

.login-title {
  font-size: 32rpx;
  color: #3a342c;
  font-weight: 600;
}

.login-close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 40rpx;
  color: rgba(58,52,44,0.5);
  line-height: 1;
}

.login-body {
  padding: 40rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin: 32rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: rgba(160,148,125,0.2);
}

.divider-text {
  font-size: 24rpx;
  color: rgba(90,82,72,0.45);
  padding: 0 20rpx;
}

.wx-login-btn {
  height: 88rpx;
  background: linear-gradient(135deg, #07c160 0%, #05a350 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(7,193,96,0.25);
  gap: 12rpx;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.wx-login-btn::after {
  border: none;
}

.wx-login-btn text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.wx-icon {
  font-size: 26rpx !important;
  background: rgba(255,255,255,0.2);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.wx-legacy-btn {
  background: linear-gradient(135deg, #8a8a8a 0%, #6e6e6e 100%);
  box-shadow: 0 6rpx 20rpx rgba(100,100,100,0.2);
}

.avatar-action-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1002;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.avatar-action-modal.show {
  opacity: 1;
}

.avatar-action-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
}

.avatar-action-content {
  position: relative;
  width: 100%;
  background: #fdfbf6;
  border-radius: 32rpx 32rpx 0 0;
  border-top: 1rpx solid rgba(160,148,125,0.2);
  padding-bottom: env(safe-area-inset-bottom);
  margin-top: auto;
}

.avatar-action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  font-size: 30rpx;
  color: #3a342c;
}

.avatar-action-divider {
  height: 1rpx;
  background: rgba(160,148,125,0.1);
  margin: 0 32rpx;
}

.avatar-action-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  font-size: 30rpx;
  color: #8a8a8a;
  margin-top: 16rpx;
  background: rgba(160,148,125,0.05);
  border-radius: 16rpx;
  margin: 16rpx 32rpx;
}

.view-avatar-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1003;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.view-avatar-modal.show {
  opacity: 1;
}

.view-avatar-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
}

.view-avatar-content {
  position: relative;
  z-index: 1004;
}

.view-avatar-inner {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3a3733 0%, #2a2825 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.35);
}

.view-avatar-text {
  color: #f0ece4;
  font-size: 140rpx;
  font-weight: bold;
}

.view-avatar-image {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.35);
}

.avatar-source-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1005;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.avatar-source-modal.show {
  opacity: 1;
}

.avatar-source-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
}

.avatar-source-content {
  position: relative;
  width: 100%;
  background: #fdfbf6;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  margin-top: auto;
}

.avatar-source-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  font-size: 30rpx;
  color: #3a342c;
}

.avatar-source-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  font-size: 30rpx;
  color: #8a8a8a;
  margin-top: 16rpx;
  background: rgba(160,148,125,0.05);
  border-radius: 16rpx;
  margin: 16rpx 32rpx;
}
