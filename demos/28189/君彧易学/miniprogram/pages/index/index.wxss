/**index.wxss - 君彧易学首页样式**/

page {
  background-color: #f5f2ed;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== 顶部品牌区域 ========== */
.header {
  position: relative;
  overflow: hidden;
  padding: 60rpx 40rpx 50rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 40%, #0f3460 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-bg::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
}

.brand {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.brand-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #d4af37;
  letter-spacing: 8rpx;
  text-shadow: 0 2rpx 12rpx rgba(212, 175, 55, 0.3);
}

.brand-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
  letter-spacing: 1rpx;
}

/* ========== 通用区块 ========== */
.section {
  padding: 0 32rpx;
  margin-top: 36rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-left: 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2c2c;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 6rpx;
  background: linear-gradient(180deg, #d4af37, #b8942c);
  border-radius: 3rpx;
}

.section-more {
  font-size: 24rpx;
  color: #999;
  letter-spacing: 1rpx;
}

/* ========== 核心功能卡片 ========== */
.feature-grid {
  display: flex;
  gap: 20rpx;
}

.feature-card {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  position: relative;
  overflow: hidden;
}

.feature-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.main-card {
  background: linear-gradient(135deg, #fff 0%, #fefcf5 100%);
  border: 1rpx solid rgba(212, 175, 55, 0.15);
}

.card-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.bazi-icon {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
}

.card-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 6rpx;
  letter-spacing: 2rpx;
}

.card-desc {
  font-size: 22rpx;
  color: #888;
  letter-spacing: 1rpx;
}

.card-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 12rpx;
  flex-shrink: 0;
  font-weight: 300;
}

/* ========== 云开发能力列表 ========== */
.power-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.power-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  transition: background-color 0.15s ease;
}

.power-row:active {
  background-color: #fafafa;
}

.power-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.power-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dot-default { background: #d4af37; }
.dot-blue { background: #4a90d9; }
.dot-green { background: #52c41a; }
.dot-purple { background: #722ed1; }
.dot-cyan { background: #13c2c2; }
.dot-orange { background: #fa8c16; }

.power-text-group {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.power-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #2c2c2c;
  margin-bottom: 4rpx;
  letter-spacing: 1rpx;
}

.power-tip {
  font-size: 22rpx;
  color: #aaa;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow-down {
  width: 28rpx;
  height: 28rpx;
  transform: rotate(90deg);
  opacity: 0.4;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.arrow-up {
  width: 28rpx;
  height: 28rpx;
  transform: rotate(-90deg);
  opacity: 0.4;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.arrow-right {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.35;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 子项列表 */
.power-sub-list {
  background: #faf9f7;
}

.sub-divider {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.06);
  margin-left: 64rpx;
}

.sub-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 26rpx 64rpx;
  transition: background-color 0.15s ease;
}

.sub-item:active {
  background: #f0eeea;
}

.sub-title {
  font-size: 26rpx;
  color: #555;
  letter-spacing: 1rpx;
}

.sub-arrow {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.3;
  transform: rotate(90deg);
}

/* ========== 底部 ========== */
.footer {
  margin-top: 60rpx;
  text-align: center;
  padding: 0 40rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #bbb;
  letter-spacing: 4rpx;
}
