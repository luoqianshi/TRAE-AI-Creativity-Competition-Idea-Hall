.page {
  min-height: 100vh;
  background: #f5f0e8;
  position: relative;
  overflow: hidden;
}

.page::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse 120% 60% at 50% 0%, rgba(180,165,140,0.12) 0%, transparent 70%),
    repeating-linear-gradient(135deg, transparent, transparent 3px, rgba(160,145,120,0.03) 3px, rgba(160,145,120,0.03) 4px);
  pointer-events: none;
  z-index: 0;
}

.hero-section {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  z-index: 1;
}

.hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(
    180deg,
    #dcd8cf 0%,
    #e4dfd5 25%,
    #ebe6db 50%,
    #f2ede2 80%,
    #f5f0e8 100%
  );
}

.mountain {
  position: absolute;
  bottom: 0;
  border-radius: 50% 50% 0 0 / 40% 40% 0 0;
}

.mountain-far {
  left: -15%;
  width: 90%;
  height: 160rpx;
  background: linear-gradient(180deg, transparent 30%, rgba(130,125,115,0.10) 70%, rgba(130,125,115,0.16) 100%);
  transform: skewX(-6deg);
  filter: blur(3rpx);
}

.mountain-mid {
  left: 20%;
  width: 85%;
  height: 200rpx;
  background: linear-gradient(180deg, transparent 35%, rgba(110,105,95,0.13) 75%, rgba(110,105,95,0.20) 100%);
  transform: skewX(7deg);
  filter: blur(2rpx);
}

.mountain-near {
  right: -20%;
  width: 80%;
  height: 160rpx;
  background: linear-gradient(180deg, transparent 40%, rgba(85,80,72,0.14) 80%, rgba(85,80,72,0.22) 100%);
  transform: skewX(-4deg);
  filter: blur(1rpx);
}

.cloud {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(150,140,125,0.20), transparent 70%);
}

.cloud-left {
  width: 160rpx; height: 50rpx;
  top: 60rpx; left: 40rpx;
  opacity: 0.5;
}

.cloud-right {
  width: 120rpx; height: 40rpx;
  top: 100rpx; right: 60rpx;
  opacity: 0.35;
}

.hero-content {
  position: relative;
  z-index: 2;
  padding: 100rpx 32rpx 0;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2c2a26;
  letter-spacing: 4rpx;
}

.hero-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(58,52,44,0.5);
  margin-top: 8rpx;
}

.calendar-card {
  margin: -40rpx 32rpx 24rpx;
  background: rgba(255,252,245,0.88);
  backdrop-filter: blur(16rpx);
  border-radius: 20rpx;
  position: relative;
  z-index: 3;
  border: 1rpx solid rgba(160,148,125,0.25);
  box-shadow:
    inset 0 1rpx 4rpx rgba(140,128,110,0.06),
    0 8rpx 36rpx rgba(100,92,78,0.08);
  overflow: hidden;
}

.calendar-card::before {
  content: '';
  position: absolute;
  top: -1rpx; left: 50%; transform: translateX(-50%);
  width: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, rgba(160,140,110,0.35), transparent);
  border-radius: 0 0 4rpx 4rpx;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid rgba(170,158,135,0.15);
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(160,148,125,0.1);
}

.nav-icon {
  font-size: 40rpx;
  color: #5a5248;
}

.month-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3a342c;
}

.week-header {
  display: flex;
  padding: 24rpx 36rpx;
  border-bottom: 1rpx solid rgba(170,158,135,0.1);
}

.week-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: rgba(90,82,72,0.6);
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 16rpx 36rpx 32rpx;
}

.day-item {
  padding: 12rpx 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  border-radius: 12rpx;
  transition: background 0.2s ease;
  min-height: 140rpx;
}

.day-item.selected {
  background: rgba(106,154,120,0.15);
}

.day-item.today:not(.selected) {
  position: relative;
}

.day-item.today:not(.selected)::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  width: 8rpx;
  height: 8rpx;
  background: #a03030;
  border-radius: 50%;
}

.day-item.other-month .day-number {
  color: rgba(90,82,72,0.25);
}

.day-item.other-month .day-lunar {
  color: rgba(90,82,72,0.15);
}

.day-number {
  font-size: 28rpx;
  color: #3a342c;
  line-height: 1.2;
}

.day-item.selected .day-number {
  color: #6a9a78;
  font-weight: 600;
}

.day-lunar {
  font-size: 18rpx;
  color: rgba(90,82,72,0.55);
  margin-top: 4rpx;
  line-height: 1.2;
}

.day-item.selected .day-lunar {
  color: rgba(106,154,120,0.7);
}

.day-jieqi {
  font-size: 16rpx;
  color: #6a9a78;
  margin-top: 4rpx;
  padding: 2rpx 8rpx;
  background: rgba(106,154,120,0.12);
  border-radius: 4rpx;
  line-height: 1.2;
}

.day-festival {
  font-size: 16rpx;
  margin-top: 4rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  line-height: 1.2;
}

.day-festival.solar {
  color: #a06060;
  background: rgba(160,96,96,0.12);
}

.day-festival.lunar {
  color: #6a9a78;
  background: rgba(106,154,120,0.12);
}

.fortune-card, .yiji-card, .suggestions-card, .hint-card {
  margin: 0 32rpx 24rpx;
  background: rgba(255,252,245,0.88);
  backdrop-filter: blur(16rpx);
  border-radius: 20rpx;
  position: relative;
  z-index: 3;
  border: 1rpx solid rgba(160,148,125,0.25);
  box-shadow:
    inset 0 1rpx 4rpx rgba(140,128,110,0.06),
    0 8rpx 36rpx rgba(100,92,78,0.08);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(170,158,135,0.1);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3a342c;
}

.ganzhi-tag {
  font-size: 22rpx;
  color: rgba(200,160,80,0.7);
}

.card-subtitle {
  font-size: 22rpx;
  color: rgba(200,160,80,0.7);
}

.date-info-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid rgba(170,158,135,0.1);
}

.date-info-item {
  font-size: 24rpx;
  color: rgba(90,82,72,0.7);
  padding: 6rpx 16rpx;
  background: rgba(160,148,125,0.08);
  border-radius: 8rpx;
}

.date-info-item.festival {
  color: #a06060;
  background: rgba(160,96,96,0.1);
}

.bazi-info-row {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid rgba(170,158,135,0.1);
  background: linear-gradient(90deg, rgba(106,154,120,0.05), transparent);
}

.bazi-label {
  font-size: 22rpx;
  color: rgba(106,154,120,0.6);
  margin-right: 16rpx;
}

.bazi-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bazi-value {
  font-size: 24rpx;
  color: #5a5248;
  margin-bottom: 2rpx;
}

.bazi-ganzhi {
  font-size: 28rpx;
  color: #6a9a78;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.bazi-switch-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(106,154,120,0.3);
  border-radius: 8rpx;
  background: rgba(106,154,120,0.05);
}

.switch-icon {
  font-size: 28rpx;
  color: #6a9a78;
}

.switch-text {
  font-size: 20rpx;
  color: #6a9a78;
}

.scores-section {
  padding: 24rpx 32rpx;
}

.score-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.score-item:last-child {
  margin-bottom: 0;
}

.score-label {
  width: 120rpx;
  font-size: 24rpx;
  color: #5a5248;
}

.score-bar {
  flex: 1;
  height: 16rpx;
  background: rgba(160,148,125,0.15);
  border-radius: 8rpx;
  overflow: hidden;
}

.score-fill {
  height: 100%;
  background: linear-gradient(90deg, #6a9a78, #8ab898);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.score-value {
  width: 60rpx;
  font-size: 24rpx;
  color: #6a9a78;
  font-weight: 600;
  text-align: right;
}

.shiShen-tag {
  padding: 16rpx 32rpx 24rpx;
  text-align: center;
}

.shiShen-text {
  font-size: 24rpx;
  color: rgba(200,160,80,0.7);
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(200,160,80,0.3);
  border-radius: 8rpx;
}

.yiji-content {
  padding: 24rpx 32rpx;
}

.yi-section, .ji-section {
  margin-bottom: 20rpx;
}

.yi-section:last-child, .ji-section:last-child {
  margin-bottom: 0;
}

.yi-title, .ji-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.yi-title {
  color: #6a9a78;
}

.ji-title {
  color: #a06060;
}

.yi-tags, .ji-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.yi-tag {
  font-size: 22rpx;
  color: #6a9a78;
  background: rgba(106,154,120,0.1);
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.ji-tag {
  font-size: 22rpx;
  color: #a06060;
  background: rgba(160,96,96,0.1);
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.suggestions-content {
  padding: 24rpx 32rpx;
}

.suggestion-item {
  display: flex;
  margin-bottom: 16rpx;
}

.suggestion-item:last-child {
  margin-bottom: 0;
}

.suggestion-label {
  font-size: 24rpx;
  color: rgba(90,82,72,0.6);
  flex-shrink: 0;
}

.suggestion-value {
  font-size: 24rpx;
  color: #5a5248;
}

.hint-content {
  padding: 24rpx 32rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #5a5248;
  line-height: 1.8;
  text-align: justify;
}

.no-record-card {
  margin: 0 32rpx 24rpx;
  padding: 60rpx 32rpx;
  background: rgba(255,252,245,0.88);
  backdrop-filter: blur(16rpx);
  border-radius: 20rpx;
  text-align: center;
  border: 1rpx solid rgba(160,148,125,0.25);
}

.no-record-text {
  display: block;
  font-size: 28rpx;
  color: rgba(58,52,44,0.5);
  margin-bottom: 12rpx;
}

.no-record-hint {
  display: block;
  font-size: 24rpx;
  color: rgba(58,52,44,0.35);
  margin-bottom: 32rpx;
}

.go-paipan-btn {
  height: 80rpx;
  background: linear-gradient(135deg, #6a9a78, #5a8a68);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.go-paipan-btn::after {
  border: none;
}

.disclaimer-section {
  margin: 40rpx 32rpx;
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(180,140,100,0.25);
  background: rgba(180,140,100,0.06);
  text-align: center;
}

.disclaimer-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(180,140,100,0.7);
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.disclaimer-text {
  font-size: 20rpx;
  color: rgba(180,140,100,0.55);
  line-height: 1.7;
  letter-spacing: 1rpx;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: rgba(255,252,245,0.98);
  border-radius: 24rpx;
  border: 1rpx solid rgba(160,148,125,0.3);
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(170,158,135,0.1);
  background: linear-gradient(135deg, rgba(106,154,120,0.08), transparent);
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5a5248;
}

.modal-close {
  font-size: 32rpx;
  color: rgba(90,82,72,0.4);
  padding: 8rpx;
}

.modal-body {
  max-height: 700rpx;
  overflow-y: auto;
}

.record-list {
  padding: 16rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.6);
  border: 1rpx solid transparent;
}

.record-item.selected {
  border-color: rgba(106,154,120,0.4);
  background: rgba(106,154,120,0.06);
}

.record-info {
  flex: 1;
}

.record-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #5a5248;
  margin-bottom: 6rpx;
}

.record-bazi {
  display: block;
  font-size: 26rpx;
  color: #6a9a78;
  letter-spacing: 4rpx;
  margin-bottom: 4rpx;
}

.record-date {
  font-size: 22rpx;
  color: rgba(90,82,72,0.4);
}

.record-check {
  font-size: 32rpx;
  color: #6a9a78;
  font-weight: bold;
}

.add-record-tip {
  padding: 60rpx 32rpx;
  text-align: center;
}

.add-record-tip .tip-text {
  display: block;
  font-size: 26rpx;
  color: rgba(90,82,72,0.4);
  margin-bottom: 24rpx;
}
