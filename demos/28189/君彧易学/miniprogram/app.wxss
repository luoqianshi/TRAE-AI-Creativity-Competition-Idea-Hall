/**app.wxss**/
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* ========== 全局 免责声明 ========== */
.disclaimer-section {
  margin: 40rpx 44rpx;
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(180,140,100,0.25);
  background: rgba(180,140,100,0.06);
  text-align: center;
}

.disclaimer-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(180,140,100,0.7);
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.disclaimer-text {
  font-size: 20rpx;
  color: rgba(180,140,100,0.55);
  line-height: 1.7;
  letter-spacing: 1rpx;
}