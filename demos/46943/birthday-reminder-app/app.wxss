/* ===== 全局样式 ===== */
/* 定义全局 CSS 变量（通过 page 选择器模拟） */
page {
  --accent: #E8654A;
  --accent-light: #FDF1EE;
  --bg: #FFFDF8;
  --bg2: #F5F4F0;
  --bg3: #EEECE7;
  --text1: #1C1C1E;
  --text2: #3C3C43;
  --text3: #8E8E93;
  --text4: #C7C7CC;
  --sep: rgba(60,60,67,0.13);
  --card: #FFFFFF;
  --radius: 13px;
  --radius-sm: 9px;

  /* 字号系统 */
  --text-xs: 22rpx;
  --text-sm: 26rpx;
  --text-subtitle: 28rpx;
  --text-md: 30rpx;
  --text-title: 30rpx;
  --text-lg: 34rpx;
  --text-xl: 44rpx;
  --text-2xl: 56rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  background-color: var(--bg2);
  color: var(--text1);
  font-size: var(--text-md);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ===== 通用容器 ===== */
.container {
  padding: 0 0 40rpx;
  background: var(--bg2);
  min-height: 100vh;
}

/* ===== 卡片组件 ===== */
.card {
  background: var(--card);
  border-radius: var(--radius);
  margin: 0 32rpx;
  overflow: hidden;
}

.card-item {
  background: var(--card);
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--sep);
}

.card-item:last-child {
  border-bottom: none;
}

/* ===== 按钮组件 ===== */
.btn-primary {
  background: var(--accent);
  color: #fff;
  font-size: var(--text-subtitle);
  font-weight: 600;
  padding: 24rpx 48rpx;
  border-radius: var(--radius-sm);
  border: none;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: var(--accent);
  font-size: var(--text-subtitle);
  font-weight: 500;
  padding: 16rpx 0;
  border: none;
  text-align: center;
}

.btn-ghost::after {
  border: none;
}

/* ===== 标签组件 ===== */
.tag {
  font-size: var(--text-xs);
  padding: 2rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 500;
  display: inline-block;
}

.tag-family { background: #FFF0E8; color: var(--accent); }
.tag-friend { background: #E3F5EE; color: #2E9E71; }
.tag-colleague { background: #EBE8F8; color: #6B5CE7; }
.tag-leader { background: #E3EEF8; color: #2B7ABE; }
.tag-other { background: var(--bg3); color: var(--text3); }

/* ===== 头像组件 ===== */
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-lg);
  font-weight: 600;
  flex-shrink: 0;
}

.avatar-lg {
  width: 128rpx;
  height: 128rpx;
  font-size: var(--text-xl);
}

/* ===== 分区标题 ===== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 32rpx 20rpx;
}

.section-title {
  font-size: var(--text-title);
  font-weight: 700;
  color: var(--text1);
  letter-spacing: -0.6rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 120rpx 60rpx;
  background: var(--card);
  border-radius: var(--radius);
  margin: 0 32rpx;
}

.empty-text {
  font-size: var(--text-subtitle);
  color: var(--text3);
  margin-top: 24rpx;
}

/* ===== 表单样式 ===== */
.form-group {
  background: var(--card);
  border-radius: var(--radius);
  margin: 0 32rpx;
  overflow: hidden;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--sep);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: var(--text-md);
  color: var(--text1);
  width: 180rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: var(--text-md);
  color: var(--text1);
  text-align: right;
}

.form-input::placeholder {
  color: var(--text4);
}

/* ===== 列表单元格 ===== */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: var(--card);
  border-bottom: 1rpx solid var(--sep);
}

.cell:last-child {
  border-bottom: none;
}

.cell-text {
  font-size: var(--text-md);
  color: var(--text1);
}

.cell-value {
  font-size: var(--text-sm);
  color: var(--text3);
}

.cell-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid var(--text4);
  border-right: 2rpx solid var(--text4);
  transform: rotate(45deg);
  margin-left: 12rpx;
}

/* ===== 分隔线 ===== */
.divider {
  height: 1rpx;
  background: var(--sep);
  margin: 0 32rpx;
}

/* ===== 安全区域适配 ===== */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
