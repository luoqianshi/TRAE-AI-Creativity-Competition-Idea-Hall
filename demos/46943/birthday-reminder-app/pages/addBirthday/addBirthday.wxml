<view class="container">
  <view class="form-card">

    <view class="form-item">
      <text class="form-label">姓名 <text class="required">*</text></text>
      <input class="form-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onNameInput" />
    </view>

    <view class="form-item">
      <text class="form-label">生日日期 <text class="required">*</text></text>
      <view class="date-picker-row">
        <view class="type-selector" bindtap="showTypePicker">
          <text class="type-selected">{{form.birthdayType === 'lunar' ? '农历' : '公历'}}</text>
          <text class="type-arrow">▾</text>
        </view>
        <view class="date-col" bindtap="showYearPicker">
          <text class="date-col-value">{{pickedYear}}</text>
          <text class="date-col-arrow">▾</text>
        </view>
        <view class="date-col" bindtap="showMonthPicker">
          <text class="date-col-value">{{pickedMonthStr}}</text>
          <text class="date-col-arrow">▾</text>
        </view>
        <view class="date-col" bindtap="showDayPicker">
          <text class="date-col-value">{{pickedDayStr}}</text>
          <text class="date-col-arrow">▾</text>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">关系</text>
      <view class="relation-grid">
        <view class="relation-option {{form.relation === 'family' ? 'active' : ''}}" bindtap="selectRelation" data-value="family">家人</view>
        <view class="relation-option {{form.relation === 'friend' ? 'active' : ''}}" bindtap="selectRelation" data-value="friend">好友</view>
        <view class="relation-option {{form.relation === 'colleague' ? 'active' : ''}}" bindtap="selectRelation" data-value="colleague">同事</view>
        <view class="relation-option {{form.relation === 'leader' ? 'active' : ''}}" bindtap="selectRelation" data-value="leader">领导</view>
        <view class="relation-option {{form.relation === 'other' ? 'active' : ''}}" bindtap="selectRelation" data-value="other">自定义标签</view>
      </view>
      <view class="custom-tag-input {{form.relation === 'other' ? 'show' : ''}}">
        <input class="form-input" placeholder="请输入自定义标签，如：同学、邻居" value="{{form.customTag}}" maxlength="10" bindinput="onCustomTagInput" />
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">邮箱地址</text>
      <input class="form-input" placeholder="用于邮件提醒（选择邮件时必填）" value="{{form.email}}" bindinput="onEmailInput" />
    </view>

    <view class="form-item">
      <text class="form-label">提醒设置</text>
      <view class="reminder-list">
        <view class="reminder-row" wx:for="{{remindStrategy}}" wx:key="index">
          <view class="reminder-main">
            <view class="reminder-pill" bindtap="showReminderDayPicker" data-index="{{index}}">{{item.dayLabel || '当天'}}</view>
            <view class="reminder-pill" bindtap="showReminderTimePicker" data-index="{{index}}">{{item.timeValue}}</view>
            <view class="reminder-pill" bindtap="showReminderChannelPicker" data-index="{{index}}">{{item.channelLabel || '微信+邮件'}}</view>
          </view>
          <view class="reminder-actions">
            <view class="reminder-action add" bindtap="addReminderItem" data-index="{{index}}">+</view>
            <view class="reminder-action delete" wx:if="{{remindStrategy.length > 1}}" bindtap="deleteReminderItem" data-index="{{index}}">−</view>
          </view>
        </view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">备注</text>
      <textarea class="form-textarea" placeholder="添加备注信息（可选）" value="{{form.remark}}" bindinput="onRemarkInput" />
    </view>

  </view>

  <button class="submit-btn" bindtap="submitForm">保存</button>

  <view class="picker-overlay {{showPicker ? 'show' : ''}}" bindtap="closePicker">
    <view class="picker-panel" catchtap="preventClose">
      <view class="picker-header">
        <text class="picker-title">{{pickerTitle}}</text>
        <text class="picker-close" bindtap="closePickerDirect">完成</text>
      </view>
      <picker-view class="picker-view" value="{{pickerValue}}" bindchange="onPickerChange">
        <picker-view-column>
          <view wx:for="{{pickerItems}}" wx:key="index" class="picker-item {{item.value === pickerSelected ? 'selected' : ''}}">
            {{item.label}}
          </view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>
</view>
