.container {
  padding: 0 0 80rpx;
  background: #F5F4F0;
  min-height: 100vh;
}

.form-card {
  background: #FFFFFF;
  border-radius: 0;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.form-item {
  margin: 0;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(60,60,67,0.13);
}

.form-item:last-of-type {
  border-bottom: none;
}

.form-label {
  display: block;
  font-size: 30rpx;
  font-weight: 400;
  color: #8E8E93;
  margin-bottom: 14rpx;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.required {
  color: #E8654A;
}

.form-input {
  width: 100%;
  height: 84rpx;
  background: transparent;
  border-radius: 0;
  padding: 0;
  font-size: 28rpx;
  color: #1C1C1E;
  border: none;
  outline: none;
}

.form-input::placeholder {
  color: #C7C7CC;
  font-size: 26rpx;
}

/* 日期选择器 */
.date-picker-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.type-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #F5F4F0;
  border-radius: 18rpx;
  padding: 20rpx 16rpx;
  min-width: 120rpx;
  border: 1.5px solid transparent;
}

.type-selector:active {
  border-color: #E8654A;
  background: #FDF1EE;
}

.type-selected {
  font-size: 26rpx;
  color: #3C3C43;
}

.type-arrow {
  font-size: 22rpx;
  color: #C7C7CC;
}

.date-col {
  flex: 1;
  background: #F5F4F0;
  border-radius: 18rpx;
  padding: 20rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 1.5px solid transparent;
  min-width: 0;
}

.date-col:active {
  border-color: #E8654A;
  background: #FDF1EE;
}

.date-col-value {
  font-size: 26rpx;
  font-weight: 400;
  color: #3C3C43;
}

.date-col-arrow {
  font-size: 22rpx;
  color: #C7C7CC;
}

/* 关系选择 */
.relation-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.relation-option {
  padding: 14rpx 32rpx;
  background: #F5F4F0;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #8E8E93;
  border: 1.5px solid transparent;
}

.relation-option.active {
  background: #FDF1EE;
  color: #E8654A;
  border-color: #E8654A;
}

.custom-tag-input {
  display: none;
  margin-top: 24rpx;
}

.custom-tag-input.show {
  display: block;
}

/* 提醒设置 */
.reminder-list {
  background: #F5F4F0;
  border-radius: 18rpx;
  padding: 8rpx 20rpx;
}

.reminder-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.12);
}

.reminder-row:last-child {
  border-bottom: none;
}

.reminder-main {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}

.reminder-pill {
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #3C3C43;
  font-size: 26rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.13);
}

.reminder-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.reminder-action {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
  color: #FFFFFF;
}

.reminder-action.add {
  background: #E8654A;
}

.reminder-action.delete {
  background: #C7C7CC;
}

/* 备注 */
.form-textarea {
  width: 100%;
  height: 180rpx;
  background: transparent;
  border-radius: 0;
  padding: 0;
  font-size: 26rpx;
  color: #1C1C1E;
  border: none;
  outline: none;
  resize: none;
}

.form-textarea::placeholder {
  color: #C7C7CC;
  font-size: 26rpx;
}

/* 提交按钮 */
.submit-btn {
  width: calc(100% - 64rpx);
  height: 100rpx;
  background: #E8654A;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 26rpx;
  border: none;
  margin: 32rpx 32rpx 0;
  letter-spacing: -0.2px;
}

.submit-btn::after {
  border: none;
}

/* 日期选择器弹层 */
.picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 500;
  display: none;
  align-items: flex-end;
  justify-content: center;
}

.picker-overlay.show {
  display: flex;
}

.picker-panel {
  width: 100%;
  max-width: 750rpx;
  background: #FFFDF8;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 0 40rpx;
  animation: slideUp 0.22s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 40rpx;
  border-bottom: 1rpx solid rgba(60,60,67,0.13);
}

.picker-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.picker-close {
  font-size: 28rpx;
  color: #E8654A;
  font-weight: 600;
}

.picker-view {
  height: 440rpx;
  width: 100%;
}

.picker-item {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #3C3C43;
  text-align: center;
}

.picker-item.selected {
  color: #E8654A;
  font-weight: 600;
  font-size: 34rpx;
}
