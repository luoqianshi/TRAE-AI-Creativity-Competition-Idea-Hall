.container {
  padding: 0 0 200rpx;
  background: #F5F4F0;
  min-height: 100vh;
}

/* 筛选网格 */
.filter-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding: 28rpx 32rpx 24rpx;
}

.filter-chip {
  padding: 14rpx 0;
  border-radius: 40rpx;
  background: #FFFFFF;
  color: #3C3C43;
  font-size: 26rpx;
  text-align: center;
  border: 1.5px solid transparent;
}

.filter-chip.active {
  background: #FDF1EE;
  color: #E8654A;
  border-color: #E8654A;
}

/* 列表容器 */
.list-wrapper {
  margin: 0 32rpx;
  border-radius: 26rpx;
  overflow: hidden;
}

/* 分组标题 */
.list-group-title {
  font-size: 26rpx;
  font-weight: 400;
  color: #8E8E93;
  padding: 28rpx 32rpx 12rpx;
  letter-spacing: 0.3px;
  text-transform: uppercase;
}

.group-card {
  background: #FFFFFF;
  border-radius: 26rpx;
  overflow: hidden;
}

/* 列表项 */
.list-item {
  background: #FFFFFF;
  border-radius: 0;
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(60,60,67,0.13);
}

.list-item:first-child {
  border-top-left-radius: 26rpx;
  border-top-right-radius: 26rpx;
}

.list-item:last-child {
  border-bottom-left-radius: 26rpx;
  border-bottom-right-radius: 26rpx;
  border-bottom: none;
}

.list-item.today-highlight {
  background: #FFF5F0;
}

.item-main {
  display: flex;
  align-items: center;
  flex: 1;
}

.item-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #E8654A;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.item-avatar.av-family { background: #E8654A; }
.item-avatar.av-friend { background: #E8654A; }
.item-avatar.av-colleague { background: #E8654A; }
.item-avatar.av-leader { background: #E8654A; }
.item-avatar.av-other { background: #E8654A; }

.item-info {
  display: flex;
  flex-direction: column;
}

.item-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1C1C1E;
}

.item-tag {
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.item-tag.family { background: #FFF0E8; color: #E8654A; }
.item-tag.friend { background: #E3F5EE; color: #2E9E71; }
.item-tag.colleague { background: #EBE8F8; color: #6B5CE7; }
.item-tag.other { background: #EEECE7; color: #8E8E93; }
.item-tag.leader { background: #E3EEF8; color: #2B7ABE; }

.item-date {
  font-size: 26rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}

.item-right {
  text-align: right;
}

.item-countdown {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #E8654A;
}

.item-countdown.urgent {
  color: #E8654A;
}

.item-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 6rpx;
  justify-content: flex-end;
}

.action-btn {
  font-size: 26rpx;
  color: #8E8E93;
}

.action-btn.delete {
  color: #8E8E93;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #8E8E93;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 56rpx;
  bottom: 196rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #E8654A;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(232,101,74,0.4);
  z-index: 100;
}

.fab-icon {
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}
