<view class="container">
  <!-- 筛选标签 -->
  <view class="filter-grid">
    <view class="filter-chip {{currentFilter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-filter="all">全部</view>
    <view class="filter-chip {{currentFilter === 'family' ? 'active' : ''}}" bindtap="setFilter" data-filter="family">家人</view>
    <view class="filter-chip {{currentFilter === 'friend' ? 'active' : ''}}" bindtap="setFilter" data-filter="friend">好友</view>
    <view class="filter-chip {{currentFilter === 'colleague' ? 'active' : ''}}" bindtap="setFilter" data-filter="colleague">同事</view>
    <view class="filter-chip {{currentFilter === 'leader' ? 'active' : ''}}" bindtap="setFilter" data-filter="leader">领导</view>
  </view>

  <!-- 全部模式：不分组列表 -->
  <view class="list-wrapper" wx:if="{{currentFilter === 'all'}}">
    <view class="list-item {{item.isToday ? 'today-highlight' : ''}}" wx:for="{{filteredList}}" wx:key="_id">
      <view class="item-main">
        <view class="item-avatar av-{{item.relation}}">{{item.name[0]}}</view>
        <view class="item-info">
          <view class="item-name-row">
            <text class="item-name">{{item.name}}</text>
            <view class="item-tag {{item.relation}}">{{item.relationText}}</view>
          </view>
          <text class="item-date">{{item.dateDisplay}}</text>
        </view>
      </view>
      <view class="item-right">
        <text class="item-countdown {{item.isToday || item.daysUntil <= 7 ? 'urgent' : ''}}">
          {{item.daysUntil === 0 ? '今天' : item.daysUntil + '天后'}}
        </text>
        <view class="item-actions">
          <text class="action-btn" bindtap="editItem" data-id="{{item._id}}">编辑</text>
          <text class="action-btn delete" bindtap="deleteItem" data-id="{{item._id}}">删除</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{filteredList.length === 0}}">
      <text class="empty-text">暂无记录</text>
    </view>
  </view>

  <!-- 筛选模式：按标签分组 -->
  <view class="list-wrapper" wx:if="{{currentFilter !== 'all'}}">
    <block wx:for="{{groupedList}}" wx:key="groupName" wx:for-item="group">
      <view class="list-group-title">{{group.groupName}} ({{group.items.length}})</view>
      <view class="group-card">
        <view class="list-item {{item.isToday ? 'today-highlight' : ''}}" wx:for="{{group.items}}" wx:key="_id" wx:for-item="item">
          <view class="item-main">
            <view class="item-avatar av-{{item.relation}}">{{item.name[0]}}</view>
            <view class="item-info">
              <view class="item-name-row">
                <text class="item-name">{{item.name}}</text>
                <view class="item-tag {{item.relation}}">{{item.relationText}}</view>
              </view>
              <text class="item-date">{{item.dateDisplay}}</text>
            </view>
          </view>
          <view class="item-right">
            <text class="item-countdown {{item.isToday || item.daysUntil <= 7 ? 'urgent' : ''}}">
              {{item.daysUntil === 0 ? '今天' : item.daysUntil + '天后'}}
            </text>
            <view class="item-actions">
              <text class="action-btn" bindtap="editItem" data-id="{{item._id}}">编辑</text>
              <text class="action-btn delete" bindtap="deleteItem" data-id="{{item._id}}">删除</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="empty-state" wx:if="{{groupedList.length === 0}}">
      <text class="empty-text">暂无记录</text>
    </view>
  </view>

  <!-- 浮动添加按钮 -->
  <view class="fab" bindtap="goToAdd">
    <text class="fab-icon">+</text>
  </view>
</view>
