<view class="app">
  <view class="status-bar">
    <text class="status-title">{{navTitle}}</text>
  </view>

  <scroll-view class="content {{showTabBar ? 'with-tab' : ''}}" scroll-y>
    <view wx:if="{{currentPage === 'home'}}" class="page page-home">
      <view class="section">
        <view class="section-header">
          <view class="section-left">
            <text class="section-title">卡片列表</text>
            <view class="search-icon" bindtap="toggleSearch">⌕</view>
          </view>
          <text class="section-count">共{{homeRecords.length}}条</text>
        </view>
        <view class="search-bar {{showSearch ? 'show' : ''}}">
          <input class="search-input" placeholder="搜索姓名或事件名称" value="{{searchKeyword}}" bindinput="onSearchInput" />
        </view>

        <view wx:if="{{homeRecords.length === 0}}" class="empty-state">
          <text class="empty-text">还没有添加记录</text>
          <text class="empty-sub">点击底部 + 按钮添加吧</text>
        </view>

        <view wx:for="{{homeRecords}}" wx:key="id" class="birthday-card {{item.isToday ? 'today' : ''}}" data-id="{{item.id}}" bindtap="editRecord">
          <view class="card-header">
            <view class="avatar av-{{item.relation}}">{{item.icon}}</view>
            <view class="card-info">
              <view class="card-name-row">
                <text class="name">{{item.name}}</text>
              </view>
              <view class="detail">
                <text class="detail-text">{{item.detail}}</text>
                <text class="detail-bell {{item.nextReminder ? '' : 'no-reminder'}}">⌁</text>
                <text class="detail-reminder">{{item.reminderText}}</text>
              </view>
            </view>
            <view class="card-countdown">
              <text class="count-num {{item.daysUntil <= 7 ? 'urgent' : ''}}">{{item.daysUntil}}</text>
              <text class="count-unit">{{item.isToday ? '今天' : '天后'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{currentPage === 'add'}}" class="page page-add">
      <view class="form-card">
        <view class="form-item form-row">
          <text class="form-label">类型</text>
          <view class="picker-trigger" bindtap="openEventTypePicker">
            <text>{{form.type === 'birthday' ? '生日提醒' : '事件提醒'}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </view>

        <block wx:if="{{form.type === 'birthday'}}">
          <view class="form-item form-row">
            <text class="form-label">姓名 <text class="required">*</text></text>
            <input class="form-input inline-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onFormInput" data-field="name" />
          </view>

          <view class="form-item date-form-row">
            <text class="form-label">生日 <text class="required">*</text></text>
            <view class="date-card">
              <picker mode="date" value="{{form.birthDate}}" start="1900-01-01" end="2100-12-31" bindchange="onBirthDateChange">
                <view class="date-main">
                  <text class="date-text">{{form.birthDate}}</text>
                  <text class="date-week">{{form.birthWeek}}</text>
                </view>
              </picker>
              <view class="calendar-switch">
                <view class="calendar-option {{form.dateType === 'solar' ? 'active' : ''}}" data-type="solar" bindtap="selectDateType">公历</view>
                <view class="calendar-option {{form.dateType === 'lunar' ? 'active' : ''}}" data-type="lunar" bindtap="selectDateType">农历</view>
              </view>
            </view>
          </view>

          <view class="form-item form-row">
            <text class="form-label">关系</text>
            <view class="picker-trigger" bindtap="openRelationPicker">
              <text>{{form.relationText}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </view>

          <view class="form-item form-row" wx:if="{{form.relation === 'other'}}">
            <text class="form-label">自定义关系</text>
            <input class="form-input inline-input" placeholder="请输入关系" value="{{form.customRelation}}" bindinput="onFormInput" data-field="customRelation" />
          </view>
        </block>

        <block wx:else>
          <view class="form-item form-row">
            <text class="form-label">事件名称 <text class="required">*</text></text>
            <input class="form-input inline-input" placeholder="请输入事件名称" value="{{form.eventName}}" bindinput="onFormInput" data-field="eventName" />
          </view>

          <view class="form-item date-form-row">
            <text class="form-label">目标日 <text class="required">*</text></text>
            <view class="date-card">
              <picker mode="date" value="{{form.targetDate}}" start="2020-01-01" end="2100-12-31" bindchange="onTargetDateChange">
                <view class="date-main">
                  <text class="date-text">{{form.targetDate}}</text>
                  <text class="date-week">{{form.targetWeek}}</text>
                </view>
              </picker>
              <view class="calendar-switch">
                <view class="calendar-option {{form.targetDateType === 'solar' ? 'active' : ''}}" data-type="solar" bindtap="selectTargetDateType">公历</view>
                <view class="calendar-option {{form.targetDateType === 'lunar' ? 'active' : ''}}" data-type="lunar" bindtap="selectTargetDateType">农历</view>
              </view>
            </view>
          </view>

          <view class="form-item form-row">
            <text class="form-label">分类</text>
            <input class="form-input inline-input" placeholder="请输入分类" value="{{form.category}}" bindinput="onFormInput" data-field="category" />
          </view>
        </block>

        <view class="form-item date-form-row reminder-setting-row">
          <view class="reminder-setting-header">
            <text class="form-label">提醒设置</text>
            <view class="switch {{multiReminderOn ? 'on' : ''}}" bindtap="toggleMultiReminder"></view>
          </view>
          <view class="reminder-list" wx:if="{{multiReminderOn}}">
            <view class="reminder-row" wx:for="{{remindStrategy}}" wx:key="index">
              <view class="reminder-main">
                <view class="reminder-pill" data-index="{{index}}" bindtap="openReminderDayPicker">{{item.dayLabel}}</view>
                <view class="reminder-pill" data-index="{{index}}" bindtap="openReminderTimePicker">{{item.timeValue}}</view>
                <view class="reminder-pill" data-index="{{index}}" bindtap="openReminderChannelPicker">{{item.channelLabel}}</view>
              </view>
              <view class="reminder-actions">
                <view class="reminder-action add" data-index="{{index}}" bindtap="addReminderItem">+</view>
                <view wx:if="{{remindStrategy.length > 1}}" class="reminder-action delete" data-index="{{index}}" bindtap="deleteReminderItem">−</view>
              </view>
            </view>
          </view>
        </view>

        <view class="form-item form-row" wx:if="{{form.type === 'birthday'}}">
          <text class="form-label">显示年龄</text>
          <view class="switch {{form.showAge ? 'on' : ''}}" bindtap="toggleShowAge"></view>
        </view>

        <view class="form-item form-row" wx:if="{{form.type === 'custom'}}">
          <text class="form-label">重复周期</text>
          <view class="repeat-control">
            <view class="reminder-pill" bindtap="openRepeatPicker">{{form.repeatLabel}}</view>
            <view class="switch {{form.useRepeatReminder ? 'on' : ''}}" bindtap="toggleRepeat"></view>
          </view>
        </view>

        <view class="form-actions">
          <button class="cancel-btn" bindtap="cancelForm">取消</button>
          <button class="submit-btn small" bindtap="submitForm">保存</button>
        </view>
      </view>
    </view>

    <view wx:elif="{{currentPage === 'list'}}" class="page page-list">
      <view class="filter-grid">
        <view wx:for="{{filters}}" wx:key="key" class="filter-chip {{currentFilter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="setFilter">{{item.label}}</view>
      </view>

      <view wx:if="{{listRecords.length === 0}}" class="empty-state">
        <text class="empty-text">暂无记录</text>
      </view>

      <view wx:for="{{listRecords}}" wx:key="id" class="list-card">
        <view class="list-main">
          <text class="list-name">{{item.name}}</text>
          <text class="list-detail">{{item.detail}} · {{item.reminderText}}</text>
        </view>
        <view class="list-actions">
          <text class="action-btn" data-id="{{item.id}}" bindtap="editRecord">编辑</text>
          <text class="action-btn delete" data-id="{{item.id}}" bindtap="deleteRecord">删除</text>
        </view>
      </view>
      <view class="fab" bindtap="goToAdd">+</view>
    </view>

    <view wx:elif="{{currentPage === 'profile'}}" class="page page-profile">
      <view class="profile-header">
        <view class="profile-avatar">我</view>
        <view class="profile-info">
          <text class="profile-name">生日提醒用户</text>
          <text class="profile-id">测试号模式</text>
        </view>
      </view>

      <view class="settings-section-title">推送设置</view>
      <view class="settings-card">
        <view class="input-item">
          <text class="input-label">邮箱</text>
          <input class="input-field" placeholder="请输入接收提醒的邮箱" value="{{profileEmail}}" bindinput="onProfileEmailInput" />
        </view>
        <view class="setting-item">
          <view class="setting-info">
            <text class="setting-name">微信提醒</text>
            <text class="setting-desc">开启后通过微信订阅推送通知</text>
          </view>
          <view class="switch {{wechatPushOn ? 'on' : ''}}" bindtap="toggleWechatPush"></view>
        </view>
        <view class="setting-item" bindtap="showCalendarSuccess">
          <view class="setting-info">
            <text class="setting-name">添加到手机日历</text>
            <text class="setting-desc">当天9:00 自动弹出通知</text>
          </view>
          <view class="switch {{calendarOn ? 'on' : ''}}" catchtap="toggleCalendar"></view>
        </view>
      </view>

      <view class="settings-section-title">更多</view>
      <view class="menu-card">
        <view class="menu-item">
          <text class="menu-name">背景主题</text>
          <view class="switch {{themePanelOpen ? 'on' : ''}}" bindtap="openThemePanel"></view>
        </view>
        <view class="menu-item" data-title="添加小程序" data-content="请在微信中点击右上角「...」，选择「添加到我的小程序」，下次即可快速找到" bindtap="showInfoModal">
          <text class="menu-name">添加小程序</text><text class="arrow">›</text>
        </view>
        <view class="menu-item" data-title="分享好友" data-content="分享功能需要在微信环境中使用" bindtap="showInfoModal">
          <text class="menu-name">分享好友</text><text class="arrow">›</text>
        </view>
        <view class="menu-item" data-title="反馈和意见" data-content="感谢您的支持！可通过微信小程序反馈入口提交意见。" bindtap="showInfoModal">
          <text class="menu-name">反馈和意见</text><text class="arrow">›</text>
        </view>
        <view class="menu-item" bindtap="confirmClearAll">
          <text class="menu-name danger">清除数据</text><text class="arrow">›</text>
        </view>
      </view>
      <view class="version">版本 1.0.0</view>
    </view>
  </scroll-view>

  <view class="tab-bar" wx:if="{{showTabBar}}">
    <view class="tab-item {{currentPage === 'home' ? 'active' : ''}}" data-page="home" bindtap="switchPage">
      <text class="tab-icon">⌂</text>
      <text class="tab-text">首页</text>
    </view>
    <view class="tab-add-btn" bindtap="goToAdd">+</view>
    <view class="tab-item {{currentPage === 'profile' ? 'active' : ''}}" data-page="profile" bindtap="switchPage">
      <text class="tab-icon">♡</text>
      <text class="tab-text">我的</text>
    </view>
  </view>

  <view class="picker-overlay {{pickerOpen ? 'show' : ''}}" bindtap="closePicker">
    <view class="picker-panel" catchtap="stopTap">
      <view class="picker-header">
        <text class="picker-title">{{pickerTitle}}</text>
        <text class="picker-close" bindtap="closePicker">完成</text>
      </view>
      <view class="picker-list">
        <view wx:for="{{pickerItems}}" wx:key="value" class="picker-item {{item.value === pickerSelected ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectPickerItem">
          <text>{{item.label}}</text>
          <text wx:if="{{item.value === pickerSelected}}">✓</text>
        </view>
      </view>
    </view>
  </view>

  <view class="theme-picker-overlay {{themePanelOpen ? 'show' : ''}}" bindtap="closeThemePanel">
    <view class="theme-picker-panel" catchtap="stopTap">
      <view class="picker-header">
        <text class="picker-title">背景主题</text>
        <text class="picker-close" bindtap="closeThemePanel">完成</text>
      </view>
      <view class="theme-grid">
        <view wx:for="{{themeColors}}" wx:key="color" class="theme-chip" style="background:{{item.color}}" data-color="{{item.color}}" bindtap="selectTheme">{{item.name}}</view>
      </view>
    </view>
  </view>
</view>
