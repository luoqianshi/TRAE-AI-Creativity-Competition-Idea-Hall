:root {}
page {
  background: #FFFDF8;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.app {
  min-height: 100vh;
  background: #FFFDF8;
}

.status-bar {
  height: 96rpx;
  padding-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFDF8;
  position: sticky;
  top: 0;
  z-index: 10;
}

.status-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.content {
  height: calc(100vh - 96rpx);
  box-sizing: border-box;
}

.content.with-tab {
  height: calc(100vh - 216rpx);
}

.page {
  padding: 24rpx 32rpx 40rpx;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.section-count {
  font-size: 26rpx;
  color: #8E8E93;
}

.search-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8E8E93;
}

.search-bar {
  display: none;
  margin-bottom: 18rpx;
}

.search-bar.show {
  display: block;
}

.search-input {
  height: 72rpx;
  border-radius: 18rpx;
  background: #F5F4F0;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.birthday-card {
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid rgba(60, 60, 67, 0.10);
}

.birthday-card.today {
  border-left: 6rpx solid #E8654A;
}

.card-header {
  display: flex;
  align-items: center;
}

.avatar {
  width: 78rpx;
  height: 78rpx;
  border-radius: 22rpx;
  background: #FDF1EE;
  color: #E8654A;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  font-size: 34rpx;
}

.card-info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
}

.detail {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  color: #8E8E93;
  font-size: 26rpx;
}

.detail-text,
.detail-reminder {
  white-space: nowrap;
}

.detail-bell {
  color: #E8654A;
}

.detail-bell.no-reminder {
  color: #C7C7CC;
}

.card-countdown {
  width: 96rpx;
  text-align: right;
}

.count-num {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  color: #E8654A;
  line-height: 1;
}

.count-num.urgent {
  color: #E8654A;
}

.count-unit {
  font-size: 22rpx;
  color: #8E8E93;
}

.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #8E8E93;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #3C3C43;
}

.empty-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.form-card,
.settings-card,
.menu-card {
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 0 30rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}

.form-item,
.input-item,
.setting-item,
.menu-item {
  min-height: 104rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.12);
  padding: 20rpx 0;
  box-sizing: border-box;
}

.form-item:last-child,
.input-item:last-child,
.setting-item:last-child,
.menu-item:last-child {
  border-bottom: none;
}

.form-row,
.setting-item,
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.form-label,
.input-label,
.setting-name,
.menu-name {
  font-size: 28rpx;
  color: #3C3C43;
}

.required,
.danger {
  color: #E8654A;
}

.form-input,
.input-field {
  flex: 1;
  min-height: 64rpx;
  font-size: 28rpx;
  color: #1C1C1E;
}

.inline-input {
  text-align: right;
}

.picker-trigger,
.date-main,
.repeat-control {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx;
  color: #1C1C1E;
  font-size: 28rpx;
}

.picker-arrow {
  color: #8E8E93;
}

.date-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
}

.date-text {
  font-size: 28rpx;
  color: #3C3C43;
}

.date-week {
  font-size: 26rpx;
  color: #8E8E93;
}

.calendar-switch {
  display: flex;
  border: 1rpx solid #E8654A;
  border-radius: 999rpx;
  overflow: hidden;
}

.calendar-option {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #3C3C43;
  background: #FFFFFF;
}

.calendar-option.active {
  color: #FFFFFF;
  background: #E8654A;
}

.reminder-setting-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.reminder-list {
  background: #F5F4F0;
  border-radius: 18rpx;
  padding: 8rpx 20rpx;
  margin-top: 16rpx;
}

.reminder-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.10);
}

.reminder-row:last-child {
  border-bottom: none;
}

.reminder-main {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}

.reminder-pill {
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #3C3C43;
  font-size: 26rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.13);
}

.reminder-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.reminder-action {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 34rpx;
}

.reminder-action.add {
  background: #E8654A;
}

.reminder-action.delete {
  background: #C7C7CC;
}

.switch {
  width: 88rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #D1D1D6;
  position: relative;
  flex-shrink: 0;
}

.switch::after {
  content: '';
  position: absolute;
  width: 46rpx;
  height: 46rpx;
  left: 3rpx;
  top: 3rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.switch.on {
  background: #E8654A;
}

.switch.on::after {
  left: 39rpx;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  padding: 32rpx 0;
}

button {
  margin: 0;
}

.cancel-btn,
.submit-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  border: none;
}

.cancel-btn {
  background: #F5F4F0;
  color: #3C3C43;
}

.submit-btn {
  background: #E8654A;
  color: #FFFFFF;
}

.filter-grid {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.filter-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #F5F4F0;
  color: #8E8E93;
  font-size: 26rpx;
}

.filter-chip.active {
  background: #E8654A;
  color: #FFFFFF;
}

.list-card {
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.05);
}

.list-main {
  flex: 1;
}

.list-name {
  display: block;
  font-size: 30rpx;
  color: #1C1C1E;
  font-weight: 600;
}

.list-detail {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #8E8E93;
}

.list-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.action-btn {
  color: #E8654A;
  font-size: 26rpx;
}

.action-btn.delete {
  color: #D14343;
}

.fab {
  position: fixed;
  right: 38rpx;
  bottom: 150rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #E8654A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  box-shadow: 0 12rpx 28rpx rgba(232,101,74,0.35);
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 34rpx 0 20rpx;
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #E8654A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

.profile-info {
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
}

.profile-id,
.setting-desc {
  margin-top: 6rpx;
  color: #8E8E93;
  font-size: 24rpx;
}

.settings-section-title {
  margin: 34rpx 0 12rpx;
  color: #8E8E93;
  font-size: 26rpx;
}

.input-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.setting-info {
  display: flex;
  flex-direction: column;
}

.arrow {
  color: #C7C7CC;
  font-size: 36rpx;
}

.version {
  text-align: center;
  color: #C7C7CC;
  font-size: 24rpx;
  margin-top: 40rpx;
}

.tab-bar {
  height: 120rpx;
  background: #FFFFFF;
  border-top: 1rpx solid rgba(60, 60, 67, 0.13);
  display: flex;
  align-items: center;
  justify-content: space-around;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8E8E93;
  font-size: 22rpx;
}

.tab-item.active {
  color: #E8654A;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-add-btn {
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: #E8654A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin: 0 34rpx;
  box-shadow: 0 8rpx 22rpx rgba(232,101,74,0.36);
}

.picker-overlay,
.theme-picker-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0,0,0,0.35);
  display: none;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
}

.picker-overlay.show,
.theme-picker-overlay.show {
  display: flex;
}

.picker-panel,
.theme-picker-panel {
  width: 100%;
  max-height: 70vh;
  background: #FFFDF8;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: 28rpx;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 36rpx;
  border-bottom: 1rpx solid rgba(60,60,67,0.13);
}

.picker-title {
  font-size: 30rpx;
  color: #1C1C1E;
}

.picker-close {
  font-size: 28rpx;
  color: #E8654A;
}

.picker-list {
  max-height: 520rpx;
  overflow: hidden;
}

.picker-item {
  min-height: 88rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  color: #3C3C43;
  border-bottom: 1rpx solid rgba(60,60,67,0.08);
}

.picker-item.selected {
  color: #E8654A;
}

.theme-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 32rpx;
}

.theme-chip {
  height: 88rpx;
  border-radius: 18rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
