/* 全局样式 */
page {
  --bg: #FFF8F5;
  --bg2: #FFF0EB;
  --ink: #4A3F3A;
  --muted: #9E8E86;
  --rule: #E8D5CD;
  --accent: #C97B63;
  --accent2: #D4A574;
  --rose: #E8A5A5;
  --cream: #FDF6F0;
  --shadow: rgba(74, 63, 58, 0.08);

  background-color: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  line-height: 1.7;
}

/* 通用容器 */
.container {
  padding: 0 32rpx;
}

/* 卡片样式 */
.card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx var(--shadow);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: white;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-secondary {
  background: transparent;
  color: var(--accent);
  border: 2rpx solid var(--accent);
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
}

/* 标签样式 */
.tag {
  display: inline-block;
  background: var(--bg2);
  color: var(--accent);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

/* 区域标题 */
.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.section-subtitle {
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 32rpx;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.6s ease forwards;
}

/* 滚动条隐藏 */
::-webkit-scrollbar {
  display: none;
}
