/* 首页样式 */
.container {
  padding-bottom: 48rpx;
}

/* Hero 区域 */
.hero-section {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  margin: 0 -32rpx;
}

.hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.4;
}

.hero-content {
  position: relative;
  z-index: 2;
  padding: 48rpx 32rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(201, 123, 99, 0.15);
  border: 1rpx solid var(--accent);
  color: var(--accent);
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  width: fit-content;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(255,255,255,0.8);
}

.hero-subtitle {
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 32rpx;
}

.hero-stats {
  display: flex;
  gap: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent);
}

.stat-label {
  font-size: 22rpx;
  color: var(--muted);
}

/* 快捷操作 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin: 32rpx 0;
}

.action-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow);
  transition: transform 0.3s;
}

.action-card:active {
  transform: scale(0.95);
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.action-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 4rpx;
}

.action-desc {
  font-size: 20rpx;
  color: var(--muted);
}

/* 最近回忆 */
.recent-section {
  margin: 32rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.view-all {
  font-size: 26rpx;
  color: var(--accent);
}

.recent-scroll {
  width: 100vw;
  margin-left: -32rpx;
}

.recent-list {
  display: flex;
  padding: 0 32rpx;
  gap: 20rpx;
}

.recent-item {
  flex-shrink: 0;
  width: 280rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx var(--shadow);
}

.recent-image {
  width: 100%;
  height: 200rpx;
  overflow: hidden;
}

.recent-image image {
  width: 100%;
  height: 100%;
}

.recent-image.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 48rpx;
}

.recent-info {
  padding: 16rpx;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 4rpx;
}

.recent-date {
  font-size: 22rpx;
  color: var(--muted);
}

/* 功能介绍 */
.features-section {
  margin-top: 32rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: white;
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow);
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  background: var(--bg2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.feature-info {
  flex: 1;
}

.feature-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 4rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: var(--muted);
}

/* 浮动添加按钮 */
.add-float {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(201, 123, 99, 0.4);
  z-index: 100;
}

.add-float text {
  color: white;
  font-size: 48rpx;
  font-weight: 300;
}
