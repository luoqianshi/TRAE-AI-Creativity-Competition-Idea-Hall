<view class="container">
  <!-- 头部欢迎区 -->
  <view class="hero-section">
    <view class="hero-content">
      <view class="hero-badge">
        <text>💕</text>
        <text>记录爱的每一刻</text>
      </view>
      <view class="hero-title">时光纪念册</view>
      <view class="hero-subtitle">为情侣与家庭打造的专属记忆空间</view>
      <view class="hero-stats">
        <view class="stat-item">
          <text class="stat-num">{{journeyData.years}}</text>
          <text class="stat-label">年相伴</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{journeyData.photoCount}}</text>
          <text class="stat-label">张照片</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{memories.length}}</text>
          <text class="stat-label">个节点</text>
        </view>
      </view>
    </view>
    <image class="hero-image" src="/images/family-memory.jpg" mode="aspectFill"/>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="action-card" bindtap="goToTimeline">
      <view class="action-icon" style="background: linear-gradient(135deg, #C97B63, #E8A5A5);">📅</view>
      <text class="action-title">时间线</text>
      <text class="action-desc">回顾美好历程</text>
    </view>
    <view class="action-card" bindtap="goToGallery">
      <view class="action-icon" style="background: linear-gradient(135deg, #D4A574, #C97B63);">📸</view>
      <text class="action-title">相册</text>
      <text class="action-desc">浏览珍贵瞬间</text>
    </view>
    <view class="action-card" bindtap="goToJourney">
      <view class="action-icon" style="background: linear-gradient(135deg, #E8A5A5, #D4A574);">🗺️</view>
      <text class="action-title">轨迹</text>
      <text class="action-desc">查看足迹地图</text>
    </view>
    <view class="action-card" bindtap="goToAdd">
      <view class="action-icon" style="background: linear-gradient(135deg, #C97B63, #D4A574);">✏️</view>
      <text class="action-title">添加</text>
      <text class="action-desc">记录新回忆</text>
    </view>
  </view>

  <!-- 最近回忆 -->
  <view class="recent-section">
    <view class="section-header">
      <text class="section-title">最近回忆</text>
      <text class="view-all" bindtap="goToTimeline">查看全部 ></text>
    </view>
    <scroll-view scroll-x class="recent-scroll" enhanced show-scrollbar="{{false}}">
      <view class="recent-list">
        <view class="recent-item" wx:for="{{recentMemories}}" wx:key="id" bindtap="viewMemory" data-id="{{item.id}}">
          <view class="recent-image" wx:if="{{item.images.length > 0}}">
            <image src="{{item.images[0]}}" mode="aspectFill"/>
          </view>
          <view class="recent-image placeholder" wx:else style="background: linear-gradient(135deg, var(--bg2), var(--cream));">
            <text class="placeholder-icon">📝</text>
          </view>
          <view class="recent-info">
            <text class="recent-title">{{item.title}}</text>
            <text class="recent-date">{{item.date}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 功能介绍 -->
  <view class="features-section">
    <view class="section-title" style="text-align: center; margin-bottom: 32rpx;">功能特色</view>
    <view class="feature-list">
      <view class="feature-item">
        <view class="feature-icon">📅</view>
        <view class="feature-info">
          <text class="feature-name">时间线展示</text>
          <text class="feature-desc">精美时间轴，串联人生重要节点</text>
        </view>
      </view>
      <view class="feature-item">
        <view class="feature-icon">📸</view>
        <view class="feature-info">
          <text class="feature-name">多媒体上传</text>
          <text class="feature-desc">支持图片、视频，记录更丰富</text>
        </view>
      </view>
      <view class="feature-item">
        <view class="feature-icon">🗺️</view>
        <view class="feature-info">
          <text class="feature-name">轨迹生成</text>
          <text class="feature-desc">自动生成人生足迹地图</text>
        </view>
      </view>
      <view class="feature-item">
        <view class="feature-icon">💝</view>
        <view class="feature-info">
          <text class="feature-name">氛围营造</text>
          <text class="feature-desc">温馨配色，浪漫浏览体验</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view class="add-float" bindtap="goToAdd">
    <text>+</text>
  </view>
</view>
