<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">{{isViewMode ? memory.title : '添加回忆'}}</text>
    <text class="page-subtitle" wx:if="{{!isViewMode}}">记录当下的美好瞬间</text>
  </view>

  <!-- 查看模式 -->
  <view wx:if="{{isViewMode}}" class="view-mode">
    <view class="memory-date">{{memory.date}} {{memory.location ? '· ' + memory.location : ''}}</view>
    <view class="memory-images" wx:if="{{memory.images.length > 0}}">
      <image wx:for="{{memory.images}}" wx:key="*this" src="{{item}}" mode="widthFix" class="memory-image"/>
    </view>
    <view class="memory-desc">{{memory.description}}</view>
    <view class="memory-tags">
      <text class="tag" wx:for="{{memory.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
    </view>
  </view>

  <!-- 编辑模式 -->
  <view wx:else class="form-mode">
    <view class="form-group">
      <text class="form-label">标题</text>
      <input class="form-input" placeholder="给这个回忆起个名字" value="{{form.title}}" bindinput="onTitleInput"/>
    </view>

    <view class="form-group">
      <text class="form-label">日期</text>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="form-picker">{{form.date || '选择日期'}}</view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">地点</text>
      <input class="form-input" placeholder="例如：北京、上海" value="{{form.location}}" bindinput="onLocationInput"/>
    </view>

    <view class="form-group">
      <text class="form-label">描述</text>
      <textarea class="form-textarea" placeholder="写下当时的心情和故事..." value="{{form.description}}" bindinput="onDescInput"/>
    </view>

    <view class="form-group">
      <text class="form-label">标签</text>
      <input class="form-input" placeholder="用逗号分隔，例如：旅行,美食,生日" value="{{form.tags}}" bindinput="onTagsInput"/>
    </view>

    <view class="form-group">
      <text class="form-label">照片/视频</text>
      <view class="upload-area" bindtap="chooseMedia">
        <text class="upload-icon">📷</text>
        <text class="upload-text">点击添加照片或视频</text>
      </view>
      <view class="preview-list" wx:if="{{form.images.length > 0}}">
        <view class="preview-item" wx:for="{{form.images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill"/>
          <view class="preview-remove" bindtap="removeImage" data-index="{{index}}">×</view>
        </view>
      </view>
    </view>

    <button class="btn-primary submit-btn" bindtap="submitMemory">保存回忆</button>
  </view>
</view>
