/* 添加回忆页面 */
.container {
  padding: 32rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--muted);
}

/* 查看模式 */
.view-mode {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx var(--shadow);
}

.memory-date {
  font-size: 26rpx;
  color: var(--accent);
  margin-bottom: 20rpx;
}

.memory-images {
  margin-bottom: 24rpx;
}

.memory-image {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.memory-desc {
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.memory-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.memory-tags .tag {
  margin: 0;
}

/* 表单模式 */
.form-mode {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.form-input,
.form-picker,
.form-textarea {
  background: white;
  border: 2rpx solid var(--rule);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.form-textarea {
  min-height: 200rpx;
  resize: none;
}

.form-picker {
  color: var(--muted);
}

.upload-area {
  background: var(--bg2);
  border: 2rpx dashed var(--accent);
  border-radius: 16rpx;
  padding: 48rpx;
  text-align: center;
}

.upload-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 26rpx;
  color: var(--muted);
}

.preview-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.preview-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-item image {
  width: 100%;
  height: 100%;
}

.preview-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.submit-btn {
  margin-top: 32rpx;
}
