<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">美好瞬间</text>
    <text class="page-subtitle">每一张照片，都是一段故事</text>
  </view>

  <!-- 筛选标签 -->
  <scroll-view scroll-x class="filter-bar" enhanced show-scrollbar="{{false}}">
    <view class="filter-list">
      <view class="filter-item {{currentFilter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-filter="all">
        <text>全部</text>
      </view>
      <view class="filter-item {{currentFilter === 'image' ? 'active' : ''}}" bindtap="setFilter" data-filter="image">
        <text>照片</text>
      </view>
      <view class="filter-item {{currentFilter === 'video' ? 'active' : ''}}" bindtap="setFilter" data-filter="video">
        <text>视频</text>
      </view>
      <view class="filter-item {{currentFilter === 'text' ? 'active' : ''}}" bindtap="setFilter" data-filter="text">
        <text>文字</text>
      </view>
    </view>
  </scroll-view>

  <!-- 相册网格 -->
  <view class="gallery-grid">
    <view class="gallery-item" wx:for="{{filteredMemories}}" wx:key="id" bindtap="viewMemory" data-id="{{item.id}}">
      <image wx:if="{{item.images.length > 0}}" class="gallery-image" src="{{item.images[0]}}" mode="aspectFill"/>
      <view wx:else class="gallery-placeholder" style="background: linear-gradient(135deg, {{gradients[index % gradients.length]}});">
        <text class="placeholder-text">{{item.title[0]}}</text>
      </view>
      <view class="gallery-overlay">
        <text class="gallery-title">{{item.title}}</text>
        <text class="gallery-date">{{item.date}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{filteredMemories.length === 0}}">
    <text class="empty-icon">📷</text>
    <text class="empty-text">暂无此类回忆</text>
    <text class="empty-hint">去添加一些美好瞬间吧</text>
  </view>
</view>
