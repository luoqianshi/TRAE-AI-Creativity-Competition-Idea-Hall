/* 相册页面 */
.container {
  padding: 32rpx;
}

.page-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--muted);
}

/* 筛选栏 */
.filter-bar {
  margin-bottom: 32rpx;
  width: 100vw;
  margin-left: -32rpx;
}

.filter-list {
  display: flex;
  padding: 0 32rpx;
  gap: 16rpx;
}

.filter-item {
  padding: 12rpx 28rpx;
  background: white;
  border-radius: 32rpx;
  border: 2rpx solid var(--rule);
  font-size: 26rpx;
  color: var(--muted);
  white-space: nowrap;
  transition: all 0.3s;
}

.filter-item.active {
  background: var(--accent);
  color: white;
  border-color: var(--accent);
}

/* 相册网格 */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.gallery-item {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  aspect-ratio: 1;
  box-shadow: 0 4rpx 16rpx var(--shadow);
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.gallery-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  opacity: 0.8;
}

.gallery-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(74,63,58,0.7) 0%, transparent 60%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 20rpx;
  opacity: 0;
  transition: opacity 0.3s;
}

.gallery-item:active .gallery-overlay {
  opacity: 1;
}

.gallery-title {
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  display: block;
}

.gallery-date {
  color: rgba(255,255,255,0.8);
  font-size: 22rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--muted);
}
