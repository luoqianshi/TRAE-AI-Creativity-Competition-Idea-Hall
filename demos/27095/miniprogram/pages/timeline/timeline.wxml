<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">时间线</text>
    <text class="page-subtitle">每一个节点，都是爱的见证</text>
  </view>

  <!-- 时间线 -->
  <view class="timeline">
    <view class="timeline-item {{index % 2 === 0 ? 'left' : 'right'}}" wx:for="{{memories}}" wx:key="id" bindtap="viewMemory" data-id="{{item.id}}">
      <view class="timeline-dot"></view>
      <view class="timeline-date">{{item.date}}</view>
      <view class="timeline-card">
        <image wx:if="{{item.images.length > 0}}" class="card-image" src="{{item.images[0]}}" mode="aspectFill"/>
        <view class="card-content">
          <text class="card-title">{{item.title}}</text>
          <text class="card-location" wx:if="{{item.location}}">📍 {{item.location}}</text>
          <text class="card-desc">{{item.description}}</text>
          <view class="card-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="timeline-end">
    <text>继续书写你们的故事...</text>
  </view>
</view>
