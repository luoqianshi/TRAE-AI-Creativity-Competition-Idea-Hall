/* 时间线页面 */
.container {
  padding: 32rpx;
}

.page-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--muted);
}

/* 时间线 */
.timeline {
  position: relative;
  padding: 20rpx 0;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: linear-gradient(to bottom, var(--accent), var(--accent2), var(--rose));
  transform: translateX(-50%);
}

.timeline-item {
  position: relative;
  margin-bottom: 48rpx;
  display: flex;
  align-items: flex-start;
}

.timeline-item.left {
  flex-direction: row-reverse;
}

.timeline-item.left .timeline-card {
  margin-right: 40rpx;
  margin-left: 0;
}

.timeline-item.left .timeline-date {
  left: auto;
  right: calc(50% + 30rpx);
  text-align: right;
}

.timeline-dot {
  position: absolute;
  left: 50%;
  top: 20rpx;
  width: 24rpx;
  height: 24rpx;
  background: var(--accent);
  border: 6rpx solid var(--bg);
  border-radius: 50%;
  transform: translateX(-50%);
  z-index: 2;
  box-shadow: 0 0 0 8rpx rgba(201, 123, 99, 0.15);
}

.timeline-date {
  position: absolute;
  left: calc(50% + 30rpx);
  top: 12rpx;
  font-size: 24rpx;
  color: var(--accent);
  white-space: nowrap;
}

.timeline-card {
  width: calc(50% - 50rpx);
  margin-left: 40rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx var(--shadow);
  transition: transform 0.3s;
}

.timeline-card:active {
  transform: scale(0.98);
}

.card-image {
  width: 100%;
  height: 240rpx;
}

.card-content {
  padding: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  display: block;
  margin-bottom: 8rpx;
}

.card-location {
  font-size: 24rpx;
  color: var(--accent);
  display: block;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.5;
  display: block;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.card-tags .tag {
  margin: 0;
}

/* 底部提示 */
.timeline-end {
  text-align: center;
  padding: 32rpx;
  color: var(--muted);
  font-size: 26rpx;
}

/* 响应式 - 移动端单列 */
@media screen and (max-width: 375px) {
  .timeline::before {
    left: 20rpx;
  }

  .timeline-item,
  .timeline-item.left {
    flex-direction: column;
    padding-left: 60rpx;
  }

  .timeline-item.left .timeline-card,
  .timeline-card {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
  }

  .timeline-dot {
    left: 20rpx;
  }

  .timeline-date {
    position: static;
    margin-bottom: 12rpx;
    text-align: left;
  }
}
