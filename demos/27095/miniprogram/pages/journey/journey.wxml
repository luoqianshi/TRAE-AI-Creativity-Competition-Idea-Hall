<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">我们的轨迹</text>
    <text class="page-subtitle">一路走来，每一步都值得纪念</text>
  </view>

  <!-- 地图区域 -->
  <view class="map-card">
    <map
      id="journeyMap"
      class="journey-map"
      latitude="{{mapCenter.latitude}}"
      longitude="{{mapCenter.longitude}}"
      scale="{{mapScale}}"
      markers="{{markers}}"
      polyline="{{polyline}}"
      show-location
    ></map>
    <view class="map-overlay">
      <view class="path-summary">
        <text class="path-text">已走过 {{journeyData.cities.length}} 个城市</text>
      </view>
    </view>
  </view>

  <!-- 统计数据 -->
  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-number">{{journeyData.cities.length}}</text>
      <text class="stat-label">城市足迹</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{journeyData.photoCount}}</text>
      <text class="stat-label">照片记录</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{journeyData.years}}</text>
      <text class="stat-label">年头相伴</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">∞</text>
      <text class="stat-label">美好回忆</text>
    </view>
  </view>

  <!-- 足迹列表 -->
  <view class="path-section">
    <text class="section-title">足迹详情</text>
    <view class="path-list">
      <view class="path-item" wx:for="{{journeyData.path}}" wx:key="city">
        <view class="path-marker">
          <view class="marker-dot"></view>
          <view class="marker-line" wx:if="{{index < journeyData.path.length - 1}}"></view>
        </view>
        <view class="path-content">
          <view class="path-header">
            <text class="path-city">{{item.city}}</text>
            <text class="path-date">{{item.date}}</text>
          </view>
          <text class="path-event">{{item.event}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
