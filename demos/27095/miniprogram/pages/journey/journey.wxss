/* 轨迹页面 */
.container {
  padding: 32rpx;
}

.page-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--muted);
}

/* 地图卡片 */
.map-card {
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx var(--shadow);
  margin-bottom: 32rpx;
  position: relative;
}

.journey-map {
  width: 100%;
  height: 500rpx;
}

.map-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(to top, rgba(255,248,245,0.95), transparent);
}

.path-summary {
  text-align: center;
}

.path-text {
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 600;
}

/* 统计数据 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.stat-card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx var(--shadow);
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent);
  display: block;
  line-height: 1;
}

.stat-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
  display: block;
}

/* 足迹列表 */
.path-section {
  margin-top: 16rpx;
}

.path-section .section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 24rpx;
  display: block;
}

.path-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.path-item {
  display: flex;
  gap: 20rpx;
}

.path-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  flex-shrink: 0;
}

.marker-dot {
  width: 20rpx;
  height: 20rpx;
  background: var(--accent);
  border-radius: 50%;
  border: 4rpx solid var(--bg);
  box-shadow: 0 0 0 4rpx rgba(201, 123, 99, 0.2);
}

.marker-line {
  flex: 1;
  width: 3rpx;
  background: linear-gradient(to bottom, var(--accent), var(--accent2));
  min-height: 80rpx;
}

.path-content {
  flex: 1;
  padding-bottom: 32rpx;
}

.path-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.path-city {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.path-date {
  font-size: 24rpx;
  color: var(--muted);
}

.path-event {
  font-size: 26rpx;
  color: var(--accent);
}
