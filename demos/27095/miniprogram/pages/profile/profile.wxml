<view class="container">
  <!-- 用户信息 -->
  <view class="user-card">
    <view class="user-avatar">
      <text>👩‍❤️‍👨</text>
    </view>
    <view class="user-info">
      <text class="user-name">我们的纪念册</text>
      <text class="user-desc">记录始于 2020年3月</text>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{memories.length}}</text>
      <text class="stat-name">回忆</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{journeyData.photoCount}}</text>
      <text class="stat-name">照片</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{journeyData.cities.length}}</text>
      <text class="stat-name">城市</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{journeyData.years}}</text>
      <text class="stat-name">年头</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goToTimeline">
      <view class="menu-icon" style="background: linear-gradient(135deg, #C97B63, #E8A5A5);">📅</view>
      <text class="menu-title">时间线</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToGallery">
      <view class="menu-icon" style="background: linear-gradient(135deg, #D4A574, #C97B63);">📸</view>
      <text class="menu-title">相册</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToJourney">
      <view class="menu-icon" style="background: linear-gradient(135deg, #E8A5A5, #D4A574);">🗺️</view>
      <text class="menu-title">轨迹</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 设置菜单 -->
  <view class="menu-card">
    <view class="menu-item">
      <view class="menu-icon" style="background: #f0f0f0; color: var(--muted);">🔔</view>
      <text class="menu-title">提醒设置</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item">
      <view class="menu-icon" style="background: #f0f0f0; color: var(--muted);">🔒</view>
      <text class="menu-title">隐私设置</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item">
      <view class="menu-icon" style="background: #f0f0f0; color: var(--muted);">💾</view>
      <text class="menu-title">数据备份</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item">
      <view class="menu-icon" style="background: #f0f0f0; color: var(--muted);">ℹ️</view>
      <text class="menu-title">关于我们</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>
