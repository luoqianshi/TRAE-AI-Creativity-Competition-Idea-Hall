<!--index.wxml - 君彧易学 首页-->
<view class="page">
  <!-- 顶部品牌区域 -->
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="brand">
        <text class="brand-name">君彧易学</text>
        <text class="brand-subtitle">传统智慧 · 精准计算</text>
      </view>
      <view class="header-desc">传统干支纪年趣味体验，探索你的性格特质</view>
    </view>
  </view>

  <!-- 核心功能入口 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">核心功能</text>
    </view>
    
    <view class="feature-grid">
      <view class="feature-card main-card" bindtap="goBazi" data-type="bazi">
        <view class="card-icon-wrap bazi-icon">
          <text class="card-emoji">☯</text>
        </view>
        <view class="card-info">
          <text class="card-title">时序转化</text>
          <text class="card-desc">时序 · 角色 · 阶段 · 星象</text>
        </view>
        <view class="card-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 更多功能 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">云开发能力</text>
      <text class="section-more">示例演示</text>
    </view>

    <view class="power-list" wx:key="title" wx:for="{{powerList}}" wx:for-item="power" wx:if="{{power.title !== '时序转化'}}">
      <view class="power-row" data-index="{{index}}" data-type="{{ power.type }}" bindtap="onClickPowerInfo">
        <view class="power-left">
          <view class="power-dot {{power.dotColor || 'dot-default'}}"></view>
          <view class="power-text-group">
            <text class="power-title">{{power.title}}</text>
            <text class="power-tip">{{power.tip}}</text>
          </view>
        </view>
        <image wx:if="{{power.item.length > 0 && !power.showItem}}" class="arrow-down" src="../../images/arrow.svg" mode="aspectFit"></image>
        <image wx:if="{{power.item.length > 0 && power.showItem}}" class="arrow-up" src="../../images/arrow.svg" mode="aspectFit"></image>
        <image wx:if="{{power.item.length === 0}}" class="arrow-right" src="../../images/arrow.svg" mode="aspectFit"></image>
      </view>

      <!-- 展开的子项 -->
      <view class="power-sub-list" wx:if="{{power.showItem && power.item.length > 0}}">
        <view wx:key="title" wx:for="{{power.item}}" wx:for-item="sub" wx:for-index="subIdx">
          <view class="sub-divider"></view>
          <view class="sub-item" bindtap="jumpPage" data-type="{{ sub.type }}" data-page="{{sub.page}}">
            <text class="sub-title">{{sub.title}}</text>
            <image class="sub-arrow" src="../../images/arrow.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer-section">
    <text class="disclaimer-title">温 馨 提 示</text>
    <text class="disclaimer-text">本工具基于中国传统干支纪年法，提供性格特质趣味分析体验。所有内容均为算法自动生成的娱乐性参考，不代表任何科学结论或人生指导。每个人的性格与人生轨迹由自身选择与努力决定，请理性看待，仅供娱乐体验。</text>
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <text class="footer-text">君彧易学 · 传统文化 趣味体验</text>
  </view>

  <cloud-tip-modal showTipProps="{{showTip}}" title="{{title}}" content="{{content}}"></cloud-tip-modal>
</view>
