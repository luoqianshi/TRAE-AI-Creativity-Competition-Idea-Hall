<view class="page">
  <view class="hero-section">
    <view class="hero-bg">
      <view class="mountain mountain-far"></view>
      <view class="mountain mountain-mid"></view>
      <view class="mountain mountain-near"></view>
      <view class="cloud cloud-left"></view>
      <view class="cloud cloud-right"></view>
    </view>
    <view class="hero-content">
      <text class="hero-title">运势日历</text>
      <text class="hero-subtitle">{{currentDate.year}}年{{currentDate.month}}月</text>
    </view>
  </view>

  <view class="calendar-card">
    <view class="calendar-header">
      <view class="nav-btn" bindtap="prevMonth">
        <text class="nav-icon">‹</text>
      </view>
      <text class="month-title">{{currentDate.year}}年{{currentDate.month}}月</text>
      <view class="nav-btn" bindtap="nextMonth">
        <text class="nav-icon">›</text>
      </view>
    </view>

    <view class="week-header">
      <text class="week-item">日</text>
      <text class="week-item">一</text>
      <text class="week-item">二</text>
      <text class="week-item">三</text>
      <text class="week-item">四</text>
      <text class="week-item">五</text>
      <text class="week-item">六</text>
    </view>

    <view class="days-grid">
      <view 
        class="day-item {{item.isSelected ? 'selected' : ''}} {{item.isToday ? 'today' : ''}} {{item.isOtherMonth ? 'other-month' : ''}}"
        wx:for="{{calendarDays}}" 
        wx:key="dateKey"
        bindtap="selectDate"
        data-date="{{item.date}}"
      >
        <text class="day-number">{{item.day}}</text>
        <text class="day-lunar" wx:if="{{item.lunarDay}}">{{item.lunarDay}}</text>
        <text class="day-jieqi" wx:if="{{item.jieQi}}">{{item.jieQi}}</text>
        <text class="day-festival solar" wx:if="{{item.solarFestival}}">{{item.solarFestival}}</text>
        <text class="day-festival lunar" wx:if="{{item.lunarFestival}}">{{item.lunarFestival}}</text>
      </view>
    </view>
  </view>

  <view class="fortune-card" wx:if="{{fortune}}">
    <view class="card-header">
      <text class="card-title">� 个人专属运势</text>
      <text class="card-subtitle">{{selectedDate.year}}年{{selectedDate.month}}月{{selectedDate.day}}日 · {{fortune.ganZhi.gan}}{{fortune.ganZhi.zhi}}日</text>
    </view>
    
    <view class="date-info-row" wx:if="{{selectedLunar}}">
      <text class="date-info-item">农历 {{selectedLunar.monthName}}{{selectedLunar.dayName}}</text>
      <text class="date-info-item">{{fortune.shengXiao}}年 · {{fortune.xingZuo}}</text>
      <text class="date-info-item festival" wx:if="{{fortune.solarFestival}}">🎉 {{fortune.solarFestival}}</text>
    </view>

    <view class="bazi-info-row" wx:if="{{userFullBaZi}}">
      <text class="bazi-label">命主八字</text>
      <view class="bazi-main">
        <text class="bazi-value">{{userFullBaZi.name}} · {{userFullBaZi.gender}}</text>
        <text class="bazi-ganzhi">{{userFullBaZi.baZi}}</text>
      </view>
      <view class="bazi-switch-btn" bindtap="showBaZiSelector">
        <text class="switch-icon">↺</text>
        <text class="switch-text">切换</text>
      </view>
    </view>

    <view class="scores-section">
      <view class="score-item">
        <text class="score-label">综合运势</text>
        <view class="score-bar">
          <view class="score-fill" style="width: {{fortune.scores.overall}}%"></view>
        </view>
        <text class="score-value">{{fortune.scores.overall}}</text>
      </view>
      <view class="score-item">
        <text class="score-label">事业运势</text>
        <view class="score-bar">
          <view class="score-fill" style="width: {{fortune.scores.career}}%"></view>
        </view>
        <text class="score-value">{{fortune.scores.career}}</text>
      </view>
      <view class="score-item">
        <text class="score-label">财运运势</text>
        <view class="score-bar">
          <view class="score-fill" style="width: {{fortune.scores.wealth}}%"></view>
        </view>
        <text class="score-value">{{fortune.scores.wealth}}</text>
      </view>
      <view class="score-item">
        <text class="score-label">感情运势</text>
        <view class="score-bar">
          <view class="score-fill" style="width: {{fortune.scores.love}}%"></view>
        </view>
        <text class="score-value">{{fortune.scores.love}}</text>
      </view>
    </view>

    <view class="shiShen-tag">
      <text class="shiShen-text">十神：{{fortune.shiShen}}</text>
    </view>
  </view>

  <view class="yiji-card">
    <view class="card-header">
      <text class="card-title">🎯 今日宜忌</text>
    </view>
    <view class="yiji-content" wx:if="{{fortune}}">
      <view class="yi-section">
        <text class="yi-title">宜</text>
        <view class="yi-tags">
          <text class="yi-tag" wx:for="{{fortune.yiJi.yi}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view class="ji-section">
        <text class="ji-title">忌</text>
        <view class="ji-tags">
          <text class="ji-tag" wx:for="{{fortune.yiJi.ji}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="suggestions-card">
    <view class="card-header">
      <text class="card-title">💡 今日建议</text>
    </view>
    <view class="suggestions-content" wx:if="{{fortune}}">
      <view class="suggestion-item">
        <text class="suggestion-label">五行旺衰：</text>
        <text class="suggestion-value">{{fortune.wangShuaiText}}</text>
      </view>
      <view class="suggestion-item">
        <text class="suggestion-label">吉祥方位：</text>
        <text class="suggestion-value">{{fortune.luckyDirection}}</text>
      </view>
      <view class="suggestion-item">
        <text class="suggestion-label">幸运数字：</text>
        <text class="suggestion-value">{{fortune.luckyNumbers}}</text>
      </view>
      <view class="suggestion-item">
        <text class="suggestion-label">幸运颜色：</text>
        <text class="suggestion-value">{{fortune.luckyColors}}</text>
      </view>
    </view>
  </view>

  <view class="hint-card" wx:if="{{fortune}}">
    <view class="card-header">
      <text class="card-title">📖 命理提示</text>
    </view>
    <view class="hint-content">
      <text class="hint-text">{{fortune.hint}}</text>
    </view>
  </view>

  <view class="no-record-card" wx:if="{{!hasBaZi}}">
    <text class="no-record-text">暂无排盘记录</text>
    <text class="no-record-hint">请先在"八字"页面完成排盘，才能查看个人运势</text>
    <button class="go-paipan-btn" bindtap="goPaipan">去排盘</button>
  </view>

  <view class="disclaimer-section">
    <text class="disclaimer-title">温 馨 提 示</text>
    <text class="disclaimer-text">运势仅供参考，人生顺遂与否取决于自身努力与选择</text>
  </view>

  <view class="modal-overlay" wx:if="{{showBaZiModal}}" bindtap="hideBaZiSelector">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">选择命主八字</text>
        <view class="modal-close" bindtap="hideBaZiSelector">✕</view>
      </view>
      <view class="modal-body">
        <view class="record-list">
          <view 
            class="record-item {{record.baZi === userFullBaZi.baZi ? 'selected' : ''}}"
            wx:for="{{baziRecords}}" 
            wx:key="id"
            wx:for-index="idx"
            bindtap="selectBaZiRecord"
            data-idx="{{idx}}"
          >
            <view class="record-info">
              <text class="record-name">{{record.name || '未命名'}}</text>
              <text class="record-bazi" wx:if="{{record.baZi}}">{{record.baZi}}</text>
              <text class="record-bazi" wx:else>暂无八字</text>
              <text class="record-date" wx:if="{{record.year && record.month && record.day}}">{{record.year}}年{{record.month}}月{{record.day}}日</text>
              <text class="record-date" wx:else>暂无日期</text>
            </view>
            <view class="record-check" wx:if="{{record.baZi === userFullBaZi.baZi}}">✓</view>
          </view>
        </view>
        <view class="add-record-tip" wx:if="{{baziRecords.length === 0}}">
          <text class="tip-text">暂无排盘记录</text>
          <button class="go-paipan-btn" bindtap="goPaipan">去排盘</button>
        </view>
      </view>
    </view>
  </view>
</view>
