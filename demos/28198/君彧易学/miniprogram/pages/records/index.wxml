<view class="page">
  <view class="hero-section">
    <view class="hero-bg">
      <view class="mountain mountain-far"></view>
      <view class="mountain mountain-mid"></view>
      <view class="mountain mountain-near"></view>
      <view class="cloud cloud-left"></view>
      <view class="cloud cloud-right"></view>
    </view>
    <view class="hero-content">
      <text class="hero-title">八字排盘记录</text>
      <text class="hero-subtitle">共 {{records.length}} 条记录</text>
    </view>
  </view>

  <view class="records-card">
    <view class="records-list" wx:if="{{records.length > 0}}">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
      <view class="record-info" bindtap="viewRecord" data-record="{{item}}">
        <view class="record-name-row">
          <text class="record-name">{{item.name}}</text>
          <text class="record-gender">{{item.gender === '男' ? '乾造' : '坤造'}}</text>
        </view>
        <text class="record-date">{{item.year}}年{{item.month}}月{{item.day}}日{{item.hour}}时</text>
        <view class="record-bazi">
          <text class="record-bazi-text">{{item.baZi}}</text>
          <text class="record-rizhu">{{item.riZhu}} · {{item.wuXing}}</text>
        </view>
        <text class="record-save-time">{{formatDate(item)}}</text>
      </view>
      <view class="record-actions">
        <view class="record-fortune" catchtap="viewFortune" data-record="{{item}}">
          <text class="fortune-text">运势</text>
        </view>
        <view class="record-delete" catchtap="deleteRecord" data-id="{{item.id}}">
          <text class="delete-text">删除</text>
        </view>
      </view>
    </view>
    </view>
    <view class="records-empty" wx:else>
      <text class="empty-text">暂无排盘记录</text>
      <text class="empty-hint">在排八字页面开启保存后点击"开始分析"可收藏您的排盘结果</text>
    </view>
  </view>

  <view class="disclaimer-section">
    <text class="disclaimer-title">温 馨 提 示</text>
    <text class="disclaimer-text">所有记录保存在本地，清除缓存或卸载小程序将导致记录丢失</text>
  </view>
</view>
