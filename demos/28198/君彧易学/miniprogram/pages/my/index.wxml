<view class="page">
  <view class="hero-section">
    <view class="hero-bg">
      <view class="mountain mountain-far"></view>
      <view class="mountain mountain-mid"></view>
      <view class="mountain mountain-near"></view>
      <view class="cloud cloud-left"></view>
      <view class="cloud cloud-right"></view>
    </view>
    <view class="hero-content">
      <view class="avatar" bindtap="onAvatarTap">
        <image class="avatar-image" src="{{user.avatarUrl || '/images/icons/avatar.png'}}" mode="aspectFill"></image>
      </view>
      <view class="user-info" bindtap="onLoginTap">
        <text class="phone" wx:if="{{isLoggedIn}}">{{user.phone}}</text>
        <view class="login-hint" wx:else>
          <text class="login-text">点击登录</text>
          <text class="login-sub">登录后享受更多服务</text>
        </view>
      </view>
    </view>
  </view>

  <view class="menu-card">
    <view
      class="menu-item"
      wx:for="{{menuList}}"
      wx:key="id"
      bindtap="onMenuTap"
      data-id="{{item.id}}"
    >
      <text class="menu-text">{{item.text}}</text>
      <view class="menu-right">
        <text wx:if="{{item.rightText}}" class="right-text" style="color: {{item.rightTextColor}}">{{item.rightText}}</text>
        <view wx:if="{{item.badge}}" class="badge">{{item.badge}}</view>
      </view>
    </view>
  </view>

  <view class="disclaimer-section">
    <text class="disclaimer-title">温 馨 提 示</text>
    <text class="disclaimer-text">除您主动输入以外，本系统不会获取您的任何信息</text>
  </view>
</view>

<view class="login-modal {{loginModalVisible ? 'show' : ''}}" wx:if="{{loginModalVisible}}">
  <view class="login-mask" bindtap="hideLoginModal"></view>
  <view class="login-content">
    <view class="login-header">
      <text class="login-title">登录</text>
      <view class="login-close" bindtap="hideLoginModal">
        <text class="close-icon">×</text>
      </view>
    </view>
    <view class="login-body">
      <button class="wx-login-btn" open-type="getPhoneNumber" bind:getphonenumber="getPhoneNumber">
        <text class="wx-icon">微信</text>
        <text>微信手机号一键登录</text>
      </button>

      <view class="divider">
        <view class="divider-line"></view>
        <text class="divider-text">或</text>
        <view class="divider-line"></view>
      </view>

      <view class="wx-login-btn wx-legacy-btn" bindtap="wxLogin">
        <text>微信 OpenID 登录</text>
      </view>
    </view>
  </view>
</view>

<view class="avatar-action-modal {{avatarActionVisible ? 'show' : ''}}" wx:if="{{avatarActionVisible}}">
  <view class="avatar-action-mask" bindtap="hideAvatarAction"></view>
  <view class="avatar-action-content">
    <view class="avatar-action-item" bindtap="viewAvatar">
      <text>查看头像</text>
    </view>
    <view class="avatar-action-divider"></view>
    <view class="avatar-action-item" bindtap="changeAvatar">
      <text>更换头像</text>
    </view>
    <view class="avatar-action-cancel" bindtap="hideAvatarAction">
      <text>取消</text>
    </view>
  </view>
</view>

<view class="view-avatar-modal {{viewAvatarVisible ? 'show' : ''}}" wx:if="{{viewAvatarVisible}}" bindtap="hideViewAvatar">
  <view class="view-avatar-mask"></view>
  <view class="view-avatar-content">
    <image class="view-avatar-image" src="{{user.avatarUrl || '/images/icons/avatar.png'}}" mode="aspectFill"></image>
  </view>
</view>

<view class="avatar-source-modal {{avatarSourceVisible ? 'show' : ''}}" wx:if="{{avatarSourceVisible}}">
  <view class="avatar-source-mask" bindtap="hideAvatarSource"></view>
  <view class="avatar-source-content">
    <view class="avatar-source-item" bindtap="chooseFromAlbum">
      <text>从相册中选择</text>
    </view>
    <view class="avatar-source-cancel" bindtap="hideAvatarSource">
      <text>取消</text>
    </view>
  </view>
</view>
