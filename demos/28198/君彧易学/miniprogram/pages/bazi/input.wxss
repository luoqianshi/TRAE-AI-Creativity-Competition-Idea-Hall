/* 八字排盘 - 输入页（中国风水墨宣纸风格） */

.page {
  min-height: 100vh;
  background: #f5f0e8;
  position: relative;
  overflow: hidden;
}

/* 页面底纹 — 宣纸质感 */
.page::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background:
    radial-gradient(ellipse 120% 60% at 50% 0%, rgba(180,165,140,0.12) 0%, transparent 70%),
    repeating-linear-gradient(135deg, transparent, transparent 3px, rgba(160,145,120,0.03) 3px, rgba(160,145,120,0.03) 4px);
  pointer-events: none;
  z-index: 0;
}

/* ========== 顶部水墨山水意境 ========== */
.hero-section {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  z-index: 1;
}

.hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  /* 天空渐变 — 水墨晕染效果 */
  background: linear-gradient(
    180deg,
    #dcd8cf 0%,
    #e4dfd5 25%,
    #ebe6db 50%,
    #f2ede2 80%,
    #f5f0e8 100%
  );
}

/* 水墨远山 — 用多层渐变模拟墨分五色 */
.mountain {
  position: absolute;
  bottom: 0;
  border-radius: 50% 50% 0 0 / 40% 40% 0 0;
}

.mountain-far {
  left: -15%;
  width: 90%;
  height: 240rpx;
  background: linear-gradient(180deg, transparent 30%, rgba(130,125,115,0.10) 70%, rgba(130,125,115,0.16) 100%);
  transform: skewX(-6deg);
  filter: blur(3rpx);
}

.mountain-mid {
  left: 20%;
  width: 85%;
  height: 300rpx;
  background: linear-gradient(180deg, transparent 35%, rgba(110,105,95,0.13) 75%, rgba(110,105,95,0.20) 100%);
  transform: skewX(7deg);
  filter: blur(2rpx);
}

.mountain-near {
  right: -20%;
  width: 80%;
  height: 260rpx;
  background: linear-gradient(180deg, transparent 40%, rgba(85,80,72,0.14) 80%, rgba(85,80,72,0.22) 100%);
  transform: skewX(-4deg);
  filter: blur(1rpx);
}

/* 墨云 — 淡淡一笔 */
.cloud {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(150,140,125,0.20), transparent 70%);
}

.cloud-left {
  width: 200rpx; height: 60rpx;
  top: 100rpx; left: 40rpx;
  opacity: 0.5;
}

.cloud-right {
  width: 160rpx; height: 48rpx;
  top: 140rpx; right: 60rpx;
  opacity: 0.35;
}

/* 飞鸟 — 极简线条 */
.bird {
  position: absolute;
  font-size: 24rpx;
  color: rgba(90,82,70,0.28);
  font-style: italic;
  letter-spacing: 6rpx;
}

.bird-1 {
  top: 90rpx; right: 140rpx;
  transform: rotate(-18deg);
}

.bird-2 {
  top: 120rpx; right: 180rpx;
  font-size: 18rpx;
  transform: rotate(-12deg);
  opacity: 0.55;
}

/* 水墨涟漪装饰线 */
.hero-bg::after {
  content: '';
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(140,128,105,0.25), transparent);
}
.hero-bg::before {
  content: '';
  position: absolute;
  bottom: 52rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 180rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(140,128,105,0.12), transparent);
}

/* 头部文字 */
.hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 110rpx;
}

.hero-title {
  font-size: 46rpx;
  color: #2c2a26;
  font-weight: 600;
  letter-spacing: 10rpx;
  margin-bottom: 14rpx;
}

.hero-subtitle {
  font-size: 38rpx;
  color: #4a4540;
  font-weight: 500;
  letter-spacing: 8rpx;
  margin-bottom: 14rpx;
}

.hero-desc {
  font-size: 23rpx;
  color: #9a9082;
  letter-spacing: 4rpx;
  margin-top: 6rpx;
}

/* ========== 表单卡片 — 宣纸质感 + 墨边 ========== */
.form-card {
  margin: -70rpx 32rpx 0;
  background: rgba(255,252,245,0.88);
  backdrop-filter: blur(16rpx);
  border-radius: 20rpx;
  padding: 0 36rpx;
  position: relative;
  z-index: 3;
  /* 墨色细边框 */
  border: 1rpx solid rgba(160,148,125,0.25);
  /* 内阴影模拟纸张凹陷 */
  box-shadow:
    inset 0 1rpx 4rpx rgba(140,128,110,0.06),
    0 8rpx 36rpx rgba(100,92,78,0.08);
}

/* 表单卡片顶饰 — 小印章感 */
.form-card::before {
  content: '';
  position: absolute;
  top: -1rpx; left: 50%; transform: translateX(-50%);
  width: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, rgba(160,140,110,0.35), transparent);
  border-radius: 0 0 4rpx 4rpx;
}

/* ========== 表单行 ========== */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 38rpx 0;
  border-bottom: 1rpx solid rgba(170,158,135,0.18);
}

.form-row:last-child {
  border-bottom: none;
}

.arrow-row {
  cursor: pointer;
}

/* ========== 标签 — 书写体感觉 ========== */
.form-label {
  font-size: 29rpx;
  color: #3a342c;
  flex-shrink: 0;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.required-mark {
  color: #a03030;
  font-size: 26rpx;
}

/* ========== 输入框 ========== */
.form-input {
  font-size: 29rpx;
  color: #2c2a26;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
  letter-spacing: 1rpx;
}

.placeholder {
  color: #b8afa0;
}

/* ========== 值显示区 ========== */
.form-value-box {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.form-value {
  font-size: 27rpx;
  color: #3a342c;
  font-weight: 400;
}

.form-value.placeholder {
  color: #b8afa0;
}

.arrow-icon {
  font-size: 30rpx;
  color: #bbb3a5;
  margin-left: 4rpx;
}

/* ========== 性别选择 — 水墨胶囊 ========== */
.gender-group {
  display: flex;
  gap: 20rpx;
}

.gender-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 13rpx 30rpx;
  border-radius: 40rpx;
  border: 1.5rpx solid rgba(170,158,135,0.35);
  transition: all 0.3s ease;
  background: transparent;
}

.gender-icon {
  font-size: 26rpx;
  color: #999082;
}

.gender-text {
  font-size: 27rpx;
  color: #888075;
  font-weight: 500;
}

.active-male {
  background: rgba(60,80,110,0.06);
  border-color: rgba(60,80,110,0.30);
}
.active-male .gender-text { color: #3a4a62; }
.active-male .gender-icon { color: #3a4a62; }

.active-female {
  background: rgba(140,65,65,0.05);
  border-color: rgba(140,65,65,0.28);
}
.active-female .gender-text { color: #8c4141; }
.active-female .gender-icon { color: #8c4141; }

/* ========== 格言区域 — 竖排印章感 ========== */
.motto-section {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 44rpx 48rpx 0;
}

.motto-line {
  width: 56rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(140,128,105,0.35), transparent);
}

.motto-text {
  font-size: 23rpx;
  color: #968a76;
  letter-spacing: 5rpx;
  white-space: nowrap;
}

/* ========== 提交按钮 — 墨笔触感 ========== */
.save-section {
  margin-top: 32rpx;
  padding: 0 48rpx;
  z-index: 3;
  position: relative;
}

.save-toggle {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.toggle-switch {
  width: 88rpx;
  height: 48rpx;
  background: #d0d0d0;
  border-radius: 24rpx;
  position: relative;
  transition: background 0.3s ease;
}

.toggle-switch.on {
  background: #6a9a78;
}

.toggle-dot {
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border-radius: 50%;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: transform 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.toggle-switch.on .toggle-dot {
  transform: translateX(40rpx);
}

.toggle-text {
  font-size: 28rpx;
  color: #666;
  transition: color 0.3s ease;
}

.toggle-switch.on + .toggle-text {
  color: #6a9a78;
}

.submit-area {
  margin-top: 32rpx;
  padding: 0 48rpx 64rpx;
  z-index: 3;
  position: relative;
}

.submit-btn {
  width: 100%;
  height: 94rpx;
  background: linear-gradient(135deg, #3a3733 0%, #2a2825 100%);
  color: #f0ece4;
  font-size: 33rpx;
  font-weight: 600;
  border-radius: 47rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 12rpx;
  box-shadow:
    0 6rpx 20rpx rgba(42,40,37,0.25),
    inset 0 1rpx 0 rgba(255,255,255,0.05);
}

.submit-btn::after { border: none; }

/* 按钮内微纹理 */
.submit-btn::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 47rpx;
  background: repeating-linear-gradient(
    95deg,
    transparent,
    transparent 8px,
    rgba(255,255,255,0.015) 8px,
    rgba(255,255,255,0.015) 16px
  );
  pointer-events: none;
}

/* ========== 日期时间选择弹窗 — 水墨风 ========== */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(40,38,34,0.50);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.picker-mask.show {
  opacity: 1;
  visibility: visible;
}

.picker-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #f8f4ec;
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  border-top: 1rpx solid rgba(160,148,125,0.2);
}

.picker-mask.show .picker-panel {
  transform: translateY(0);
}

/* 弹窗头部 */
.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx;
  border-bottom: 1rpx solid rgba(170,158,135,0.15);
}

.picker-cancel {
  font-size: 29rpx;
  color: #998f80;
  padding: 8rpx 12rpx;
}

.picker-title {
  font-size: 31rpx;
  color: #3a342c;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.picker-confirm {
  font-size: 29rpx;
  color: #3a3733;
  font-weight: 600;
  padding: 8rpx 12rpx;
}

/* 列标题 */
.picker-col-headers {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(170,158,135,0.10);
}

.picker-col-header {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  color: #aa9f90;
}

/* 选择器列 */
.picker-columns {
  display: flex;
  height: 480rpx;
  position: relative;
}

.picker-columns::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 20rpx;
  right: 20rpx;
  height: 80rpx;
  transform: translateY(-50%);
  background: rgba(190,178,158,0.18);
  border-radius: 12rpx;
  z-index: 0;
  border: 1rpx solid rgba(170,158,135,0.12);
}

.picker-col {
  flex: 1;
  height: 100%;
  position: relative;
  z-index: 1;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  font-size: 29rpx;
  color: #c0b8aa;
  transition: all 0.2s;
}

.picker-item.active {
  font-size: 37rpx;
  color: #3a342c;
  font-weight: 700;
}

/* ========== 地区选择弹窗 ========== */
.region-panel {
  max-height: 75vh;
}

.region-columns {
  display: flex;
  height: 560rpx;
}

.region-list {
  flex: 1;
  height: 100%;
}

.region-divider {
  width: 1rpx;
  background: rgba(170,158,135,0.15);
  flex-shrink: 0;
}

.region-item {
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  color: #6a6258;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.region-item.active {
  color: #3a342c;
  font-weight: 700;
  font-size: 29rpx;
  background: rgba(160,148,125,0.08);
}
