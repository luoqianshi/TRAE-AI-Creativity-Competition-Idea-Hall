<view class="page">
    <!-- 加载态 -->
    <view wx:if="{{loading}}" class="loading-area">
      <view class="taiji-spinner"></view>
      <text class="loading-text">解析中...</text>
    </view>

  <!-- 错误态 -->
  <view wx:elif="{{error}}" class="error-area">
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="onBack">返回</button>
  </view>

  <!-- 主体内容 -->
  <view wx:else class="content">
    <!-- V2引擎状态指示 -->
    <view class="v2-status-bar">
      <text class="v2-status-text">{{v2Status}}</text>
    </view>

    <!-- 深度分析计算中提示 -->
    <view wx:if="{{computing}}" class="computing-bar">
      <view class="computing-dot"></view>
      <text class="computing-text">正在深度解析，请稍候...</text>
    </view>

    <!-- ====== 顶部铭牌 ====== -->
    <view class="seal-header">
      <view class="seal-frame">
        <view class="seal-corner seal-tl"></view>
        <view class="seal-corner seal-tr"></view>
        <view class="seal-corner seal-bl"></view>
        <view class="seal-corner seal-br"></view>
        <view class="seal-body">
          <text class="seal-name">{{name}}</text>
          <view class="seal-divider">
            <view class="seal-line"></view>
            <text class="seal-divider-text">个 人 专 属 分 析</text>
            <view class="seal-line"></view>
          </view>
          <text class="seal-sub">特 质 基 础 倾 向（{{riZhu.wuXing}} 型 特 质）</text>
        </view>
      </view>
    </view>

    <!-- ====== 特质能量分析 ====== -->
    <view class="card-section" wx:if="{{yuanPan}}">
      <view class="card-header">
        <view class="card-ornament">
          <view class="ornament-diamond"></view>
          <view class="ornament-line"></view>
        </view>
        <text class="card-title">特 质 能 量 分 析</text>
        <view class="card-ornament">
          <view class="ornament-line"></view>
          <view class="ornament-diamond"></view>
        </view>
      </view>
      <view class="card-body">
        <!-- 特质能量偏向 -->
        <view class="strength-bar-row">
          <text class="strength-label">{{yuanPan.strongWeakLevel}}</text>
          <view class="strength-bar-track">
            <view class="strength-bar-fill" style="width: {{yuanPan.shiShenConfig.length > 0 ? (wuXingStats[riZhu.wuXing] || 0) / 5 * 100 : 20}}%"></view>
          </view>
          <text class="strength-value">{{wuXingStats[riZhu.wuXing] || 0}}分</text>
        </view>
        <text class="body-text-sm">{{yuanPan.strongWeakDesc}}</text>
        
        <!-- 时序组合 -->
        <view class="pillar-quick" wx:if="{{pillars.length > 0}}">
          <view class="pillar-quick-item" wx:for="{{pillars}}" wx:key="name">
            <text class="pq-name">{{item.name}}</text>
            <text class="pq-ganZhi">{{item.ganZhi}}</text>
            <text class="pq-shiShen">{{item.shiShen}}</text>
          </view>
        </view>

        <!-- 各元角色 -->
        <view class="role-list" wx:if="{{yuanPan.roleDescs.length > 0}}">
          <view class="role-item" wx:for="{{yuanPan.roleDescs}}" wx:key="*this">
            <view class="role-dot"></view>
            <text class="body-text-sm role-text">{{item}}</text>
          </view>
        </view>

        <!-- 特征标签 -->
        <view class="feature-tags" wx:if="{{yuanPan.features.length > 0}}">
          <text class="feature-tag" wx:for="{{yuanPan.features}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- ====== 有利元素分析 ====== -->
    <view class="card-section highlight-card" wx:if="{{yongShen.yongShen}}">
      <view class="card-header">
        <view class="card-ornament">
          <view class="ornament-diamond ornament-diamond-gold"></view>
          <view class="ornament-line"></view>
        </view>
        <text class="card-title card-title-gold">核心能量偏向</text>
        <view class="card-ornament">
          <view class="ornament-line"></view>
          <view class="ornament-diamond ornament-diamond-gold"></view>
        </view>
      </view>
      <view class="card-body">
        <!-- 有利/不利元素标签 -->
        <view class="yongshen-tag-row">
          <view class="ys-tag-group">
            <text class="ys-label">有利</text>
            <view class="ys-tags">
              <text class="ys-tag ys-tag-yong" wx:for="{{yongShen.yongShen}}" wx:key="*this">{{item}}</text>
            </view>
          </view>
          <view class="ys-tag-group">
            <text class="ys-label">不利</text>
            <view class="ys-tags">
              <text class="ys-tag ys-tag-ji" wx:for="{{yongShen.jiShen}}" wx:key="*this">{{item}}</text>
            </view>
          </view>
        </view>
        <!-- 有利元素详解 -->
        <text class="body-text">{{yongShen.desc}}</text>
        <!-- 平衡状态 -->
        <view wx:if="{{yongShen.tiaoHou}}" class="tiaohou-row">
          <view class="tiaohou-dot"></view>
          <text class="body-text-sm">{{yongShen.tiaoHouDesc}}</text>
        </view>
        <!-- 特质调节 -->
        <view wx:if="{{yongShen.sickDesc}}" class="sick-row">
          <view class="sick-dot"></view>
          <text class="body-text-sm">{{yongShen.sickDesc}}</text>
        </view>
      </view>
    </view>

    <!-- ====== 未解锁 · 截断提示 ====== -->
    <view class="card-section lock-section" wx:if="{{!unlocked}}">
      <view class="lock-card">
        <!-- 截断渐变 -->
        <view class="lock-fade-top"></view>
        <!-- 锁芯装饰（连续点击5次开发者快捷解锁） -->
        <view class="lock-seal" bindtap="onDevSealTap">
          <view class="lock-seal-outer">
            <view class="lock-seal-inner">
              <text class="lock-seal-glyph">封</text>
            </view>
          </view>
        </view>
        <text class="lock-title">以下为趣味特质解析报告</text>
        <text class="lock-subtitle">邀一位好友即可解锁全部内容</text>
        <!-- 待解锁内容预览 -->
        <view class="lock-preview">
          <text class="lock-preview-item">◇ 性 格 特 质 分 析</text>
          <text class="lock-preview-item">◇ 人 际 相 处 模 式</text>
          <text class="lock-preview-item">◇ 成 长 潜 力 方 向</text>
          <text class="lock-preview-item">◇ 阶 段 状 态 参 考</text>
          <text class="lock-preview-item">◇ 生 活 习 惯 建 议</text>
          <text class="lock-preview-item">◇ 职 业 适 配 方 向</text>
          <text class="lock-preview-item">◇ 生 活 环 境 偏 好</text>
          <text class="lock-preview-item">◇ 个 人 小 偏 好 参 考</text>
          <text class="lock-preview-item">◇ 日 常 趣 味 建 议</text>
        </view>
        <!-- 分享按钮 -->
        <button class="lock-share-btn" open-type="share">
          <view class="lock-share-inner">
            <text class="lock-share-icon">✦</text>
            <text class="lock-share-text">邀 友 共 鉴 · 解 锁 全 篇</text>
          </view>
        </button>
        <text class="lock-hint">分享至聊天即自动解锁，好友通过卡片进入亦享完整解读</text>
      </view>
    </view>

    <!-- ====== 性格特质分析 ====== -->
    <view class="card-section" wx:if="{{geJu.geJu && unlocked}}">
      <view class="card-header">
        <view class="card-ornament">
          <view class="ornament-diamond"></view>
          <view class="ornament-line"></view>
        </view>
        <text class="card-title">性 格 特 质 分 析</text>
        <view class="card-ornament">
          <view class="ornament-line"></view>
          <view class="ornament-diamond"></view>
        </view>
      </view>
      <view class="card-body">
        <view class="geju-tag-row">
          <text class="geju-main-tag">{{geJu.geJu}}</text>
          <block wx:if="{{geJu.jianGe.length > 0}}">
            <text class="geju-jian-tag" wx:for="{{geJu.jianGe}}" wx:key="*this">{{item}}</text>
          </block>
        </view>
        <text class="body-text">{{geJu.fullDesc}}</text>
      </view>
    </view>

    <!-- ====== 人际相处模式 ====== -->
    <view class="card-section highlight-card" wx:if="{{marriage && unlocked}}">
      <view class="card-header">
        <view class="card-ornament">
          <view class="ornament-diamond ornament-diamond-gold"></view>
          <view class="ornament-line"></view>
        </view>
        <text class="card-title card-title-gold">人 际 相 处 模 式</text>
        <view class="card-ornament">
          <view class="ornament-line"></view>
          <view class="ornament-diamond ornament-diamond-gold"></view>
        </view>
      </view>
      <view class="card-body">
        <!-- 婚恋特质等级 -->
        <view class="marriage-level-row">
          <text class="marriage-level-tag marriage-level-{{marriage.marriageLevelColor}}">{{marriage.marriageLevel}}</text>
        </view>
        <!-- 感情特质分析 -->
        <text class="body-text">{{marriage.spousePalace}}</text>
        <text class="body-text-sm">{{marriage.spouseShen}}</text>
        <!-- 感情特质 -->
        <view wx:if="{{marriage.starDesc}}" class="marriage-star-box">
          <text class="body-text-sm">{{marriage.starDesc}}</text>
        </view>
        <!-- 人际缘分提示 -->
        <view class="peach-tips" wx:if="{{marriage.peachTips.length > 0}}">
          <text class="peach-tip" wx:for="{{marriage.peachTips}}" wx:key="*this">🌸 {{item}}</text>
        </view>
        <!-- 感情模式 -->
        <view class="insight-box" wx:if="{{marriage.loveStyle}}">
          <text class="insight-label">💕 感情模式</text>
          <text class="body-text-sm">{{marriage.loveStyle}}</text>
        </view>
        <!-- 最佳婚恋时机期 -->
        <view class="insight-box" wx:if="{{marriage.bestPeriod}}">
          <text class="insight-label">💒 最佳婚恋时机</text>
          <text class="body-text-sm">{{marriage.bestPeriod}}</text>
        </view>
        <!-- 注意事项 -->
        <view class="cautions-box" wx:if="{{marriage.cautions.length > 0}}">
          <text class="insight-label">⚠ 注意事项</text>
          <text class="caution-item" wx:for="{{marriage.cautions}}" wx:key="*this">· {{item}}</text>
        </view>
      </view>
    </view>

    <!-- ====== 成长潜力方向 ====== -->
    <view class="card-section" wx:if="{{academics && unlocked}}">
      <view class="card-header">
        <view class="card-ornament">
          <view class="ornament-diamond"></view>
          <view class="ornament-line"></view>
        </view>
        <text class="card-title">成 长 潜 力 方 向</text>
        <view class="card-ornament">
          <view class="ornament-line"></view>
          <view class="ornament-diamond"></view>
        </view>
      </view>
      <view class="card-body">
        <!-- 学历潜力 -->
        <view class="edu-level-row" wx:if="{{academics.eduLevel}}">
          <text class="edu-level-tag">{{academics.eduLevel}}</text>
        </view>
        <!-- 学业天赋 -->
        <text class="body-text">{{academics.talentDesc}}</text>
        <!-- 适合学科 -->
        <view class="subject-row" wx:if="{{academics.subjects.length > 0}}">
          <text class="insight-label">📚 天赋学科</text>
          <text class="body-text-sm">{{academics.subjects[0]}}</text>
        </view>
        <view class="subject-row" wx:if="{{academics.yongSubjects.length > 0}}">
          <text class="insight-label">🎯 有利元素学科</text>
          <view class="subject-tags">
            <text class="subject-tag" wx:for="{{academics.yongSubjects}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
        <!-- 学习方式 -->
        <view class="insight-box" wx:if="{{academics.studyStyle}}">
          <text class="insight-label">✏ 学习方式</text>
          <text class="body-text-sm">{{academics.studyStyle}}</text>
        </view>
        <!-- 师缘助力 -->
        <view class="insight-box" wx:if="{{academics.mentorDesc}}">
          <text class="insight-label">🎓 师缘助力</text>
          <text class="body-text-sm">{{academics.mentorDesc}}</text>
        </view>
        <!-- 考试阶段 -->
        <view class="exam-luck-box" wx:if="{{academics.examLuck.length > 0}}">
          <text class="insight-label">📝 考试阶段提示</text>
          <text class="body-text-sm exam-item" wx:for="{{academics.examLuck}}" wx:key="*this">· {{item}}</text>
        </view>
        <!-- 文星标签 -->
        <view class="academics-stars" wx:if="{{academics.yinStars.length > 0 || academics.shiShangStars.length > 0}}">
          <text class="academics-star-label">特质文星：</text>
          <text class="academics-star-tag star-yin" wx:for="{{academics.yinStars}}" wx:key="*this">{{item}}</text>
          <text class="academics-star-tag star-shishang" wx:for="{{academics.shiShangStars}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- ====== 阶段状态参考 ====== -->
    <view class="card-section" wx:if="{{keyDaYun.length > 0 && unlocked}}">
      <view class="card-header">
        <view class="card-ornament">
          <view class="ornament-diamond ornament-diamond-gold"></view>
          <view class="ornament-line"></view>
        </view>
        <text class="card-title card-title-gold">阶 段 状 态 参 考</text>
        <view class="card-ornament">
          <view class="ornament-line"></view>
          <view class="ornament-diamond ornament-diamond-gold"></view>
        </view>
      </view>
      <view class="card-body">
        <!-- 最佳/需谨慎阶段速览 -->
        <view class="best-worst-row" wx:if="{{bestDaYun || worstDaYun}}">
          <view class="bw-item bw-best" wx:if="{{bestDaYun}}">
            <text class="bw-label">最佳阶段</text>
            <text class="bw-value">{{bestDaYun.ganZhi}}（{{bestDaYun.ageStart}}-{{bestDaYun.ageEnd}}岁）</text>
          </view>
          <view class="bw-item bw-worst" wx:if="{{worstDaYun && worstDaYun.score < -1}}">
            <text class="bw-label">需谨慎</text>
            <text class="bw-value">{{worstDaYun.ganZhi}}（{{worstDaYun.ageStart}}-{{worstDaYun.ageEnd}}岁）</text>
          </view>
        </view>

        <!-- 转折点提示 -->
        <view class="turning-alert" wx:if="{{turningPoints.length > 0}}">
          <view class="turning-icon">⚡</view>
          <view class="turning-content">
            <text class="turning-title">关键转折节点</text>
            <text class="turning-desc" wx:for="{{turningPoints}}" wx:key="*this">{{item.desc}}</text>
          </view>
        </view>

        <!-- 八阶段成长参考 -->
        <view class="dayun-timeline">
          <view class="dayun-item" wx:for="{{keyDaYun}}" wx:key="index">
            <view class="dayun-left">
              <view class="dayun-dot dayun-dot-{{item.typeColor}}"></view>
              <view class="dayun-line" wx:if="{{index < keyDaYun.length - 1}}"></view>
            </view>
            <view class="dayun-right">
              <view class="dayun-top-row">
                <text class="dayun-ganzhi">{{item.ganZhi}}</text>
                <text class="dayun-type-tag dayun-type-{{item.typeColor}}">{{item.typeTag}}</text>
                <text class="dayun-age">{{item.ageStart}}-{{item.ageEnd}}岁</text>
              </view>
              <text class="dayun-desc">{{item.desc}}</text>
              <!-- 元素标注 -->
              <view class="dayun-wx-row">
                <text class="dayun-wx-tag {{yongShen.yongShen.indexOf(item.ganWuXing) >= 0 ? 'wx-yong' : (yongShen.jiShen.indexOf(item.ganWuXing) >= 0 ? 'wx-ji' : 'wx-normal')}}">{{item.gan}}{{item.ganWuXing}}</text>
                <text class="dayun-wx-tag {{yongShen.yongShen.indexOf(item.zhiWuXing) >= 0 ? 'wx-yong' : (yongShen.jiShen.indexOf(item.zhiWuXing) >= 0 ? 'wx-ji' : 'wx-normal')}}">{{item.zhi}}{{item.zhiWuXing}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ====== 元素关系（性格特质补充） ====== -->
    <view class="card-section" wx:if="{{pillarRelations.summary && unlocked}}">
      <view class="card-header">
        <view class="card-ornament">
          <view class="ornament-diamond"></view>
          <view class="ornament-line"></view>
        </view>
        <text class="card-title">干 支 关 系 参 考</text>
        <view class="card-ornament">
          <view class="ornament-line"></view>
          <view class="ornament-diamond"></view>
        </view>
      </view>
      <view class="card-body">
        <text class="body-text">{{pillarRelations.summary}}</text>
        <!-- 天干合 -->
        <view wx:if="{{pillarRelations.ganHe.length > 0}}" class="relation-group">
          <text class="relation-group-title">天干融合</text>
          <text class="body-text-sm relation-item" wx:for="{{pillarRelations.ganHe}}" wx:key="*this">{{item.desc}}</text>
        </view>
        <!-- 地支融合 -->
        <view wx:if="{{pillarRelations.zhiLiuHe.length > 0}}" class="relation-group">
          <text class="relation-group-title">地支融合</text>
          <text class="body-text-sm relation-item" wx:for="{{pillarRelations.zhiLiuHe}}" wx:key="*this">{{item.desc}}</text>
        </view>
        <!-- 地支组合 -->
        <view wx:if="{{pillarRelations.zhiSanHe.length > 0}}" class="relation-group">
          <text class="relation-group-title">地支组合</text>
          <text class="body-text-sm relation-item" wx:for="{{pillarRelations.zhiSanHe}}" wx:key="*this">{{item.desc}}</text>
        </view>
        <!-- 地支冲突 -->
        <view wx:if="{{pillarRelations.zhiLiuChong.length > 0}}" class="relation-group">
          <text class="relation-group-title">地支冲突</text>
          <text class="body-text-sm relation-item" wx:for="{{pillarRelations.zhiLiuChong}}" wx:key="*this">{{item.desc}}</text>
        </view>
        <!-- 地支制约 -->
        <view wx:if="{{pillarRelations.zhiXing.length > 0}}" class="relation-group">
          <text class="relation-group-title">地支制约关系</text>
          <text class="body-text-sm relation-item" wx:for="{{pillarRelations.zhiXing}}" wx:key="*this">{{item.desc}}</text>
        </view>
        <!-- 地支排斥 -->
        <view wx:if="{{pillarRelations.zhiHai.length > 0}}" class="relation-group">
          <text class="relation-group-title">元素相斥</text>
          <text class="body-text-sm relation-item" wx:for="{{pillarRelations.zhiHai}}" wx:key="*this">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- ====== 生活习惯建议 ====== -->
    <view class="card-section" wx:if="{{health && unlocked}}">
      <view class="card-header">
        <view class="card-ornament">
          <view class="ornament-diamond"></view>
          <view class="ornament-line"></view>
        </view>
        <text class="card-title">生 活 习 惯 建 议</text>
        <view class="card-ornament">
          <view class="ornament-line"></view>
          <view class="ornament-diamond"></view>
        </view>
      </view>
      <view class="card-body">
        <!-- 体质总评 -->
        <text class="body-text">{{health.constitution}}</text>
        <!-- 情绪健康 -->
        <view class="insight-box" wx:if="{{health.emotionAdvice}}">
          <text class="insight-label">🧘 情绪养生</text>
          <text class="body-text-sm">{{health.emotionAdvice}}</text>
        </view>
        <!-- 运动建议 -->
        <view class="insight-box" wx:if="{{health.sportAdvice.length > 0}}">
          <text class="insight-label">🏃 运动养生</text>
          <text class="body-text-sm sport-item" wx:for="{{health.sportAdvice}}" wx:key="*this">· {{item}}</text>
        </view>
        <!-- 元素健康明细 -->
        <text class="sub-section-title">元素脏腑详析</text>
        <view class="health-grid" wx:if="{{health.items.length > 0}}">
          <view class="health-item" wx:for="{{health.items}}" wx:key="wuXing">
            <view class="health-left">
              <text class="health-wx">{{item.wuXing}}</text>
              <text class="health-power">{{item.power}}分</text>
            </view>
            <view class="health-middle">
              <text class="health-organs">{{item.organs}}</text>
              <text class="health-status health-status-{{item.status === '偏弱' ? 'weak' : item.status === '偏旺' ? 'strong' : 'ok'}}">{{item.status}}</text>
            </view>
            <view class="health-right">
              <text class="health-advice">{{item.advice}}</text>
            </view>
          </view>
        </view>
        <!-- 年龄段健康重点 -->
        <view class="age-health-box" wx:if="{{health.ageHealth.length > 0}}">
          <text class="insight-label">📅 各阶段健康重点</text>
          <text class="body-text-sm age-item" wx:for="{{health.ageHealth}}" wx:key="*this">· {{item}}</text>
        </view>
        <!-- 星象健康提示 -->
        <view wx:if="{{health.shenShaTips.length > 0}}" class="shensha-health-tip">
          <text class="body-text-sm dim-text" wx:for="{{health.shenShaTips}}" wx:key="*this">· {{item}}</text>
        </view>
      </view>
    </view>

    <!-- ====== 职业适配方向 ====== -->
    <view class="card-section highlight-card" wx:if="{{career && unlocked}}">
      <view class="card-header">
        <view class="card-ornament">
          <view class="ornament-diamond ornament-diamond-gold"></view>
          <view class="ornament-line"></view>
        </view>
        <text class="card-title card-title-gold">职 业 适 配 方 向</text>
        <view class="card-ornament">
          <view class="ornament-line"></view>
          <view class="ornament-diamond ornament-diamond-gold"></view>
        </view>
      </view>
      <view class="card-body">
        <!-- 总纲 -->
        <text class="body-text">{{career.summary}}</text>
        <!-- 财富特质 -->
        <view class="insight-box" wx:if="{{career.wealthDesc}}">
          <text class="insight-label">💰 财富特质</text>
          <text class="body-text-sm">{{career.wealthDesc}}</text>
        </view>
