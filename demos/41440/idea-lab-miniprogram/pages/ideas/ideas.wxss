.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-box {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 20rpx;
  color: #555;
  font-size: 28rpx;
  z-index: 1;
}

.search-input {
  width: 100%;
  background: #12121f;
  border: 2rpx solid #2a2a4a;
  border-radius: 40rpx;
  padding: 16rpx 20rpx 16rpx 56rpx;
  font-size: 28rpx;
  color: white;
  box-sizing: border-box;
}

.btn-export {
  background: linear-gradient(135deg, #43e97b, #38f9d7);
  color: #1a1a2e;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: none;
  white-space: nowrap;
}

.btn-export::after {
  border: none;
}

/* 筛选栏 */
.filter-scroll {
  margin-bottom: 20rpx;
}

.filter-list {
  display: flex;
  gap: 12rpx;
  white-space: nowrap;
}

.filter-item {
  background: #2a2a4a;
  color: #aaa;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  border: 1rpx solid #3a3a5a;
}

.filter-item.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-color: transparent;
}

/* 去重提示 */
.duplicate-alert {
  background: rgba(250, 112, 154, 0.1);
  border: 1rpx solid rgba(250, 112, 154, 0.3);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  color: #fa709a;
  font-size: 26rpx;
}

/* 想法卡片 */
.idea-card {
  background: #12121f;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #667eea;
}

.idea-card.pinned {
  border-left-color: #ffd700;
  background: linear-gradient(135deg, #12121f, #1a1a2f);
}

.idea-header {
  margin-bottom: 12rpx;
}

.idea-title {
  font-size: 30rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 10rpx;
}

.idea-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.idea-content {
  color: #999;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.idea-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.idea-meta {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.idea-time {
  color: #666;
  font-size: 24rpx;
}

.idea-score {
  font-size: 26rpx;
  font-weight: 600;
}

.idea-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: #2a2a4a;
  color: #aaa;
}

.btn-analyze {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  color: #1a1a2e;
}

.btn-pin.active {
  background: rgba(255, 215, 0, 0.15);
  color: #ffd700;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal {
  background: #1a1a2e;
  border-radius: 24rpx;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  border: 1rpx solid #2a2a4a;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #2a2a4a;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
}

.modal-close {
  color: #888;
  font-size: 32rpx;
  padding: 8rpx;
}

.modal-body {
  padding: 28rpx 30rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #2a2a4a;
}

.detail-label {
  color: #888;
  font-size: 26rpx;
}

.detail-value {
  color: white;
  font-size: 26rpx;
  font-weight: 500;
}

.detail-content {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #12121f;
  border-radius: 16rpx;
  color: #bbb;
  font-size: 28rpx;
  line-height: 1.7;
}

.modal-input {
  width: 100%;
  background: #12121f;
  border: 2rpx solid #2a2a4a;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: white;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.modal-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #12121f;
  border: 2rpx solid #2a2a4a;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: white;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.edit-textarea {
  min-height: 360rpx;
}

.edit-hint {
  color: #666;
  font-size: 24rpx;
  margin-bottom: 16rpx;
  display: block;
}

/* 合并弹窗 */
.merge-desc {
  color: #888;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  display: block;
}

.merge-card {
  background: #12121f;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid;
}

.merge-title {
  color: white;
  font-weight: 600;
  font-size: 28rpx;
  display: block;
  margin-bottom: 8rpx;
}

.merge-content {
  color: #888;
  font-size: 24rpx;
}
