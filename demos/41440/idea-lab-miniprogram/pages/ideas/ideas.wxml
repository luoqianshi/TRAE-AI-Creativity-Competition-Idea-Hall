<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索想法..." 
        placeholder-class="placeholder"
        bindinput="onSearch"
        value="{{searchText}}"
      />
    </view>
    <button class="btn-export" bindtap="exportIdeas">📥 导出</button>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="filter-scroll" scroll-x>
    <view class="filter-list">
      <view class="filter-item {{currentFilter === 'all' ? 'active' : ''}}" bindtap="filterByCategory" data-category="all">全部</view>
      <view class="filter-item {{currentFilter === '社会服务' ? 'active' : ''}}" bindtap="filterByCategory" data-category="社会服务">社会服务</view>
      <view class="filter-item {{currentFilter === '教育创新' ? 'active' : ''}}" bindtap="filterByCategory" data-category="教育创新">教育创新</view>
      <view class="filter-item {{currentFilter === '生活娱乐' ? 'active' : ''}}" bindtap="filterByCategory" data-category="生活娱乐">生活娱乐</view>
      <view class="filter-item {{currentFilter === '学习工作' ? 'active' : ''}}" bindtap="filterByCategory" data-category="学习工作">学习工作</view>
      <view class="filter-item {{currentFilter === '硬件交互' ? 'active' : ''}}" bindtap="filterByCategory" data-category="硬件交互">硬件交互</view>
    </view>
  </scroll-view>

  <!-- 去重提示 -->
  <view class="duplicate-alert" wx:if="{{duplicates.length > 0}}" bindtap="showMergeModal">
    🔄 发现 {{duplicates.length}} 对相似想法，点击查看合并建议 →
  </view>

  <!-- 想法列表 -->
  <view class="ideas-list">
    <view class="idea-card {{item.pinned ? 'pinned' : ''}}" wx:for="{{filteredIdeas}}" wx:key="id">
      <view class="idea-header">
        <view class="idea-title" bindtap="showDetail" data-id="{{item.id}}">
          {{item.title}} {{item.pinned ? '📌' : ''}}
        </view>
        <view class="idea-tags">
          <text class="tag tag-blue" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
      </view>
      
      <view class="idea-content">{{item.content}}</view>
      
      <view class="idea-footer">
        <view class="idea-meta">
          <text class="idea-time">{{item.date}} {{item.time}}</text>
          <text class="idea-score {{item.score >= 70 ? 'score-high' : item.score >= 50 ? 'score-mid' : 'score-low'}}">{{item.score}}分</text>
        </view>
        <view class="idea-actions">
          <text class="action-btn btn-analyze" bindtap="goToAnalysis" data-id="{{item.id}}">📊 分析</text>
          <text class="action-btn btn-edit" bindtap="showEditModal" data-id="{{item.id}}">✏️</text>
          <text class="action-btn btn-pin {{item.pinned ? 'active' : ''}}" bindtap="togglePin" data-id="{{item.id}}">{{item.pinned ? '📌' : '📍'}}</text>
          <text class="action-btn btn-delete" bindtap="deleteIdea" data-id="{{item.id}}">🗑️</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{filteredIdeas.length === 0}}">
    <view class="empty-icon">💡</view>
    <text>还没有想法，快去记录你的第一个闪念吧！</text>
  </view>
</view>

<!-- 详情弹窗 -->
<view class="modal-overlay" wx:if="{{showDetailModal}}" bindtap="closeDetailModal">
  <view class="modal" catchtap="preventBubble">
    <view class="modal-header">
      <text class="modal-title">想法详情</text>
      <text class="modal-close" bindtap="closeDetailModal">✕</text>
    </view>
    <view class="modal-body">
      <view class="detail-row">
        <text class="detail-label">标题</text>
        <text class="detail-value">{{detailIdea.title}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">分类</text>
        <text class="detail-value">{{detailIdea.category}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">标签</text>
        <text class="detail-value">{{detailIdea.tags ? detailIdea.tags.join('、') : ''}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">时间</text>
        <text class="detail-value">{{detailIdea.date}} {{detailIdea.time}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">可行性评分</text>
        <text class="detail-value score {{detailIdea.score >= 70 ? 'score-high' : detailIdea.score >= 50 ? 'score-mid' : 'score-low'}}">{{detailIdea.score}}分</text>
      </view>
      <view class="detail-content">{{detailIdea.content}}</view>
    </view>
  </view>
</view>

<!-- 编辑弹窗 -->
<view class="modal-overlay" wx:if="{{showEditModal}}" bindtap="closeEditModal">
  <view class="modal" catchtap="preventBubble">
    <view class="modal-header">
      <text class="modal-title">编辑想法</text>
      <text class="modal-close" bindtap="closeEditModal">✕</text>
    </view>
    <view class="modal-body">
      <view class="edit-hint">修改内容后保存，标题将自动生成</view>
      <textarea class="modal-textarea edit-textarea" placeholder="编辑你的想法内容..." value="{{editContent}}" bindinput="onEditContent" />
      <button class="btn-primary" bindtap="saveEdit">保存</button>
    </view>
  </view>
</view>

<!-- 合并弹窗 -->
<view class="modal-overlay" wx:if="{{showMergeModal}}" bindtap="closeMergeModal">
  <view class="modal" catchtap="preventBubble">
    <view class="modal-header">
      <text class="modal-title">🔄 去重合并建议</text>
      <text class="modal-close" bindtap="closeMergeModal">✕</text>
    </view>
    <view class="modal-body">
      <text class="merge-desc">以下两个想法相似度较高（{{Math.round(mergePair.sim * 100)}}%），建议合并：</text>
      <view class="merge-card" style="border-left-color: #667eea;">
        <text class="merge-title">{{mergePair.a.title}}</text>
        <text class="merge-content">{{mergePair.a.content.substring(0, 80)}}...</text>
      </view>
      <view class="merge-card" style="border-left-color: #f093fb;">
        <text class="merge-title">{{mergePair.b.title}}</text>
        <text class="merge-content">{{mergePair.b.content.substring(0, 80)}}...</text>
      </view>
      <button class="btn-primary" bindtap="confirmMerge">合并</button>
    </view>
  </view>
</view>
