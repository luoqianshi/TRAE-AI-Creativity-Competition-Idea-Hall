<view class="container">
  <view class="header">
    <text class="title gradient-text">👤 你的思维画像</text>
  </view>

  <!-- 思维热力图 -->
  <view class="section">
    <text class="section-title">🗺️ 思维热力图</text>
    <view class="heatmap">
      <view class="heatmap-cell" wx:for="{{heatmapData}}" wx:key="category" style="background: {{item.color}}">
        <text class="heatmap-percent">{{item.percent}}%</text>
        <text class="heatmap-label">{{item.category}}</text>
      </view>
    </view>
  </view>

  <!-- 能力雷达 -->
  <view class="section">
    <text class="section-title">🎯 能力雷达</text>
    <view class="radar-grid">
      <view class="radar-item" wx:for="{{radarData}}" wx:key="name">
        <text class="radar-icon">{{item.icon}}</text>
        <text class="radar-name">{{item.name}}</text>
        <text class="radar-score" style="color: {{item.color}}">{{item.score}}</text>
        <view class="radar-bar">
          <view class="radar-bar-fill" style="width: {{item.score}}%; background: {{item.color}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 关联发现（思维导图） -->
  <view class="section">
    <text class="section-title">🧠 关联发现</text>
    <canvas type="2d" id="mindmap" class="mindmap-canvas"></canvas>
    
    <!-- 关联列表 -->
    <view class="relation-list" wx:if="{{relationList.length > 0}}">
      <text class="relation-subtitle">💡 发现 {{relationList.length}} 组想法关联</text>
      <view class="relation-card" wx:for="{{relationList}}" wx:key="index">
        <view class="relation-ideas">
          <view class="relation-idea">
            <text class="relation-dot" style="background: {{item.categoryA === '社会服务' ? '#667eea' : item.categoryA === '教育创新' ? '#764ba2' : item.categoryA === '生活娱乐' ? '#f093fb' : item.categoryA === '学习工作' ? '#f5576c' : '#fa709a'}}"></text>
            <text class="relation-title">{{item.titleA}}</text>
          </view>
          <view class="relation-link">
            <text class="relation-sim">{{item.sim}}% 相似</text>
            <view class="relation-line"></view>
          </view>
          <view class="relation-idea">
            <text class="relation-dot" style="background: {{item.categoryB === '社会服务' ? '#667eea' : item.categoryB === '教育创新' ? '#764ba2' : item.categoryB === '生活娱乐' ? '#f093fb' : item.categoryB === '学习工作' ? '#f5576c' : '#fa709a'}}"></text>
            <text class="relation-title">{{item.titleB}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="relation-empty" wx:if="{{relationList.length === 0}}">
      <text>记录更多想法后，将自动发现关联</text>
    </view>
  </view>

  <!-- 成长轨迹 -->
  <view class="section">
    <text class="section-title">📈 成长轨迹</text>
    <view class="growth-timeline">
      <view class="growth-item" wx:for="{{growthData}}" wx:key="date">
        <text class="growth-date">{{item.date}}</text>
        <text class="growth-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <!-- 提升建议 -->
  <view class="section">
    <text class="section-title">🎓 提升建议</text>
    <view class="grow-cards">
      <view class="grow-card" wx:for="{{growData}}" wx:key="type">
        <text class="grow-type type-{{item.type}}">{{item.typeLabel}}</text>
        <text class="grow-title">{{item.title}}</text>
        <view class="grow-list">
          <text class="grow-item" wx:for="{{item.items}}" wx:for-item="growItem" wx:key="*this">• {{growItem}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
