.header {
  text-align: center;
  padding: 20rpx 0 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: white;
  display: block;
  margin-bottom: 20rpx;
}

/* 热力图 */
.heatmap {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
}

.heatmap-cell {
  border-radius: 20rpx;
  padding: 24rpx 10rpx;
  text-align: center;
  color: white;
  font-weight: 600;
}

.heatmap-percent {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 6rpx;
}

.heatmap-label {
  font-size: 22rpx;
  opacity: 0.8;
}

/* 能力雷达 */
.radar-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
}

.radar-item {
  text-align: center;
  background: #12121f;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  border: 1rpx solid #2a2a4a;
}

.radar-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 6rpx;
}

.radar-name {
  color: #aaa;
  font-size: 22rpx;
  margin-bottom: 6rpx;
  display: block;
}

.radar-score {
  font-size: 32rpx;
  font-weight: 700;
  display: block;
}

.radar-bar {
  width: 100%;
  height: 8rpx;
  background: #2a2a4a;
  border-radius: 4rpx;
  margin-top: 10rpx;
  overflow: hidden;
}

.radar-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 1s;
}

/* 思维导图 */
.mindmap-canvas {
  width: 100%;
  height: 460rpx;
  background: #12121f;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

/* 关联发现列表 */
.relation-list {
  margin-top: 10rpx;
}

.relation-subtitle {
  font-size: 26rpx;
  color: #888;
  display: block;
  margin-bottom: 16rpx;
}

.relation-card {
  background: #12121f;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #2a2a4a;
}

.relation-ideas {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.relation-idea {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.relation-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.relation-title {
  color: white;
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.relation-link {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-left: 24rpx;
}

.relation-sim {
  font-size: 22rpx;
  color: #667eea;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.relation-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  opacity: 0.4;
}

.relation-empty {
  text-align: center;
  padding: 40rpx;
  color: #555;
  font-size: 26rpx;
}

/* 成长轨迹 */
.growth-timeline {
  position: relative;
  padding-left: 30rpx;
}

.growth-timeline::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: linear-gradient(to bottom, #667eea, #764ba2);
}

.growth-item {
  position: relative;
  padding-bottom: 24rpx;
  padding-left: 24rpx;
}

.growth-item::before {
  content: '';
  position: absolute;
  left: -22rpx;
  top: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #667eea;
  border: 3rpx solid #0f0f1a;
}

.growth-date {
  color: #667eea;
  font-size: 24rpx;
  font-weight: 600;
  display: block;
}

.growth-text {
  color: #bbb;
  font-size: 26rpx;
  margin-top: 6rpx;
  display: block;
}

/* 提升建议 */
.grow-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.grow-card {
  background: #12121f;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #2a2a4a;
}

.grow-type {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  margin-bottom: 10rpx;
}

.type-learn {
  background: rgba(67, 233, 123, 0.15);
  color: #43e97b;
}

.type-action {
  background: rgba(102, 126, 234, 0.15);
  color: #667eea;
}

.type-inspire {
  background: rgba(240, 147, 251, 0.15);
  color: #f093fb;
}

.grow-title {
  color: white;
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
  display: block;
}

.grow-item {
  color: #999;
  font-size: 22rpx;
  padding: 4rpx 0;
  display: block;
}

@media (max-width: 400px) {
  .grow-cards {
    grid-template-columns: 1fr;
  }
  .heatmap {
    grid-template-columns: repeat(2, 1fr);
  }
  .radar-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
