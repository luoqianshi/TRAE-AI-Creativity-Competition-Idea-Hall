.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: white;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #888;
  display: block;
  margin-bottom: 24rpx;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 16rpx;
}

.search-box {
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 20rpx;
  color: #555;
  font-size: 28rpx;
  z-index: 1;
}

.search-input {
  width: 100%;
  background: #12121f;
  border: 2rpx solid #2a2a4a;
  border-radius: 40rpx;
  padding: 16rpx 20rpx 16rpx 56rpx;
  font-size: 28rpx;
  color: white;
  box-sizing: border-box;
}

/* 分类筛选 */
.filter-scroll {
  margin-bottom: 20rpx;
}

.filter-list {
  display: flex;
  gap: 12rpx;
  white-space: nowrap;
}

.filter-item {
  background: #2a2a4a;
  color: #aaa;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  border: 1rpx solid #3a3a5a;
}

.filter-item.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-color: transparent;
}

/* 卡片列表 - 单列布局 */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.select-card {
  background: #12121f;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #2a2a4a;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.select-card.pinned {
  border-color: #ffd700;
  background: linear-gradient(135deg, #12121f, #1a1a2f);
}

.select-card.analyzed {
  border-color: #43e97b;
}

.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.card-title-wrap {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 12rpx;
  min-width: 0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: white;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.card-status {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  align-self: flex-start;
  white-space: nowrap;
}

.status-analyzed {
  background: rgba(67, 233, 123, 0.15);
  color: #43e97b;
}

.status-new {
  background: rgba(102, 126, 234, 0.15);
  color: #667eea;
}

.card-score {
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.card-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

/* 标签 - 单行显示 */
.card-tags {
  display: flex;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  align-items: center;
}

.card-tags .tag {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  white-space: nowrap;
}

.card-category {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.15);
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
}

/* 返回按钮 */
.back-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}

.back-arrow {
  font-size: 36rpx;
  color: #667eea;
  margin-right: 8rpx;
}

.back-text {
  font-size: 28rpx;
  color: #667eea;
}

/* 重新分析栏 */
.reanalyze-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: #12121f;
  border-radius: 16rpx;
  border: 1rpx solid #2a2a4a;
}

.analyzed-badge {
  background: rgba(67, 233, 123, 0.15);
  color: #43e97b;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.reanalyze-btn {
  color: #667eea;
  font-size: 26rpx;
  font-weight: 500;
  padding: 8rpx 16rpx;
}

/* 加载 */
.loading {
  text-align: center;
  padding: 100rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #2a2a4a;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: white;
  font-size: 30rpx;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.loading-hint {
  color: #888;
  font-size: 24rpx;
}

/* 想法摘要 */
.idea-summary {
  background: #12121f;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #2a2a4a;
}

.summary-title {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  display: block;
  margin-bottom: 12rpx;
}

.summary-content {
  font-size: 28rpx;
  color: #bbb;
  line-height: 1.7;
  margin-bottom: 16rpx;
  display: block;
}

.summary-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

/* 报告头部 */
.report-header {
  text-align: center;
  padding: 40rpx;
  background: linear-gradient(135deg, #1a1a3e, #2a2a5e);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #2a2a4a;
}

.score-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  font-size: 48rpx;
  font-weight: 700;
}

.score-circle.score-high {
  background: linear-gradient(135deg, #43e97b, #38f9d7);
  color: #1a1a2e;
}

.score-circle.score-mid {
  background: linear-gradient(135deg, #fa709a, #fee140);
  color: #1a1a2e;
}

.score-circle.score-low {
  background: linear-gradient(135deg, #f5576c, #ff6b6b);
  color: white;
}

.report-title {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  display: block;
}

.report-subtitle {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

/* 三维评分 - 横向布局 */
.score-breakdown {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 10rpx;
  background: #12121f;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #2a2a4a;
}

.score-item {
  text-align: center;
  flex: 1;
  padding: 0 10rpx;
}

.score-label {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-bottom: 10rpx;
}

.score-value {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.score-desc {
  font-size: 22rpx;
  color: #666;
  display: block;
  line-height: 1.4;
}

/* 报告板块 */
.report-section {
  background: #12121f;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #2a2a4a;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #667eea;
  display: block;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #bbb;
  line-height: 1.7;
  white-space: pre-line;
}

/* 风险 */
.risk-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #2a2a4a;
}

.risk-item:last-child {
  border-bottom: none;
}

.risk-level {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.risk-high {
  background: rgba(245, 87, 108, 0.15);
  color: #f5576c;
}

.risk-mid {
  background: rgba(250, 112, 154, 0.15);
  color: #fa709a;
}

.risk-low {
  background: rgba(67, 233, 123, 0.15);
  color: #43e97b;
}

.risk-text {
  font-size: 26rpx;
  color: #bbb;
}

/* 建议 */
.suggestion-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #2a2a4a;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.suggestion-text {
  font-size: 28rpx;
  color: #bbb;
  line-height: 1.6;
}
