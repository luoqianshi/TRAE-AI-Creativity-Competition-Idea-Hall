<view class="container">
  <!-- 想法选择列表 -->
  <view wx:if="{{!selectedIdea}}">
    <text class="page-title">📊 选择要分析的想法</text>
    <text class="page-subtitle">AI 将为你生成详细的可行性分析报告</text>
    
    <!-- 搜索栏 -->
    <view class="search-bar">
      <view class="search-box">
        <text class="search-icon">🔍</text>
        <input 
          class="search-input" 
          placeholder="搜索想法..." 
          placeholder-class="placeholder"
          bindinput="onSearch"
          value="{{searchText}}"
        />
      </view>
    </view>

    <!-- 分类筛选 -->
    <scroll-view class="filter-scroll" scroll-x>
      <view class="filter-list">
        <view class="filter-item {{currentFilter === 'all' ? 'active' : ''}}" bindtap="filterByCategory" data-category="all">全部</view>
        <view class="filter-item {{currentFilter === '社会服务' ? 'active' : ''}}" bindtap="filterByCategory" data-category="社会服务">社会服务</view>
        <view class="filter-item {{currentFilter === '教育创新' ? 'active' : ''}}" bindtap="filterByCategory" data-category="教育创新">教育创新</view>
        <view class="filter-item {{currentFilter === '生活娱乐' ? 'active' : ''}}" bindtap="filterByCategory" data-category="生活娱乐">生活娱乐</view>
        <view class="filter-item {{currentFilter === '学习工作' ? 'active' : ''}}" bindtap="filterByCategory" data-category="学习工作">学习工作</view>
        <view class="filter-item {{currentFilter === '硬件交互' ? 'active' : ''}}" bindtap="filterByCategory" data-category="硬件交互">硬件交互</view>
      </view>
    </scroll-view>
    
    <!-- 卡片列表 -->
    <view class="card-list">
      <view class="select-card {{item.pinned ? 'pinned' : ''}} {{item.analyzed ? 'analyzed' : ''}}" wx:for="{{filteredList}}" wx:key="id" bindtap="selectIdea" data-id="{{item.id}}">
        <view class="card-header-row">
          <view class="card-title-wrap">
            <text class="card-title">{{item.title}}</text>
            <text class="card-status {{item.analyzed ? 'status-analyzed' : 'status-new'}}">{{item.analyzed ? '✓ 已分析' : '新'}}</text>
          </view>
          <text class="card-score {{item.score >= 70 ? 'score-high' : item.score >= 50 ? 'score-mid' : 'score-low'}}">{{item.score}}分</text>
        </view>
        <text class="card-desc">{{item.content}}</text>
        <view class="card-bottom">
          <view class="card-tags">
            <text class="tag tag-blue" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
          <text class="card-category">{{item.category}}</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{filteredList.length === 0}}">
      <view class="empty-icon">💡</view>
      <text>没有找到匹配的想法</text>
    </view>
  </view>

  <!-- 分析报告 -->
  <view wx:if="{{selectedIdea}}">
    <view class="back-bar" bindtap="backToList">
      <text class="back-arrow">←</text>
      <text class="back-text">返回选择</text>
    </view>

    <view class="loading" wx:if="{{isLoading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">AI 正在深度分析中...</text>
      <text class="loading-hint">正在分析「{{selectedIdea.title}}」的可行性</text>
    </view>

    <view class="report" wx:if="{{report && !isLoading}}">
      <!-- 重新分析按钮 -->
      <view class="reanalyze-bar">
        <view class="analyzed-badge">✓ 该想法已分析</view>
        <text class="reanalyze-btn" bindtap="reanalyze">🔄 重新分析</text>
      </view>

      <view class="idea-summary card">
        <text class="summary-title">{{selectedIdea.title}}</text>
        <text class="summary-content">{{selectedIdea.content}}</text>
        <view class="summary-tags">
          <text class="tag tag-blue" wx:for="{{selectedIdea.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
      </view>

      <view class="report-header card">
        <view class="score-circle {{report.overallScore >= 70 ? 'score-high' : report.overallScore >= 50 ? 'score-mid' : 'score-low'}}">
          {{report.overallScore}}
        </view>
        <text class="report-title">综合可行性评分</text>
        <text class="report-subtitle">{{selectedIdea.category}} · 基于想法内容分析</text>
      </view>

      <view class="score-breakdown card">
        <view class="score-item">
          <text class="score-label">🔧 技术可行性</text>
          <text class="score-value {{report.techScore >= 70 ? 'score-high' : report.techScore >= 50 ? 'score-mid' : 'score-low'}}">{{report.techScore}}</text>
          <text class="score-desc">{{report.techDesc}}</text>
        </view>
        <view class="score-item">
          <text class="score-label">📈 市场可行性</text>
          <text class="score-value {{report.marketScore >= 70 ? 'score-high' : report.marketScore >= 50 ? 'score-mid' : 'score-low'}}">{{report.marketScore}}</text>
          <text class="score-desc">{{report.marketDesc}}</text>
        </view>
        <view class="score-item">
          <text class="score-label">💰 资源可行性</text>
          <text class="score-value {{report.resourceScore >= 70 ? 'score-high' : report.resourceScore >= 50 ? 'score-mid' : 'score-low'}}">{{report.resourceScore}}</text>
          <text class="score-desc">{{report.resourceDesc}}</text>
        </view>
      </view>

      <view class="report-section card">
        <text class="section-title">💡 核心洞察</text>
        <text class="section-content">{{report.insight}}</text>
      </view>

      <view class="report-section card">
        <text class="section-title">📈 市场调研</text>
        <text class="section-content">{{report.market}}</text>
      </view>

      <view class="report-section card">
        <text class="section-title">🔍 竞品分析</text>
        <text class="section-content">{{report.competitors}}</text>
      </view>

      <view class="report-section card">
        <text class="section-title">⚠️ 风险评估</text>
        <view class="risk-item" wx:for="{{report.risks}}" wx:key="index">
          <text class="risk-level risk-{{item.level}}">{{item.level === 'high' ? '高风险' : item.level === 'mid' ? '中风险' : '低风险'}}</text>
          <text class="risk-text">{{item.text}}</text>
        </view>
      </view>

      <view class="report-section card">
        <text class="section-title">🎯 行动建议</text>
        <view class="suggestion-item" wx:for="{{report.suggestions}}" wx:key="index">
          <text class="suggestion-num">{{index + 1}}</text>
          <text class="suggestion-text">{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
