.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
}

/* 捕捉卡片 */
.capture-card {
  background: #1a1a2e;
  border-radius: 32rpx;
  padding: 40rpx;
  margin: 20rpx 0;
  border: 1rpx solid #2a2a4a;
}

.capture-title {
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  display: block;
  margin-bottom: 8rpx;
}

.capture-desc {
  font-size: 26rpx;
  color: #888;
  display: block;
  margin-bottom: 30rpx;
}

.input-wrapper {
  position: relative;
  margin-bottom: 24rpx;
}

.capture-input {
  width: 100%;
  min-height: 200rpx;
  background: #12121f;
  border: 2rpx solid #2a2a4a;
  border-radius: 24rpx;
  padding: 24rpx 60rpx 24rpx 24rpx;
  font-size: 30rpx;
  color: white;
  box-sizing: border-box;
}

.placeholder {
  color: #555;
}

.clear-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  background: #2a2a4a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 24rpx;
  z-index: 10;
}

.capture-actions {
  display: flex;
  gap: 20rpx;
}

.capture-btn {
  flex: 1;
}

.btn-icon {
  margin-right: 8rpx;
}

.btn-voice {
  background: linear-gradient(135deg, #f093fb, #f5576c);
  color: white;
  border-radius: 40rpx;
  padding: 24rpx 40rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-voice::after {
  border: none;
}

.btn-voice.recording {
  animation: pulse 1s infinite;
  background: linear-gradient(135deg, #f5576c, #ff6b6b);
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

/* 想法分类 */
.category-section {
  margin-bottom: 30rpx;
}

.category-title {
  font-size: 26rpx;
  color: #888;
  display: block;
  margin-bottom: 16rpx;
}

.category-list {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
}

.category-item {
  background: #1a1a2e;
  border: 1rpx solid #2a2a4a;
  border-radius: 20rpx;
  padding: 20rpx 10rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-hover {
  background: #2a2a4a;
  transform: scale(0.98);
}

.category-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 22rpx;
  color: #aaa;
}

/* 今日统计 */
.today-stats {
  margin-bottom: 30rpx;
}

.stat-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #667eea;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

/* 最近想法 */
.recent-section {
  margin-top: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
}

.section-more {
  font-size: 26rpx;
  color: #667eea;
}

.recent-list {
  background: #1a1a2e;
  border-radius: 24rpx;
  border: 1rpx solid #2a2a4a;
  overflow: hidden;
}

.recent-item {
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #2a2a4a;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-title {
  font-size: 30rpx;
  color: white;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.recent-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.recent-category {
  font-size: 24rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.recent-score {
  font-size: 26rpx;
  font-weight: 600;
}
