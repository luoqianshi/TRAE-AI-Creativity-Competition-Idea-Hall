<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="title gradient-text">⚡ 闪念实验室</text>
    <text class="subtitle">你的每一个闪念，都值得被认真对待</text>
  </view>

  <!-- 输入区域 -->
  <view class="capture-card">
    <text class="capture-title">记录你的闪念</text>
    <text class="capture-desc">想到什么就说什么，AI 会帮你整理分析</text>
    
    <view class="input-wrapper">
      <textarea 
        class="capture-input" 
        placeholder="例如：我想做一个帮老年人智能陪伴的产品..."
        placeholder-class="placeholder"
        bindinput="onInput"
        value="{{inputValue}}"
        maxlength="500"
      />
      <view class="clear-btn" wx:if="{{inputValue.length > 0}}" bindtap="clearInput">
        <text>✕</text>
      </view>
    </view>
    
    <view class="capture-actions">
      <button class="btn-primary capture-btn" bindtap="addIdea">
        <text class="btn-icon">✨</text>
        <text>记录想法</text>
      </button>
      <button class="btn-voice {{isRecording ? 'recording' : ''}}" bindtap="toggleVoice">
        <text class="btn-icon">{{isRecording ? '⏹' : '🎤'}}</text>
        <text>{{isRecording ? '停止录音' : '语音输入'}}</text>
      </button>
    </view>
  </view>

  <!-- 想法分类 -->
  <view class="category-section">
    <text class="category-title">不知道写什么？选一个分类试试 👇</text>
    <view class="category-list">
      <view class="category-item" bindtap="quickFill" data-category="产品创意" hover-class="category-hover">
        <view class="category-icon">💡</view>
        <view class="category-name">产品创意</view>
      </view>
      <view class="category-item" bindtap="quickFill" data-category="学习心得" hover-class="category-hover">
        <view class="category-icon">📚</view>
        <view class="category-name">学习心得</view>
      </view>
      <view class="category-item" bindtap="quickFill" data-category="优化想法" hover-class="category-hover">
        <view class="category-icon">🔧</view>
        <view class="category-name">优化想法</view>
      </view>
      <view class="category-item" bindtap="quickFill" data-category="问题发现" hover-class="category-hover">
        <view class="category-icon">🔍</view>
        <view class="category-name">问题发现</view>
      </view>
      <view class="category-item" bindtap="quickFill" data-category="灵感闪现" hover-class="category-hover">
        <view class="category-icon">⚡</view>
        <view class="category-name">灵感闪现</view>
      </view>
    </view>
  </view>

  <!-- 今日统计 -->
  <view class="today-stats card" wx:if="{{todayCount > 0}}">
    <view class="stat-row">
      <view class="stat-item">
        <text class="stat-num">{{todayCount}}</text>
        <text class="stat-label">今日想法</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{todayAvgScore}}</text>
        <text class="stat-label">平均评分</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{todayMaxScore}}</text>
        <text class="stat-label">最高评分</text>
      </view>
    </view>
  </view>

  <!-- 最近想法 -->
  <view class="recent-section" wx:if="{{recentIdeas.length > 0}}">
    <view class="section-header">
      <text class="section-title">最近的想法</text>
      <text class="section-more" bindtap="goToIdeas">查看全部 ></text>
    </view>
    <view class="recent-list">
      <view class="recent-item" wx:for="{{recentIdeas}}" wx:key="id" bindtap="goToAnalysis" data-id="{{item.id}}">
        <view class="recent-title">{{item.title}}</view>
        <view class="recent-meta">
          <text class="recent-category">{{item.category}}</text>
          <text class="recent-score {{item.score >= 70 ? 'score-high' : item.score >= 50 ? 'score-mid' : 'score-low'}}">{{item.score}}分</text>
        </view>
      </view>
    </view>
  </view>
</view>
