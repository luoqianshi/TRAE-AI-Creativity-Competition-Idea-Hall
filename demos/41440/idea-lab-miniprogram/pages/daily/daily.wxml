<view class="container">
  <!-- 头部 -->
  <view class="daily-hero">
    <text class="hero-title">📋 今日想法报告</text>
    <text class="hero-date">{{todayDate}}</text>
    <view class="hero-stats">
      <view class="hero-stat">
        <text class="hero-num">{{todayCount}}</text>
        <text class="hero-label">今日想法</text>
      </view>
      <view class="hero-stat">
        <text class="hero-num">{{analyzedCount}}</text>
        <text class="hero-label">已分析</text>
      </view>
      <view class="hero-stat">
        <text class="hero-num">{{maxScore}}</text>
        <text class="hero-label">最高评分</text>
      </view>
      <view class="hero-stat">
        <text class="hero-num">{{categoryCount}}</text>
        <text class="hero-label">涉及领域</text>
      </view>
    </view>
  </view>

  <!-- 创意指数 -->
  <view class="ci-card card">
    <view class="ci-header">
      <view>
        <text class="ci-value">{{creativityIndex}}</text>
        <text class="ci-label">今日创意指数</text>
      </view>
      <view class="ci-status">
        <text class="ci-status-text">{{ciStatus}}</text>
        <text class="ci-status-desc">{{ciDesc}}</text>
      </view>
    </view>
    <view class="ci-bar">
      <view class="ci-bar-fill" style="width: {{creativityIndex}}%"></view>
    </view>
    <view class="ci-stats">
      <view class="ci-stat">
        <text class="ci-stat-num">{{weekCount}}</text>
        <text class="ci-stat-label">本周累计</text>
      </view>
      <view class="ci-stat">
        <text class="ci-stat-num">{{avgScore}}</text>
        <text class="ci-stat-label">平均评分</text>
      </view>
      <view class="ci-stat">
        <text class="ci-stat-num">{{totalScore}}</text>
        <text class="ci-stat-label">总分</text>
      </view>
    </view>
  </view>

  <!-- TOP 3 -->
  <view class="top3-section">
    <text class="section-title">🏆 最值得深入的想法 TOP 3</text>
    <view class="top3-list">
      <view class="top3-card {{index === 0 ? 'highlight' : ''}}" wx:for="{{top3}}" wx:key="id" bindtap="goToAnalysis" data-id="{{item.id}}">
        <view class="top3-header">
          <text class="top3-rank rank-{{index + 1}}">{{index + 1}}</text>
          <view class="top3-info">
            <text class="top3-title">{{item.title}}</text>
            <text class="top3-meta">可行性 {{item.score}}分 · {{item.category}}</text>
          </view>
        </view>
        <text class="top3-reason">{{item.reason}}</text>
      </view>
    </view>
  </view>

  <!-- 时间轴 -->
  <view class="timeline-section">
    <text class="section-title">🕐 今日想法时间轴</text>
    <view class="timeline">
      <view class="timeline-item {{item.pinned ? 'highlight' : ''}}" wx:for="{{timeline}}" wx:key="id">
        <text class="timeline-time">⏰ {{item.time}}</text>
        <text class="timeline-title">{{item.title}}</text>
        <text class="timeline-desc">{{item.content.substring(0, 40)}}{{item.content.length > 40 ? '...' : ''}}</text>
        <text class="timeline-score {{item.score >= 70 ? 'score-high' : item.score >= 50 ? 'score-mid' : 'score-low'}}">{{item.score}}分 · {{item.category}}</text>
      </view>
    </view>
  </view>

  <!-- 趋势图 -->
  <view class="trend-section">
    <text class="section-title">📈 本周创意趋势</text>
    <canvas type="2d" id="trendChart" class="trend-canvas"></canvas>
  </view>
</view>
