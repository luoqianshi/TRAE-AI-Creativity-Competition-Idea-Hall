.daily-hero {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.hero-date {
  font-size: 26rpx;
  opacity: 0.7;
  display: block;
  margin-bottom: 24rpx;
}

.hero-stats {
  display: flex;
  justify-content: space-around;
}

.hero-stat {
  text-align: center;
}

.hero-num {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
}

.hero-label {
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 4rpx;
}

/* 创意指数 */
.ci-card {
  margin-bottom: 20rpx;
}

.ci-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.ci-value {
  font-size: 64rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea, #f093fb);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: block;
}

.ci-label {
  font-size: 24rpx;
  color: #888;
}

.ci-status {
  text-align: right;
}

.ci-status-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #43e97b;
  display: block;
}

.ci-status-desc {
  font-size: 24rpx;
  color: #888;
}

.ci-bar {
  width: 100%;
  height: 12rpx;
  background: #2a2a4a;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.ci-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #667eea, #764ba2, #f093fb);
  transition: width 1s;
}

.ci-stats {
  display: flex;
  justify-content: space-around;
}

.ci-stat {
  text-align: center;
}

.ci-stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #667eea;
  display: block;
}

.ci-stat-label {
  font-size: 22rpx;
  color: #888;
}

/* TOP 3 */
.top3-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  display: block;
  margin-bottom: 16rpx;
}

.top3-card {
  background: #12121f;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #2a2a4a;
}

.top3-card.highlight {
  border-color: #f093fb;
  background: linear-gradient(135deg, #1a1a3e, #2a1a3e);
}

.top3-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.top3-rank {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rank-1 {
  background: linear-gradient(135deg, #ffd700, #ffaa00);
  color: #1a1a2e;
}

.rank-2 {
  background: linear-gradient(135deg, #c0c0c0, #a0a0a0);
  color: #1a1a2e;
}

.rank-3 {
  background: linear-gradient(135deg, #cd7f32, #b8690e);
  color: white;
}

.top3-title {
  font-size: 30rpx;
  color: white;
  font-weight: 500;
  display: block;
}

.top3-meta {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
  display: block;
}

.top3-reason {
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.5;
  margin-top: 12rpx;
  display: block;
}

/* 时间轴 */
.timeline-section {
  margin-bottom: 20rpx;
}

.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 18rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: linear-gradient(to bottom, #667eea, #764ba2, #f093fb);
}

.timeline-item {
  position: relative;
  padding-bottom: 24rpx;
  padding-left: 24rpx;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: -26rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #667eea;
  border: 4rpx solid #0f0f1a;
}

.timeline-item.highlight::before {
  background: #ffd700;
  box-shadow: 0 0 10rpx rgba(255, 215, 0, 0.4);
}

.timeline-time {
  color: #667eea;
  font-size: 24rpx;
  font-weight: 600;
  display: block;
}

.timeline-title {
  color: white;
  font-weight: 500;
  margin-top: 6rpx;
  font-size: 28rpx;
  display: block;
}

.timeline-desc {
  color: #888;
  font-size: 24rpx;
  margin-top: 4rpx;
  display: block;
}

.timeline-score {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
}

/* 趋势图 */
.trend-section {
  margin-bottom: 40rpx;
}

.trend-canvas {
  width: 100%;
  height: 300rpx;
  background: #12121f;
  border-radius: 20rpx;
}
