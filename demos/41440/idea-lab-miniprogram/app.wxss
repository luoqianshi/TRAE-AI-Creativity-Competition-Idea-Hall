/* 全局样式 - 暗色主题 */
page {
  background-color: #0f0f1a;
  color: #e0e0e0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
}

/* 卡片样式 */
.card {
  background: #1a1a2e;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #2a2a4a;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #2a2a4a;
  color: #aaa;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

.btn-secondary::after {
  border: none;
}

/* 输入框样式 */
.input {
  background: #12121f;
  border: 2rpx solid #2a2a4a;
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  font-size: 30rpx;
  color: white;
  width: 100%;
  box-sizing: border-box;
}

.input:focus {
  border-color: #667eea;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.tag-blue {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.tag-pink {
  background: linear-gradient(135deg, #f093fb, #f5576c);
  color: white;
}

.tag-green {
  background: linear-gradient(135deg, #43e97b, #38f9d7);
  color: #1a1a2e;
}

.tag-orange {
  background: linear-gradient(135deg, #fa709a, #fee140);
  color: #1a1a2e;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #555;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

/* 渐变文字 */
.gradient-text {
  background: linear-gradient(135deg, #667eea, #f093fb);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 分数颜色 */
.score-high { color: #43e97b; }
.score-mid { color: #fee140; }
.score-low { color: #f5576c; }

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.4s ease;
}

/* 滚动条隐藏 */
::-webkit-scrollbar {
  display: none;
}
