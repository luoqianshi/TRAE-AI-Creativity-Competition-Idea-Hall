<Window x:Class="AiCompanion.App.Views.InteractionLayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid>
        <!-- 透明背景，仅在控件区域可交互 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 上部大面积透明穿透区域（不放置控件） -->
        <Grid Grid.Row="0"/>

        <!-- 底部操作栏 -->
        <Border Background="#AA1E1E2E"
                CornerRadius="10"
                Padding="8,4"
                HorizontalAlignment="Center"
                Grid.Row="1"
                Margin="0,0,0,5"
                Cursor="Hand">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnChat"
                        Width="36" Height="36"
                        Margin="4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnChatClick">
                    <TextBlock Text="💬" FontSize="18"/>
                </Button>

                <Button x:Name="BtnSettings"
                        Width="36" Height="36"
                        Margin="4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnSettingsClick">
                    <TextBlock Text="⚙️" FontSize="18"/>
                </Button>

                <Button x:Name="BtnRefresh"
                        Width="36" Height="36"
                        Margin="4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnRefreshClick">
                    <TextBlock Text="🔄" FontSize="18"/>
                </Button>

                <Button x:Name="BtnClose"
                        Width="36" Height="36"
                        Margin="4,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnCloseClick">
                    <TextBlock Text="✕" FontSize="16" Foreground="#FF9999"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
