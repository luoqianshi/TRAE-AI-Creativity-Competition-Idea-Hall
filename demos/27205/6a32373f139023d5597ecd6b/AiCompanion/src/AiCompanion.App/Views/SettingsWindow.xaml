<Window x:Class="AiCompanion.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="480"
        Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Grid>
        <Border Background="#FF1E1E2E" CornerRadius="16">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Border Background="#FF2D2D44" CornerRadius="16,16,0,0" Grid.Row="0">
                    <Grid>
                        <TextBlock Text="⚙️ 设置" Foreground="#FFF0F0F8"
                                   FontSize="14" Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 设置内容 -->
                <ScrollViewer Grid.Row="1" Padding="16,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 角色设置 -->
                        <TextBlock Text="🎭 角色设置" Foreground="#FF6BB5" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="角色名称" Foreground="#FFA0A0C0" VerticalAlignment="Center"/>
                            <TextBox x:Name="CharName" Grid.Column="1" Background="#FF3A3A5C" Foreground="#FFF0F0F8"
                                     BorderThickness="0" CornerRadius="6" Padding="8,6" FontSize="13"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="性格描述" Foreground="#FFA0A0C0" VerticalAlignment="Center"/>
                            <TextBox x:Name="CharPersonality" Grid.Column="1" Background="#FF3A3A5C" Foreground="#FFF0F0F8"
                                     BorderThickness="0" CornerRadius="6" Padding="8,6" FontSize="13"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="身份背景" Foreground="#FFA0A0C0" VerticalAlignment="Center"/>
                            <TextBox x:Name="CharIdentity" Grid.Column="1" Background="#FF3A3A5C" Foreground="#FFF0F0F8"
                                     BorderThickness="0" CornerRadius="6" Padding="8,6" FontSize="13" TextWrapping="Wrap" Height="50"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="BtnRandomChar" Content="🎲 随机生成"
                                    Background="#FF3A3A5C" Foreground="#FFF0F0F8"
                                    BorderThickness="0" CornerRadius="6" Padding="12,6"
                                    Cursor="Hand" Margin="0,0,8,0"/>
                            <Button x:Name="BtnSaveChar" Content="💾 保存角色"
                                    Background="#FF6BB5" Foreground="White"
                                    BorderThickness="0" CornerRadius="6" Padding="12,6"
                                    Cursor="Hand"/>
                        </StackPanel>

                        <Separator Background="#FF3A3A5C" Height="1" Margin="0,8"/>

                        <!-- AI 设置 -->
                        <TextBlock Text="🤖 AI 设置" Foreground="#FF6BB5" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,10"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="当前后端" Foreground="#FFA0A0C0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbProvider" Grid.Column="1" Background="#FF3A3A5C"
                                      Foreground="#FFF0F0F8" BorderThickness="0" CornerRadius="6" Padding="8,4"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ollama 模型" Foreground="#FFA0A0C0" VerticalAlignment="Center"/>
                            <TextBox x:Name="OllamaModel" Grid.Column="1" Background="#FF3A3A5C" Foreground="#FFF0F0F8"
                                     BorderThickness="0" CornerRadius="6" Padding="8,6" FontSize="13"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="云端 API Key" Foreground="#FFA0A0C0" VerticalAlignment="Center"/>
                            <TextBox x:Name="ApiKey" Grid.Column="1" Background="#FF3A3A5C" Foreground="#FFF0F0F8"
                                     BorderThickness="0" CornerRadius="6" Padding="8,6" FontSize="13"/>
                        </Grid>

                        <Separator Background="#FF3A3A5C" Height="1" Margin="0,8"/>

                        <!-- 系统设置 -->
                        <TextBlock Text="⚡ 系统设置" Foreground="#FF6BB5" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,10"/>
                        <CheckBox x:Name="ChkAutoStart" Content="开机自启" Foreground="#FFF0F0F8"
                                  FontSize="13" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkWindowMonitor" Content="启用桌面行为监控" Foreground="#FFF0F0F8"
                                  FontSize="13" Margin="0,0,0,8" IsChecked="True"/>

                        <!-- 状态信息 -->
                        <TextBlock x:Name="TxtStatus" Foreground="#FFA0A0C0" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
