<Window x:Class="AiCompanion.App.Views.ChatDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对话"
        Width="380"
        Height="520"
        MinWidth="320"
        MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="True">
    <Grid>
        <!-- 圆角主背景 -->
        <Border Background="#FF1E1E2E"
                CornerRadius="16"
                Margin="0">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Background="#FF2D2D44"
                        CornerRadius="16,16,0,0"
                        Grid.Row="0"
                        MouseLeftButtonDown="OnTitleBarDragStart">
                    <Grid>
                        <TextBlock Text="💬 对话"
                                   Foreground="#FFF0F0F8"
                                   FontSize="14"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"/>
                        <Button Content="✕"
                                Width="32" Height="32"
                                FontSize="14"
                                Foreground="#FFA0A0C0"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                Click="OnCloseClick"/>
                    </Grid>
                </Border>

                <!-- 消息列表 -->
                <ScrollViewer Grid.Row="1"
                              x:Name="MessagesScroll"
                              VerticalScrollBarVisibility="Auto"
                              Padding="10">
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Border Padding="10,8"
                                            CornerRadius="12"
                                            MaxWidth="280">
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Foreground="#FFF0F0F8"
                                                   Margin="0,2,0,0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 输入区域 -->
                <Border Grid.Row="2"
                        Background="#FF2D2D44"
                        CornerRadius="0,0,16,16"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InputBox"
                                 Grid.Column="0"
                                 Background="#FF3A3A5C"
                                 Foreground="#FFF0F0F8"
                                 BorderThickness="0"
                                 CornerRadius="8"
                                 Padding="10,8"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MaxHeight="80"
                                 PreviewKeyDown="OnInputKeyDown"/>

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Margin="8,0,0,0"
                                Background="#FF6BB5"
                                BorderThickness="0"
                                CornerRadius="8"
                                Content="➤"
                                FontSize="16"
                                Foreground="White"
                                Cursor="Hand"
                                Click="OnSendClick"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
