<Application x:Class="AiCompanion.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <!-- 主题色 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6BB5"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FF9DD0"/>
        <SolidColorBrush x:Key="BgDarkBrush" Color="#FF1E1E2E"/>
        <SolidColorBrush x:Key="BgMediumBrush" Color="#FF2D2D44"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF0F0F8"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA0A0C0"/>
        <SolidColorBrush x:Key="BubbleUserBrush" Color="#FF3A3A5C"/>
        <SolidColorBrush x:Key="BubbleAiBrush" Color="#FF2D1B3A"/>
    </Application.Resources>
</Application>
