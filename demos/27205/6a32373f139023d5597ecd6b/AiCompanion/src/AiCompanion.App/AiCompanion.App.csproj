<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AiCompanion</AssemblyName>
    <RootNamespace>AiCompanion.App</RootNamespace>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiCompanion.Core\AiCompanion.Core.csproj" />
    <ProjectReference Include="..\AiCompanion.Infrastructure\AiCompanion.Infrastructure.csproj" />
    <ProjectReference Include="..\AiCompanion.Animation\AiCompanion.Animation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
