/* components/beast-icon/beast-icon.wxss */

.beast-icon {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.emoji {
  position: relative;
  z-index: 1;
}

/* 尺寸 */
.size-small .emoji {
  font-size: 48rpx;
}

.size-medium .emoji {
  font-size: 80rpx;
}

.size-large .emoji {
  font-size: 140rpx;
}

/* 锁定状态 */
.locked {
  opacity: 0.5;
  filter: grayscale(80%);
}

/* 光环 */
.aura {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  opacity: 0.3;
  animation: aura-glow 2s ease-in-out infinite;
}

.beast-qinglong .aura { background: radial-gradient(circle, #00d2ff, transparent); }
.beast-baihu .aura { background: radial-gradient(circle, #f5f7fa, transparent); }
.beast-zhuque .aura { background: radial-gradient(circle, #f5af19, transparent); }
.beast-xuanwu .aura { background: radial-gradient(circle, #38ef7d, transparent); }

@keyframes aura-glow {
  0%, 100% { opacity: 0.2; transform: scale(0.9); }
  50% { opacity: 0.5; transform: scale(1.1); }
}
