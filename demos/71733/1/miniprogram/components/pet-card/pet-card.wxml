<!-- components/pet-card/pet-card.wxml -->
<view class="pet-card beast-{{beastId}}" bindtap="onTap">
  <view class="card-top">
    <text class="card-emoji">{{emoji}}</text>
    <view class="card-badge" wx:if="{{isCurrent}}">出战</view>
  </view>
  <text class="card-name">{{name}}</text>
  <view class="card-meta">
    <text class="card-element">{{element}}</text>
    <text class="card-level">Lv.{{level}}</text>
  </view>
  <view class="card-exp-bar">
    <view class="card-exp-fill" style="width: {{expProgress}}%"></view>
  </view>
  <view class="card-stats">
    <text class="card-power">⚔️ {{power}}</text>
  </view>
</view>
