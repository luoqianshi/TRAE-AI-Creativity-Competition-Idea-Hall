/* components/pet-card/pet-card.wxss */

.pet-card {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  transition: transform 0.2s;
}

.pet-card:active {
  transform: scale(0.97);
}

.card-top {
  position: relative;
  margin-bottom: 12rpx;
}

.card-emoji {
  font-size: 72rpx;
  display: block;
}

.card-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  font-size: 18rpx;
  color: #ffffff;
  background: #e94560;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.card-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.card-meta {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.card-element {
  font-size: 20rpx;
  color: #888888;
}

.card-level {
  font-size: 20rpx;
  color: #00d2ff;
}

.card-exp-bar {
  width: 100%;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.card-exp-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.beast-qinglong .card-exp-fill { background: linear-gradient(90deg, #00d2ff, #3a7bd5); }
.beast-baihu .card-exp-fill { background: linear-gradient(90deg, #f5f7fa, #c3cfe2); }
.beast-zhuque .card-exp-fill { background: linear-gradient(90deg, #f12711, #f5af19); }
.beast-xuanwu .card-exp-fill { background: linear-gradient(90deg, #11998e, #38ef7d); }

.card-stats {
  display: flex;
  justify-content: center;
}

.card-power {
  font-size: 22rpx;
  color: #ffc107;
}
