/* app.wxss - 全局样式 */
page {
  background-color: #16213e;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  min-height: 100vh;
}

/* 通用容器 */
.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 通用卡片样式 */
.card {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, #e94560 0%, #c23152 100%);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(233, 69, 96, 0.4);
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn-secondary:active {
  opacity: 0.8;
  background: rgba(255, 255, 255, 0.15);
}

/* 通用标题 */
.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #e94560;
}

/* 经验条 */
.exp-bar-container {
  width: 100%;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  overflow: hidden;
  margin-top: 12rpx;
}

.exp-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* 四神兽主题色 */
.beast-qinglong .exp-bar-fill {
  background: linear-gradient(90deg, #00d2ff, #3a7bd5);
}

.beast-baihu .exp-bar-fill {
  background: linear-gradient(90deg, #f5f7fa, #c3cfe2);
}

.beast-zhuque .exp-bar-fill {
  background: linear-gradient(90deg, #f12711, #f5af19);
}

.beast-xuanwu .exp-bar-fill {
  background: linear-gradient(90deg, #11998e, #38ef7d);
}

/* 动画 */
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

@keyframes glow {
  0%, 100% { box-shadow: 0 0 20rpx rgba(233, 69, 96, 0.3); }
  50% { box-shadow: 0 0 40rpx rgba(233, 69, 96, 0.6); }
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}

.animate-float {
  animation: float 3s ease-in-out infinite;
}

.animate-glow {
  animation: glow 2s ease-in-out infinite;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(233, 69, 96, 0.2);
  color: #e94560;
}

.tag-new {
  background: rgba(255, 193, 7, 0.2);
  color: #ffc107;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #888888;
}

.empty-state text {
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: 24rpx 0;
}
