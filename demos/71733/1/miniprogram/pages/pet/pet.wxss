/* pages/pet/pet.wxss - 宠物详情页样式 */

.current-beast {
  margin-bottom: 30rpx;
}

.beast-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 30rpx;
  position: relative;
  overflow: hidden;
}

.beast-visual {
  position: relative;
  margin-bottom: 24rpx;
}

.beast-emoji {
  font-size: 200rpx;
  display: block;
  position: relative;
  z-index: 1;
}

.beast-aura {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  opacity: 0.3;
  animation: glow 3s ease-in-out infinite;
}

.beast-qinglong .beast-aura { background: radial-gradient(circle, #00d2ff, transparent); }
.beast-baihu .beast-aura { background: radial-gradient(circle, #f5f7fa, transparent); }
.beast-zhuque .beast-aura { background: radial-gradient(circle, #f5af19, transparent); }
.beast-xuanwu .beast-aura { background: radial-gradient(circle, #38ef7d, transparent); }

.beast-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.beast-name {
  font-size: 44rpx;
  font-weight: bold;
}

.beast-desc {
  font-size: 24rpx;
  color: #888888;
  text-align: center;
}

.element-tag {
  background: rgba(255, 255, 255, 0.1);
  color: #cccccc;
}

/* 详细属性 */
.detail-card {
  padding: 30rpx;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-label {
  font-size: 22rpx;
  color: #888888;
  margin-bottom: 8rpx;
}

.detail-value {
  font-size: 34rpx;
  font-weight: bold;
}

.level-value {
  color: #00d2ff;
}

.power-value {
  color: #ffc107;
}

.collection-value {
  color: #e94560;
}

.exp-detail {
  margin-top: 8rpx;
}

.exp-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.exp-label {
  font-size: 24rpx;
  color: #888888;
}

.exp-text {
  font-size: 24rpx;
  color: #cccccc;
}

/* 已保存神兽列表 */
.section {
  margin-bottom: 30rpx;
}

.beast-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.beast-list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
}

.list-emoji {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.list-info {
  flex: 1;
}

.list-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
}

.list-level {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-top: 4rpx;
}

.list-action {
  font-size: 26rpx;
  color: #e94560;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(233, 69, 96, 0.3);
  border-radius: 30rpx;
}

/* 操作按钮 */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-btn {
  width: 100%;
  margin: 0;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  max-height: 70vh;
  background: #1a1a2e;
  border-radius: 24rpx;
  padding: 40rpx;
  overflow-y: auto;
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 16rpx;
}

.modal-hint {
  display: block;
  font-size: 24rpx;
  color: #888888;
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.modal-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  transition: background 0.2s;
}

.modal-item.current {
  background: rgba(233, 69, 96, 0.15);
  border: 1rpx solid rgba(233, 69, 96, 0.3);
}

.modal-item:active {
  background: rgba(255, 255, 255, 0.1);
}

.modal-emoji {
  font-size: 50rpx;
  margin-right: 20rpx;
}

.modal-info {
  flex: 1;
}

.modal-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
}

.modal-sub {
  display: block;
  font-size: 22rpx;
  color: #888888;
  margin-top: 4rpx;
}

.modal-check {
  font-size: 32rpx;
  color: #e94560;
  font-weight: bold;
}

.adopt-item:active {
  background: rgba(56, 239, 125, 0.1);
}

.modal-close {
  width: 100%;
  margin: 0;
}
