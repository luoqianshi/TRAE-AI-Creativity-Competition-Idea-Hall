<!-- pages/pet/pet.wxml - 宠物详情页 -->
<view class="container">
  <!-- 当前神兽信息 -->
  <view class="current-beast beast-{{currentBeast}}">
    <view class="beast-hero card">
      <view class="beast-visual">
        <text class="beast-emoji animate-float">{{beastEmoji}}</text>
        <view class="beast-aura"></view>
      </view>
      <view class="beast-header">
        <text class="beast-name">{{beastName}}</text>
        <text class="tag element-tag">{{beastElement}}属性</text>
        <text class="tag tag-new" wx:if="{{isMaxLevel}}">满级</text>
      </view>
      <text class="beast-desc">{{beastDescription}}</text>
    </view>

    <!-- 详细属性 -->
    <view class="detail-card card">
      <view class="detail-grid">
        <view class="detail-item">
          <text class="detail-label">等级</text>
          <text class="detail-value level-value">Lv.{{level}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-label">战力</text>
          <text class="detail-value power-value">⚔️ {{power}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-label">喂养次数</text>
          <text class="detail-value">{{totalFeedCount}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-label">收藏数</text>
          <text class="detail-value collection-value">{{collectionCount}}/4</text>
        </view>
      </view>

      <view class="divider"></view>

      <!-- 经验条 -->
      <view class="exp-detail">
        <view class="exp-header">
          <text class="exp-label">经验值</text>
          <text class="exp-text" wx:if="{{!isMaxLevel}}">{{exp}} / {{expForNextLevel}}</text>
          <text class="exp-text" wx:else>MAX</text>
        </view>
        <view class="exp-bar-container">
          <view class="exp-bar-fill" style="width: {{expProgress}}%"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 已保存的神兽 -->
  <view class="section" wx:if="{{savedBeasts.length > 0}}">
    <text class="section-title">已保存的神兽</text>
    <view class="beast-list">
      <view class="beast-list-item card" wx:for="{{savedBeasts}}" wx:key="id" bindtap="onSelectBeast" data-id="{{item.id}}">
        <text class="list-emoji">{{item.emoji}}</text>
        <view class="list-info">
          <text class="list-name">{{item.name}}</text>
          <text class="list-level">Lv.{{item.level}} · ⚔️ {{item.power}}</text>
        </view>
        <text class="list-action">切换</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <button class="btn-primary action-btn" bindtap="onSwitchBeast">🔄 切换神兽</button>
    <button class="btn-secondary action-btn" bindtap="onAdoptBeast" wx:if="{{adoptableBeasts.length > 0}}">🐣 领养新神兽</button>
  </view>

  <!-- 切换弹窗 -->
  <view class="modal-mask" wx:if="{{showSwitchModal}}" bindtap="onCloseSwitchModal">
    <view class="modal-content" catchtap="preventBubble">
      <text class="modal-title">选择神兽</text>
      <view class="modal-list">
        <view class="modal-item {{item.isCurrent ? 'current' : ''}}" wx:for="{{allBeasts}}" wx:key="id"
          bindtap="onSelectBeast" data-id="{{item.id}}">
          <text class="modal-emoji">{{item.emoji}}</text>
          <view class="modal-info">
            <text class="modal-name">{{item.name}}</text>
            <text class="modal-sub">{{item.element}}属性{{item.isCurrent ? ' · 当前' : item.isSaved ? ' · 已保存' : ''}}</text>
          </view>
          <text class="modal-check" wx:if="{{item.isCurrent}}">✓</text>
        </view>
      </view>
      <button class="btn-secondary modal-close" bindtap="onCloseSwitchModal">关闭</button>
    </view>
  </view>

  <!-- 领养弹窗 -->
  <view class="modal-mask" wx:if="{{showAdoptModal}}" bindtap="onCloseAdoptModal">
    <view class="modal-content" catchtap="preventBubble">
      <text class="modal-title">领养新神兽</text>
      <text class="modal-hint">领养后当前神兽数据将被保存</text>
      <view class="modal-list">
        <view class="modal-item adopt-item" wx:for="{{adoptableBeasts}}" wx:key="id"
          bindtap="onSelectAdopt" data-id="{{item.id}}">
          <text class="modal-emoji">{{item.emoji}}</text>
          <view class="modal-info">
            <text class="modal-name">{{item.name}}</text>
            <text class="modal-sub">{{item.element}}属性 · {{item.description}}</text>
          </view>
        </view>
      </view>
      <button class="btn-secondary modal-close" bindtap="onCloseAdoptModal">关闭</button>
    </view>
  </view>
</view>
