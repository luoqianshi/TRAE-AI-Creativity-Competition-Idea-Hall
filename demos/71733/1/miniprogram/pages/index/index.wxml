<!-- pages/index/index.wxml - 首页 -->
<view class="container">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="title">四神兽养成</text>
    <text class="subtitle">东方神话 · 灵兽驯养</text>
  </view>

  <!-- 孵蛋状态 -->
  <view class="egg-section" wx:if="{{hasEgg}}">
    <view class="egg-container {{showHatchAnimation ? 'hatching' : ''}} {{eggTapScale ? 'tap-scale' : ''}}" bindtap="onTapEgg">
      <view class="egg-glow"></view>
      <text class="egg-emoji">🥚</text>
      <view class="egg-cracks" wx:if="{{eggClickCount > 3}}">
        <text class="crack crack-1">✨</text>
        <text class="crack crack-2" wx:if="{{eggClickCount > 6}}">💫</text>
        <text class="crack crack-3" wx:if="{{eggClickCount > 8}}">⭐</text>
      </view>
    </view>

    <!-- 孵化进度 -->
    <view class="egg-progress card">
      <view class="progress-header">
        <text class="progress-label">孵化进度</text>
        <text class="progress-value">{{eggClickCount}}/{{eggClickTotal}}</text>
      </view>
      <view class="progress-bar-container">
        <view class="progress-bar-fill" style="width: {{eggProgress}}%"></view>
      </view>
      <text class="progress-hint">点击神蛋加速孵化</text>
    </view>

    <!-- 孵化粒子效果 -->
    <view class="particles" wx:if="{{showHatchAnimation}}">
      <view wx:for="{{particles}}" wx:key="id"
        class="particle"
        style="left: {{item.x}}rpx; top: {{item.y}}rpx; width: {{item.size}}rpx; height: {{item.size}}rpx; animation-delay: {{item.delay}}s; animation-duration: {{item.duration}}s;">
      </view>
    </view>
  </view>

  <!-- 宠物状态 -->
  <view class="pet-section beast-{{beastTheme}}" wx:if="{{hasPet}}">
    <!-- 宠物展示区 -->
    <view class="pet-display card {{showLevelUpAnimation ? 'level-up-glow' : ''}}">
      <view class="pet-emoji-container animate-float">
        <text class="pet-emoji {{showFeedAnimation ? 'feed-bounce' : ''}}">{{beastEmoji}}</text>
      </view>
      <view class="pet-info">
        <view class="pet-name-row">
          <text class="pet-name">{{beastName}}</text>
          <text class="tag element-tag">{{beastElement}}属性</text>
          <text class="tag tag-new" wx:if="{{isMaxLevel}}">满级</text>
        </view>
        <text class="pet-desc">{{beastDescription}}</text>
      </view>
    </view>

    <!-- 等级与经验 -->
    <view class="stats-card card">
      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-label">等级</text>
          <text class="stat-value">Lv.{{level}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">战力</text>
          <text class="stat-value power-value">⚔️ {{power}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">喂养</text>
          <text class="stat-value">{{totalFeedCount}}次</text>
        </view>
      </view>

      <view class="divider"></view>

      <!-- 经验条 -->
      <view class="exp-section">
        <view class="exp-header">
          <text class="exp-label">经验值</text>
          <text class="exp-value" wx:if="{{!isMaxLevel}}">{{exp}}/{{expForNextLevel}}</text>
          <text class="exp-value" wx:else>MAX</text>
        </view>
        <view class="exp-bar-container">
          <view class="exp-bar-fill" style="width: {{expProgress}}%"></view>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="btn-primary feed-btn" bindtap="onFeedPet" disabled="{{!canFeed || isMaxLevel}}">
        <text wx:if="{{canFeed && !isMaxLevel}}">🍖 喂养</text>
        <text wx:elif="{{isMaxLevel}}">✨ 已满级</text>
        <text wx:else>⏳ {{feedCooldownText}}</text>
      </button>
      <button class="btn-secondary detail-btn" bindtap="onGoToPet">📋 详情</button>
    </view>

    <!-- 升级特效 -->
    <view class="level-up-overlay" wx:if="{{showLevelUpAnimation}}">
      <text class="level-up-text">⬆️ LEVEL UP!</text>
    </view>
  </view>

  <!-- 无数据（不应出现） -->
  <view class="empty-state" wx:if="{{!hasEgg && !hasPet && hasData}}">
    <text class="empty-icon">🔮</text>
    <text>正在初始化...</text>
  </view>
</view>
