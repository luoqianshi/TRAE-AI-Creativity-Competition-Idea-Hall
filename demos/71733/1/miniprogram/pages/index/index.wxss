/* pages/index/index.wxss - 首页样式 */

/* 顶部标题 */
.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
}

.title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #e94560, #ffc107, #00d2ff);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-top: 8rpx;
  letter-spacing: 8rpx;
}

/* ====== 孵蛋区域 ====== */
.egg-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.egg-container {
  position: relative;
  width: 360rpx;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 40rpx 0;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(233, 69, 96, 0.1) 0%, transparent 70%);
  transition: transform 0.15s ease;
}

.egg-container.tap-scale {
  transform: scale(0.95);
}

.egg-container.hatching {
  animation: hatch-shake 0.3s ease infinite;
}

.egg-glow {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 193, 7, 0.3) 0%, transparent 60%);
  animation: glow 2s ease-in-out infinite;
}

.egg-emoji {
  font-size: 160rpx;
  z-index: 1;
}

.egg-cracks {
  position: absolute;
  width: 100%;
  height: 100%;
}

.crack {
  position: absolute;
  font-size: 40rpx;
  animation: crack-appear 0.3s ease;
}

.crack-1 { top: 20%; left: 15%; }
.crack-2 { top: 60%; right: 15%; }
.crack-3 { bottom: 25%; left: 40%; }

.egg-progress {
  width: 100%;
  text-align: center;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.progress-label {
  font-size: 28rpx;
  color: #cccccc;
}

.progress-value {
  font-size: 28rpx;
  color: #ffc107;
  font-weight: bold;
}

.progress-bar-container {
  width: 100%;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #e94560, #ffc107);
  transition: width 0.3s ease;
}

.progress-hint {
  display: block;
  font-size: 22rpx;
  color: #888888;
  margin-top: 16rpx;
}

/* 孵化粒子 */
.particles {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 100;
}

.particle {
  position: absolute;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffc107, #e94560);
  animation: particle-fly 1.5s ease-out forwards;
  opacity: 0;
}

/* ====== 宠物区域 ====== */
.pet-section {
  display: flex;
  flex-direction: column;
}

.pet-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx;
  position: relative;
  overflow: hidden;
}

.pet-display.level-up-glow {
  box-shadow: 0 0 60rpx rgba(255, 193, 7, 0.5);
}

.pet-emoji-container {
  margin-bottom: 20rpx;
}

.pet-emoji {
  font-size: 180rpx;
  display: block;
}

.pet-emoji.feed-bounce {
  animation: feed-bounce 0.4s ease;
}

.pet-info {
  text-align: center;
  width: 100%;
}

.pet-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.pet-name {
  font-size: 40rpx;
  font-weight: bold;
}

.element-tag {
  background: rgba(255, 255, 255, 0.1);
  color: #cccccc;
}

.pet-desc {
  font-size: 24rpx;
  color: #888888;
}

/* 神兽主题色 */
.beast-qinglong .pet-display {
  border-color: rgba(0, 210, 255, 0.3);
}

.beast-baihu .pet-display {
  border-color: rgba(245, 247, 250, 0.3);
}

.beast-zhuque .pet-display {
  border-color: rgba(241, 39, 17, 0.3);
}

.beast-xuanwu .pet-display {
  border-color: rgba(56, 239, 125, 0.3);
}

/* 统计卡片 */
.stats-card {
  padding: 30rpx;
}

.stat-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 22rpx;
  color: #888888;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
}

.power-value {
  color: #ffc107;
}

.exp-section {
  margin-top: 8rpx;
}

.exp-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.exp-label {
  font-size: 24rpx;
  color: #888888;
}

.exp-value {
  font-size: 24rpx;
  color: #cccccc;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.feed-btn, .detail-btn {
  flex: 1;
  margin: 0;
  border: none;
  line-height: 88rpx;
  padding: 0;
}

.feed-btn[disabled] {
  background: rgba(255, 255, 255, 0.05);
  color: #555555;
  box-shadow: none;
}

.detail-btn {
  line-height: 88rpx;
}

/* 升级特效 */
.level-up-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  pointer-events: none;
  animation: fade-out 1.5s ease forwards;
}

.level-up-text {
  font-size: 72rpx;
  font-weight: bold;
  color: #ffc107;
  text-shadow: 0 0 30rpx rgba(255, 193, 7, 0.8);
  animation: level-up-pop 1.5s ease;
}

/* 空状态 */
.empty-icon {
  font-size: 120rpx;
}

/* ====== 动画 ====== */
@keyframes hatch-shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-5deg); }
  75% { transform: rotate(5deg); }
}

@keyframes crack-appear {
  from { opacity: 0; transform: scale(0); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes particle-fly {
  0% { opacity: 1; transform: translateY(0) scale(1); }
  100% { opacity: 0; transform: translateY(-200rpx) scale(0); }
}

@keyframes feed-bounce {
  0% { transform: scale(1); }
  30% { transform: scale(1.2); }
  60% { transform: scale(0.9); }
  100% { transform: scale(1); }
}

@keyframes level-up-pop {
  0% { transform: scale(0.5); opacity: 0; }
  30% { transform: scale(1.3); opacity: 1; }
  60% { transform: scale(0.95); opacity: 1; }
  100% { transform: scale(1); opacity: 0; }
}

@keyframes fade-out {
  0%, 60% { opacity: 1; }
  100% { opacity: 0; }
}
