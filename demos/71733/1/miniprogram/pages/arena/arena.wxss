/* pages/arena/arena.wxss - 竞技场页面样式 */

/* 我的战力 */
.my-power {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.power-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.my-emoji {
  font-size: 60rpx;
}

.power-info {
  display: flex;
  flex-direction: column;
}

.power-name {
  font-size: 30rpx;
  font-weight: bold;
}

.power-level {
  font-size: 22rpx;
  color: #888888;
}

.power-display {
  text-align: right;
}

.power-label {
  display: block;
  font-size: 22rpx;
  color: #888888;
  margin-bottom: 4rpx;
}

.power-number {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #ffc107;
}

/* 竞技场列表 */
.arena-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.arena-card {
  padding: 30rpx;
  position: relative;
  overflow: hidden;
}

.arena-card.locked {
  opacity: 0.6;
}

.arena-card.available {
  border-color: rgba(56, 239, 125, 0.3);
}

.arena-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.arena-icon {
  font-size: 48rpx;
}

.arena-info {
  flex: 1;
}

.arena-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
}

.arena-desc {
  display: block;
  font-size: 22rpx;
  color: #888888;
  margin-top: 4rpx;
}

.arena-details {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.arena-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.arena-stat-label {
  font-size: 20rpx;
  color: #888888;
  margin-bottom: 6rpx;
}

.arena-stat-value {
  font-size: 28rpx;
  font-weight: bold;
}

.reward-value {
  color: #ffc107;
}

.fight-btn {
  width: 100%;
  margin: 0;
  border: none;
  line-height: 80rpx;
  padding: 0;
  font-size: 30rpx;
}

.fight-btn[disabled] {
  opacity: 0.5;
}

/* ==============================
   战斗动画系统
   ============================== */

/* --- 战斗遮罩 --- */
.battle-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: overlay-fade-in 300ms ease-out;
}

@keyframes overlay-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* --- 屏幕震动容器 --- */
.battle-screen {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  will-change: transform;
}

.battle-screen.screen-shake-light {
  animation: screen-shake-light 200ms ease;
}

.battle-screen.screen-shake-heavy {
  animation: screen-shake-heavy 300ms ease;
}

/* --- 回合指示器 --- */
.round-indicator {
  position: absolute;
  top: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 15;
}

.round-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffc107;
  text-shadow: 0 0 20rpx rgba(255, 193, 7, 0.5);
  animation: round-flash 800ms ease-out forwards;
}

@keyframes round-flash {
  0% { transform: scale(0.5); opacity: 0; }
  30% { transform: scale(1.3); opacity: 1; }
  60% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.8); opacity: 0; }
}

/* --- 技能名称 --- */
.skill-name-container {
  position: absolute;
  top: 160rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 15;
  white-space: nowrap;
}

.skill-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 0 20rpx rgba(255, 255, 255, 0.5);
}

.skill-name.skill-flash {
  animation: skill-flash 400ms ease-out forwards;
}

.skill-name.skill-flash-intensified {
  animation: skill-flash 500ms ease-out forwards;
  color: #ffc107;
  text-shadow: 0 0 30rpx rgba(255, 193, 7, 0.8), 0 0 60rpx rgba(255, 193, 7, 0.4);
}

@keyframes skill-flash {
  0% { transform: scale(0.5); opacity: 0; letter-spacing: 20rpx; }
  40% { transform: scale(1.2); opacity: 1; letter-spacing: 8rpx; }
  60% { transform: scale(1); opacity: 1; letter-spacing: 4rpx; }
  100% { transform: scale(0.8); opacity: 0; letter-spacing: 0; }
}

/* --- 战斗场景 --- */
.battle-scene {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  padding: 0 30rpx;
  position: relative;
  z-index: 5;
}

/* --- 战斗者区域 --- */
.fighter {
  display: flex;
  flex-direction: column;
  align-items: center;
  will-change: transform, opacity;
}

.fighter-emoji-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.fighter-emoji {
  font-size: 120rpx;
  position: relative;
  z-index: 2;
}

.fighter-name {
  font-size: 24rpx;
  color: #cccccc;
  font-weight: bold;
}

/* --- HP 血条 --- */
.hp-bar {
  width: 200rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hp-bar-bg {
  width: 100%;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.hp-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.4s ease-out;
  background: linear-gradient(90deg, #38ef7d, #11998e);
}

.hp-bar-fill.hp-low {
  background: linear-gradient(90deg, #ffc107, #ff9800);
}

.hp-bar-fill.hp-critical {
  background: linear-gradient(90deg, #e94560, #b71c1c);
  animation: hp-critical-flash 0.5s ease infinite;
}

@keyframes hp-critical-flash {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.hp-text {
  font-size: 18rpx;
  color: #aaaaaa;
  margin-top: 4rpx;
}

/* --- VS 标识 --- */
.battle-vs {
  font-size: 48rpx;
  font-weight: bold;
  color: #e94560;
  opacity: 0;
  will-change: transform;
}

.battle-vs.vs-pop {
  animation: vs-pop 500ms ease-out forwards;
}

/* --- 元素光环 --- */
.element-aura {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200rpx;
  height: 200rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
  z-index: 1;
}

.element-aura.active {
  opacity: 1;
  animation: aura-burst 400ms ease-out;
}

/* 青龙光环 - 蓝绿 */
.element-aura.beast-qinglong.active {
  background: radial-gradient(circle, rgba(0, 210, 255, 0.4), transparent 70%);
  box-shadow: 0 0 30rpx rgba(0, 210, 255, 0.3);
}

/* 白虎光环 - 银白 */
.element-aura.beast-baihu.active {
  background: radial-gradient(circle, rgba(245, 247, 250, 0.4), transparent 70%);
  box-shadow: 0 0 30rpx rgba(245, 247, 250, 0.3);
}

/* 朱雀光环 - 红橙 */
.element-aura.beast-zhuque.active {
  background: radial-gradient(circle, rgba(241, 39, 17, 0.4), transparent 70%);
  box-shadow: 0 0 30rpx rgba(241, 39, 17, 0.3);
}

/* 玄武光环 - 翠绿 */
.element-aura.beast-xuanwu.active {
  background: radial-gradient(circle, rgba(56, 239, 125, 0.4), transparent 70%);
  box-shadow: 0 0 30rpx rgba(56, 239, 125, 0.3);
}

@keyframes aura-burst {
  0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0; }
  50% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.8; }
  100% { transform: translate(-50%, -50%) scale(1); opacity: 0; }
}

/* --- 敌方攻击特效 --- */
.enemy-strike-effect {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 160rpx;
  height: 80rpx;
  transform: translate(-50%, -50%);
  opacity: 0;
  pointer-events: none;
  z-index: 3;
}

.enemy-strike-effect.active {
  animation: enemy-strike-wave 400ms ease-out forwards;
}

@keyframes enemy-strike-wave {
  0% { opacity: 0; transform: translate(40rpx, -50%) scale(0.5); box-shadow: 0 0 0 #e94560; }
  40% { opacity: 0.9; transform: translate(-50%, -50%) scale(1.2); box-shadow: 0 0 40rpx #e94560; background: radial-gradient(ellipse, rgba(233, 69, 96, 0.5), transparent); }
  100% { opacity: 0; transform: translate(-120rpx, -50%) scale(0.8); box-shadow: 0 0 0 #e94560; }
}

/* --- 元素技能特效层 --- */
.element-effect-layer {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 400rpx;
  height: 400rpx;
  pointer-events: none;
  z-index: 10;
}

.element-effect {
  width: 100%;
  height: 100%;
  opacity: 0;
  will-change: transform, opacity;
}

/* 青龙 - 风雷斩 */
.element-qinglong.active {
  animation: element-qinglong-attack 400ms ease-out forwards;
}

@keyframes element-qinglong-attack {
  0% { opacity: 0; transform: translateX(-100rpx) scale(0.3); box-shadow: 0 0 0 #00d2ff; }
  30% { opacity: 1; transform: translateX(0) scale(1.2); box-shadow: 0 0 40rpx #00d2ff, 0 0 80rpx #3a7bd5; background: radial-gradient(ellipse at 30% 50%, rgba(0, 210, 255, 0.6), transparent); }
  60% { opacity: 0.8; transform: translateX(80rpx) scale(1); box-shadow: 0 0 60rpx #00d2ff; }
  100% { opacity: 0; transform: translateX(200rpx) scale(0.5); box-shadow: 0 0 0 #00d2ff; }
}

.element-qinglong.active.intensified {
  animation: element-qinglong-attack-intense 500ms ease-out forwards;
}

@keyframes element-qinglong-attack-intense {
  0% { opacity: 0; transform: translateX(-150rpx) scale(0.3); box-shadow: 0 0 0 #00d2ff; }
  25% { opacity: 1; transform: translateX(-30rpx) scale(1.5); box-shadow: 0 0 60rpx #00d2ff, 0 0 120rpx #3a7bd5; background: radial-gradient(ellipse at 30% 50%, rgba(0, 210, 255, 0.8), transparent); }
  50% { opacity: 0.9; transform: translateX(60rpx) scale(1.3); box-shadow: 0 0 80rpx #00d2ff; }
  100% { opacity: 0; transform: translateX(250rpx) scale(0.3); box-shadow: 0 0 0 #00d2ff; }
}

/* 白虎 - 庚金裂空 */
.element-baihu.active {
  animation: element-baihu-attack 400ms ease-out forwards;
}

@keyframes element-baihu-attack {
  0% { opacity: 0; transform: scale(0) rotate(0deg); }
  40% { opacity: 1; transform: scale(1.5) rotate(90deg); box-shadow: 0 0 40rpx #f5f7fa, 0 0 80rpx #c3cfe2; background: radial-gradient(circle, rgba(245, 247, 250, 0.6), transparent); }
  70% { opacity: 0.7; transform: scale(1.2) rotate(180deg); }
  100% { opacity: 0; transform: scale(0.3) rotate(360deg); }
}

.element-baihu.active.intensified {
  animation: element-baihu-attack-intense 500ms ease-out forwards;
}

@keyframes element-baihu-attack-intense {
  0% { opacity: 0; transform: scale(0) rotate(0deg); }
  30% { opacity: 1; transform: scale(2) rotate(120deg); box-shadow: 0 0 60rpx #f5f7fa, 0 0 120rpx #c3cfe2; background: radial-gradient(circle, rgba(245, 247, 250, 0.8), transparent); }
  60% { opacity: 0.8; transform: scale(1.5) rotate(240deg); }
  100% { opacity: 0; transform: scale(0.2) rotate(480deg); }
}

/* 朱雀 - 涅槃之焰 */
.element-zhuque.active {
  animation: element-zhuque-attack 400ms ease-out forwards;
}

@keyframes element-zhuque-attack {
  0% { opacity: 0; transform: scale(0); border-radius: 50%; }
  30% { opacity: 1; transform: scale(1); border-radius: 50%; box-shadow: 0 0 50rpx #f12711, 0 0 100rpx #f5af19; background: radial-gradient(circle, rgba(241, 39, 17, 0.7), rgba(245, 175, 25, 0.3), transparent); }
  60% { opacity: 0.8; transform: scale(1.8); border-radius: 40%; }
  100% { opacity: 0; transform: scale(2.5); border-radius: 30%; }
}

.element-zhuque.active.intensified {
  animation: element-zhuque-attack-intense 500ms ease-out forwards;
}

@keyframes element-zhuque-attack-intense {
  0% { opacity: 0; transform: scale(0); border-radius: 50%; }
  25% { opacity: 1; transform: scale(1.3); border-radius: 50%; box-shadow: 0 0 80rpx #f12711, 0 0 150rpx #f5af19; background: radial-gradient(circle, rgba(241, 39, 17, 0.9), rgba(245, 175, 25, 0.5), transparent); }
  50% { opacity: 0.9; transform: scale(2.2); border-radius: 35%; }
  100% { opacity: 0; transform: scale(3.5); border-radius: 20%; }
}

/* 玄武 - 深渊潮涌 */
.element-xuanwu.active {
  animation: element-xuanwu-attack 400ms ease-out forwards;
}

@keyframes element-xuanwu-attack {
  0% { opacity: 0; transform: scale(0.3); border: 6rpx solid #38ef7d; border-radius: 50%; }
  30% { opacity: 1; transform: scale(1); border: 4rpx solid #38ef7d; border-radius: 50%; box-shadow: 0 0 40rpx #11998e, 0 0 60rpx #38ef7d; background: radial-gradient(circle, transparent 60%, rgba(56, 239, 125, 0.3)); }
  70% { opacity: 0.6; transform: scale(2); border: 2rpx solid #38ef7d; border-radius: 50%; }
  100% { opacity: 0; transform: scale(3); border: 1rpx solid #38ef7d; border-radius: 50%; }
}

.element-xuanwu.active.intensified {
  animation: element-xuanwu-attack-intense 500ms ease-out forwards;
}

@keyframes element-xuanwu-attack-intense {
  0% { opacity: 0; transform: scale(0.3); border: 8rpx solid #38ef7d; border-radius: 50%; }
  25% { opacity: 1; transform: scale(1.3); border: 5rpx solid #38ef7d; border-radius: 50%; box-shadow: 0 0 60rpx #11998e, 0 0 100rpx #38ef7d; background: radial-gradient(circle, transparent 50%, rgba(56, 239, 125, 0.5)); }
  50% { opacity: 0.7; transform: scale(2.5); border: 3rpx solid #38ef7d; border-radius: 50%; }
  100% { opacity: 0; transform: scale(4); border: 1rpx solid #38ef7d; border-radius: 50%; }
}

/* --- 伤害数字层 --- */
.damage-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 20;
}

.damage-number {
  position: absolute;
  font-size: 48rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.8);
  animation: damage-float 0.8s ease-out forwards;
  white-space: nowrap;
  will-change: transform, opacity;
}

/* 打在敌方身上的伤害 - 金色 */
.damage-number.on-enemy {
  top: 25%;
  left: 62%;
  color: #ffc107;
  text-shadow: 0 0 10rpx rgba(255, 193, 7, 0.5), 0 2rpx 8rpx rgba(0, 0, 0, 0.8);
}

/* 打在我方身上的伤害 - 红色 */
.damage-number.on-player {
  top: 25%;
  left: 22%;
  color: #e94560;
  text-shadow: 0 0 10rpx rgba(233, 69, 96, 0.5), 0 2rpx 8rpx rgba(0, 0, 0, 0.8);
}

/* 暴击伤害 */
.damage-number.critical {
  font-size: 72rpx;
  animation: damage-float-critical 1s ease-out forwards;
}

@keyframes damage-float {
  0% { transform: translateY(0) scale(0.5); opacity: 0; }
  15% { transform: translateY(-20rpx) scale(1.2); opacity: 1; }
  30% { transform: translateY(-40rpx) scale(1); opacity: 1; }
  100% { transform: translateY(-120rpx) scale(0.8); opacity: 0; }
}

@keyframes damage-float-critical {
  0% { transform: translateY(0) scale(0.5); opacity: 0; }
  10% { transform: translateY(-10rpx) scale(1.8); opacity: 1; }
  25% { transform: translateY(-30rpx) scale(1.3); opacity: 1; }
  100% { transform: translateY(-140rpx) scale(0.8); opacity: 0; }
}

/* --- 粒子效果层 --- */
.battle-particles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 25;
}

.battle-particle {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  will-change: transform, opacity;
}

.battle-particle.victory {
  background: linear-gradient(135deg, #ffc107, #e94560);
  animation: victory-particle 0.8s ease-out forwards;
}

@keyframes victory-particle {
  0% { opacity: 1; transform: translate(0, 0) scale(1); }
  100% { opacity: 0; transform: translate(var(--px), var(--py)) scale(0); }
}

/* ==============================
   战斗者动画 class
   ============================== */

/* 入场动画 */
.fighter-player.slide-in-left {
  animation: slide-in-left 600ms ease-out forwards;
}

.fighter-enemy.slide-in-right {
  animation: slide-in-right 600ms ease-out forwards;
}

@keyframes slide-in-left {
  0% { transform: translateX(-500rpx); opacity: 0; }
  60% { opacity: 1; }
  100% { transform: translateX(0); opacity: 1; }
}

@keyframes slide-in-right {
  0% { transform: translateX(500rpx); opacity: 0; }
  60% { opacity: 1; }
  100% { transform: translateX(0); opacity: 1; }
}

/* VS 弹出 */
@keyframes vs-pop {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.4); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* 待机呼吸 */
.fighter-player.idle-breathe,
.fighter-enemy.idle-breathe {
  animation: idle-breathe 2s ease-in-out infinite;
}

@keyframes idle-breathe {
  0%, 100% { transform: scale(1) translateY(0); }
  50% { transform: scale(1.03) translateY(-4rpx); }
}

/* 我方冲刺 */
.fighter-player.player-lunge {
  animation: player-lunge 300ms ease-in forwards;
}

@keyframes player-lunge {
  0% { transform: translateX(0); }
  100% { transform: translateX(120rpx); }
}

/* 我方回撤 */
.fighter-player.player-retreat {
  animation: player-retreat 300ms ease-out forwards;
}

@keyframes player-retreat {
  0% { transform: translateX(120rpx); }
  100% { transform: translateX(0); }
}

/* 敌方冲刺 */
.fighter-enemy.enemy-lunge {
  animation: enemy-lunge 300ms ease-in forwards;
}

@keyframes enemy-lunge {
  0% { transform: translateX(0); }
  100% { transform: translateX(-120rpx); }
}

/* 敌方回撤 */
.fighter-enemy.enemy-retreat {
  animation: enemy-retreat 300ms ease-out forwards;
}

@keyframes enemy-retreat {
  0% { transform: translateX(-120rpx); }
  100% { transform: translateX(0); }
}

/* 受击抖动 */
.fighter-player.hit-shake,
.fighter-enemy.hit-shake {
  animation: hit-shake 300ms ease;
}

@keyframes hit-shake {
  0% { transform: translateX(0); }
  20% { transform: translateX(-20rpx); }
  40% { transform: translateX(20rpx); }
  60% { transform: translateX(-12rpx); }
  80% { transform: translateX(12rpx); }
  100% { transform: translateX(0); }
}

/* 屏幕震动 */
@keyframes screen-shake-light {
  0% { transform: translate(0, 0); }
  25% { transform: translate(-6rpx, 4rpx); }
  50% { transform: translate(6rpx, -4rpx); }
  75% { transform: translate(-4rpx, -6rpx); }
  100% { transform: translate(0, 0); }
}

@keyframes screen-shake-heavy {
  0% { transform: translate(0, 0); }
  10% { transform: translate(-12rpx, 8rpx); }
  20% { transform: translate(12rpx, -8rpx); }
  30% { transform: translate(-10rpx, -10rpx); }
  40% { transform: translate(10rpx, 10rpx); }
  50% { transform: translate(-8rpx, 6rpx); }
  60% { transform: translate(8rpx, -6rpx); }
  70% { transform: translate(-4rpx, 4rpx); }
  80% { transform: translate(4rpx, -4rpx); }
  100% { transform: translate(0, 0); }
}

/* --- 胜负动画 --- */

/* 敌方败退消失 */
.fighter-enemy.defeat-fade {
  animation: defeat-fade 500ms ease-out forwards;
}

@keyframes defeat-fade {
  0% { transform: scale(1) rotate(0deg); opacity: 1; }
  50% { transform: scale(1.2) rotate(15deg); opacity: 0.5; }
  100% { transform: scale(0) rotate(45deg); opacity: 0; }
}

/* 我方败退倒下 */
.fighter-player.defeat-fall {
  animation: defeat-fall 500ms ease-out forwards;
}

@keyframes defeat-fall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(40rpx) rotate(15deg); opacity: 0.5; }
}

/* 我方胜利姿态 */
.fighter-player.victory-stand {
  animation: victory-stand 1.5s ease-in-out infinite;
}

@keyframes victory-stand {
  0%, 100% { transform: scale(1); filter: brightness(1); }
  50% { transform: scale(1.1); filter: brightness(1.3); }
}

/* 敌方嘲讽 */
.fighter-enemy.enemy-taunt {
  animation: enemy-taunt 600ms ease-in-out infinite;
}

@keyframes enemy-taunt {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

/* 败北灰度 */
.battle-screen.defeat-grayscale {
  filter: grayscale(0.8);
  transition: filter 0.5s;
}

/* ==============================
   战斗结果
   ============================== */
.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  border-radius: 24rpx;
  min-width: 500rpx;
  will-change: transform, opacity;
}

.result-content.result-slide-up {
  animation: result-slide-up 400ms ease-out forwards;
}

.result-content.result-win {
  background: linear-gradient(180deg, rgba(255, 193, 7, 0.15), rgba(0, 0, 0, 0.6));
  border: 2rpx solid rgba(255, 193, 7, 0.3);
}

.result-content.result-lose {
  background: linear-gradient(180deg, rgba(233, 69, 96, 0.15), rgba(0, 0, 0, 0.6));
  border: 2rpx solid rgba(233, 69, 96, 0.3);
}

@keyframes result-slide-up {
  0% { transform: translateY(100%); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.result-emoji {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  animation: result-emoji-pop 0.5s ease-out;
}

@keyframes result-emoji-pop {
  0% { transform: scale(0); }
  60% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.result-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.result-win .result-title {
  color: #ffc107;
  text-shadow: 0 0 20rpx rgba(255, 193, 7, 0.4);
}

.result-lose .result-title {
  color: #e94560;
}

.result-arena {
  font-size: 28rpx;
  color: #888888;
  margin-bottom: 16rpx;
}

.result-details {
  display: flex;
  gap: 30rpx;
  margin-bottom: 16rpx;
}

.result-detail-text {
  font-size: 24rpx;
  color: #aaaaaa;
}

.result-reward {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffc107;
  margin-bottom: 12rpx;
  animation: reward-glow 1s ease-in-out infinite;
}

@keyframes reward-glow {
  0%, 100% { text-shadow: 0 0 10rpx rgba(255, 193, 7, 0.3); }
  50% { text-shadow: 0 0 30rpx rgba(255, 193, 7, 0.6); }
}

.result-message {
  font-size: 26rpx;
  color: #cccccc;
  margin-bottom: 16rpx;
}

.result-tap-hint {
  font-size: 20rpx;
  color: #666666;
  margin-top: 8rpx;
}
