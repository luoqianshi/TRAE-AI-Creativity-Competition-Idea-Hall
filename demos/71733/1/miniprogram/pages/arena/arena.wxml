<!-- pages/arena/arena.wxml - 竞技场页面 -->
<view class="container">
  <!-- 无宠物提示 -->
  <view class="empty-state" wx:if="{{noPet}}">
    <text class="empty-icon">⚔️</text>
    <text>还没有宠物，先去孵蛋吧！</text>
  </view>

  <view wx:else>
    <!-- 我的战力 -->
    <view class="my-power card">
      <view class="power-header">
        <text class="my-emoji">{{myBeastEmoji}}</text>
        <view class="power-info">
          <text class="power-name">{{myBeastName}}</text>
          <text class="power-level">Lv.{{myLevel}}</text>
        </view>
      </view>
      <view class="power-display">
        <text class="power-label">当前战力</text>
        <text class="power-number">⚔️ {{myPower}}</text>
      </view>
    </view>

    <!-- 竞技场列表 -->
    <view class="section-title">竞技场</view>

    <view class="arena-list">
      <view class="arena-card card {{item.locked ? 'locked' : ''}} {{item.canFight ? 'available' : ''}}"
        wx:for="{{arenas}}" wx:key="id">

        <view class="arena-header">
          <text class="arena-icon">{{item.id === 'beginner' ? '🟢' : item.id === 'intermediate' ? '🟡' : '🔴'}}</text>
          <view class="arena-info">
            <text class="arena-name">{{item.name}}</text>
            <text class="arena-desc">{{item.description}}</text>
          </view>
        </view>

        <view class="arena-details">
          <view class="arena-stat">
            <text class="arena-stat-label">战力要求</text>
            <text class="arena-stat-value" style="color: {{item.powerColor}}">{{item.powerRequirement}}</text>
          </view>
          <view class="arena-stat">
            <text class="arena-stat-label">经验奖励</text>
            <text class="arena-stat-value reward-value">+{{item.expReward}}</text>
          </view>
          <view class="arena-stat">
            <text class="arena-stat-label">每日次数</text>
            <text class="arena-stat-value">{{item.remaining}}/{{item.dailyLimit}}</text>
          </view>
        </view>

        <button class="fight-btn {{item.canFight ? 'btn-primary' : 'btn-secondary'}}"
          bindtap="onFight" data-id="{{item.id}}" disabled="{{!item.canFight}}">
          <text wx:if="{{item.locked}}">🔒 战力不足</text>
          <text wx:elif="{{item.remaining > 0}}">⚔️ 挑战</text>
          <text wx:else>⏳ 今日已用完</text>
        </button>
      </view>
    </view>

    <!-- ===== 战斗动画遮罩 ===== -->
    <view class="battle-overlay beast-{{currentBeastId}}" wx:if="{{isFighting}}">

      <!-- 屏幕震动容器 -->
      <view class="battle-screen {{screenShakeClass}}">

        <!-- 回合指示器 -->
        <view class="round-indicator" wx:if="{{showRoundText}}">
          <text class="round-text">{{roundText}}</text>
        </view>

        <!-- 技能名称 -->
        <view class="skill-name-container" wx:if="{{showSkillName}}">
          <text class="skill-name {{skillNameClass}}">{{skillName}}</text>
        </view>

        <!-- 战斗场景 -->
        <view class="battle-scene">

          <!-- 我方区域 -->
          <view class="fighter fighter-player {{playerAnimClass}}">
            <!-- 血条 -->
            <view class="hp-bar my-hp-bar">
              <view class="hp-bar-bg">
                <view class="hp-bar-fill {{myHP <= 25 ? 'hp-critical' : myHP <= 50 ? 'hp-low' : ''}}" style="width: {{myHP}}%"></view>
              </view>
              <text class="hp-text">{{myHP}}/100</text>
            </view>
            <!-- 神兽 -->
            <view class="fighter-emoji-wrap">
              <text class="fighter-emoji">{{myBeastEmoji}}</text>
              <!-- 元素光环（攻击时显示） -->
              <view class="element-aura {{showPlayerAura ? 'active' : ''}} beast-{{currentBeastId}}"></view>
            </view>
            <!-- 我方名字 -->
            <text class="fighter-name">{{myBeastName}}</text>
          </view>

          <!-- VS 标识 -->
          <view class="battle-vs {{vsAnimClass}}">
            <text>VS</text>
          </view>

          <!-- 敌方区域 -->
          <view class="fighter fighter-enemy {{enemyAnimClass}}">
            <!-- 血条 -->
            <view class="hp-bar enemy-hp-bar">
              <view class="hp-bar-bg">
                <view class="hp-bar-fill {{enemyHP <= 25 ? 'hp-critical' : enemyHP <= 50 ? 'hp-low' : ''}}" style="width: {{enemyHP}}%"></view>
              </view>
              <text class="hp-text">{{enemyHP}}/100</text>
            </view>
            <!-- 敌人 -->
            <view class="fighter-emoji-wrap enemy-type-{{enemyType}}">
              <text class="fighter-emoji">{{enemyEmoji}}</text>
              <!-- 敌方攻击特效 -->
              <view class="enemy-strike-effect {{showEnemyStrike ? 'active' : ''}}"></view>
            </view>
            <!-- 敌方名字 -->
            <text class="fighter-name">{{enemyName}}</text>
          </view>
        </view>

        <!-- 元素技能特效层 -->
        <view class="element-effect-layer" wx:if="{{showElementEffect}}">
          <view class="element-effect element-{{currentBeastId}} {{elementEffectClass}}"></view>
        </view>

        <!-- 伤害数字层 -->
        <view class="damage-layer">
          <view wx:for="{{damageNumbers}}" wx:key="id"
            class="damage-number {{item.isCritical ? 'critical' : ''}} {{item.isEnemy ? 'on-enemy' : 'on-player'}}">
            {{item.value}}
          </view>
        </view>
      </view>

      <!-- 粒子效果层 -->
      <view class="battle-particles" wx:if="{{particles.length > 0}}">
        <view wx:for="{{particles}}" wx:key="id"
          class="battle-particle {{item.type}}"
          style="left: {{item.x}}%; top: {{item.y}}%; --px: {{item.px}}rpx; --py: {{item.py}}rpx; animation-delay: {{item.delay}}s; animation-duration: {{item.duration}}s;">
        </view>
      </view>
    </view>

    <!-- ===== 战斗结果 ===== -->
    <view class="result-overlay" wx:if="{{showResult && battleResult}}" bindtap="onCloseResult">
      <view class="result-content result-{{battleResult.victory ? 'win' : 'lose'}} {{resultAnimClass}}" catchtap="">
        <text class="result-emoji">{{battleResult.victory ? '🎉' : '💔'}}</text>
        <text class="result-title">{{battleResult.victory ? '胜利！' : '失败'}}</text>
        <text class="result-arena">{{battleResult.arenaName}}</text>
        <!-- 战斗详情 -->
        <view class="result-details" wx:if="{{battleDetail}}">
          <text class="result-detail-text">回合数: {{battleDetail.rounds}}</text>
          <text class="result-detail-text">总伤害: {{battleDetail.totalDamage}}</text>
        </view>
        <text class="result-reward" wx:if="{{battleResult.victory}}">经验 +{{battleResult.expReward}}</text>
        <text class="result-message">{{battleResult.message}}</text>
        <text class="result-tap-hint">点击关闭</text>
      </view>
    </view>
  </view>
</view>
