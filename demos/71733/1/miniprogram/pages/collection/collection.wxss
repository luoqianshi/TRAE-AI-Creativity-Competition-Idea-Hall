/* pages/collection/collection.wxss - 图鉴页面样式 */

.collection-header {
  margin-bottom: 30rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.progress-info {
  margin-top: 12rpx;
}

.progress-text {
  display: block;
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 12rpx;
}

.progress-bar-container {
  width: 100%;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #e94560, #ffc107);
  transition: width 0.3s ease;
}

/* 神兽网格 */
.beast-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.beast-card {
  padding: 30rpx 20rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s;
}

.beast-card:active {
  transform: scale(0.97);
}

.beast-card.collected {
  border-color: rgba(233, 69, 96, 0.2);
}

.beast-card.locked {
  opacity: 0.6;
}

.beast-card-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 12rpx;
}

.locked-emoji {
  opacity: 0.5;
  filter: grayscale(100%);
}

.card-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.locked-name {
  color: #555555;
}

.card-element {
  font-size: 22rpx;
  color: #888888;
}

.locked-element {
  color: #444444;
}

.card-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
}

.card-level {
  font-size: 22rpx;
  color: #00d2ff;
}

.card-power {
  font-size: 22rpx;
  color: #ffc107;
}

.card-current-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #e94560;
  background: rgba(233, 69, 96, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-top: 10rpx;
}

/* 神兽主题边框 */
.beast-qinglong.collected { border-color: rgba(0, 210, 255, 0.3); }
.beast-baihu.collected { border-color: rgba(245, 247, 250, 0.3); }
.beast-zhuque.collected { border-color: rgba(241, 39, 17, 0.3); }
.beast-xuanwu.collected { border-color: rgba(56, 239, 125, 0.3); }

/* 详情弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  max-height: 80vh;
  background: #1a1a2e;
  border-radius: 24rpx;
  padding: 40rpx;
  overflow-y: auto;
  text-align: center;
}

.detail-header {
  position: relative;
  display: inline-block;
  margin-bottom: 20rpx;
}

.detail-emoji {
  font-size: 140rpx;
  position: relative;
  z-index: 1;
}

.detail-aura {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  opacity: 0.3;
  animation: glow 3s ease-in-out infinite;
}

.beast-qinglong .detail-aura { background: radial-gradient(circle, #00d2ff, transparent); }
.beast-baihu .detail-aura { background: radial-gradient(circle, #f5f7fa, transparent); }
.beast-zhuque .detail-aura { background: radial-gradient(circle, #f5af19, transparent); }
.beast-xuanwu .detail-aura { background: radial-gradient(circle, #38ef7d, transparent); }

.detail-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.detail-tags {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.element-tag {
  background: rgba(255, 255, 255, 0.1);
  color: #cccccc;
}

.detail-desc {
  display: block;
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 10rpx;
}

.detail-stats {
  margin-top: 16rpx;
}

.detail-stat-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.detail-stat-label {
  font-size: 28rpx;
  color: #888888;
}

.detail-stat-value {
  font-size: 28rpx;
  font-weight: bold;
}

.power-text {
  color: #ffc107;
}

/* 神兽传说 */
.beast-lore {
  margin-top: 20rpx;
  text-align: left;
}

.lore-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  padding-left: 12rpx;
  border-left: 4rpx solid #e94560;
}

.lore-text {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.modal-close {
  width: 100%;
  margin: 24rpx 0 0;
}
