<!-- pages/collection/collection.wxml - 图鉴页面 -->
<view class="container">
  <!-- 标题和进度 -->
  <view class="collection-header">
    <text class="page-title">神兽图鉴</text>
    <view class="progress-info">
      <text class="progress-text">收集进度 {{collectedCount}}/{{totalBeasts}}</text>
      <view class="progress-bar-container">
        <view class="progress-bar-fill" style="width: {{collectedCount / totalBeasts * 100}}%"></view>
      </view>
    </view>
  </view>

  <!-- 神兽列表 -->
  <view class="beast-grid">
    <view class="beast-card card {{item.isCollected ? 'collected' : 'locked'}} beast-{{item.id}}"
      wx:for="{{beasts}}" wx:key="id" bindtap="onTapBeast" data-id="{{item.id}}">

      <!-- 已收集 -->
      <view class="beast-card-content" wx:if="{{item.isCollected}}">
        <text class="card-emoji {{item.isCurrent ? 'animate-pulse' : ''}}">{{item.emoji}}</text>
        <text class="card-name">{{item.name}}</text>
        <text class="card-element">{{item.element}}属性</text>
        <view class="card-stats" wx:if="{{item.level > 0}}">
          <text class="card-level">Lv.{{item.level}}</text>
          <text class="card-power">⚔️ {{item.power}}</text>
        </view>
        <text class="card-current-tag" wx:if="{{item.isCurrent}}">出战中</text>
      </view>

      <!-- 未收集 -->
      <view class="beast-card-content locked-content" wx:else>
        <text class="card-emoji locked-emoji">❓</text>
        <text class="card-name locked-name">???</text>
        <text class="card-element locked-element">未收集</text>
      </view>
    </view>
  </view>

  <!-- 神兽详情弹窗 -->
  <view class="modal-mask" wx:if="{{showDetail}}" bindtap="onCloseDetail">
    <view class="modal-content" catchtap="preventBubble">
      <view class="detail-header beast-{{selectedBeast.id}}">
        <text class="detail-emoji">{{selectedBeast.emoji}}</text>
        <view class="detail-aura"></view>
      </view>
      <text class="detail-name">{{selectedBeast.name}}</text>
      <view class="detail-tags">
        <text class="tag element-tag">{{selectedBeast.element}}属性</text>
        <text class="tag tag-new" wx:if="{{selectedBeast.isCurrent}}">出战中</text>
      </view>
      <text class="detail-desc">{{selectedBeast.description}}</text>

      <view class="divider"></view>

      <view class="detail-stats" wx:if="{{selectedBeast.level > 0}}">
        <view class="detail-stat-row">
          <text class="detail-stat-label">等级</text>
          <text class="detail-stat-value">Lv.{{selectedBeast.level}}</text>
        </view>
        <view class="detail-stat-row">
          <text class="detail-stat-label">战力</text>
          <text class="detail-stat-value power-text">⚔️ {{selectedBeast.power}}</text>
        </view>
        <view class="detail-stat-row">
          <text class="detail-stat-label">喂养次数</text>
          <text class="detail-stat-value">{{selectedBeast.totalFeedCount}}</text>
        </view>
      </view>

      <!-- 神兽传说 -->
      <view class="beast-lore">
        <text class="lore-title">神兽传说</text>
        <text class="lore-text">{{selectedBeast.description}}</text>
        <text class="lore-text" wx:if="{{selectedBeast.id === 'qinglong'}}">青龙镇守东方，身披翠甲，呼风唤雨，万兽臣服。传说中，唯有心怀正义之人方能与之结契。</text>
        <text class="lore-text" wx:if="{{selectedBeast.id === 'baihu'}}">白虎坐镇西方，金甲银芒，杀伐果断。自古以来便是勇者的象征，唯有无畏之人可获其认可。</text>
        <text class="lore-text" wx:if="{{selectedBeast.id === 'zhuque'}}">朱雀翱翔南方，浴火重生，不死不灭。它的羽翼可焚尽世间邪恶，与炽热之魂共鸣。</text>
        <text class="lore-text" wx:if="{{selectedBeast.id === 'xuanwu'}}">玄武盘踞北方，玄甲如山，深不可测。厚土深渊之力汇聚一身，坚韧如磐石，永不动摇。</text>
      </view>

      <button class="btn-secondary modal-close" bindtap="onCloseDetail">关闭</button>
    </view>
  </view>
</view>
