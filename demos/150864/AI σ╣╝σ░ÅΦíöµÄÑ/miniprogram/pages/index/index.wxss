/* pages/index/index.wxss — 儿童探究岛 */
.home { padding: 24rpx 32rpx; }

/* 顶部问候 */
.greeting {
  display: flex;
  align-items: center;
  background: #FFFBF3;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #DCEAD8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
}
.greet-text { flex: 1; }
.hello { font-size: 34rpx; font-weight: 700; color: #3A322B; }
.sub { font-size: 24rpx; color: #7A6E61; margin-top: 4rpx; }
.coins {
  display: flex;
  align-items: center;
  background: #FBEBC4;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}
.coin-icon { font-size: 28rpx; }
.coin-num { font-size: 30rpx; font-weight: 700; color: #854F0B; margin-left: 8rpx; }

/* 分区 */
.section { margin-bottom: 36rpx; }
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3A322B;
  margin-bottom: 20rpx;
}

/* 心情打卡 */
.emotion-row { display: flex; gap: 20rpx; }
.emotion-card {
  flex: 1;
  background: #FFFBF3;
  border-radius: 24rpx;
  padding: 28rpx 0;
  text-align: center;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}
.emotion-card.selected {
  background: #FBD9CE;
  border-color: #E8745A;
  transform: scale(1.05);
}
.emo-emoji { font-size: 48rpx; }
.emo-label { font-size: 22rpx; color: #7A6E61; margin-top: 8rpx; }

/* 任务卡片 */
.task-list { display: flex; flex-direction: column; gap: 20rpx; }
.task-card {
  display: flex;
  align-items: center;
  background: #FFFBF3;
  border-radius: 28rpx;
  padding: 32rpx;
}
.task-card.done { opacity: 0.55; }
.task-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #F5EAD6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}
.task-body { flex: 1; }
.task-title { font-size: 28rpx; font-weight: 600; color: #3A322B; }
.task-type { font-size: 22rpx; color: #A99C8C; margin-top: 6rpx; }
.task-status {
  font-size: 36rpx;
  color: #E8745A;
  font-weight: 700;
}
.task-card.done .task-status { color: #5C8A57; }

/* 闭环提示 */
.loop-hint {
  text-align: center;
  font-size: 22rpx;
  color: #A99C8C;
  padding: 24rpx 0;
  letter-spacing: 2rpx;
}
