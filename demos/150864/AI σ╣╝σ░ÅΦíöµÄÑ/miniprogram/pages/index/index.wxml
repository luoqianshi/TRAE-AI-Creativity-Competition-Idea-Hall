<!-- pages/index/index.wxml — 儿童探究岛 -->
<view class="home">
  <!-- 顶部问候 -->
  <view class="greeting">
    <view class="avatar">🌱</view>
    <view class="greet-text">
      <view class="hello">你好，{{childName}}</view>
      <view class="sub">今天准备好探索了吗？</view>
    </view>
    <view class="coins">
      <text class="coin-icon">🪙</text>
      <text class="coin-num">{{growthCoins}}</text>
    </view>
  </view>

  <!-- 心情打卡 -->
  <view class="section">
    <view class="section-title">今天心情怎么样？</view>
    <view class="emotion-row">
      <view
        wx:for="{{emotions}}"
        wx:key="key"
        class="emotion-card {{emotion === item.key ? 'selected' : ''}}"
        data-key="{{item.key}}"
        bindtap="pickEmotion"
      >
        <view class="emo-emoji">{{item.emoji}}</view>
        <view class="emo-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 今日探究任务 -->
  <view class="section">
    <view class="section-title">今日探究任务</view>
    <view class="task-list">
      <view
        wx:for="{{todayTasks}}"
        wx:key="id"
        class="task-card {{item.done ? 'done' : ''}}"
        data-id="{{item.id}}"
        bindtap="goTask"
      >
        <view class="task-icon">{{item.icon}}</view>
        <view class="task-body">
          <view class="task-title">{{item.title}}</view>
          <view class="task-type">{{item.type}}</view>
        </view>
        <view class="task-status">{{item.done ? '✓' : '→'}}</view>
      </view>
    </view>
  </view>

  <!-- 探究闭环提示 -->
  <view class="loop-hint">
    <text>发现 → 完成 → 表达 → 反思</text>
  </view>

  <view class="safe-bottom"></view>
</view>
