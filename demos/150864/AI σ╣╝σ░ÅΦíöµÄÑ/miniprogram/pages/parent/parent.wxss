/* pages/parent/parent.wxss */
.parent { padding: 24rpx 32rpx; }

.hero {
  background: linear-gradient(135deg, #FBD9CE 0%, #FBEBC4 100%);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
}
.hero-title { font-size: 38rpx; font-weight: 800; color: #3A322B; }
.hero-sub { font-size: 24rpx; color: #7A6E61; margin-top: 8rpx; }

/* 数据卡片 */
.stats-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.stat-card {
  flex: 1;
  background: #FFFBF3;
  border-radius: 24rpx;
  padding: 32rpx 0;
  text-align: center;
}
.stat-num { font-size: 44rpx; font-weight: 800; color: #D4563D; }
.stat-label { font-size: 22rpx; color: #7A6E61; margin-top: 8rpx; }

/* 进度条 */
.progress-box { margin-bottom: 40rpx; }
.progress-bar {
  height: 20rpx;
  background: #F5EAD6;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #7FA67A;
  border-radius: 999rpx;
  transition: width 0.6s;
}
.progress-text {
  font-size: 24rpx;
  color: #7A6E61;
  margin-top: 12rpx;
  text-align: right;
}

/* 快捷入口 */
.shortcuts { display: flex; flex-direction: column; gap: 20rpx; }
.shortcut-card {
  display: flex;
  align-items: center;
  border-radius: 28rpx;
  padding: 32rpx;
}
.sc-icon { font-size: 48rpx; margin-right: 24rpx; }
.sc-body { flex: 1; }
.sc-title { font-size: 30rpx; font-weight: 700; color: #3A322B; }
.sc-desc { font-size: 22rpx; color: #7A6E61; margin-top: 6rpx; }
.sc-arrow { font-size: 36rpx; color: #3A322B; opacity: 0.4; }
