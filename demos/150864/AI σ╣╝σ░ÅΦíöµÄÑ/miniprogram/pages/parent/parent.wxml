<!-- pages/parent/parent.wxml -->
<view class="parent">
  <view class="hero">
    <view class="hero-title">{{childName}}的本周成长</view>
    <view class="hero-sub">坚持就是最棒的进步</view>
  </view>

  <!-- 本周数据概览 -->
  <view class="stats-grid">
    <view class="stat-card">
      <view class="stat-num">{{weekData.doneCount}}/{{weekData.taskCount}}</view>
      <view class="stat-label">完成任务</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{weekData.totalMinutes}}</view>
      <view class="stat-label">学习分钟</view>
    </view>
    <view class="stat-card">
      <view class="stat-num">{{weekData.coins}}</view>
      <view class="stat-label">成长币</view>
    </view>
  </view>

  <!-- 进度条 -->
  <view class="progress-box">
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{weekData.doneCount / weekData.taskCount * 100}}%"></view>
    </view>
    <view class="progress-text">本周完成度 {{weekData.doneCount / weekData.taskCount * 100}}%</view>
  </view>

  <!-- 快捷入口 -->
  <view class="shortcuts">
    <view
      wx:for="{{shortcuts}}"
      wx:key="title"
      class="shortcut-card"
      style="background: {{item.color}}"
      data-path="{{item.path}}"
      bindtap="goShortcut"
    >
      <view class="sc-icon">{{item.icon}}</view>
      <view class="sc-body">
        <view class="sc-title">{{item.title}}</view>
        <view class="sc-desc">{{item.desc}}</view>
      </view>
      <view class="sc-arrow">→</view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
