/* pages/login/login.wxss */
.login {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 48rpx;
  box-sizing: border-box;
}
.logo {
  font-size: 120rpx;
  margin-bottom: 16rpx;
}
.brand {
  font-size: 56rpx;
  font-weight: 800;
  color: #3A322B;
}
.slogan {
  font-size: 26rpx;
  color: #7A6E61;
  margin-top: 8rpx;
  margin-bottom: 80rpx;
}

/* 角色选择 */
.role-box { width: 100%; }
.role-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 40rpx;
}
.role-cards { display: flex; gap: 24rpx; }
.role-card {
  flex: 1;
  background: #FFFBF3;
  border-radius: 32rpx;
  padding: 48rpx 24rpx;
  text-align: center;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}
.role-card:active {
  border-color: #E8745A;
  background: #FBD9CE;
}
.role-emoji { font-size: 72rpx; }
.role-name { font-size: 32rpx; font-weight: 700; color: #3A322B; margin-top: 16rpx; }
.role-desc { font-size: 22rpx; color: #7A6E61; margin-top: 8rpx; }

/* 信息表单 */
.profile-box { width: 100%; }
.profile-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 48rpx;
}
.form-item { margin-bottom: 36rpx; }
.form-label {
  font-size: 26rpx;
  color: #7A6E61;
  margin-bottom: 12rpx;
}
.form-input {
  background: #FFFBF3;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
}
.start-btn {
  margin-top: 48rpx;
  width: 100%;
}

.privacy {
  margin-top: auto;
  padding-top: 48rpx;
  font-size: 22rpx;
  color: #A99C8C;
  text-align: center;
}
