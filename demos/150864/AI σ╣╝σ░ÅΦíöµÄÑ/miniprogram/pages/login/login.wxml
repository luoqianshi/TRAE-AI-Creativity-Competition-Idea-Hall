<!-- pages/login/login.wxml -->
<view class="login">
  <view class="logo">🌱</view>
  <view class="brand">芽芽星</view>
  <view class="slogan">AI 幼小衔接成长平台</view>

  <!-- 步骤1：角色选择 -->
  <view wx:if="{{step === 'role'}}" class="role-box">
    <view class="role-title">我是...</view>
    <view class="role-cards">
      <view class="role-card" data-role="parent" bindtap="pickRole">
        <view class="role-emoji">👨‍👩‍👧</view>
        <view class="role-name">家长</view>
        <view class="role-desc">陪伴孩子成长</view>
      </view>
      <view class="role-card" data-role="teacher" bindtap="pickRole">
        <view class="role-emoji">👩‍🏫</view>
        <view class="role-name">教师</view>
        <view class="role-desc">管理班级学习</view>
      </view>
    </view>
  </view>

  <!-- 步骤2：儿童信息 -->
  <view wx:if="{{step === 'profile'}}" class="profile-box">
    <view class="profile-title">{{role === 'parent' ? '宝宝信息' : '教师信息'}}</view>
    <view class="form-item">
      <view class="form-label">{{role === 'parent' ? '宝宝昵称' : '您的姓名'}}</view>
      <input class="form-input" placeholder="请输入" value="{{childName}}" bindinput="onNameInput" />
    </view>
    <view wx:if="{{role === 'parent'}}" class="form-item">
      <view class="form-label">出生年月（如 2020-06）</view>
      <input class="form-input" placeholder="YYYY-MM" value="{{birthMonth}}" bindinput="onBirthInput" />
    </view>
    <button class="btn-primary start-btn" bindtap="handleStart">开始成长之旅</button>
  </view>

  <view class="privacy">登录即同意《用户协议》与《隐私政策》</view>
</view>
