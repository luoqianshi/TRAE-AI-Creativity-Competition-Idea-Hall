/* app.wxss — 芽芽星全局样式 */
@import "/theme/tokens.wxss";

page {
  background-color: var(--yy-cream);
  color: var(--yy-ink);
  font-family: "Nunito", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* 通用容器 */
.container {
  padding: 32rpx;
  box-sizing: border-box;
}

/* 卡片基础 */
.card {
  background: var(--yy-paper);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

/* 标题层级 */
.display {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--yy-ink);
  line-height: 1.3;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--yy-ink);
}
.subtitle {
  font-size: 26rpx;
  color: var(--yy-ink-soft);
}

/* 主按钮（珊瑚色） */
.btn-primary {
  background: var(--yy-coral);
  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}
.btn-primary::after { border: none; }

/* 次按钮（描边） */
.btn-ghost {
  background: transparent;
  color: var(--yy-coral-deep);
  border: 2rpx solid var(--yy-coral);
  border-radius: 999rpx;
  padding: 22rpx 46rpx;
  font-size: 30rpx;
  text-align: center;
}
.btn-ghost::after { border: none; }

/* 安全区域底部留白 */
.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

/* 骨架屏占位 */
.skeleton {
  background: var(--yy-cream-deep);
  border-radius: 16rpx;
  animation: yy-pulse 1.4s ease-in-out infinite;
}
@keyframes yy-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
