/* theme/tokens.wxss — 芽芽星设计令牌
   源自 index.html 设计稿，儿童友好的奶油+珊瑚+鼠尾草绿配色 */

page {
  /* 主色板 */
  --yy-cream: #FBF4E8;          /* 页面底色 */
  --yy-cream-deep: #F5EAD6;     /* 深奶油 */
  --yy-paper: #FFFBF3;          /* 卡片纸张色 */

  /* 文字 */
  --yy-ink: #3A322B;            /* 主文字 */
  --yy-ink-soft: #7A6E61;       /* 次文字 */
  --yy-ink-faint: #A99C8C;      /* 弱文字 */

  /* 珊瑚（主强调） */
  --yy-coral: #E8745A;
  --yy-coral-deep: #D4563D;
  --yy-coral-soft: #FBD9CE;

  /* 鼠尾草绿（成功/成长） */
  --yy-sage: #7FA67A;
  --yy-sage-deep: #5C8A57;
  --yy-sage-soft: #DCEAD8;

  /* 黄油（高亮/奖励） */
  --yy-butter: #F4C95D;
  --yy-butter-soft: #FBEBC4;

  /* 天蓝（信息） */
  --yy-sky: #8FC9D6;
  --yy-sky-soft: #D4ECF1;

  /* 紫丁香（创意） */
  --yy-lilac: #B8A4E0;
  --yy-lilac-soft: #E6DDF2;

  /* 分割线 */
  --yy-line: #EADFC8;

  /* 圆角 */
  --yy-radius: 32rpx;
  --yy-radius-sm: 22rpx;
  --yy-radius-pill: 999rpx;

  /* 间距 */
  --yy-gap-xs: 8rpx;
  --yy-gap-sm: 16rpx;
  --yy-gap-md: 24rpx;
  --yy-gap-lg: 32rpx;
  --yy-gap-xl: 48rpx;
}
