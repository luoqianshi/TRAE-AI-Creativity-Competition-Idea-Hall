{
  "pages": [
    "pages/index/index",
    "pages/login/login",
    "pages/parent/parent"
  ],
  "subpackages": [
    {
      "root": "subpackages/learning",
      "name": "learning",
      "pages": [
        "pages/task/task",
        "pages/express/express",
        "pages/reward/reward"
      ]
    },
    {
      "root": "subpackages/dashboard",
      "name": "dashboard",
      "pages": [
        "pages/radar/radar",
        "pages/weekly/weekly",
        "pages/cohort/cohort"
      ]
    },
    {
      "root": "subpackages/teacher",
      "name": "teacher",
      "pages": [
        "pages/class/class",
        "pages/group/group",
        "pages/tree/tree"
      ]
    },
    {
      "root": "subpackages/marketing",
      "name": "marketing",
      "pages": [
        "pages/share/share",
        "pages/trial/trial",
        "pages/coupon/coupon"
      ],
      "independent": true
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["learning"]
    },
    "pages/parent/parent": {
      "network": "wifi",
      "packages": ["dashboard"]
    }
  },
  "tabBar": {
    "custom": true,
    "color": "#A99C8C",
    "selectedColor": "#D4563D",
    "backgroundColor": "#FFFBF3",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "探究岛"
      },
      {
        "pagePath": "pages/parent/parent",
        "text": "成长"
      }
    ]
  },
  "window": {
    "backgroundColor": "#FBF4E8",
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#FFFBF3",
    "navigationBarTitleText": "芽芽星",
    "navigationBarTextStyle": "black"
  },
  "lazyCodeLoading": "requiredComponents",
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "cloud": true
}
