/* components/custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFBF3;
  display: flex;
  align-items: center;
  border-top: 2rpx solid #EADFC8;
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
}
.tab-icon {
  font-size: 40rpx;
  line-height: 1;
  opacity: 0.5;
  transition: all 0.2s;
}
.tab-text {
  font-size: 22rpx;
  color: #A99C8C;
  margin-top: 6rpx;
}
.tab-item.active .tab-icon {
  opacity: 1;
  transform: scale(1.1);
}
.tab-item.active .tab-text {
  color: #D4563D;
  font-weight: 600;
}
