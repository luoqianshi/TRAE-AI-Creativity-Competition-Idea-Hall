digraph Architecture {
    rankdir=TB;
    node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=10, margin="0.15,0.1"];
    edge [fontname="Noto Sans CJK SC", fontsize=9, arrowsize=0.8];

    // User layer
    subgraph cluster_user {
        label="用户层";
        style=filled;
        color="#dbeafe";
        pc [label="PC Web", fillcolor="#ffffff"];
        h5 [label="H5 / 小程序", fillcolor="#ffffff"];
    }

    // Gateway
    subgraph cluster_gateway {
        label="网关与安全";
        style=filled;
        color="#fef3c7";
        gateway [label="API 网关\n鉴权 / 限流 / 日志", fillcolor="#ffffff"];
        waf [label="WAF / CDN", fillcolor="#ffffff"];
    }

    // Services
    subgraph cluster_service {
        label="服务层";
        style=filled;
        color="#d1fae5";
        user_svc [label="用户服务", fillcolor="#ffffff"];
        rec_svc [label="推荐引擎服务", fillcolor="#ffffff"];
        data_svc [label="数据服务", fillcolor="#ffffff"];
        kb_svc [label="张雪峰知识库服务", fillcolor="#ffffff"];
        ai_svc [label="AI 顾问服务", fillcolor="#ffffff"];
        report_svc [label="报告生成服务", fillcolor="#ffffff"];
    }

    // Data & AI
    subgraph cluster_data {
        label="数据与 AI 层";
        style=filled;
        color="#f3e8ff";
        pg [label="PostgreSQL", fillcolor="#ffffff", shape=cylinder];
        redis [label="Redis 缓存", fillcolor="#ffffff", shape=cylinder];
        es [label="Elasticsearch", fillcolor="#ffffff", shape=cylinder];
        vec [label="向量数据库", fillcolor="#ffffff", shape=cylinder];
        ch [label="ClickHouse\nDoris", fillcolor="#ffffff", shape=cylinder];
        llm [label="LLM API\n本地模型", fillcolor="#ffffff"];
    }

    // Data collection
    subgraph cluster_collect {
        label="数据采集层";
        style=filled;
        color="#fee2e2";
        scrapy [label="Scrapy 爬虫", fillcolor="#ffffff"];
        airflow [label="Airflow 调度", fillcolor="#ffffff"];
        parser [label="PDF/Excel 解析", fillcolor="#ffffff"];
    }

    pc -> gateway;
    h5 -> gateway;
    gateway -> user_svc;
    gateway -> rec_svc;
    gateway -> data_svc;
    gateway -> kb_svc;
    gateway -> ai_svc;
    gateway -> report_svc;

    user_svc -> pg;
    rec_svc -> pg;
    rec_svc -> redis;
    rec_svc -> ch;
    data_svc -> pg;
    data_svc -> es;
    kb_svc -> vec;
    kb_svc -> llm;
    ai_svc -> vec;
    ai_svc -> llm;
    report_svc -> pg;
    report_svc -> redis;

    scrapy -> parser;
    parser -> airflow;
    airflow -> pg;
    airflow -> ch;
}
