<view class="container">
  <view class="card">
    <view class="card-title">生成结果</view>
    <textarea 
      class="form-textarea" 
      style="min-height: 400rpx;"
      value="{{message}}" 
      bindinput="onMessageInput"
      placeholder="生成的沟通话术将显示在这里..."
    />
  </view>

  <view class="card" wx:if="{{suggestions.length > 0}}">
    <view class="card-title">沟通建议</view>
    <view wx:for="{{suggestions}}" wx:key="index" class="suggestion-item">
      <text class="suggestion-number">{{index + 1}}.</text>
      <text class="suggestion-text">{{item}}</text>
    </view>
  </view>

  <button class="btn-primary" bindtap="copyMessage">复制到剪贴板</button>
  <button class="btn-secondary" bindtap="saveAsTemplate">保存为模板</button>
  <button class="btn-secondary" bindtap="regenerate">重新生成</button>
  <button class="btn-secondary" bindtap="goBack">返回修改</button>
</view>
