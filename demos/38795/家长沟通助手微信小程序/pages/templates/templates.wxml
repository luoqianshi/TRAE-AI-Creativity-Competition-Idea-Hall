<view class="container">
  <view class="card">
    <view class="card-title">场景筛选</view>
    <view class="tag-group">
      <view 
        class="tag {{selectedScene === '' ? 'active' : ''}}"
        bindtap="selectScene"
        data-value=""
      >
        全部
      </view>
      <view 
        wx:for="{{scenes}}" 
        wx:key="value"
        class="tag {{selectedScene === item.value ? 'active' : ''}}"
        bindtap="selectScene"
        data-value="{{item.value}}"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{templates.length === 0}}">
    <view class="empty-state">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无模板</text>
    </view>
  </view>

  <view wx:for="{{templates}}" wx:key="id" class="list-item" bindtap="selectTemplate" data-id="{{item.id}}">
    <view class="flex-row justify-between">
      <view class="flex-1">
        <view class="list-item-title">{{item.name}}</view>
        <view class="list-item-subtitle">
          {{item.scene}} · {{item.style}} · {{item.channel}}
        </view>
      </view>
      <text class="text-primary" style="font-size: 24rpx;">使用 →</text>
    </view>
    <view class="list-item-content" style="margin-top: 12rpx;">{{item.content}}</view>
    <view class="flex-row justify-between" style="margin-top: 16rpx;">
      <text class="text-warning" style="font-size: 24rpx;" bindtap="editTemplate" data-id="{{item.id}}">编辑</text>
      <text class="text-danger" style="font-size: 24rpx;" bindtap="deleteTemplate" data-id="{{item.id}}">删除</text>
    </view>
  </view>

  <button class="btn-primary" bindtap="addTemplate" style="position: fixed; bottom: 180rpx; left: 20rpx; right: 20rpx;">+ 添加自定义模板</button>
</view>
