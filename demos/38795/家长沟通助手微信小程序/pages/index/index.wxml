<view class="container">
  <view class="card">
    <view class="card-title">选择沟通场景</view>
    <view class="tag-group">
      <view 
        wx:for="{{scenes}}" 
        wx:key="value"
        class="tag {{selectedScene === item.value ? 'active' : ''}}"
        bindtap="selectScene"
        data-value="{{item.value}}"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">学生基本信息</view>
    <view class="form-item">
      <text class="form-label">学生姓名</text>
      <input class="form-input" placeholder="请输入学生姓名" value="{{studentInfo.name}}" bindinput="onNameInput" />
    </view>
    <view class="form-item">
      <text class="form-label">年级</text>
      <input class="form-input" placeholder="如：高一" value="{{studentInfo.grade}}" bindinput="onGradeInput" />
    </view>
    <view class="form-item">
      <text class="form-label">班级</text>
      <input class="form-input" placeholder="如：3班" value="{{studentInfo.className}}" bindinput="onClassInput" />
    </view>
    <view class="form-item">
      <text class="form-label">科目</text>
      <input class="form-input" placeholder="如：数学" value="{{studentInfo.subject}}" bindinput="onSubjectInput" />
    </view>
  </view>

  <view class="card">
    <view class="card-title">学生表现数据</view>
    <view class="flex-row" style="gap: 16rpx;">
      <view class="flex-1">
        <text class="form-label">当前分数</text>
        <input class="form-input" type="number" placeholder="0-100" value="{{performance.score}}" bindinput="onScoreInput" />
      </view>
      <view class="flex-1">
        <text class="form-label">上次分数</text>
        <input class="form-input" type="number" placeholder="0-100" value="{{performance.lastScore}}" bindinput="onLastScoreInput" />
      </view>
    </view>
    <view class="flex-row" style="gap: 16rpx;">
      <view class="flex-1">
        <text class="form-label">班级排名</text>
        <input class="form-input" type="number" placeholder="如：5" value="{{performance.rank}}" bindinput="onRankInput" />
      </view>
      <view class="flex-1">
        <text class="form-label">班级人数</text>
        <input class="form-input" type="number" placeholder="如：45" value="{{performance.totalStudents}}" bindinput="onTotalStudentsInput" />
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">作业情况</text>
      <textarea class="form-textarea" placeholder="请描述作业完成情况，如：完成质量很高、未按时提交等" value="{{performance.homework}}" bindinput="onHomeworkInput" />
    </view>
    <view class="form-item">
      <text class="form-label">课堂表现</text>
      <textarea class="form-textarea" placeholder="请描述课堂表现，如：积极回答问题、注意力不集中等" value="{{performance.classBehavior}}" bindinput="onClassBehaviorInput" />
    </view>
    <view class="form-item">
      <text class="form-label">知识点掌握</text>
      <textarea class="form-textarea" placeholder="请描述知识点掌握情况，如：函数掌握扎实、三角函数薄弱等" value="{{performance.knowledge}}" bindinput="onKnowledgeInput" />
    </view>
  </view>

  <view class="card">
    <view class="card-title">选择沟通风格</view>
    <view class="tag-group">
      <view 
        wx:for="{{styles}}" 
        wx:key="value"
        class="tag {{selectedStyle === item.value ? 'active' : ''}}"
        bindtap="selectStyle"
        data-value="{{item.value}}"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">选择沟通渠道</view>
    <view class="tag-group">
      <view 
        wx:for="{{channels}}" 
        wx:key="value"
        class="tag {{selectedChannel === item.value ? 'active' : ''}}"
        bindtap="selectChannel"
        data-value="{{item.value}}"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <button class="btn-primary" bindtap="generateMessage">生成沟通话术</button>
  <button class="btn-secondary" bindtap="useTemplate">使用模板生成</button>
</view>
