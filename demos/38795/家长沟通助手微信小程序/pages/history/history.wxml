<view class="container">
  <view class="card">
    <view class="card-title">筛选条件</view>
    <view class="tag-group">
      <view 
        class="tag {{selectedScene === '' ? 'active' : ''}}"
        bindtap="selectScene"
        data-value=""
      >
        全部场景
      </view>
      <view 
        wx:for="{{scenes}}" 
        wx:key="value"
        class="tag {{selectedScene === item.value ? 'active' : ''}}"
        bindtap="selectScene"
        data-value="{{item.value}}"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{historyList.length === 0}}">
    <view class="empty-state">
      <text class="empty-icon">📝</text>
      <text class="empty-text">暂无沟通记录</text>
    </view>
  </view>

  <view wx:for="{{historyList}}" wx:key="id" class="list-item">
    <view class="flex-row justify-between">
      <view class="flex-1">
        <view class="list-item-title">{{item.studentInfo.name}} - {{item.scene}}</view>
        <view class="list-item-subtitle">
          {{item.studentInfo.grade}}/{{item.studentInfo.className}} · {{item.studentInfo.subject}}
        </view>
      </view>
      <text class="text-primary" style="font-size: 24rpx;" bindtap="copyMessage" data-message="{{item.message}}">复制</text>
    </view>
    <view class="list-item-content" style="margin-top: 12rpx;">{{item.message}}</view>
    <view class="flex-row justify-between" style="margin-top: 16rpx;">
      <text class="text-warning" style="font-size: 24rpx;">{{item.style}} · {{item.channel}}</text>
      <text class="text-danger" style="font-size: 24rpx;" bindtap="deleteRecord" data-id="{{item.id}}">删除</text>
    </view>
    <view style="font-size: 22rpx; color: #999999; margin-top: 8rpx;">
      {{formatDate(item.createdAt)}}
    </view>
  </view>

  <button class="btn-secondary" bindtap="clearAll" wx:if="{{historyList.length > 0}}">清空所有记录</button>
</view>
