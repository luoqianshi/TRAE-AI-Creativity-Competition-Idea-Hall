.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  border-radius: 50%;
  font-size: 32rpx;
  color: #333;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.placeholder {
  width: 60rpx;
}

.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ranking-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  padding: 25rpx 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.ranking-item.rank-gold {
  background: linear-gradient(135deg, #fff9e6 0%, #fff5d6 100%);
  border: 2rpx solid #ffd700;
}

.ranking-item.rank-silver {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border: 2rpx solid #ced4da;
}

.ranking-item.rank-bronze {
  background: linear-gradient(135deg, #fff5eb 0%, #ffe8d6 100%);
  border: 2rpx solid #cd7f32;
}

.rank-badge {
  font-size: 40rpx;
  width: 80rpx;
  text-align: center;
}

.player-info {
  flex: 1;
  margin-left: 20rpx;
}

.player-name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.player-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 5rpx;
}

.player-score {
  display: flex;
  align-items: baseline;
}

.score-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #667eea;
}

.score-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 5rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}