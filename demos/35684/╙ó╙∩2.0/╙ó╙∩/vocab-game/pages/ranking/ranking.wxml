<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">←</view>
    <text class="title">{{title}}</text>
    <view class="placeholder"></view>
  </view>

  <view class="ranking-list" wx:if="{{!isEmpty}}">
    <view 
      wx:for="{{rankings}}" 
      wx:key="time" 
      class="ranking-item {{getRankStyle(index)}}"
    >
      <view class="rank-badge">{{getRankIcon(index)}}</view>
      <view class="player-info">
        <text class="player-name">{{item.name}}</text>
        <text class="player-time">{{item.time ? formatTime(item.time) : ''}}</text>
      </view>
      <view class="player-score">
        <text class="score-value">{{item.score}}</text>
        <text class="score-unit">分</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-icon">🏆</text>
    <text class="empty-text">暂无排行数据</text>
    <text class="empty-hint">快去挑战关卡吧！</text>
  </view>
</view>