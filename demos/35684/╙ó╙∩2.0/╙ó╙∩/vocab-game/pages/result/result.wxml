<view class="container">
  <view class="result-content">
    <view class="trophy">🏆</view>
    <text class="title">挑战成功！</text>
    <text class="level-name">{{levelName}}</text>
    <text class="score-label">最终得分</text>
    <text class="score-value">{{score}}</text>
    
    <view class="stats">
      <view class="stat-item">
        <text class="stat-value">{{score / 10}}</text>
        <text class="stat-label">正确</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{wrongCount}}</text>
        <text class="stat-label">错误</text>
      </view>
    </view>

    <button class="btn-primary" bindtap="playAgain">🎮 再玩一次</button>
    <button class="btn-secondary" bindtap="viewRanking">📊 查看排行榜</button>
    <button class="btn-outline" bindtap="goHome">🏠 返回首页</button>
  </view>
</view>