.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 50%, #fcd34d 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(251, 191, 36, 0.3);
  width: 100%;
  max-width: 600rpx;
}

.trophy {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  animation: bounce 1s ease infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #92400e;
  margin-bottom: 10rpx;
}

.level-name {
  font-size: 28rpx;
  color: #78716c;
  margin-bottom: 20rpx;
}

.score-label {
  font-size: 28rpx;
  color: #78716c;
  margin-bottom: 10rpx;
}

.score-value {
  font-size: 96rpx;
  font-weight: bold;
  color: #f59e0b;
  margin-bottom: 40rpx;
}

.stats {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-bottom: 50rpx;
  padding: 30rpx;
  background: #fffbeb;
  border-radius: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #92400e;
}

.stat-label {
  font-size: 24rpx;
  color: #78716c;
  margin-top: 8rpx;
}

.btn-primary {
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.4);
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-secondary {
  width: 100%;
  padding: 24rpx;
  background: #ffffff;
  color: #78716c;
  border-radius: 50rpx;
  font-size: 32rpx;
  border: 3rpx solid #e5e7eb;
}

.btn-secondary:active {
  transform: scale(0.98);
}

.btn-outline {
  width: 100%;
  padding: 24rpx;
  background: transparent;
  color: #78716c;
  border-radius: 50rpx;
  font-size: 28rpx;
  border: 2rpx solid #d1d5db;
  margin-top: 10rpx;
}

.btn-outline:active {
  transform: scale(0.98);
}
