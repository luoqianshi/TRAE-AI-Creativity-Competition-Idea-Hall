.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.username-row {
  display: flex;
  align-items: center;
}

.username {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.edit-icon {
  font-size: 24rpx;
  margin-left: 10rpx;
  color: #999;
}

.total-score {
  font-size: 24rpx;
  color: #666;
  margin-top: 5rpx;
}

.total-ranking-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  padding: 20rpx 30rpx;
  border-radius: 15rpx;
  color: #fff;
}

.ranking-icon {
  font-size: 36rpx;
}

.ranking-text {
  font-size: 22rpx;
  margin-top: 5rpx;
}

.title-section {
  text-align: center;
  margin-bottom: 30rpx;
}

.main-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.sub-title {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

.levels-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.level-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.level-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.level-info {
  display: flex;
  flex-direction: column;
}

.level-number {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
}

.level-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-top: 5rpx;
}

.level-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 5rpx;
}

.level-stats {
  background: #f5f5f5;
  padding: 15rpx 20rpx;
  border-radius: 10rpx;
}

.word-count {
  font-size: 24rpx;
  color: #666;
}

.level-score {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
  padding: 15rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.score-label {
  font-size: 24rpx;
  color: #8b5a2b;
  margin-right: 10rpx;
}

.score-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #d46b08;
}

.level-actions {
  display: flex;
  gap: 20rpx;
}

.btn-play, .btn-ranking {
  flex: 1;
  padding: 25rpx;
  border-radius: 15rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-play {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-ranking {
  background: #f0f0f0;
  color: #666;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  padding: 40rpx;
  border-radius: 20rpx;
  width: 80%;
  max-width: 600rpx;
}

.modal-title {
  display: block;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.modal-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  font-size: 30rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  padding: 25rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  border: none;
}

.modal-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}