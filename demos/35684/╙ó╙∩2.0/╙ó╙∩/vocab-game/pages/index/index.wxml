<view class="container">
  <view class="header">
    <view class="user-info">
      <view class="avatar">👤</view>
      <view class="user-detail">
        <view class="username-row">
          <text class="username">{{playerName}}</text>
          <text class="edit-icon" bindtap="changeName">✏️</text>
        </view>
        <text class="total-score">累计得分: {{totalScore}}</text>
      </view>
    </view>
    <view class="total-ranking-btn" bindtap="viewTotalRanking">
      <text class="ranking-icon">🏆</text>
      <text class="ranking-text">总排行榜</text>
    </view>
  </view>

  <view class="title-section">
    <text class="main-title">词汇配对游戏</text>
    <text class="sub-title">选择关卡开始挑战</text>
  </view>

  <view class="levels-container">
    <view 
      wx:for="{{levels}}" 
      wx:key="id" 
      class="level-card"
    >
      <view class="level-header">
        <view class="level-info">
          <text class="level-number">第{{item.id}}关</text>
          <text class="level-name">{{item.name}}</text>
          <text class="level-desc">{{item.description}}</text>
        </view>
        <view class="level-stats">
          <text class="word-count">{{item.words.length}}词</text>
        </view>
      </view>
      
      <view class="level-score" wx:if="{{item.bestScore > 0}}">
        <text class="score-label">最佳成绩</text>
        <text class="score-value">{{item.bestScore}}分</text>
      </view>

      <view class="level-actions">
        <button class="btn-play" bindtap="startLevel" data-level-id="{{item.id}}">
          <text>🎮 开始挑战</text>
        </button>
        <button class="btn-ranking" bindtap="viewLevelRanking" data-level-id="{{item.id}}" data-level-name="{{item.name}}">
          <text>📊 排行榜</text>
        </button>
      </view>
    </view>
  </view>

  <view class="modal-overlay" wx:if="{{showNameModal}}" bindtap="cancelName">
    <view class="modal-content" bindtap.stop>
      <text class="modal-title">修改昵称</text>
      <input 
        class="modal-input" 
        placeholder="请输入昵称" 
        value="{{inputName}}"
        bindinput="onInputChange"
        maxlength="10"
      />
      <view class="modal-actions">
        <button class="modal-btn cancel" bindtap="cancelName">取消</button>
        <button class="modal-btn confirm" bindtap="confirmName">确定</button>
      </view>
    </view>
  </view>
</view>