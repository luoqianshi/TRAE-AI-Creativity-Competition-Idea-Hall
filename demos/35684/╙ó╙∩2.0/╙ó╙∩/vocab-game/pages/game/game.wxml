<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">←</view>
    <text class="title">{{levelName}}</text>
    <view class="score-badge">
      <text class="score-label">得分:</text>
      <text class="score-value">{{score}}</text>
    </view>
  </view>

  <view class="hint-bar {{selectedWord ? 'active' : ''}}">
    <text class="hint-text">{{selectedWord ? '请选择对应的中文释义' : '请选择英文词汇'}}</text>
  </view>

  <view class="game-area">
    <scroll-view class="left-panel" scroll-y>
      <view 
        wx:for="{{englishWords}}" 
        wx:key="index"
        class="word-card {{item.matched ? 'matched' : ''}} {{selectedIndex === index ? 'selected' : ''}}"
        data-index="{{index}}"
        data-en="{{item.en}}"
        data-zh="{{item.zh}}"
        bindtap="onWordTap"
      >
        {{item.en}}
      </view>
    </scroll-view>

    <view class="divider"></view>

    <scroll-view class="right-panel" scroll-y>
      <view 
        wx:for="{{chineseWords}}" 
        wx:key="index"
        class="word-card target {{item.matched ? 'matched' : ''}}"
        data-index="{{index}}"
        data-zh="{{item.zh}}"
        data-en="{{item.en}}"
        bindtap="onTargetTap"
      >
        {{item.zh}}
      </view>
    </scroll-view>
  </view>

  <view class="feedback-toast {{showFeedback ? 'show' : ''}} {{feedbackType === 'correct' ? 'correct' : 'wrong'}}">
    {{feedbackText}}
  </view>
</view>