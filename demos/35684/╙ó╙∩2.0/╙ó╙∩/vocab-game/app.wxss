page {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ec 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.flex {
  display: flex;
}

.flex-wrap {
  flex-wrap: wrap;
}

.justify-center {
  justify-content: center;
}

.items-center {
  align-items: center;
}

.justify-around {
  justify-content: space-around;
}

.gap-4 {
  gap: 32rpx;
}

.w-full {
  width: 100%;
}

.p-4 {
  padding: 32rpx;
}

.mb-4 {
  margin-bottom: 32rpx;
}

.mb-6 {
  margin-bottom: 48rpx;
}

.mb-8 {
  margin-bottom: 64rpx;
}

.text-center {
  text-align: center;
}

.text-sm {
  font-size: 28rpx;
}

.text-2xl {
  font-size: 48rpx;
}

.text-4xl {
  font-size: 72rpx;
}

.font-bold {
  font-weight: bold;
}

.text-indigo-600 {
  color: #4f46e5;
}

.text-orange-600 {
  color: #ea580c;
}

.text-green-600 {
  color: #16a34a;
}

.text-gray-500 {
  color: #6b7280;
}

.bg-indigo-50 {
  background-color: #eef2ff;
}

.bg-slate-50 {
  background-color: #f8fafc;
}

.bg-white {
  background-color: #ffffff;
}

.rounded-lg {
  border-radius: 16rpx;
}

.rounded-xl {
  border-radius: 24rpx;
}

.overflow-y-auto {
  overflow-y: auto;
}

.animate-bounce {
  animation: bounce 0.6s ease-in-out;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}
