<view class="container">
  <view class="camera-header">
    <text class="header-title">拍照识别</text>
    <text class="header-tip">拍摄流浪犬照片，AI自动匹配档案</text>
  </view>

  <view class="camera-preview" wx:if="{{!imageSrc}}">
    <view class="camera-placeholder">
      <view class="camera-icon">📷</view>
      <text class="camera-text">点击拍照或上传照片</text>
      <text class="camera-hint">支持从相册选择照片</text>
    </view>
  </view>

  <view class="image-preview" wx:else>
    <image class="preview-image" src="{{imageSrc}}" mode="widthFix"></image>
    <view class="preview-actions">
      <view class="preview-btn secondary" bindtap="retakePhoto">
        <text class="btn-icon">🔄</text>
        <text class="btn-text">重新拍摄</text>
      </view>
      <view class="preview-btn primary" bindtap="identifyDog">
        <text class="btn-icon">✨</text>
        <text class="btn-text">AI识别</text>
      </view>
    </view>
  </view>

  <view class="camera-actions">
    <view class="action-btn" bindtap="chooseImage">
      <text class="action-icon">📁</text>
      <text class="action-text">相册</text>
    </view>
    <view class="action-btn camera" bindtap="takePhoto">
      <view class="camera-ring"></view>
      <view class="camera-inner"></view>
    </view>
    <view class="action-btn" bindtap="goToNewDog">
      <text class="action-icon">➕</text>
      <text class="action-text">新建档案</text>
    </view>
  </view>

  <view class="ai-result" wx:if="{{showResult}}">
    <view class="result-header">
      <text class="result-title">识别结果</text>
      <text class="result-close" bindtap="closeResult">✕</text>
    </view>
    <view class="result-content" wx:if="{{matchedDog}}">
      <view class="matched-card">
        <image class="matched-photo" src="{{matchedDog.photo}}" mode="aspectFill"></image>
        <view class="matched-info">
          <text class="matched-name">{{matchedDog.name}}</text>
          <text class="matched-similarity">相似度: {{similarity}}%</text>
          <view class="matched-tags">
            <text class="tag">{{matchedDog.color}}</text>
            <text class="tag">{{matchedDog.size}}</text>
            <text class="tag">{{matchedDog.breed}}</text>
          </view>
        </view>
      </view>
      <view class="result-actions">
        <view class="result-btn" bindtap="confirmMatch">
          <text class="btn-text">确认匹配并打卡</text>
        </view>
        <view class="result-btn secondary" bindtap="createNew">
          <text class="btn-text">这是新犬只，创建档案</text>
        </view>
      </view>
    </view>
    <view class="result-content" wx:else>
      <view class="no-match">
        <text class="no-match-icon">🐶</text>
        <text class="no-match-text">未找到匹配的犬只</text>
        <text class="no-match-hint">是否为新发现的流浪犬？</text>
      </view>
      <view class="result-actions">
        <view class="result-btn" bindtap="createNew">
          <text class="btn-text">创建新犬只档案</text>
        </view>
      </view>
    </view>
  </view>

  <view class="scan-overlay" wx:if="{{scanning}}">
    <view class="scan-line"></view>
    <text class="scan-text">AI正在识别中...</text>
  </view>
</view>