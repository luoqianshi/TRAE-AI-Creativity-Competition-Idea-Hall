.profile-header {
  position: relative;
  height: 320rpx;
  padding: 40rpx 30rpx;
  padding-top: calc(60rpx + env(safe-area-inset-top));
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
}

.user-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  margin-right: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-icon {
  font-size: 50rpx;
}

.level-badge {
  position: absolute;
  bottom: -5rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #FFD700;
  color: #8B4513;
  font-size: 20rpx;
  font-weight: 600;
  padding: 5rpx 15rpx;
  border-radius: 100rpx;
  white-space: nowrap;
}

.user-detail {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.edit-btn {
  position: relative;
  z-index: 1;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon {
  font-size: 32rpx;
  color: #ffffff;
}

.stats-card {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 0;
  margin: -40rpx 30rpx 30rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF8C42;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 5rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #F5F5F5;
}

.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}

.featured-section {
  padding: 20rpx 0;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #FF8C42;
}

.featured-dog {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 25rpx;
}

.featured-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.featured-info {
  flex: 1;
}

.featured-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}

.featured-intimacy {
  display: block;
  font-size: 24rpx;
  color: #FF4D4F;
  margin-bottom: 10rpx;
}

.featured-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}

.footer {
  text-align: center;
  padding: 40rpx 0;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.footer-text {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 5rpx;
}

.footer-desc {
  font-size: 22rpx;
  color: #CCCCCC;
}