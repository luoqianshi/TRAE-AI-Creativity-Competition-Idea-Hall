<view class="container">
  <view class="detail-header">
    <image class="header-bg" src="{{dog.photo}}" mode="aspectFill"></image>
    <view class="header-overlay"></view>
    <view class="header-content">
      <view class="back-btn" bindtap="goBack">
        <text class="back-icon">‹</text>
      </view>
      <view class="header-info">
        <text class="dog-name">{{dog.name}}</text>
        <view class="header-tags">
          <text class="tag">{{dog.color}}</text>
          <text class="tag">{{dog.size}}</text>
          <text class="tag">{{dog.gender}}</text>
        </view>
      </view>
      <view class="header-actions">
        <view class="action-btn" bindtap="toggleFavorite">
          <text class="action-icon">{{isFavorite ? '❤️' : '🤍'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="intimacy-section">
    <view class="intimacy-header">
      <text class="intimacy-title">亲密度</text>
      <text class="intimacy-level">Lv.{{intimacyLevel}}</text>
    </view>
    <view class="intimacy-bar">
      <view class="intimacy-fill" style="width: {{intimacyPercent}}%"></view>
    </view>
    <view class="intimacy-stats">
      <text class="intimacy-num">{{dog.intimacy}}</text>
      <text class="intimacy-next">距离下一级还需 {{nextLevel}} 次打卡</text>
    </view>
  </view>

  <view class="info-card">
    <text class="card-title">基本信息</text>
    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">品种</text>
        <text class="info-value">{{dog.breed}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">年龄</text>
        <text class="info-value">{{dog.age}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">毛色</text>
        <text class="info-value">{{dog.color}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">体型</text>
        <text class="info-value">{{dog.size}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">性别</text>
        <text class="info-value">{{dog.gender}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">性格</text>
        <text class="info-value">{{dog.personality}}</text>
      </view>
    </view>
  </view>

  <view class="info-card">
    <text class="card-title">健康状况</text>
    <view class="health-info">
      <view class="health-item">
        <text class="health-status {{dog.health === '健康' ? 'good' : 'warning'}}">{{dog.health}}</text>
        <text class="health-label">当前状态</text>
      </view>
      <view class="health-item">
        <text class="health-status">{{dog.injury}}</text>
        <text class="health-label">伤病情况</text>
      </view>
    </view>
  </view>

  <view class="info-card">
    <text class="card-title">出没地点</text>
    <view class="location-info">
      <text class="location-text">📍 {{dog.address}}</text>
      <text class="feed-point">🍖 投喂点：{{dog.feedPoint}}</text>
    </view>
    <view class="mini-map">
      <map 
        class="small-map"
        longitude="{{dog.location.longitude}}"
        latitude="{{dog.location.latitude}}"
        scale="16"
        markers="{{markers}}"
        show-location
      ></map>
    </view>
  </view>

  <view class="info-card">
    <text class="card-title">特征描述</text>
    <text class="features-text">{{dog.features}}</text>
  </view>

  <view class="info-card">
    <text class="card-title">目击记录</text>
    <view class="sighting-stats">
      <view class="sighting-stat">
        <text class="stat-num">{{dog.sightingCount}}</text>
        <text class="stat-label">累计目击</text>
      </view>
      <view class="sighting-stat">
        <text class="stat-num">{{dog.lastSeen}}</text>
        <text class="stat-label">最后出现</text>
      </view>
    </view>
    <view class="witnesses">
      <text class="witnesses-label">目击人：</text>
      <view class="witness-tags">
        <text class="witness-tag" wx:for="{{dog.witnesses}}" wx:key="index">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-actions">
    <view class="action-btn secondary">
      <text class="btn-icon">📝</text>
      <text class="btn-text">更新信息</text>
    </view>
    <view class="action-btn primary" bindtap="checkIn">
      <text class="btn-icon">❤️</text>
      <text class="btn-text">打卡</text>
    </view>
  </view>
</view>