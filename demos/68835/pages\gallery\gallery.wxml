<view class="container">
  <view class="gallery-header">
    <text class="header-title">流浪犬图鉴</text>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
    <text class="progress-text">已收集 {{collectedCount}}/{{totalCount}} 只</text>
  </view>

  <view class="filter-tabs">
    <view 
      class="filter-tab {{activeFilter === 'all' ? 'active' : ''}}" 
      bindtap="setFilter"
      data-filter="all"
    >
      <text class="tab-text">全部</text>
    </view>
    <view 
      class="filter-tab {{activeFilter === 'unlocked' ? 'active' : ''}}" 
      bindtap="setFilter"
      data-filter="unlocked"
    >
      <text class="tab-text">已解锁</text>
    </view>
    <view 
      class="filter-tab {{activeFilter === 'locked' ? 'active' : ''}}" 
      bindtap="setFilter"
      data-filter="locked"
    >
      <text class="tab-text">待解锁</text>
    </view>
  </view>

  <scroll-view class="gallery-grid" scroll-y>
    <view 
      class="gallery-item {{item.unlocked ? 'unlocked' : 'locked'}}" 
      wx:for="{{filteredDogs}}" 
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="item-image">
        <image class="dog-image" src="{{item.photo}}" mode="aspectFill"></image>
        <view class="lock-overlay" wx:if="{{!item.unlocked}}">
          <text class="lock-icon">🔒</text>
        </view>
        <view class="intimacy-badge" wx:if="{{item.intimacy > 0}}">
          <text class="badge-icon">❤</text>
          <text class="badge-num">{{item.intimacy}}</text>
        </view>
      </view>
      <view class="item-info">
        <text class="item-name">{{item.unlocked ? item.name : '???'}}</text>
        <text class="item-breed">{{item.unlocked ? item.breed : '待解锁'}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="empty-state" wx:if="{{filteredDogs.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无犬只</text>
  </view>

  <view class="collection-guide">
    <text class="guide-title">收集指南</text>
    <view class="guide-list">
      <view class="guide-item">
        <text class="guide-num">1</text>
        <text class="guide-desc">散步时拍摄流浪犬照片</text>
      </view>
      <view class="guide-item">
        <text class="guide-num">2</text>
        <text class="guide-desc">AI识别匹配已有档案</text>
      </view>
      <view class="guide-item">
        <text class="guide-num">3</text>
        <text class="guide-desc">多次打卡提升亲密度</text>
      </view>
      <view class="guide-item">
        <text class="guide-num">4</text>
        <text class="guide-desc">解锁完整档案和专属卡片</text>
      </view>
    </view>
  </view>
</view>