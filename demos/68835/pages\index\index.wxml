<view class="container">
  <view class="header-card">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="greeting">
        <text class="greeting-text">你好，铲屎官</text>
        <text class="greeting-date">今天发现新的流浪犬了吗？</text>
      </view>
      <view class="header-stats">
        <view class="stat-item">
          <text class="stat-num">{{stats.totalSightings}}</text>
          <text class="stat-label">累计目击</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{stats.totalDogs}}</text>
          <text class="stat-label">记录犬只</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{stats.galleryProgress}}%</text>
          <text class="stat-label">图鉴进度</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">附近的流浪犬</text>
      <text class="section-more" bindtap="goToMap">查看全部</text>
    </view>
    <scroll-view class="dog-scroll" scroll-x enable-flex>
      <view 
        class="dog-card" 
        wx:for="{{nearbyDogs}}" 
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <image class="dog-photo" src="{{item.photo}}" mode="aspectFill"></image>
        <view class="dog-info">
          <text class="dog-name">{{item.name}}</text>
          <text class="dog-location">{{item.address}}</text>
          <view class="dog-intimacy">
            <text class="intimacy-icon">❤</text>
            <text class="intimacy-num">{{item.intimacy}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">最新目击</text>
      <text class="section-more">更多</text>
    </view>
    <view class="sighting-list">
      <view 
        class="sighting-item" 
        wx:for="{{sightings}}" 
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <image class="sighting-photo" src="{{item.photo}}" mode="aspectFill"></image>
        <view class="sighting-content">
          <view class="sighting-header">
            <text class="sighting-name">{{item.name}}</text>
            <text class="sighting-time">{{item.lastSeen}}</text>
          </view>
          <text class="sighting-location">📍 {{item.address}}</text>
          <view class="sighting-tags">
            <text class="tag">{{item.color}}</text>
            <text class="tag">{{item.size}}</text>
            <text class="tag">{{item.health}}</text>
          </view>
        </view>
        <view class="sighting-action">
          <text class="action-text">打卡</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">走失寻宠</text>
      <text class="section-more" bindtap="goToLost">查看全部</text>
    </view>
    <view class="lost-card" bindtap="goToLost">
      <image class="lost-bg" src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=lost%20pet%20dog%20missing%20poster%20sad%20searching%20love&image_size=landscape_16_9" mode="aspectFill"></image>
      <view class="lost-content">
        <text class="lost-title">寻找走失的毛孩子</text>
        <text class="lost-desc">{{lostDogs.length}}只狗狗等待回家</text>
        <text class="lost-btn">立即发布</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">亲密度排行榜</text>
    </view>
    <view class="ranking-list">
      <view class="ranking-item" wx:for="{{ranking}}" wx:key="id">
        <view class="ranking-num" wx:if="{{index === 0}}">🥇</view>
        <view class="ranking-num" wx:elif="{{index === 1}}">🥈</view>
        <view class="ranking-num" wx:elif="{{index === 2}}">🥉</view>
        <view class="ranking-num other" wx:else>{{index + 1}}</view>
        <image class="ranking-photo" src="{{item.photo}}" mode="aspectFill"></image>
        <view class="ranking-info">
          <text class="ranking-name">{{item.name}}</text>
          <text class="ranking-desc">{{item.breed}}</text>
        </view>
        <view class="ranking-intimacy">
          <text class="intimacy-icon">❤</text>
          <text class="intimacy-num">{{item.intimacy}}</text>
        </view>
      </view>
    </view>
  </view>
</view>