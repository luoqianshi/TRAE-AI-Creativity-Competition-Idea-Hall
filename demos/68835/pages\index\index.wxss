.header-card {
  position: relative;
  height: 400rpx;
  border-radius: 30rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 50%, #FF4D4F 100%);
}

.header-bg::after {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 40rpx 30rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.greeting {
  color: #ffffff;
}

.greeting-text {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.greeting-date {
  font-size: 26rpx;
  opacity: 0.9;
}

.header-stats {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 25rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 5rpx;
}

.stat-divider {
  width: 2rpx;
  background: rgba(255, 255, 255, 0.3);
}

.section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-more {
  font-size: 26rpx;
  color: #FF8C42;
}

.dog-scroll {
  white-space: nowrap;
}

.dog-card {
  display: inline-block;
  width: 280rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  vertical-align: top;
}

.dog-photo {
  width: 100%;
  height: 280rpx;
}

.dog-info {
  padding: 20rpx;
}

.dog-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.dog-location {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dog-intimacy {
  display: flex;
  align-items: center;
}

.intimacy-icon {
  font-size: 24rpx;
  color: #FF4D4F;
  margin-right: 5rpx;
}

.intimacy-num {
  font-size: 22rpx;
  color: #FF4D4F;
}

.sighting-list {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.sighting-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  border-bottom: 2rpx solid #F5F5F5;
}

.sighting-item:last-child {
  border-bottom: none;
}

.sighting-photo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.sighting-content {
  flex: 1;
}

.sighting-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.sighting-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.sighting-time {
  font-size: 22rpx;
  color: #999999;
}

.sighting-location {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.sighting-tags {
  display: flex;
  flex-wrap: wrap;
}

.sighting-action {
  width: 80rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-text {
  font-size: 24rpx;
  color: #ffffff;
}

.lost-card {
  position: relative;
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.lost-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.lost-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.4);
}

.lost-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.lost-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 20rpx;
}

.lost-btn {
  display: inline-block;
  width: 160rpx;
  height: 60rpx;
  background: #ffffff;
  color: #FF8C42;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ranking-list {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 20rpx 25rpx;
  border-bottom: 2rpx solid #F5F5F5;
}

.ranking-item:last-child {
  border-bottom: none;
}

.ranking-num {
  width: 48rpx;
  height: 48rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.ranking-num.other {
  font-size: 26rpx;
  color: #999999;
}

.ranking-photo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.ranking-info {
  flex: 1;
}

.ranking-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 5rpx;
}

.ranking-desc {
  font-size: 22rpx;
  color: #999999;
}

.ranking-intimacy {
  display: flex;
  align-items: center;
}