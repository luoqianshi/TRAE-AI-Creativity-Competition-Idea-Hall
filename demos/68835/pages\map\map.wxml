<view class="container">
  <view class="map-header">
    <view class="location-btn" bindtap="refreshLocation">
      <text class="location-icon">📍</text>
      <text class="location-text">我的位置</text>
    </view>
    <view class="search-box" bindtap="showSearch">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索犬只名称或位置</text>
    </view>
  </view>

  <view class="map-container">
    <map 
      id="dogMap"
      class="dog-map"
      longitude="{{centerLongitude}}"
      latitude="{{centerLatitude}}"
      scale="15"
      markers="{{markers}}"
      bindmarkertap="onMarkerTap"
      show-location
    ></map>
    
    <view class="map-legend">
      <view class="legend-item">
        <view class="legend-dot active"></view>
        <text class="legend-text">已解锁犬只</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot locked"></view>
        <text class="legend-text">待解锁</text>
      </view>
    </view>
  </view>

  <view class="bottom-panel">
    <view class="panel-header">
      <text class="panel-title">周边犬只</text>
      <text class="panel-count">共{{dogList.length}}只</text>
    </view>
    <scroll-view class="dog-list" scroll-y>
      <view 
        class="dog-item" 
        wx:for="{{dogList}}" 
        wx:key="id"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <image class="dog-avatar" src="{{item.photo}}" mode="aspectFill"></image>
        <view class="dog-detail">
          <view class="dog-title-row">
            <text class="dog-name">{{item.name}}</text>
            <text class="dog-intimacy-tag" wx:if="{{item.intimacy > 0}}">❤ {{item.intimacy}}</text>
          </view>
          <text class="dog-address">{{item.address}}</text>
          <view class="dog-meta">
            <text class="meta-item">{{item.color}}</text>
            <text class="meta-item">{{item.size}}</text>
            <text class="meta-item">{{item.health}}</text>
          </view>
        </view>
        <view class="dog-arrow">
          <text class="arrow-icon">›</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="fab-btn" bindtap="goToCamera">
    <text class="fab-icon">📸</text>
  </view>
</view>