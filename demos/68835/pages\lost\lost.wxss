.page-header {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  padding: 40rpx 30rpx;
  padding-top: calc(40rpx + env(safe-area-inset-top));
  text-align: center;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.search-section {
  background: #ffffff;
  padding: 20rpx 30rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 100rpx;
  padding: 0 25rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.filter-tag {
  background: #F5F5F5;
  padding: 15rpx 25rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #666666;
}

.filter-tag.active {
  background: #FFF8F0;
  color: #FF8C42;
}

.lost-list {
  padding: 20rpx 30rpx;
  padding-bottom: 140rpx;
}

.lost-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.lost-photo {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.lost-info {
  margin-bottom: 20rpx;
}

.lost-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.lost-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-right: 15rpx;
}

.lost-tag {
  background: #FFF8F0;
  color: #FF8C42;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.lost-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 15rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #666666;
}

.lost-location,
.lost-date,
.lost-features {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.lost-contact {
  display: flex;
  align-items: center;
  margin-top: 15rpx;
  padding-top: 15rpx;
  border-top: 2rpx solid #F5F5F5;
}

.contact-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.contact-text {
  font-size: 28rpx;
  color: #FF8C42;
  font-weight: 500;
}

.lost-actions {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
}

.action-btn.secondary {
  background: #F5F5F5;
}

.action-btn.primary .btn-text {
  color: #ffffff;
}

.action-btn.secondary .btn-text {
  color: #666666;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

.fab-btn {
  position: fixed;
  right: 30rpx;
  bottom: calc(30rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(255, 140, 66, 0.4);
}

.fab-icon {
  font-size: 48rpx;
  color: #ffffff;
}