<view class="container">
  <view class="profile-header">
    <view class="header-bg"></view>
    <view class="user-info">
      <view class="avatar-wrap">
        <view class="avatar">
          <text class="avatar-icon">👤</text>
        </view>
        <view class="level-badge">{{userStats.level}}</view>
      </view>
      <view class="user-detail">
        <text class="user-name">爱心铲屎官</text>
        <text class="user-desc">已记录 {{userStats.totalDogs}} 只流浪犬</text>
      </view>
    </view>
    <view class="edit-btn">
      <text class="edit-icon">⚙</text>
    </view>
  </view>

  <view class="stats-card">
    <view class="stat-item" bindtap="goToGallery">
      <text class="stat-num">{{userStats.totalSightings}}</text>
      <text class="stat-label">目击次数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{userStats.totalDogs}}</text>
      <text class="stat-label">记录犬只</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{userStats.intimacyTotal}}</text>
      <text class="stat-label">总亲密度</text>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="goToLost">
      <text class="menu-icon">🔍</text>
      <text class="menu-text">走失寻宠</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">❤️</text>
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">📝</text>
      <text class="menu-text">打卡记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">🏥</text>
      <text class="menu-text">救助信息</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item">
      <text class="menu-icon">📱</text>
      <text class="menu-text">分享给朋友</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">⭐</text>
      <text class="menu-text">给我们评分</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">💬</text>
      <text class="menu-text">联系我们</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="featured-section">
    <text class="section-title">本周推荐</text>
    <view class="featured-dog" bindtap="goToDetail" data-id="dog_003">
      <image class="featured-photo" src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=large%20black%20labrador%20mix%20dog%20energetic%20running%20in%20city%20park&image_size=square" mode="aspectFill"></image>
      <view class="featured-info">
        <text class="featured-name">旺财</text>
        <text class="featured-intimacy">❤ 亲密度 78</text>
        <text class="featured-desc">国贸CBD最受欢迎的流浪犬，每天早上6点准时出现在喷泉旁</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="footer-text">JimiDog v1.0.0</text>
    <text class="footer-desc">让每一只流浪犬都拥有专属身份卡</text>
  </view>
</view>