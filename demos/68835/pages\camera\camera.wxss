.camera-header {
  text-align: center;
  padding: 40rpx 30rpx;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}

.header-tip {
  font-size: 26rpx;
  color: #999999;
}

.camera-preview {
  height: 600rpx;
  background: #F5F5F5;
  border-radius: 20rpx;
  margin: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-placeholder {
  text-align: center;
}

.camera-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.camera-text {
  display: block;
  font-size: 30rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.camera-hint {
  font-size: 24rpx;
  color: #999999;
}

.image-preview {
  padding: 0 30rpx;
}

.preview-image {
  width: 100%;
  border-radius: 20rpx;
}

.preview-actions {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-top: 30rpx;
}

.preview-btn {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx;
  border-radius: 100rpx;
}

.preview-btn.primary {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
}

.preview-btn.secondary {
  background: #F5F5F5;
}

.preview-btn .btn-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.preview-btn.primary .btn-text {
  color: #ffffff;
}

.preview-btn.secondary .btn-text {
  color: #666666;
}

.camera-actions {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 60rpx 30rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666666;
}

.action-btn.camera {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(255, 140, 66, 0.4);
}

.camera-ring {
  width: 120rpx;
  height: 120rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-inner {
  width: 80rpx;
  height: 80rpx;
  background: #ffffff;
  border-radius: 50%;
}

.ai-result {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 30rpx rgba(0, 0, 0, 0.1);
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.result-close {
  font-size: 36rpx;
  color: #CCCCCC;
}

.result-content {
  max-height: 60vh;
  overflow-y: auto;
}

.matched-card {
  display: flex;
  background: #FFF8F0;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 30rpx;
}

.matched-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.matched-info {
  flex: 1;
}

.matched-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}

.matched-similarity {
  display: block;
  font-size: 26rpx;
  color: #FF8C42;
  margin-bottom: 15rpx;
}

.matched-tags {
  display: flex;
  flex-wrap: wrap;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.result-btn {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  border-radius: 100rpx;
  padding: 25rpx;
  text-align: center;
}

.result-btn.secondary {
  background: #F5F5F5;
}

.result-btn .btn-text {
  font-size: 28rpx;
  color: #ffffff;
}

.result-btn.secondary .btn-text {
  color: #666666;
}

.no-match {
  text-align: center;
  padding: 40rpx 0;
}

.no-match-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.no-match-text {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}

.no-match-hint {
  font-size: 26rpx;
  color: #999999;
}

.scan-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.scan-line {
  width: 60%;
  height: 4rpx;
  background: #FF8C42;
  animation: scan 2s infinite;
}

@keyframes scan {
  0% {
    transform: translateY(-100rpx);
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
  100% {
    transform: translateY(100rpx);
    opacity: 0;
  }
}

.scan-text {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #ffffff;
}