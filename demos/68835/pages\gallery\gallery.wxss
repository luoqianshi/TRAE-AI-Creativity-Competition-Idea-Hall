.gallery-header {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  padding: 40rpx 30rpx;
  padding-top: calc(40rpx + env(safe-area-inset-top));
  text-align: center;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 25rpx;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 100rpx;
  overflow: hidden;
  margin-bottom: 15rpx;
}

.progress-fill {
  height: 100%;
  background: #ffffff;
  border-radius: 100rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.filter-tabs {
  display: flex;
  background: #ffffff;
  padding: 10rpx 30rpx;
  gap: 20rpx;
}

.filter-tab {
  flex: 1;
  height: 72rpx;
  background: #F5F5F5;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-tab.active {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
}

.tab-text {
  font-size: 28rpx;
  color: #666666;
}

.filter-tab.active .tab-text {
  color: #ffffff;
}

.gallery-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  height: calc(100vh - 450rpx);
}

.gallery-item {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.gallery-item.locked .dog-image {
  filter: grayscale(100%);
}

.item-image {
  position: relative;
  width: 100%;
  height: 280rpx;
}

.dog-image {
  width: 100%;
  height: 100%;
}

.lock-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lock-icon {
  font-size: 60rpx;
}

.intimacy-badge {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  background: rgba(255, 77, 79, 0.9);
  border-radius: 100rpx;
  padding: 8rpx 15rpx;
  display: flex;
  align-items: center;
}

.badge-icon {
  font-size: 20rpx;
  margin-right: 5rpx;
}

.badge-num {
  font-size: 22rpx;
  color: #ffffff;
}

.item-info {
  padding: 20rpx;
}

.item-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 5rpx;
}

.item-breed {
  font-size: 24rpx;
  color: #999999;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.collection-guide {
  background: #FFF8F0;
  padding: 30rpx;
  margin: 20rpx;
  border-radius: 20rpx;
}

.guide-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #FF8C42;
  margin-bottom: 20rpx;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.guide-item {
  display: flex;
  align-items: center;
}

.guide-num {
  width: 48rpx;
  height: 48rpx;
  background: #FF8C42;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 15rpx;
}

.guide-desc {
  font-size: 26rpx;
  color: #666666;
}