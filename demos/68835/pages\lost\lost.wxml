<view class="container">
  <view class="page-header">
    <text class="header-title">走失寻宠</text>
    <text class="header-desc">帮助走失的毛孩子找到回家的路</text>
  </view>

  <view class="search-section">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索犬只名称、特征" />
    </view>
    <view class="filter-tags">
      <view class="filter-tag active">全部</view>
      <view class="filter-tag">泰迪</view>
      <view class="filter-tag">金毛</view>
      <view class="filter-tag">哈士奇</view>
      <view class="filter-tag">中华田园犬</view>
    </view>
  </view>

  <view class="lost-list">
    <view class="lost-card" wx:for="{{lostDogs}}" wx:key="id">
      <image class="lost-photo" src="{{item.photo}}" mode="aspectFill"></image>
      <view class="lost-info">
        <view class="lost-header">
          <text class="lost-name">{{item.name}}</text>
          <text class="lost-tag">{{item.breed}}</text>
        </view>
        <view class="lost-meta">
          <text class="meta-item">{{item.color}}</text>
          <text class="meta-item">{{item.size}}</text>
          <text class="meta-item">{{item.gender}}</text>
          <text class="meta-item">{{item.age}}</text>
        </view>
        <text class="lost-location">📍 {{item.lostLocation}}</text>
        <text class="lost-date">走失时间：{{item.lostDate}}</text>
        <text class="lost-features">特征：{{item.features}}</text>
        <view class="lost-contact">
          <text class="contact-icon">📞</text>
          <text class="contact-text">{{item.contact}}</text>
        </view>
      </view>
      <view class="lost-actions">
        <view class="action-btn primary">
          <text class="btn-text">我看到了</text>
        </view>
        <view class="action-btn secondary">
          <text class="btn-text">分享扩散</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{lostDogs.length === 0}}">
    <text class="empty-icon">🐾</text>
    <text class="empty-text">暂无走失犬只信息</text>
    <text class="empty-desc">如果您发现走失犬只，可以发布寻宠信息</text>
  </view>

  <view class="fab-btn" bindtap="publishLost">
    <text class="fab-icon">➕</text>
  </view>
</view>