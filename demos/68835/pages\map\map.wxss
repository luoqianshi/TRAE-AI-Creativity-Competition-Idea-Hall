.map-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 20rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  gap: 15rpx;
}

.location-btn {
  width: 120rpx;
  height: 72rpx;
  background: #FFF8F0;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
}

.location-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.location-text {
  font-size: 24rpx;
  color: #FF8C42;
}

.search-box {
  flex: 1;
  height: 72rpx;
  background: #F5F5F5;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  padding: 0 25rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 15rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #999999;
}

.map-container {
  position: fixed;
  top: calc(112rpx + env(safe-area-inset-top));
  left: 0;
  right: 0;
  bottom: 400rpx;
}

.dog-map {
  width: 100%;
  height: 100%;
}

.map-legend {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  padding: 15rpx 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.legend-item:last-child {
  margin-bottom: 0;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.legend-dot.active {
  background: #FF8C42;
}

.legend-dot.locked {
  background: #CCCCCC;
}

.legend-text {
  font-size: 22rpx;
  color: #666666;
}

.bottom-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -4rpx 30rpx rgba(0, 0, 0, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 30rpx;
  border-bottom: 2rpx solid #F5F5F5;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.panel-count {
  font-size: 26rpx;
  color: #999999;
}

.dog-list {
  height: calc(320rpx - env(safe-area-inset-bottom));
  padding: 10rpx 0;
}

.dog-item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
}

.dog-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.dog-detail {
  flex: 1;
}

.dog-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.dog-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-right: 15rpx;
}

.dog-intimacy-tag {
  font-size: 22rpx;
  color: #FF4D4F;
}

.dog-address {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.dog-meta {
  display: flex;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 22rpx;
  color: #999999;
  margin-right: 20rpx;
}

.dog-arrow {
  width: 40rpx;
  display: flex;
  justify-content: center;
}

.arrow-icon {
  font-size: 40rpx;
  color: #CCCCCC;
}

.fab-btn {
  position: fixed;
  right: 30rpx;
  bottom: 440rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(255, 140, 66, 0.4);
}

.fab-icon {
  font-size: 40rpx;
}