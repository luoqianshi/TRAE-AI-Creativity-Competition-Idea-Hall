.detail-header {
  position: relative;
  height: 500rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.header-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.7));
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  padding: 30rpx;
  padding-top: calc(60rpx + env(safe-area-inset-top));
  height: 100%;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #ffffff;
}

.header-info {
  flex: 1;
}

.dog-name {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 15rpx;
}

.header-tags {
  display: flex;
  flex-wrap: wrap;
}

.header-tags .tag {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.header-actions {
  margin-left: 20rpx;
}

.header-actions .action-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 36rpx;
}

.intimacy-section {
  background: #ffffff;
  margin: -40rpx 30rpx 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.intimacy-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.intimacy-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.intimacy-level {
  font-size: 26rpx;
  color: #FF8C42;
}

.intimacy-bar {
  width: 100%;
  height: 20rpx;
  background: #F5F5F5;
  border-radius: 100rpx;
  overflow: hidden;
  margin-bottom: 15rpx;
}

.intimacy-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF8C42 0%, #FF6B35 100%);
  border-radius: 100rpx;
  transition: width 0.3s ease;
}

.intimacy-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.intimacy-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF8C42;
}

.intimacy-next {
  font-size: 24rpx;
  color: #999999;
}

.info-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.info-item:nth-child(odd) {
  border-right: 2rpx solid #F5F5F5;
}

.info-item:nth-last-child(-n+2) {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.health-info {
  display: flex;
}

.health-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  margin-right: 15rpx;
}

.health-item:last-child {
  margin-right: 0;
}

.health-status {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.health-status.good {
  color: #52C41A;
}

.health-status.warning {
  color: #FF8C42;
}

.health-label {
  font-size: 24rpx;
  color: #999999;
}

.location-info {
  margin-bottom: 20rpx;
}

.location-text {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 10rpx;
}

.feed-point {
  font-size: 26rpx;
  color: #FF8C42;
}

.mini-map {
  border-radius: 16rpx;
  overflow: hidden;
}

.small-map {
  width: 100%;
  height: 300rpx;
}

.features-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.sighting-stats {
  display: flex;
  margin-bottom: 20rpx;
}

.sighting-stat {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #F9F9F9;
  border-radius: 16rpx;
  margin-right: 15rpx;
}

.sighting-stat:last-child {
  margin-right: 0;
}

.sighting-stat .stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FF8C42;
  margin-bottom: 8rpx;
}

.sighting-stat .stat-label {
  font-size: 24rpx;
  color: #999999;
}

.witnesses {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.witnesses-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 10rpx;
}

.witness-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.witness-tag {
  background: #FFF8F0;
  color: #FF8C42;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.bottom-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.bottom-actions .action-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-actions .action-btn.primary {
  background: linear-gradient(135deg, #FF8C42 0%, #FF6B35 100%);
}

.bottom-actions .action-btn.secondary {
  background: #F5F5F5;
}

.bottom-actions .btn-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.bottom-actions .btn-text {
  font-size: 30rpx;
  font-weight: 500;
}

.bottom-actions .primary .btn-text {
  color: #ffffff;
}

.bottom-actions .secondary .btn-text {
  color: #666666;
}