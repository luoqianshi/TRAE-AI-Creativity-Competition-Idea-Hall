{
  "name": "xinmianxiaozhu",
  "version": "1.2.0",
  "description": "心眠小筑 - AI情绪管理与助眠应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "web": "start index.html"
  },
  "keywords": [
    "AI",
    "情绪管理",
    "助眠",
    "心理健康",
    "火山引擎",
    "electron"
  ],
  "author": "心眠小筑团队",
  "license": "MIT",
  "build": {
    "appId": "com.xinmianxiaozhu.app",
    "productName": "心眠小筑",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "deb",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
