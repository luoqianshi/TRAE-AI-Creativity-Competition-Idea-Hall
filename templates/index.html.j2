<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TRAE AI 创造力大赛 · 灵感 Demo Hall</title>
  <link rel="icon" type="image/png" href="assets/trae-work.png">
  <link rel="stylesheet" href="styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <canvas id="particle-canvas"></canvas>

  <!-- Navbar -->
  <nav class="navbar">
    <a href="./" class="logo">
      <img src="assets/trae-work.png" alt="TRAE" class="logo-img">
      <span>TRAE Idea Hall</span>
    </a>
    <div class="nav-right">
      <input type="text" class="search-box" id="search-input" placeholder="搜索灵感...">
    </div>
  </nav>

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <div class="hero-inner">
          <div class="pill-tag">
            <span class="dot"></span>
            TRAE AI 创造力大赛 · 灵感 Demo Hall
          </div>
          <h1>
            实时汇总大赛报名专区的<br>
            <span class="accent">创意产物</span>与 Demo 展示
          </h1>
          <p>每日自动爬取 forum.trae.cn 大赛报名专区的灵感帖，汇聚所有参赛者的 HTML Demo 作品，一键在线体验。</p>
          <div class="hero-cta">
            <a href="#demos" class="btn btn-primary">浏览全部 Demo</a>
            <a href="https://forum.trae.cn/c/38-category/40-category/40" target="_blank" class="btn btn-secondary">前往社区报名</a>
          </div>
          <div class="hero-stats">
            <div class="stat-item">
              <span class="stat-value">{{ stats.total }}</span>
              <span class="stat-label">总作品</span>
            </div>
            <div class="stat-item">
              <span class="stat-value" style="color:#22c55e">{{ stats.approved }}</span>
              <span class="stat-label">审核通过</span>
            </div>
            <div class="stat-item">
              <span class="stat-value">{{ stats.with_demo }}</span>
              <span class="stat-label">含 Demo</span>
            </div>
            {% for tag_key, tag_name in track_tags.items() %}
            <div class="stat-item">
              <span class="stat-value">{{ stats.get(tag_name, 0) }}</span>
              <span class="stat-label">{{ tag_name }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- Filter Bar -->
    <div class="filter-bar">
      <div class="container">
        <div class="filter-inner">
          <div class="filter-tags">
            <span class="tag-pill active" data-tag="all">全部</span>
            {% for tag_key, tag_name in track_tags.items() %}
            <span class="tag-pill" data-tag="{{ tag_name }}">{{ tag_name }}</span>
            {% endfor %}
          </div>
          <div class="filter-sort">
            <select id="sort-select">
              <option value="newest">最新发布</option>
              <option value="views">最多浏览</option>
              <option value="likes">最多点赞</option>
            </select>
          </div>
        </div>
        <div class="filter-inner" style="margin-top:8px;">
          <div class="filter-approval">
            <label class="approval-toggle">
              <input type="checkbox" id="approved-only" checked>
              <span class="toggle-slider"></span>
              <span class="toggle-label">仅展示官方审核通过</span>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Cards Grid -->
    <section class="cards-section" id="demos">
      <div class="container">
        <div class="cards-grid">
          {% for demo in demos %}
          <div class="card"
               data-tags="{{ demo.tags | join(',') }}"
               data-title="{{ demo.title }}"
               data-excerpt="{{ demo.excerpt or '' }}"
               data-created="{{ demo.created_at }}"
               data-views="{{ demo.views }}"
               data-likes="{{ demo.like_count }}"
               data-approved="{{ 'true' if demo.approved else 'false' }}">
            {% if demo.tags %}
            <div class="card-tag-row">
              {% set tag_img_map = {'生活娱乐': 'life-default.png', '学习工作': 'study-default.png', '社会服务': 'common-env-default.png', '硬件交互': 'hardware-default.png', '社会公益': 'special-default.png'} %}
              {% if demo.tags[0] in tag_img_map %}
              <img src="assets/tracks/{{ tag_img_map[demo.tags[0]] }}" alt="{{ demo.tags[0] }}" class="card-tag-img">
              {% endif %}
              <span class="card-tag-text">{{ demo.tags[0] }}</span>
              {% if demo.approved %}
              <span class="approved-badge" title="官方审核通过">&#10003;</span>
              {% endif %}
            </div>
            {% endif %}
            <h3 class="card-title">{{ demo.title }}</h3>
            <p class="card-excerpt">{{ demo.excerpt or '暂无描述' }}</p>
            <div class="card-meta">
              <span class="meta-item"><img src="assets/icons/eye.svg" class="meta-icon" alt="views"> {{ demo.views }}</span>
              <span class="meta-item"><img src="assets/icons/heart.svg" class="meta-icon" alt="likes"> {{ demo.like_count }}</span>
              <span class="meta-item"><img src="assets/icons/user.svg" class="meta-icon" alt="author"> {{ demo.author }}</span>
            </div>
            <div class="card-actions">
              {% if demo.has_demo %}
                {% if demo.demo_url %}
                <a href="{{ demo.demo_url }}" target="_blank" class="btn btn-primary btn-sm"><img src="assets/icons/play.svg" class="btn-icon" alt=""> 查看 Demo</a>
                {% elif demo.external_url %}
                <a href="{{ demo.external_url }}" target="_blank" class="btn btn-primary btn-sm"><img src="assets/icons/play.svg" class="btn-icon" alt=""> 查看 Demo</a>
                {% endif %}
              {% else %}
                <button class="btn btn-primary btn-sm disabled" disabled><img src="assets/icons/play.svg" class="btn-icon" alt=""> 暂无 Demo</button>
              {% endif %}
              <a href="{{ demo.forum_url }}" target="_blank" class="btn btn-secondary btn-sm"><img src="assets/icons/external.svg" class="btn-icon" alt=""> 社区帖子</a>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <p>Powered by <a href="https://www.trae.cn" target="_blank">TRAE</a> · 数据来源: <a href="https://forum.trae.cn/c/38-category/40-category/40" target="_blank">forum.trae.cn</a> + 飞书官方审核名单</p>
        <p>作者 <a href="https://forum.trae.cn/u/%E9%AA%86%E8%B0%A6%E5%AE%9E/summary" target="_blank">@骆谦实</a> · TRAE 中文社区</p>
        <p>最后更新: {{ last_updated[:19] if last_updated else '未知' }}</p>
      </div>
    </footer>
  </main>

  <script src="script.js"></script>
</body>
</html>
